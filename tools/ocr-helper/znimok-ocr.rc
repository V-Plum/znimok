// Version information: an exe without it looks like malware to antivirus heuristics.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Vadym Slyva"
            VALUE "FileDescription", "Znimok text recognition helper (Tesseract)"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "znimok-ocr"
            VALUE "LegalCopyright", "Copyright (c) 2026 Vadym Slyva. Tesseract and Leptonica: see NOTICE."
            VALUE "OriginalFilename", "znimok-ocr.exe"
            VALUE "ProductName", "Znimok"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
