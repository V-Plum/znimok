<?xml version="1.0" encoding="utf-8"?>
<!--
  Znimok for Windows (ZK-78): a per-user MSI — no UAC prompt, installs into
  %LOCALAPPDATA%\Programs\Znimok, a newer version replaces the older one (MajorUpgrade), settings
  and the library in the profile are never touched, uninstall removes everything it added.

  Built by .github/workflows/release.yml:
    wix build packaging/msi/znimok.wxs -arch x64 -d Version=1.2.3 -d Bin=<folder with the exes> -o Znimok.msi

  UpgradeCode must NEVER change: it is how a new version finds and replaces the old one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Znimok"
           Manufacturer="Vadym Slyva"
           Version="$(var.Version)"
           UpgradeCode="{7B593159-BA4C-4248-9B58-82E33A5A9DBB}"
           Scope="perUser"
           Compressed="yes"
           Language="1033">
    <SummaryInformation Description="Znimok — screenshots, annotations, agents" />
    <!-- Working builds all carry the workspace version (0.0.0-preview.<sha> → 0.0.0): without
         AllowSameVersionUpgrades a newer one would install beside the old instead of replacing it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Znimok is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The icon in Settings → Apps / Programs and Features. The Start menu shortcut and the
         .znimok type take the icon from znimok-app.exe itself. -->
    <Icon Id="ZnimokIcon" SourceFile="crates\znimok-app\icons\znimok.ico" />
    <Property Id="ARPPRODUCTICON" Value="ZnimokIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/V-Plum/znimok" />
    <Property Id="ARPHELPLINK" Value="https://github.com/V-Plum/znimok/issues" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Znimok">
          <Directory Id="TESSDATA" Name="tessdata" />
          <Directory Id="DOCICONS" Name="icons" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Per-user components keep an HKCU value as their key path (ICE38). -->
    <!-- Per-user files keyed by an HKCU value need fixed component GUIDs: never change them. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Component Id="App" Guid="{06CC4D80-FEDA-4EBD-9B69-8869403EE477}">
        <File Id="AppExe" Source="$(var.Bin)\znimok-app.exe" />
        <RegistryValue Root="HKCU" Key="Software\Znimok\Installed" Name="app" Type="integer" Value="1" KeyPath="yes" />
        <!-- The installed version, for the updater's own check (ZK-122) and the app. -->
        <RegistryValue Root="HKCU" Key="Software\Znimok\Installed" Name="version" Type="string" Value="[ProductVersion]" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
      <Component Id="Cli" Guid="{C0CE9BCB-2FE2-4FFC-8341-FFC81292CF6E}">
        <File Id="CliExe" Source="$(var.Bin)\znimok.exe" />
        <RegistryValue Root="HKCU" Key="Software\Znimok\Installed" Name="cli" Type="integer" Value="1" KeyPath="yes" />
        <!-- `znimok` on the user's PATH: the CLI and `claude mcp add znimok` (then `znimok mcp`). -->
        <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
        <!-- The CLI is the browsers' DevTools-log host (ZK-97): the app registers it on start; the
             uninstall takes the registration away. -->
        <RemoveRegistryKey Action="removeOnUninstall" Root="HKCU" Key="Software\Google\Chrome\NativeMessagingHosts\com.znimok.devtools" />
        <RemoveRegistryKey Action="removeOnUninstall" Root="HKCU" Key="Software\Microsoft\Edge\NativeMessagingHosts\com.znimok.devtools" />
        <RemoveRegistryKey Action="removeOnUninstall" Root="HKCU" Key="Software\Chromium\NativeMessagingHosts\com.znimok.devtools" />
      </Component>
      <Component Id="Thumbnails" Guid="{16D6D7F6-C481-45C6-A322-C37DD78D6E25}">
        <File Id="ThumbDll" Source="$(var.Bin)\znimok_thumbnail.dll" />
        <RegistryValue Root="HKCU" Key="Software\Znimok\Installed" Name="thumbnails" Type="integer" Value="1" KeyPath="yes" />
        <!-- Explorer thumbnails of .znimok (ZK-76): the same keys as znimok_thumbnail::register. -->
        <RegistryKey Root="HKCU" Key="Software\Classes\CLSID\{787777D8-E076-4FDC-8065-F7282E5D3F86}">
          <RegistryValue Type="string" Value="Znimok thumbnail" />
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]znimok_thumbnail.dll" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKCU" Key="Software\Classes\.znimok\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{787777D8-E076-4FDC-8065-F7282E5D3F86}" />
        <!-- File icons by kind (ZK-150): the icon handler in the same DLL; the document type asks it
             per file ("%1" in DefaultIcon). -->
        <RegistryKey Root="HKCU" Key="Software\Classes\CLSID\{0F5C6E12-2A39-4AAC-9C34-3E2C9305E05A}">
          <RegistryValue Type="string" Value="Znimok file icon" />
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]znimok_thumbnail.dll" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKCU" Key="Software\Classes\Znimok.Document\shellex\IconHandler" Type="string" Value="{0F5C6E12-2A39-4AAC-9C34-3E2C9305E05A}" />
      </Component>
      <Component Id="License" Guid="{A63EC25C-3911-4DC9-8450-A17B6788BAF9}">
        <File Id="LicenseFile" Source="$(var.Bin)\LICENSE" Name="LICENSE.txt" />
        <RegistryValue Root="HKCU" Key="Software\Znimok\Installed" Name="license" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- Text recognition in Ukrainian and English (ZK-120): the Tesseract helper, its models and
           their licenses. -->
      <Component Id="Ocr" Guid="{38B50DB7-F1F8-4021-8B20-6F292E61A891}">
        <File Id="OcrExe" Source="$(var.Bin)\znimok-ocr.exe" />
        <File Id="OcrNotice" Source="$(var.Bin)\NOTICE-ocr.txt" />
        <RegistryValue Root="HKCU" Key="Software\Znimok\Installed" Name="ocr" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- The .znimok file icons (a screenshot, a video, a video with a DevTools log), next to the
           DLL whose icon handler names them (ZK-150). -->
      <Component Id="DocIcons" Directory="DOCICONS" Guid="{E51B4249-A03A-4914-B0F8-58CC73E570D3}">
        <File Id="DocIconImage" Source="$(var.Bin)\icons\doc-image.ico" />
        <File Id="DocIconVideo" Source="$(var.Bin)\icons\doc-video.ico" />
        <File Id="DocIconReport" Source="$(var.Bin)\icons\doc-report.ico" />
        <RegistryValue Root="HKCU" Key="Software\Znimok\Installed" Name="doc-icons" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveDocIcons" On="uninstall" />
      </Component>
      <Component Id="OcrModels" Directory="TESSDATA" Guid="{ECF62A12-0E8E-42A1-BF20-E3760024E24E}">
        <File Id="OcrUkr" Source="$(var.Bin)\tessdata\ukr.traineddata" />
        <File Id="OcrEng" Source="$(var.Bin)\tessdata\eng.traineddata" />
        <RegistryValue Root="HKCU" Key="Software\Znimok\Installed" Name="ocr-models" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveTessdata" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- .znimok opens in Znimok (ZK-75): the keys of znimok_win::WinFileAssoc. The installer owns
         the type, so it is the default here; the user's own choice (UserChoice) still wins. -->
    <ComponentGroup Id="Association" Directory="INSTALLFOLDER">
      <Component Id="FileType" Guid="{B62C6D5A-F5DC-40C1-84D7-8C13FD635865}">
        <RegistryValue Root="HKCU" Key="Software\Znimok\Installed" Name="association" Type="integer" Value="1" KeyPath="yes" />
        <RegistryKey Root="HKCU" Key="Software\Classes\Znimok.Document">
          <RegistryValue Type="string" Value="Znimok document" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="Znimok document" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="%1" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]znimok-app.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKCU" Key="Software\Classes\.znimok" Type="string" Value="Znimok.Document" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.znimok\OpenWithProgids" Name="Znimok.Document" Type="string" Value="" />
        <RegistryKey Root="HKCU" Key="Software\Classes\Applications\znimok-app.exe">
          <RegistryValue Key="SupportedTypes" Name=".znimok" Type="string" Value="" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]znimok-app.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Menu" Directory="ProgramMenuFolder">
      <Component Id="StartMenu" Guid="{777B37D7-0D1A-4F8B-AD45-9BD81299E4EB}">
        <Shortcut Id="StartMenuShortcut" Name="Znimok" Target="[INSTALLFOLDER]znimok-app.exe" WorkingDirectory="INSTALLFOLDER" Description="Screenshots and annotations" />
        <RegistryValue Root="HKCU" Key="Software\Znimok\Installed" Name="menu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Znimok" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentGroupRef Id="Association" />
      <ComponentGroupRef Id="Menu" />
    </Feature>
  </Package>
</Wix>
