{
  "manifest_version": 3,
  "name": "Znimok — DevTools log",
  "short_name": "Znimok",
  "version": "0.1.0",
  "description": "Writes the page's console, errors, network (headers and bodies) and navigations in sync with a Znimok screen recording, and starts recording this window from the toolbar.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "alarms",
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Znimok",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-recording": {
      "description": "Start or stop recording this window"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
