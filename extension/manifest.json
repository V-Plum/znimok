{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Znimok",
  "version": "0.1.4",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "alarms",
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-recording": {
      "description": "__MSG_cmdToggle__"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
