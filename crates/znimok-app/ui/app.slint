// Znimok — first working prototype of the application UI (ZK-46/47/59).
// Layout follows the design mock-up (Design artifact v17): library as the home screen; editor
// with a top bar (back, Open, title, autosave, undo/redo, Copy ▾), a tool rail, the canvas, an
// inspector and a status bar. Strings come from i18n/*.ftl through @tr (ZK-29).
// Not yet here: tabs, overlay editor, full inspector, settings (see the tickets of Phase 4).

import { LineEdit, ScrollView } from "std-widgets.slint";

export global Theme {
    out property <color> canvas: #0B0D11;
    out property <color> app: #0F1115;
    out property <color> panel: #171A20;
    out property <color> elevated: #1E2229;
    out property <color> control-on: #2A2F38;
    out property <color> line: #22262E;
    out property <color> text: #E8EAEE;
    out property <color> text2: #A7ADB8;
    out property <color> text3: #6F7682;
    out property <color> accent: #3D7BF5;
    out property <color> accent-text: #8FB6FF;
    out property <color> attention: #FFD23F;
    out property <color> ok: #34C48A;
    out property <color> disabled: #4A505A;
}

export struct CardData {
    name: string,
    meta: string,
    thumb: image,
    path: string,
}

component Icon inherits Path {
    in property <string> d;
    in property <color> tint: Theme.text2;
    commands: d;
    stroke: tint;
    stroke-width: 1.75px;
    fill: transparent;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 20px;
    height: 20px;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <string> label;
    callback clicked;
    callback hovered(bool);
    width: 36px;
    height: 32px;
    border-radius: 8px;
    background: active ? Theme.control-on : (ta.has-hover && enabled ? Theme.elevated : transparent);
    accessible-role: button;
    accessible-label: label;
    Icon {
        d: icon;
        tint: !enabled ? Theme.disabled : (active ? Theme.text : Theme.text2);
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: primary ? (enabled ? (ta.has-hover ? #5189F7 : Theme.accent) : Theme.control-on) : (ta.has-hover && enabled ? Theme.elevated : transparent);
    border-width: primary ? 0 : 1px;
    border-color: Theme.control-on;
    accessible-role: button;
    accessible-label: text;
    lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            d: root.icon;
            tint: primary ? white : (enabled ? Theme.text : Theme.disabled);
        }
        Text {
            text: root.text;
            color: primary ? white : (enabled ? Theme.text : Theme.disabled);
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component MenuItemRow inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    border-radius: 8px;
    background: ta.has-hover && enabled ? Theme.control-on : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        Text { text: root.text; color: enabled ? Theme.text : Theme.disabled; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; wrap: no-wrap; }
        Text { text: root.shortcut; color: Theme.text3; font-size: 11px; vertical-alignment: center; wrap: no-wrap; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Switch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled;
    width: 32px;
    height: 18px;
    border-radius: 9px;
    background: checked ? Theme.accent : Theme.control-on;
    accessible-role: switch;
    accessible-checked: checked;
    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: white;
        animate x { duration: 160ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component CardView inherits Rectangle {
    in property <CardData> data;
    callback open;
    border-radius: 12px;
    background: Theme.panel;
    border-width: ta.has-hover ? 1.5px : 0;
    border-color: Theme.accent;
    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 64px;
        border-radius: 8px;
        background: Theme.canvas;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.data.thumb;
            image-fit: contain;
        }
    }
    Text {
        x: 12px;
        y: parent.height - 50px;
        width: parent.width - 24px;
        text: root.data.name;
        color: Theme.text;
        font-size: 13px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        x: 12px;
        y: parent.height - 28px;
        width: parent.width - 24px;
        text: root.data.meta;
        color: Theme.text3;
        font-size: 11px;
        overflow: elide;
    }
    ta := TouchArea {
        clicked => { root.open(); }
    }
}

export component AppWindow inherits Window {
    title: @tr("app-name" => "Znimok");
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 800px;
    min-height: 560px;
    background: Theme.app;
    default-font-size: 13px;

    // ---- state shared with Rust
    in-out property <int> page: 0; // 0 library, 1 editor
    in property <[CardData]> cards;
    in property <string> library-dir;
    in property <bool> capture-available: true;
    in property <string> capture-key: "Ctrl+Shift+4";
    in-out property <string> toast;

    in property <string> doc-name;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in-out property <bool> autosave: true;
    in property <int> save-state: 0; // 0 saved, 1 unsaved, 2 saving
    in-out property <int> tool: 1;
    in property <image> canvas;
    in property <string> image-size;
    in property <int> mark-count;
    in property <string> zoom-text: "100 %";
    in property <string> crop-text;
    in property <int> color-index: 0;
    in property <int> thick-index: 1;
    in property <bool> has-selection;
    in property <string> hint;
    in-out property <string> hover-hint;

    // text editing overlay
    in-out property <bool> editing: false;
    in-out property <length> edit-x;
    in-out property <length> edit-y;
    in-out property <string> edit-text;

    out property <length> canvas-width: canvas-area.width;
    out property <length> canvas-height: canvas-area.height;

    // ---- callbacks
    callback new-shot();
    callback open-file();
    callback open-clipboard();
    callback open-card(string);
    callback search(string);
    callback back();
    callback undo();
    callback redo();
    callback copy();
    callback export();
    callback autosave-toggled(bool);
    callback tool-chosen(int);
    callback pointer(int, length, length, int, bool, bool);
    callback wheel(length, length, length, bool, bool);
    callback key(string, bool, bool, bool);
    callback commit-text(string);
    callback cancel-text();
    callback set-color(int);
    callback set-thick(int);
    callback zoom-fit();
    callback zoom-100();

    public function focus-library() { lib-keys.focus(); }
    public function focus-canvas() { keys.focus(); }

    // ================================================================= library
    Rectangle {
        visible: root.page == 0;
        background: Theme.app;
        lib-keys := FocusScope {
            key-pressed(e) => {
                if (e.modifiers.control && (e.text == "v" || e.text == "V" || e.text == "м" || e.text == "М")) {
                    root.open-clipboard();
                    return accept;
                }
                if (e.modifiers.control && (e.text == "o" || e.text == "O" || e.text == "щ" || e.text == "Щ")) {
                    root.open-file();
                    return accept;
                }
                return reject;
            }
            VerticalLayout {
                Rectangle {
                    height: 56px;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Path {
                            y: 16px;
                            width: 24px; height: 24px;
                            viewbox-width: 24; viewbox-height: 24;
                            commands: "M3.5 13.5 h8 L3.5 21 h8";
                            stroke: #3D7BF5; stroke-width: 2.4px; fill: transparent;
                        }
                        Text { text: @tr("lib-title" => "Library"); color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        Rectangle {
                            width: 360px;
                            LineEdit {
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                placeholder-text: @tr("lib-search" => "Search by name, tag or text in the screenshot");
                                edited(t) => { root.search(t); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TextButton {
                            y: 12px;
                            text: @tr("lib-new-shot" => "New screenshot");
                            icon: "M12 5 v14 M5 12 h14";
                            primary: true;
                            enabled: root.capture-available;
                            clicked => { root.new-shot(); }
                        }
                        TextButton {
                            y: 12px;
                            text: @tr("open-file" => "File…");
                            icon: "M3 7 a2 2 0 0 1 2 -2 h4 l2 2 h8 a2 2 0 0 1 2 2 v9 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 z";
                            clicked => { root.open-file(); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                grid := Rectangle {
                    vertical-stretch: 1;
                    property <length> gap: 16px;
                    property <int> cols: max(1, floor((self.width - 32px + gap) / (240px + gap)));
                    property <length> cw: (self.width - 32px - (cols - 1) * gap) / cols;
                    property <length> ch: cw * 0.62 + 56px;
                    if root.cards.length == 0: VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text { text: @tr("lib-empty-title" => "Your screenshots will appear here"); color: Theme.text; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: @tr("lib-empty-body" => "Press {0} to capture a region, or use the button below.", root.capture-key); color: Theme.text2; horizontal-alignment: center; }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            TextButton {
                                text: @tr("lib-new-shot" => "New screenshot");
                                icon: "M12 5 v14 M5 12 h14";
                                primary: true;
                                enabled: root.capture-available;
                                clicked => { root.new-shot(); }
                            }
                            TextButton {
                                text: @tr("open-clipboard" => "From clipboard");
                                clicked => { root.open-clipboard(); }
                            }
                        }
                        Text { text: @tr("lib-empty-drop" => "Drop an image here to open it"); color: Theme.text3; horizontal-alignment: center; }
                        Text { text: root.library-dir; color: Theme.text3; font-size: 11px; horizontal-alignment: center; }
                    }
                    ScrollView {
                        visible: root.cards.length > 0;
                        content-height: (floor((root.cards.length + grid.cols - 1) / grid.cols)) * (grid.ch + grid.gap) + 32px;
                        for card[i] in root.cards: CardView {
                            x: 16px + mod(i, grid.cols) * (grid.cw + grid.gap);
                            y: 16px + floor(i / grid.cols) * (grid.ch + grid.gap);
                            width: grid.cw;
                            height: grid.ch;
                            data: card;
                            open => { root.open-card(card.path); }
                        }
                    }
                }
                Rectangle {
                    height: 30px;
                    background: Theme.panel;
                    Text { x: 16px; text: root.toast != "" ? root.toast : root.library-dir; color: root.toast != "" ? Theme.accent-text : Theme.text3; font-size: 12px; vertical-alignment: center; height: parent.height; }
                }
            }
            init => { self.focus(); }
        }
    }

    // ================================================================== editor
    Rectangle {
        visible: root.page == 1;
        background: Theme.app;
        VerticalLayout {
            // top bar
            Rectangle {
                height: 52px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Rectangle {
                        y: 10px;
                        width: back-row.preferred-width + 16px;
                        height: 32px;
                        border-radius: 8px;
                        background: back-ta.has-hover ? Theme.elevated : transparent;
                        back-row := HorizontalLayout {
                            x: 6px;
                            spacing: 4px;
                            Icon { y: 6px; d: "M15 6 l-6 6 6 6"; }
                            Text { text: @tr("nav-library" => "Library"); color: Theme.text2; font-weight: 500; vertical-alignment: center; }
                        }
                        back-ta := TouchArea { clicked => { root.back(); } }
                    }
                    open-btn := Rectangle {
                        y: 10px;
                        width: open-row.preferred-width + 16px;
                        height: 32px;
                        border-radius: 8px;
                        background: open-ta.has-hover ? Theme.elevated : transparent;
                        open-row := HorizontalLayout {
                            x: 10px;
                            spacing: 2px;
                            Text { text: @tr("common-open" => "Open"); color: Theme.text2; font-weight: 500; vertical-alignment: center; }
                            Icon { y: 8px; width: 16px; height: 16px; d: "M6 9 l6 6 6 -6"; }
                        }
                        open-ta := TouchArea { clicked => { open-menu.show(); } }
                        open-menu := PopupWindow {
                            x: 0;
                            y: parent.height + 4px;
                            width: 260px;
                            Rectangle {
                                background: Theme.elevated;
                                border-radius: 12px;
                                drop-shadow-blur: 24px;
                                drop-shadow-color: #00000080;
                                VerticalLayout {
                                    padding: 6px;
                                    MenuItemRow { text: @tr("open-file" => "File…"); shortcut: "Ctrl+O"; clicked => { root.open-file(); } }
                                    MenuItemRow { text: @tr("open-clipboard" => "From clipboard"); shortcut: "Ctrl+V"; clicked => { root.open-clipboard(); } }
                                    MenuItemRow { text: @tr("open-new-shot" => "New screenshot"); enabled: root.capture-available; clicked => { root.new-shot(); } }
                                }
                            }
                        }
                    }
                    Rectangle { width: 1px; height: 20px; y: 16px; background: Theme.control-on; }
                    Rectangle {
                        y: 14px;
                        height: 24px;
                        width: kind-row.preferred-width + 16px;
                        border-radius: 6px;
                        background: #3D7BF524;
                        kind-row := HorizontalLayout {
                            x: 8px;
                            Text { text: @tr("doc-kind-screenshot" => "Screenshot"); color: Theme.accent-text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                    Text { text: root.doc-name; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; max-width: 360px; }
                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;
                        Switch {
                            y: 17px;
                            checked <=> root.autosave;
                            toggled => { root.autosave-toggled(self.checked); }
                        }
                        Text { text: @tr("doc-autosave" => "Save automatically"); color: Theme.text2; font-size: 12px; vertical-alignment: center; wrap: no-wrap; }
                        Text {
                            text: root.save-state == 0 ? @tr("doc-state-saved" => "saved") : (root.save-state == 2 ? @tr("doc-state-saving" => "saving…") : @tr("doc-state-unsaved" => "unsaved"));
                            color: root.save-state == 1 ? Theme.attention : Theme.text3;
                            font-size: 12px;
                            vertical-alignment: center;
                            wrap: no-wrap;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        y: 10px;
                        height: 32px;
                        width: 72px;
                        border-radius: 10px;
                        background: Theme.elevated;
                        HorizontalLayout {
                            IconButton { label: @tr("doc-undo" => "Undo"); icon: "M9 14 L4 9 l5 -5 M4 9 h11 a5 5 0 0 1 0 10 h-3"; enabled: root.can-undo; clicked => { root.undo(); } }
                            IconButton { label: @tr("doc-redo" => "Redo"); icon: "M15 14 l5 -5 -5 -5 M20 9 H9 a5 5 0 0 0 0 10 h3"; enabled: root.can-redo; clicked => { root.redo(); } }
                        }
                    }
                    Rectangle {
                        y: 10px;
                        height: 32px;
                        width: copy-row.preferred-width;
                        border-radius: 8px;
                        background: Theme.accent;
                        clip: true;
                        copy-row := HorizontalLayout {
                            Rectangle {
                                width: copy-inner.preferred-width + 26px;
                                background: copy-ta.has-hover ? #5189F7 : transparent;
                                copy-inner := HorizontalLayout {
                                    x: 13px;
                                    spacing: 6px;
                                    Icon { y: 6px; tint: white; d: "M11 9 h7 a2 2 0 0 1 2 2 v7 a2 2 0 0 1 -2 2 h-7 a2 2 0 0 1 -2 -2 v-7 a2 2 0 0 1 2 -2 z M5 15 V5 a2 2 0 0 1 2 -2 h10"; }
                                    Text { text: @tr("doc-copy" => "Copy"); color: white; font-weight: 600; vertical-alignment: center; wrap: no-wrap; }
                                }
                                copy-ta := TouchArea { clicked => { root.copy(); } }
                            }
                            Rectangle { width: 1px; background: #FFFFFF38; }
                            Rectangle {
                                width: 30px;
                                background: more-ta.has-hover ? #5189F7 : transparent;
                                Icon { width: 16px; height: 16px; tint: white; d: "M6 9 l6 6 6 -6"; }
                                more-ta := TouchArea { clicked => { more-menu.show(); } }
                            }
                        }
                        more-menu := PopupWindow {
                            x: parent.width - 260px;
                            y: parent.height + 4px;
                            width: 260px;
                            Rectangle {
                                background: Theme.elevated;
                                border-radius: 12px;
                                drop-shadow-blur: 24px;
                                drop-shadow-color: #00000080;
                                VerticalLayout {
                                    padding: 6px;
                                    MenuItemRow { text: @tr("share-copy-image" => "Copy image"); shortcut: "Ctrl+C"; clicked => { root.copy(); } }
                                    MenuItemRow { text: @tr("share-export" => "Export file…"); shortcut: "Ctrl+Shift+S"; clicked => { root.export(); } }
                                    MenuItemRow { text: @tr("share-system" => "Share…"); enabled: false; }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            HorizontalLayout {
                vertical-stretch: 1;
                // tool rail
                Rectangle {
                    width: 56px;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        alignment: start;
                        IconButton { width: 40px; height: 36px; label: @tr("tool-select" => "Select (V)"); icon: "M5 3 l14 8 -6 2 -3 6 -5 -16 z"; active: root.tool == 0; clicked => { root.tool-chosen(0); } hovered(h) => { root.hover-hint = h ? self.label : ""; } }
                        IconButton { width: 40px; height: 36px; label: @tr("tool-rect" => "Rectangle (R)"); icon: "M6 5 h12 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 V7 a2 2 0 0 1 2 -2 z"; active: root.tool == 1; clicked => { root.tool-chosen(1); } hovered(h) => { root.hover-hint = h ? self.label : ""; } }
                        IconButton { width: 40px; height: 36px; label: @tr("tool-ellipse" => "Ellipse (E)"); icon: "M4 12 a8 6 0 1 0 16 0 a8 6 0 1 0 -16 0 z"; active: root.tool == 2; clicked => { root.tool-chosen(2); } hovered(h) => { root.hover-hint = h ? self.label : ""; } }
                        IconButton { width: 40px; height: 36px; label: @tr("tool-arrow" => "Arrow (L)"); icon: "M4 20 L20 4 M11 4 h9 v9"; active: root.tool == 3; clicked => { root.tool-chosen(3); } hovered(h) => { root.hover-hint = h ? self.label : ""; } }
                        IconButton { width: 40px; height: 36px; label: @tr("tool-pen" => "Pen (P)"); icon: "M4 20 c2 -6 6 -10 12 -12 l4 4 c-2 6 -6 10 -12 12 l-4 -4 z"; active: root.tool == 4; clicked => { root.tool-chosen(4); } hovered(h) => { root.hover-hint = h ? self.label : ""; } }
                        IconButton { width: 40px; height: 36px; label: @tr("tool-text" => "Text (T)"); icon: "M5 6 h14 M12 6 v14"; active: root.tool == 5; clicked => { root.tool-chosen(5); } hovered(h) => { root.hover-hint = h ? self.label : ""; } }
                        Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; x: 8px; width: parent.width - 16px; background: Theme.line; } }
                        IconButton { width: 40px; height: 36px; label: @tr("tool-hide" => "Hide (B)"); icon: "M3 3 l18 18 M10.6 10.6 a2 2 0 0 0 2.8 2.8 M9.9 5.1 A10 10 0 0 1 21 12 a17 17 0 0 1 -2.8 3.6 M6.6 6.6 A17 17 0 0 0 3 12 s3.5 6 9 6 a9 9 0 0 0 3.6 -0.7"; active: root.tool == 6; clicked => { root.tool-chosen(6); } hovered(h) => { root.hover-hint = h ? self.label : ""; } }
                        IconButton { width: 40px; height: 36px; label: @tr("tool-highlighter" => "Highlighter (H)"); icon: "M4 20 h6 l10 -10 -6 -6 L4 14 v6 z M13 7 l4 4"; active: root.tool == 7; clicked => { root.tool-chosen(7); } hovered(h) => { root.hover-hint = h ? self.label : ""; } }
                        IconButton { width: 40px; height: 36px; label: @tr("tool-counter" => "Counter (N)"); icon: "M3 12 a9 9 0 1 0 18 0 a9 9 0 1 0 -18 0 z M10.5 9 l2 -1.2 V16"; active: root.tool == 8; clicked => { root.tool-chosen(8); } hovered(h) => { root.hover-hint = h ? self.label : ""; } }
                        IconButton { width: 40px; height: 36px; label: @tr("tool-stamp" => "Stamp (S)"); icon: "M8 12 V7 a4 4 0 0 1 8 0 v5 M5 12 h14 v4 H5 z M7 16 v4 h10 v-4"; active: root.tool == 9; clicked => { root.tool-chosen(9); } hovered(h) => { root.hover-hint = h ? self.label : ""; } }
                        // Stable layout from v1: tools not implemented yet stay in place, disabled.
                        IconButton { width: 40px; height: 36px; label: @tr("tool-image" => "Image (I)"); icon: "M5 5 h14 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 V7 a2 2 0 0 1 2 -2 z M7 10 a1.5 1.5 0 1 0 3 0 a1.5 1.5 0 1 0 -3 0 M4 17 l5 -5 4 4 3 -3 4 4"; enabled: false; hovered(h) => { root.hover-hint = h ? @tr("common-in-development" => "Coming soon") : ""; } }
                        Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; x: 8px; width: parent.width - 16px; background: Theme.line; } }
                        IconButton { width: 40px; height: 36px; label: @tr("tool-crop" => "Crop (C)"); icon: "M6 2 v14 a2 2 0 0 0 2 2 h14 M2 6 h14 a2 2 0 0 1 2 2 v14"; enabled: false; hovered(h) => { root.hover-hint = h ? @tr("common-in-development" => "Coming soon") : ""; } }
                    }
                }
                Rectangle { width: 1px; background: Theme.line; }
                // canvas
                canvas-area := Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.canvas;
                    clip: true;
                    Image {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        source: root.canvas;
                        image-fit: fill;
                        image-rendering: pixelated;
                    }
                    keys := FocusScope {
                        key-pressed(e) => {
                            if (root.editing) { return reject; }
                            root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
                            return accept;
                        }
                        TouchArea {
                            mouse-cursor: root.tool == 0 ? default : crosshair;
                            pointer-event(e) => {
                                if (!root.editing) { keys.focus(); }
                                if (e.kind == PointerEventKind.down) {
                                    root.pointer(0, self.mouse-x, self.mouse-y, e.button == PointerEventButton.left ? 0 : (e.button == PointerEventButton.right ? 1 : 2), e.modifiers.shift, e.modifiers.alt);
                                } else if (e.kind == PointerEventKind.up) {
                                    root.pointer(2, self.mouse-x, self.mouse-y, e.button == PointerEventButton.left ? 0 : (e.button == PointerEventButton.right ? 1 : 2), e.modifiers.shift, e.modifiers.alt);
                                } else if (e.kind == PointerEventKind.move) {
                                    root.pointer(1, self.mouse-x, self.mouse-y, 0, e.modifiers.shift, e.modifiers.alt);
                                }
                            }
                            scroll-event(e) => {
                                root.wheel(self.mouse-x, self.mouse-y, e.delta-y, e.modifiers.control, e.modifiers.alt);
                                return accept;
                            }
                        }
                        init => { self.focus(); }
                    }
                    if root.editing: Rectangle {
                        x: root.edit-x;
                        y: root.edit-y;
                        width: 280px;
                        height: 36px;
                        edit := LineEdit {
                            width: parent.width;
                            height: parent.height;
                            text <=> root.edit-text;
                            font-size: 16px;
                            accepted(t) => { root.commit-text(t); }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.cancel-text();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        init => {
                            edit.focus();
                            edit.select-all();
                        }
                    }
                }
                Rectangle { width: 1px; background: Theme.line; }
                // inspector (Object tab; the other tabs come with ZK-54)
                Rectangle {
                    width: 284px;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle { height: 28px; width: 72px; border-radius: 7px; background: Theme.control-on; Text { text: @tr("insp-tab-object" => "Object"); color: Theme.text; font-weight: 600; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                            Rectangle { height: 28px; width: 60px; Text { text: @tr("insp-tab-layers" => "Layers"); color: Theme.disabled; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                            Rectangle { height: 28px; width: 60px; Text { text: @tr("insp-tab-shot" => "Image"); color: Theme.disabled; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                            Rectangle { height: 28px; width: 50px; Text { text: @tr("insp-tab-meta" => "Meta"); color: Theme.disabled; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                        }
                        Text {
                            text: root.has-selection ? "" : (root.mark-count == 0 ? @tr("insp-no-marks" => "No annotations yet. Pick a tool on the left and draw on the screenshot.") : @tr("insp-nothing-selected" => "Select an annotation to change it, or pick a tool on the left."));
                            color: Theme.text3;
                            font-size: 12px;
                            wrap: word-wrap;
                            visible: self.text != "";
                        }
                        Text { text: @tr("insp-stroke" => "Stroke"); color: Theme.text2; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 6px;
                            for c[i] in [#FF5A5F, #FF8A3D, #FFD23F, #34C48A, #3D7BF5, #9B5CF5, #FFFFFF, #14161A]: Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 7px;
                                background: c;
                                border-width: root.color-index == i ? 2px : 1px;
                                border-color: root.color-index == i ? Theme.text : #FFFFFF22;
                                TouchArea { clicked => { root.set-color(i); } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 2px;
                            for t[i] in ["2", "4", "7"]: Rectangle {
                                height: 28px;
                                horizontal-stretch: 1;
                                border-radius: 7px;
                                background: root.thick-index == i ? Theme.control-on : Theme.elevated;
                                Text { text: t; color: root.thick-index == i ? Theme.text : Theme.text2; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                                TouchArea { clicked => { root.set-thick(i); } }
                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            // status bar
            Rectangle {
                height: 30px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 16px;
                    Text { text: root.image-size; color: Theme.text3; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.hover-hint != "" ? root.hover-hint : (root.toast != "" ? root.toast : root.hint); color: root.toast != "" && root.hover-hint == "" ? Theme.accent-text : Theme.text2; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: root.crop-text; color: Theme.text3; font-size: 12px; vertical-alignment: center; }
                    HorizontalLayout {
                        spacing: 4px;
                        horizontal-stretch: 0;
                        IconButton { y: 3px; height: 24px; width: 24px; label: @tr("status-fit" => "Fit to window"); icon: "M4 9 V4 h5 M15 4 h5 v5 M20 15 v5 h-5 M9 20 H4 v-5"; clicked => { root.zoom-fit(); } hovered(h) => { root.hover-hint = h ? self.label : ""; } }
                        Text { text: root.zoom-text; color: Theme.text; font-size: 12px; vertical-alignment: center; min-width: 40px; }
                    }
                    Rectangle {
                        y: 4px;
                        width: 48px;
                        height: 22px;
                        border-radius: 6px;
                        background: z100.has-hover ? Theme.control-on : Theme.elevated;
                        Text { text: "100%"; color: Theme.text2; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        z100 := TouchArea { clicked => { root.zoom-100(); } }
                    }
                }
            }
        }
    }
}
