// Znimok — first working prototype of the application UI (ZK-46/47/59).
// Layout follows the design mock-up (Design artifact v17): library as the home screen; editor
// with a top bar (back, Open, title, autosave, undo/redo, Copy ▾), a tool rail, the canvas, an
// inspector and a status bar. Strings come from i18n/*.ftl through @tr (ZK-29).
// Not yet here: tabs, overlay editor, full inspector, settings (see the tickets of Phase 4).

import { AboutSlint, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
// Bundled faces (ZK-34, SIL OFL 1.1): Onest for the interface and the marks, JetBrains Mono for
// numbers and key combinations, Unbounded for the Znimok wordmark only.
import "../../znimok-render/fonts/Onest.ttf";
import "../../znimok-render/fonts/JetBrainsMono.ttf";
import "../../znimok-render/fonts/Unbounded.ttf";

// Light and dark (ZK-46): "as the system" by default, or chosen in the settings. The capture
// overlay is always dark (decision of 28.09: it sits over any screen), so it sets mode 2.
// Neutrals lean a little blue, like the accent; the light theme keeps text at ≥ 7:1 on panels.
export global Theme {
    // 0 as the system, 1 light, 2 dark.
    in-out property <int> mode: 0;
    // What the system uses now (from winit: at start and on every change).
    in-out property <bool> system-dark: true;
    out property <bool> dark: root.mode == 2 || (root.mode == 0 && root.system-dark);
    out property <color> canvas: root.dark ? #0B0D11 : #E3E6EB;
    out property <color> app: root.dark ? #0F1115 : #F4F5F7;
    out property <color> panel: root.dark ? #171A20 : #FFFFFF;
    out property <color> elevated: root.dark ? #1E2229 : #EEF0F3;
    out property <color> control-on: root.dark ? #2A2F38 : #DCE0E6;
    out property <color> line: root.dark ? #22262E : #E3E6EA;
    out property <color> text: root.dark ? #E8EAEE : #15181D;
    out property <color> text2: root.dark ? #A7ADB8 : #4A515C;
    out property <color> text3: root.dark ? #6F7682 : #7A818C;
    out property <color> accent: #3D7BF5;
    out property <color> accent-text: root.dark ? #8FB6FF : #2458C6;
    out property <color> attention: root.dark ? #FFD23F : #A36A00;
    out property <color> ok: root.dark ? #34C48A : #178A5B;
    out property <color> disabled: root.dark ? #4A505A : #B4B9C1;
    // A hovered control, a swatch's rim, the tooltip bubble.
    out property <color> hover: root.dark ? #FFFFFF0D : #0000000A;
    out property <color> swatch-rim: root.dark ? #FFFFFF22 : #00000029;
    out property <color> tip-bg: root.dark ? #0B0D11F2 : #FFFFFFF7;
}

export struct CardData {
    name: string,
    meta: string,
    thumb: image,
    path: string,
}

component Icon inherits Path {
    in property <string> d;
    in property <color> tint: Theme.text2;
    commands: d;
    stroke: tint;
    stroke-width: 1.75px;
    fill: transparent;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 20px;
    height: 20px;
}

// ---------------------------------------------------------------------------------------------
// Tooltips (owner, 28.09): any control with a `tip` shows it after a short hover, beside the
// control, fading in. One shared bubble drawn at the end of AppWindow.
export global Tip {
    in-out property <string> text;
    // Anchor in window coordinates and which side of it the bubble goes: 0 below, 1 right, 2 above.
    in-out property <length> ax;
    in-out property <length> ay;
    in-out property <int> side;
    in-out property <bool> armed;
    in-out property <int> serial;
}

// Shortcuts as each system writes them (ZK-60): "Ctrl+Shift+Z" on Windows, "⇧⌘Z" on macOS.
export global Keys {
    in property <bool> mac;
    // Last way the picture left the editor, repeated by Enter: 0 copy, 1 export.
    in property <int> last-share;
    public pure function k(win: string, mac: string) -> string {
        return self.mac ? mac : win;
    }
}

// A TouchArea that arms the shared tooltip while hovered.
component TipTouch inherits TouchArea {
    in property <string> tip;
    in property <int> tip-side: 0;
    // What can be clicked shows the pointing hand (owner, 29.09); users of TipTouch that are
    // not buttons (sliders, the drag handle of Copy) set their own.
    mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
    property <int> mine: -1;
    changed has-hover => {
        if (self.has-hover && root.tip != "") {
            Tip.text = root.tip;
            Tip.side = root.tip-side;
            Tip.ax = root.tip-side == 1 ? self.absolute-position.x + self.width : self.absolute-position.x + self.width / 2;
            Tip.ay = root.tip-side == 0 ? self.absolute-position.y + self.height : (root.tip-side == 2 ? self.absolute-position.y : self.absolute-position.y + self.height / 2);
            Tip.serial += 1;
            root.mine = Tip.serial;
            Tip.armed = true;
        } else if (!self.has-hover && Tip.serial == root.mine) {
            Tip.armed = false;
        }
    }
    changed pressed => {
        if (self.pressed) { Tip.armed = false; }
    }
}

// Small "open menu" chevron, drawn at its real size (not a scaled 24 px icon).
component Chevron inherits Path {
    in property <color> tint: Theme.text2;
    commands: "M1 1.5 L5 5.5 L9 1.5";
    viewbox-width: 10;
    viewbox-height: 7;
    width: 10px;
    height: 7px;
    stroke: tint;
    stroke-width: 1.6px;
    fill: transparent;
}

// Top-bar button: optional icon, text, optional chevron; 32 px high, content centred.
component BarButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> chevron;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked;
    height: 32px;
    width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: ta.has-hover && root.enabled ? Theme.elevated : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.95 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    accessible-role: button;
    accessible-label: root.text;
    row := HorizontalLayout {
        padding-left: root.icon != "" ? 6px : 10px;
        padding-right: root.chevron ? 8px : 10px;
        spacing: 6px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { d: root.icon; tint: root.enabled ? Theme.text2 : Theme.disabled; }
        }
        Text { text: root.text; color: root.enabled ? Theme.text2 : Theme.disabled; font-size: 13px; font-weight: 500; vertical-alignment: center; wrap: no-wrap; }
        if root.chevron: VerticalLayout {
            alignment: center;
            Chevron { }
        }
    }
    ta := TipTouch {
        tip: root.tip;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Small status-bar button: the same box for an icon ("Fit") and for text ("100%").
component SmallButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    height: 22px;
    width: root.icon != "" ? 28px : max(28px, label.preferred-width + 14px);
    horizontal-stretch: 0;
    border-radius: 6px;
    background: ta.has-hover && root.enabled ? Theme.control-on : Theme.elevated;
    animate background { duration: 120ms; easing: ease-out; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.92 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    if root.icon != "": Icon { width: 14px; height: 14px; d: root.icon; tint: Theme.text2; }
    label := Text {
        visible: root.icon == "";
        text: root.text;
        color: Theme.text2;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TipTouch {
        tip: root.tip;
        tip-side: 2;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One option of a segmented control (thickness, line style, corners, heads, tabs…).
component SegOption inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> on;
    in property <string> tip;
    in property <bool> enabled: true;
    // Line-thickness preview: a bar this thick instead of text or an icon.
    in property <length> bar: 0px;
    callback clicked;
    height: 28px;
    horizontal-stretch: 1;
    border-radius: 7px;
    background: root.on ? Theme.control-on : (ta.has-hover && root.enabled ? Theme.hover : Theme.elevated);
    animate background { duration: 140ms; easing: ease-out; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.94 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    if root.icon != "": Icon { width: 18px; height: 18px; d: root.icon; tint: root.on ? Theme.text : (root.enabled ? Theme.text2 : Theme.disabled); }
    if root.bar > 0: Rectangle {
        width: parent.width * 0.55;
        height: root.bar;
        border-radius: root.bar / 2;
        background: root.on ? Theme.text : Theme.text2;
    }
    if root.icon == "" && root.bar == 0: Text {
        text: root.text;
        color: root.on ? Theme.text : (root.enabled ? Theme.text2 : Theme.disabled);
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TipTouch {
        tip: root.tip;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Colour chip; `none` draws the "no colour" slash.
component Swatch inherits Rectangle {
    in property <color> c;
    in property <bool> on;
    in property <bool> none;
    in property <string> tip;
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: root.none ? Theme.elevated : root.c;
    border-width: root.on ? 2px : 1px;
    border-color: root.on ? Theme.text : Theme.swatch-rim;
    animate border-width { duration: 140ms; easing: ease-out; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.88 : (ta.has-hover ? 1.08 : 1.0);
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    if root.none: Path {
        commands: "M5 19 L19 5";
        viewbox-width: 24;
        viewbox-height: 24;
        width: parent.width;
        height: parent.height;
        stroke: #FF5A5F;
        stroke-width: 1.6px;
    }
    ta := TipTouch {
        tip: root.tip;
        clicked => { root.clicked(); }
    }
}

// Slider 0…1 with a knob that grows under the finger.
component MiniSlider inherits Rectangle {
    in-out property <float> value;
    in property <string> tip;
    callback moved(float);
    callback released();
    height: 22px;
    min-width: 60px;
    function set-from(x: length) {
        root.value = clamp(x / max(1px, root.width), 0, 1);
        root.moved(root.value);
    }
    Rectangle { x: 0; y: (parent.height - 4px) / 2; height: 4px; width: parent.width; border-radius: 2px; background: Theme.control-on; }
    Rectangle { x: 0; y: (parent.height - 4px) / 2; height: 4px; width: parent.width * root.value; border-radius: 2px; background: Theme.accent; }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: white;
        x: (parent.width - self.width) * root.value;
        y: (parent.height - self.height) / 2;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000080;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: ta.pressed ? 1.3 : (ta.has-hover ? 1.12 : 1.0);
        animate transform-scale { duration: 150ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    ta := TipTouch {
        tip: root.tip;
        tip-side: 2;
        // Only left and right: a two-way arrow (Windows draws "grab" as four arrows, owner 29.09).
        mouse-cursor: MouseCursor.ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.set-from(self.mouse-x); }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => {
            if (self.pressed) { root.set-from(self.mouse-x); }
        }
    }
}

// Numeric field with a label in front (X, Y, W, H).
component NumField inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;
    callback committed(string);
    spacing: 4px;
    Text { text: root.label; color: Theme.text3; font-size: 11px; vertical-alignment: center; width: 18px; }
    Rectangle {
        height: 26px;
        horizontal-stretch: 1;
        border-radius: 6px;
        background: Theme.elevated;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.control-on;
        animate border-color { duration: 120ms; }
        input := TextInput {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            vertical-alignment: center;
            color: Theme.text;
            font-size: 12px;
            input-type: number;
            font-family: "JetBrains Mono";
            text <=> root.value;
            accepted => { root.committed(self.text); }
            changed has-focus => { if (!self.has-focus) { root.committed(self.text); } }
        }
    }
}

// Palette shared by the stroke and fill rows.
global Palette {
    out property <[color]> colors: [#FF5A5F, #FF8A3D, #FFD23F, #34C48A, #3D7BF5, #9B5CF5, #FFFFFF, #14161A];
}

export struct LayerRow {
    // Mark id, or the group id on a group's header row.
    id: int,
    name: string,
    kind: int,
    hidden: bool,
    selected: bool,
    // Group header (kind 10) and its members (depth 1) — ZK-54.
    is-group: bool,
    depth: int,
    collapsed: bool,
    count: int,
}

// Icons of the mark kinds (layers list), in the order of `prop-kind` / LayerRow.kind:
// rectangle, ellipse, line, pen, text, hide, marker, counter, stamp, image.
global KindIcons {
    out property <[string]> paths: [
        "M6 5 h12 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 V7 a2 2 0 0 1 2 -2 z",
        "M4 12 a8 6 0 1 0 16 0 a8 6 0 1 0 -16 0 z",
        "M4 20 L20 4 M11 4 h9 v9",
        "M15.5 4.5 a2.1 2.1 0 0 1 3 3 L8 18 l-4 1 1 -4 z M13.5 6.5 l3 3 M12 20 q2 -3 4 0 t4 0",
        "M5 6 h14 M12 6 v14",
        "M3 3 l18 18 M10.6 10.6 a2 2 0 0 0 2.8 2.8 M9.9 5.1 A10 10 0 0 1 21 12 a17 17 0 0 1 -2.8 3.6 M6.6 6.6 A17 17 0 0 0 3 12 s3.5 6 9 6 a9 9 0 0 0 3.6 -0.7",
        "M14 3.5 L20.5 10 L13 17.5 L6.5 11 Z M6.5 11 L4 16.5 L7.5 20 L13 17.5 M16.5 6 L10 12.5 M3 22.3 h9",
        "M3 12 a9 9 0 1 0 18 0 a9 9 0 1 0 -18 0 z M10.5 9 l2 -1.2 V16",
        "M8 12 V7 a4 4 0 0 1 8 0 v5 M5 12 h14 v4 H5 z M7 16 v4 h10 v-4",
        "M5 5 h14 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 V7 a2 2 0 0 1 2 -2 z M7 10 a1.5 1.5 0 1 0 3 0 a1.5 1.5 0 1 0 -3 0 M4 17 l5 -5 4 4 3 -3 4 4",
        // 10: a group (folder)
        "M3 7 a2 2 0 0 1 2 -2 h4 l2 2 h8 a2 2 0 0 1 2 2 v8 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 z",
    ];
}

// ---------------------------------------------------------------------------------------------
// Own title bar (owner, 28.09: "the header must be ours and follow the window's theme").
// Windows: no system frame; our bars carry minimise / maximise / close on the right, the empty
// part of a bar drags the window, a double click maximises, the edges resize it.
// macOS: the system traffic lights stay (native), over a transparent title bar; our bars leave
// room for them on the left.

// Empty part of a bar: drags the window, double click = maximise / restore.
component DragArea inherits TouchArea {
    callback drag();
    callback toggle();
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.drag(); }
    }
    double-clicked => { root.toggle(); }
}

component WindowButton inherits Rectangle {
    in property <string> icon;
    in property <bool> danger;
    in property <string> tip;
    callback clicked;
    width: 46px;
    background: ta.has-hover ? (root.danger ? #E81123 : Theme.elevated) : transparent;
    animate background { duration: 100ms; }
    Icon { width: 14px; height: 14px; d: root.icon; tint: ta.has-hover && root.danger ? white : Theme.text2; }
    ta := TipTouch { tip: root.tip; clicked => { root.clicked(); } }
}

component WindowControls inherits HorizontalLayout {
    in property <bool> maximized;
    width: 138px;
    spacing: 0px;
    callback minimize();
    callback toggle();
    callback close();
    WindowButton { icon: "M5 12 h14"; clicked => { root.minimize(); } }
    WindowButton {
        icon: root.maximized ? "M8 8 h11 v11 H8 z M5 16 V5 h11" : "M5.5 5.5 h13 v13 h-13 z";
        clicked => { root.toggle(); }
    }
    WindowButton { icon: "M6 6 l12 12 M18 6 l-12 12"; danger: true; clicked => { root.close(); } }
}

// Invisible resize edge of a frameless window (Windows).
component ResizeEdge inherits TouchArea {
    in property <int> dir;
    callback resize(int);
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.resize(root.dir); }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <string> label;
    // Tooltip text (defaults to the label) and side: 0 below, 1 right, 2 above.
    in property <string> tip: root.label;
    in property <int> tip-side: 0;
    callback clicked;
    callback hovered(bool);
    width: 36px;
    height: 32px;
    border-radius: 8px;
    background: active ? Theme.control-on : (ta.has-hover && enabled ? Theme.elevated : transparent);
    accessible-role: button;
    accessible-label: label;
    // Tactile press: a quick dip and back (iOS-like).
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.94 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    animate background { duration: 120ms; easing: ease-out; }

    Icon {
        d: icon;
        tint: !enabled ? Theme.disabled : (active ? Theme.text : Theme.text2);
    }
    ta := TipTouch {
        tip: root.tip;
        tip-side: root.tip-side;
        enabled: root.enabled;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    out property <bool> hover: ta.has-hover;
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: primary ? (enabled ? (ta.has-hover ? #5189F7 : Theme.accent) : Theme.control-on) : (ta.has-hover && enabled ? Theme.elevated : transparent);
    // Tactile press: a quick dip and back (iOS-like).
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.94 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    animate background { duration: 120ms; easing: ease-out; }

    border-width: primary ? 0 : 1px;
    border-color: Theme.control-on;
    accessible-role: button;
    accessible-label: text;
    lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            d: root.icon;
            tint: primary ? white : (enabled ? Theme.text : Theme.disabled);
        }
        Text {
            text: root.text;
            color: primary ? white : (enabled ? Theme.text : Theme.disabled);
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

component MenuItemRow inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    border-radius: 8px;
    background: ta.has-hover && enabled ? Theme.control-on : transparent;
    animate background { duration: 100ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        // A label longer than the menu ends with «…» instead of running past its edge.
        Text { text: root.text; color: enabled ? Theme.text : Theme.disabled; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; wrap: no-wrap; overflow: elide; min-width: 0px; }
        Text { text: root.shortcut; color: Theme.text3; font-size: 11px; vertical-alignment: center; wrap: no-wrap; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// Check box: a rounded square that fills with the accent and draws its tick (tactile press).
component CheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled;
    // The row is one target: box and caption (a TouchArea inside a layout would be a cell of its
    // own, zero wide — the first version never got the click).
    width: row.preferred-width;
    height: max(20px, row.preferred-height);
    row := HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: root.checked ? Theme.accent : transparent;
            border-width: root.checked ? 0 : 1.5px;
            border-color: Theme.text3;
            animate background { duration: 140ms; easing: ease-out; }
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: ta.pressed ? 0.88 : 1.0;
            animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            if root.checked: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M6 12.5 l4 4 L18 8";
                stroke: white;
                stroke-width: 2.4px;
                fill: transparent;
            }
        }
        Text { text: root.text; color: Theme.text2; font-size: 12px; vertical-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component Switch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled;
    width: 32px;
    height: 18px;
    border-radius: 9px;
    background: checked ? Theme.accent : Theme.control-on;
    accessible-role: switch;
    accessible-checked: checked;
    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: white;
        animate x { duration: 160ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// ---------------------------------------------------------------------------------------------
// Object panel building blocks: a section with a small caption (and an optional action on the
// right), a row with a 60 px label column, and a colour row with room for the colour picker.

// Scrolling column of the inspector. The content takes the viewport's width (minus a gutter
// for the vertical bar), never its own preferred width: no horizontal scrolling, text wraps,
// the bar never covers a control (owner, 29.09).
component InspScroll inherits ScrollView {
    in property <length> spacing: 14px;
    vertical-stretch: 1;
    // Never sideways (owner, 29.09): the viewport would otherwise take the content's minimum
    // width and show a horizontal bar even when everything fits the panel.
    viewport-width: self.visible-width;
    VerticalLayout {
        x: 0;
        width: max(120px, root.visible-width - 12px);
        spacing: root.spacing;
        alignment: start;
        @children
    }
}

component PropSection inherits VerticalLayout {
    in property <string> title;
    in property <string> action-icon;
    in property <string> action-tip;
    in property <bool> action-enabled: true;
    callback action();
    spacing: 8px;
    HorizontalLayout {
        height: 22px;
        Text { text: root.title; color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; vertical-alignment: center; horizontal-stretch: 1; }
        if root.action-icon != "": IconButton { width: 26px; height: 22px; icon: root.action-icon; label: root.action-tip; enabled: root.action-enabled; clicked => { root.action(); } }
    }
    @children
}

component PropRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text { text: root.label; color: Theme.text3; font-size: 11px; vertical-alignment: center; width: 60px; overflow: elide; }
    @children
}

// Palette chips plus, at the right, the chip that will open the colour picker with the
// eyedropper (strings `colour-picker` / `colour-eyedropper` already exist; the popover is
// a later ticket) — the room is reserved now so the layout does not move when it lands.
component ColourRow inherits Rectangle {
    in property <int> selected: -1;
    in property <bool> with-none;
    in property <string> none-tip;
    callback picked(int);
    // Ten columns in every row (none, eight colours, the picker at the right edge), so rows line
    // up under each other whether or not they offer "none" (owner, 29.09).
    property <length> cell: min(27px, self.width / 10);
    property <length> chip: min(22px, self.cell - 3px);
    height: 24px;
    if root.with-none: Swatch { x: 0; y: (parent.height - self.height) / 2; width: root.chip; height: root.chip; none: true; on: root.selected < 0; tip: root.none-tip; clicked => { root.picked(-1); } }
    for c[i] in Palette.colors: Swatch { x: (i + 1) * root.cell; y: (parent.height - self.height) / 2; width: root.chip; height: root.chip; c: c; on: root.selected == i; clicked => { root.picked(i); } }
    Rectangle {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: root.chip;
        height: root.chip;
        border-radius: 7px;
        background: @linear-gradient(135deg, #FF5A5F 0%, #FFD23F 30%, #34C48A 55%, #3D7BF5 80%, #9B5CF5 100%);
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: pick-ta.has-hover ? 1.08 : 1.0;
        animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        Rectangle { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; border-radius: 5px; background: Theme.panel; }
        Icon { width: 12px; height: 12px; d: "M3 21 l6 -6 M15 3 l6 6 -9 9 -6 -6 z M13 5 l6 6"; tint: Theme.text2; }
        pick-ta := TipTouch { tip: @tr("colour-picker" => "Colour picker") + " — " + @tr("common-in-development" => "Coming soon"); }
    }
}

// Button that acts while held ("Compare": the original tone while the finger is down).
component HoldButton inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    callback held(bool);
    height: 28px;
    border-radius: 7px;
    background: ta.pressed ? Theme.control-on : (ta.has-hover ? Theme.hover : Theme.elevated);
    animate background { duration: 120ms; easing: ease-out; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.96 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    Text {
        text: root.text;
        color: ta.pressed ? Theme.text : Theme.text2;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TipTouch {
        tip: root.tip;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.held(true); }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.held(false); }
        }
    }
}

// A switch with its caption on the left.
component SwitchRow inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled;
    spacing: 8px;
    height: 24px;
    Text { text: root.text; color: Theme.text2; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
    VerticalLayout {
        alignment: center;
        Switch { checked <=> root.checked; toggled => { root.toggled(); } }
    }
}

// A small round button over a library card (shows while the card is hovered).
component CardHover inherits Rectangle {
    out property <bool> hover: ta.has-hover;
    in property <string> icon;
    in property <string> tip;
    in property <bool> danger;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: ta.has-hover ? (root.danger ? #FF5A5F : Theme.control-on) : #0B0D11CC;
    animate background { duration: 120ms; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.9 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    Icon { width: 16px; height: 16px; d: root.icon; tint: ta.has-hover ? #FFFFFF : #FFFFFFD0; }
    ta := TipTouch { tip: root.tip; clicked => { root.clicked(); } }
}

component CardView inherits Rectangle {
    in property <CardData> data;
    callback open;
    callback rename(string);
    callback trash();
    callback reveal();
    property <bool> renaming;
    border-radius: 12px;
    background: Theme.panel;
    border-width: ta.has-hover ? 1.5px : 0;
    border-color: Theme.accent;
    // Lifts a little under the pointer, dips when pressed.
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.98 : (ta.has-hover ? 1.02 : 1.0);
    animate transform-scale { duration: 180ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    drop-shadow-blur: ta.has-hover ? 18px : 0px;
    drop-shadow-color: #00000066;
    animate drop-shadow-blur { duration: 180ms; easing: ease-out; }
    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 64px;
        border-radius: 8px;
        background: Theme.canvas;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.data.thumb;
            image-fit: contain;
        }
    }
    if !root.renaming: Text {
        x: 12px;
        y: parent.height - 50px;
        width: parent.width - 24px;
        text: root.data.name;
        color: Theme.text;
        font-size: 13px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        x: 12px;
        y: parent.height - 28px;
        width: parent.width - 24px;
        text: root.data.meta;
        color: Theme.text3;
        font-size: 11px;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { if (!root.renaming) { root.open(); } }
    }
    // Inline rename: Enter keeps the name, Esc or leaving the field drops it.
    if root.renaming: Rectangle {
        x: 8px;
        y: parent.height - 54px;
        width: parent.width - 16px;
        height: 26px;
        border-radius: 6px;
        background: Theme.elevated;
        border-width: 1px;
        border-color: Theme.accent;
        name-input := TextInput {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            vertical-alignment: center;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            text: root.data.name;
            accepted => { root.renaming = false; root.rename(self.text); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.renaming = false; return accept; }
                return reject;
            }
            changed has-focus => { if (!self.has-focus) { root.renaming = false; } }
            init => { self.focus(); self.select-all(); }
        }
    }
    // Actions on the picture's corner while the card is under the pointer.
    HorizontalLayout {
        x: parent.width - self.preferred-width - 14px;
        y: 14px;
        spacing: 6px;
        opacity: ta.has-hover || rb.hover || fb.hover || tb.hover ? 1 : 0;
        animate opacity { duration: 140ms; }
        rb := CardHover { icon: "M15.5 4.5 a2.1 2.1 0 0 1 3 3 L8 18 l-4 1 1 -4 z"; tip: @tr("common-rename" => "Rename"); clicked => { root.renaming = true; } }
        fb := CardHover { icon: "M3 7 a2 2 0 0 1 2 -2 h4 l2 2 h8 a2 2 0 0 1 2 2 v8 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 z"; tip: @tr("lib-show-in-folder" => "Show in folder"); clicked => { root.reveal(); } }
        tb := CardHover { icon: "M4 7 h16 M10 11 v6 M14 11 v6 M6 7 l1 12 a2 2 0 0 0 2 2 h6 a2 2 0 0 0 2 -2 l1 -12 M9 7 V4 h6 v3"; tip: @tr("lib-trash-long" => "Move to trash"); danger: true; clicked => { root.trash(); } }
    }
}

component HintChip inherits HorizontalLayout {
    in property <string> key;
    in property <string> text;
    spacing: 6px;
    height: 20px;
    Rectangle {
        width: key-text.preferred-width + 12px;
        height: 20px;
        border-radius: 5px;
        background: #FFFFFF1F;
        key-text := Text { text: root.key; color: #E8EAEE; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
    }
    Text { text: root.text; color: #A7ADB8; font-size: 12px; vertical-alignment: center; }
}

// The capture overlay (ZK-39/40): the frozen screen, a dim veil, a selection frame
// (drag = region, click = window under the pointer, Space = whole screen), guides through the
// pointer across the whole screen (they are the cursor, as in Little Helpers), a magnifier drawn
// by Rust (nearest neighbour, pixel grid from ×8) and the hint strip, which jumps to the top
// when the pointer comes near it. Coordinates are logical pixels of this window.
// ---------------------------------------------------------------------------------------------
// The small card in the corner after a quick capture (ZK-41): the shot is already in the
// clipboard and the library. Its own window: it must not take the focus from what the user is
// doing (see the attributes hook in main.rs), so its buttons carry no shared tooltips — the
// second line of the card says what the button under the pointer does.

component PillButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    out property <bool> hover: ta.has-hover;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: ta.pressed ? Theme.control-on : (ta.has-hover ? Theme.elevated : transparent);
    animate background { duration: 120ms; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.92 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    accessible-role: button;
    accessible-label: root.label;
    Icon { width: 18px; height: 18px; d: root.icon; tint: ta.has-hover ? Theme.text : Theme.text2; }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component Pill inherits Window {
    default-font-family: "Onest";
    // Matched by the window-attributes hook in main.rs: no activation, no taskbar button.
    title: "Znimok pill";
    no-frame: true;
    always-on-top: true;
    width: 380px;
    height: 96px;
    background: Theme.panel;
    in property <image> thumb;
    in property <string> heading;
    in property <string> sub;
    // Time left, 1 → 0 (the thin bar at the bottom).
    in property <float> progress: 1;
    in property <bool> shown;
    callback edit();
    callback dismiss();
    callback save-file();
    callback show-library();
    callback drag-out();
    callback hovered(bool);
    out property <bool> hover: bg.has-hover || th.has-hover || b-edit.hover || b-save.hover || b-lib.hover || b-close.hover;
    changed hover => { root.hovered(self.hover); }
    property <string> hint: b-save.hover ? @tr("pill-save-file" => "Save as file…") : (b-lib.hover ? @tr("pill-show-library" => "Show in library") : (th.has-hover ? @tr("share-drag-tip" => "drag to a chat or a folder") : ""));

    Rectangle {
        // Slides in from the side and settles with a little overshoot (owner: iOS-like motion).
        x: root.shown ? 0 : 28px;
        opacity: root.shown ? 1 : 0;
        animate x { duration: 340ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.15); }
        animate opacity { duration: 200ms; easing: ease-out; }
        width: root.width;
        height: root.height;
        border-width: 1px;
        border-color: Theme.control-on;
        background: Theme.panel;
        bg := TouchArea { }
        HorizontalLayout {
            padding: 10px;
            padding-right: 8px;
            spacing: 12px;
            // The picture: click edits, pulling it drags the file out.
            Rectangle {
                width: 104px;
                border-radius: 8px;
                background: Theme.canvas;
                clip: true;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale: th.pressed ? 0.96 : (th.has-hover ? 1.02 : 1.0);
                animate transform-scale { duration: 160ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                Image { width: parent.width; height: parent.height; source: root.thumb; image-fit: contain; }
                th := TouchArea {
                    property <bool> dragged;
                    mouse-cursor: self.dragged ? MouseCursor.grabbing : MouseCursor.pointer;
                    pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.dragged = false; } }
                    moved => {
                        if (self.pressed && !self.dragged && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px)) {
                            self.dragged = true;
                            root.drag-out();
                        }
                    }
                    clicked => {
                        if (!self.dragged) { root.edit(); }
                        self.dragged = false;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.heading; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                Text { text: root.hint != "" ? root.hint : root.sub; color: root.hint != "" ? Theme.accent-text : Theme.text2; font-size: 11px; overflow: elide; }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 4px;
                    alignment: start;
                    b-edit := TextButton { text: @tr("pill-edit" => "Edit"); primary: true; clicked => { root.edit(); } }
                    b-save := PillButton { icon: "M12 4 v11 M7 10 l5 5 5 -5 M5 19 h14"; label: @tr("pill-save-file" => "Save as file…"); clicked => { root.save-file(); } }
                    b-lib := PillButton { icon: "M4 4 h7 v7 H4 z M13 4 h7 v7 h-7 z M4 13 h7 v7 H4 z M13 13 h7 v7 h-7 z"; label: @tr("pill-show-library" => "Show in library"); clicked => { root.show-library(); } }
                }
            }
            VerticalLayout {
                alignment: start;
                b-close := PillButton { width: 26px; height: 26px; icon: "M6 6 l12 12 M18 6 L6 18"; label: @tr("common-close" => "Close"); clicked => { root.dismiss(); } }
            }
        }
        // Time left: a thin accent line that runs out (pauses while the pointer is on the card).
        Rectangle {
            x: 0;
            y: parent.height - 2px;
            height: 2px;
            width: parent.width * root.progress;
            background: Theme.accent;
            opacity: 0.8;
        }
    }
}

export component Overlay inherits Window {
    init => { Theme.mode = 2; }
    default-font-family: "Onest";
    no-frame: true;
    // Windows: top-most. macOS: Rust sets a window level above the menu bar instead (Slint's
    // top-most = NSFloatingWindowLevel 3, below the menu bar; it would also override ours).
    in property <bool> on-top: true;
    in property <bool> mac;
    always-on-top: root.on-top;
    background: black;
    title: "Znimok";

    in property <image> shot;
    // Selection, or the window under the pointer when nothing is dragged.
    in property <bool> has-sel;
    in-out property <length> sel-x;
    in-out property <length> sel-y;
    in-out property <length> sel-w;
    in-out property <length> sel-h;
    in property <string> sel-label;
    in property <bool> is-window;
    // Pointer (for the guides, the lens and the hint strip).
    in property <length> pointer-x: -100px;
    in property <length> pointer-y: -100px;
    in property <image> guide-h;
    in property <image> guide-v;
    // Magnifier (ZK-40): off until the wheel turns it on.
    in property <bool> lens-visible;
    in property <image> lens;
    in property <length> lens-size: 144px;
    in property <string> lens-coords;
    in property <string> lens-hex;
    in property <color> lens-color;

    callback pointer(int, length, length, bool, bool);
    callback key(string, bool, bool);
    callback wheel(length);

    // The frame glides from window to window while hovering (like the system screenshot tool);
    // while dragging a region it follows the pointer exactly.
    animate sel-x, sel-y, sel-w, sel-h { duration: root.is-window ? 140ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    in property <bool> lens-pulse;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.shot;
        image-fit: fill;
    }
    // Veil around the selection (the whole screen when nothing is selected).
    Rectangle { x: 0; y: 0; width: parent.width; height: root.has-sel ? root.sel-y : parent.height; background: #00000073; }
    if root.has-sel: Rectangle { x: 0; y: root.sel-y + root.sel-h; width: parent.width; height: max(0, parent.height - root.sel-y - root.sel-h); background: #00000073; }
    if root.has-sel: Rectangle { x: 0; y: root.sel-y; width: root.sel-x; height: root.sel-h; background: #00000073; }
    if root.has-sel: Rectangle { x: root.sel-x + root.sel-w; y: root.sel-y; width: max(0, parent.width - root.sel-x - root.sel-w); height: root.sel-h; background: #00000073; }
    if root.has-sel: Rectangle {
        x: root.sel-x - 1px;
        y: root.sel-y - 1px;
        width: root.sel-w + 2px;
        height: root.sel-h + 2px;
        border-width: root.is-window ? 2.5px : 1px;
        border-color: root.is-window ? #50A0FF : #FFFFFFEB;
        background: transparent;
    }
    // Guides through the pointer: where the frame's corner will land. Drawn by Rust pixel by
    // pixel in a colour that contrasts with what is under each pixel (black on light, white on
    // dark), one physical pixel thick.
    Image { x: 0; y: root.pointer-y; width: parent.width; height: 1phx; source: root.guide-h; image-fit: fill; image-rendering: pixelated; }
    Image { x: root.pointer-x; y: 0; width: 1phx; height: parent.height; source: root.guide-v; image-fit: fill; image-rendering: pixelated; }
    if root.has-sel && root.sel-label != "": Rectangle {
        x: min(max(4px, root.sel-x), parent.width - self.width - 4px);
        y: root.sel-y > 34px ? root.sel-y - 30px : min(root.sel-y + root.sel-h + 6px, parent.height - 30px);
        width: label.preferred-width + 16px;
        height: 24px;
        border-radius: 6px;
        background: #171A20E6;
        label := Text { text: root.sel-label; color: #E8EAEE; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
    }
    // Hint strip: bottom centre, or top centre when the pointer comes near the bottom.
    hint-strip := Rectangle {
        property <bool> up: root.pointer-y > parent.height - self.height - 28px - 80px;
        x: (parent.width - self.width) / 2;
        y: self.up ? 28px : parent.height - self.height - 28px;
        // Moves out of the pointer's way with a small overshoot — a physical "hop".
        animate y { duration: 320ms; easing: ease-out-back; }
        width: hints.preferred-width + 32px;
        height: 40px;
        border-radius: 12px;
        background: #171A20F0;
        hints := HorizontalLayout {
            x: 14px;
            y: (parent.height - 20px) / 2;
            width: self.preferred-width;
            height: 20px;
            spacing: 18px;
            HintChip { key: @tr("capture-release" => "release"); text: @tr("capture-to-editor" => "to editor"); }
            HintChip { key: "Shift"; text: @tr("capture-to-clipboard" => "to clipboard"); }
            HintChip { key: root.mac ? "⌥" : "Alt"; text: @tr("capture-over-screen" => "over the screen"); }
            HintChip { key: "Space"; text: @tr("capture-whole-screen" => "whole screen"); }
            HintChip { key: @tr("capture-click" => "click"); text: @tr("capture-window" => "window"); }
            HintChip { key: "Esc"; text: @tr("capture-cancel" => "cancel"); }
        }
    }
    // Magnifier: above-right of the pointer (like Little Helpers), flipping at the edges.
    Rectangle {
        opacity: root.lens-visible ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 140ms; easing: ease-in-out; }
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: root.lens-pulse ? 1.07 : 1.0;
        animate transform-scale { duration: 160ms; easing: ease-in-out; }
        property <length> info-h: 44px;
        property <length> gap: 24px;
        // Which side of the pointer: flips near the edges. Only the offset is animated, so the
        // lens still follows the pointer exactly and glides over when it changes sides.
        property <bool> left: root.pointer-x + self.gap + root.lens-size > parent.width;
        property <bool> below: root.pointer-y - 44px - root.lens-size - self.info-h < 0;
        property <length> off-x: self.left ? -self.gap - root.lens-size : self.gap;
        property <length> off-y: self.below ? self.gap : -44px - root.lens-size - self.info-h;
        animate off-x, off-y { duration: 240ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        x: max(0, root.pointer-x + self.off-x);
        y: min(max(0, root.pointer-y + self.off-y), parent.height - root.lens-size - self.info-h);
        width: root.lens-size;
        height: root.lens-size + self.info-h;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000099;
        background: #141418E1;
        Image {
            x: 0;
            y: 0;
            width: root.lens-size;
            height: root.lens-size;
            source: root.lens;
            image-fit: fill;
            image-rendering: pixelated;
        }
        Text {
            x: 6px;
            y: root.lens-size + 2px;
            height: 20px;
            text: root.lens-coords;
            color: #EBEBF0;
            font-size: 11px;
            vertical-alignment: center;
        }
        Rectangle {
            x: 6px;
            y: root.lens-size + 24px;
            width: 14px;
            height: 14px;
            background: root.lens-color;
            border-width: 1px;
            border-color: #FFFFFFC8;
        }
        Text {
            x: 26px;
            y: root.lens-size + 22px;
            height: 18px;
            text: root.lens-hex;
            color: #EBEBF0;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    fs := FocusScope {
        key-pressed(e) => {
            root.key(e.text, e.modifiers.shift, e.modifiers.alt);
            return accept;
        }
        TouchArea {
            // The guides are the cursor.
            mouse-cursor: none;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.pointer(e.button == PointerEventButton.left ? 0 : 3, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.alt);
                } else if (e.kind == PointerEventKind.up) {
                    root.pointer(e.button == PointerEventButton.left ? 2 : 4, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.alt);
                } else if (e.kind == PointerEventKind.move) {
                    root.pointer(1, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.alt);
                }
            }
            scroll-event(e) => {
                root.wheel(e.delta-y);
                return accept;
            }
        }
    }
    public function grab-focus() { fs.focus(); }
}

// Tray icon (Windows) / menu bar item (macOS): the app keeps running there after the window
// closes, so the hotkey works and "Quit" is always one click away (ZK-45 in full later).
export component AppTray inherits SystemTrayIcon {
    in property <image> tray-icon;
    in property <string> capture-key;
    in property <bool> capture-available: true;
    in property <bool> mac: false;
    icon: tray-icon;
    tooltip: root.paused ? @tr("tray-tooltip-paused-keys" => "Znimok — hotkeys paused") : @tr("tray-tooltip" => "Znimok");

    callback shot();
    callback open-window();
    callback quit();
    // ZK-44: all global hotkeys released until resumed.
    in property <bool> paused;
    callback toggle-pause();

    clicked => { root.open-window(); }

    Menu {
        MenuItem {
            title: @tr("tray-screen" => "Screenshot") + "    " + root.capture-key;
            enabled: root.capture-available;
            activated => { root.shot(); }
        }
        MenuItem {
            title: @tr("tray-open" => "Open Znimok");
            activated => { root.open-window(); }
        }
        MenuItem {
            title: root.paused ? @tr("tray-resume-keys" => "Resume hotkeys") : @tr("tray-pause-keys" => "Pause hotkeys");
            activated => { root.toggle-pause(); }
        }
        MenuSeparator { }
        MenuItem {
            title: root.mac ? @tr("tray-quit-mac" => "Quit Znimok") : @tr("tray-quit" => "Quit");
            activated => { root.quit(); }
        }
    }
}

// The tool rail: docked at the left of the editor, or floating by the frame over the screen
// (ZK-58, without Crop there: the frame itself is the crop).
component ToolRail inherits VerticalLayout {
    in property <int> tool;
    in property <bool> ctrl-held;
    in property <bool> with-crop: true;
    callback chosen(int);
    padding: 8px;
    spacing: 4px;
    alignment: start;
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-select" => "Select (V)"); icon: "M5 3 l14 8 -6 2 -3 6 -5 -16 z"; active: root.tool == 0 || root.ctrl-held; clicked => { root.chosen(0); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-rect" => "Rectangle (R)"); icon: "M6 5 h12 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 V7 a2 2 0 0 1 2 -2 z"; active: root.tool == 1 && !root.ctrl-held; clicked => { root.chosen(1); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-ellipse" => "Ellipse (E)"); icon: "M4 12 a8 6 0 1 0 16 0 a8 6 0 1 0 -16 0 z"; active: root.tool == 2 && !root.ctrl-held; clicked => { root.chosen(2); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-line" => "Line (L)"); icon: "M4 20 L20 4 M11 4 h9 v9"; active: root.tool == 3 && !root.ctrl-held; clicked => { root.chosen(3); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-pen" => "Pen (P)"); icon: "M15.5 4.5 a2.1 2.1 0 0 1 3 3 L8 18 l-4 1 1 -4 z M13.5 6.5 l3 3 M12 20 q2 -3 4 0 t4 0"; active: root.tool == 4 && !root.ctrl-held; clicked => { root.chosen(4); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-text" => "Text (T)"); icon: "M5 6 h14 M12 6 v14"; active: root.tool == 5 && !root.ctrl-held; clicked => { root.chosen(5); } }
        Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; x: 8px; width: parent.width - 16px; background: Theme.line; } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-hide" => "Hide (B)"); icon: "M3 3 l18 18 M10.6 10.6 a2 2 0 0 0 2.8 2.8 M9.9 5.1 A10 10 0 0 1 21 12 a17 17 0 0 1 -2.8 3.6 M6.6 6.6 A17 17 0 0 0 3 12 s3.5 6 9 6 a9 9 0 0 0 3.6 -0.7"; active: root.tool == 6 && !root.ctrl-held; clicked => { root.chosen(6); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-highlighter" => "Highlighter (H)"); icon: "M14 3.5 L20.5 10 L13 17.5 L6.5 11 Z M6.5 11 L4 16.5 L7.5 20 L13 17.5 M16.5 6 L10 12.5 M3 22.3 h9"; active: root.tool == 7 && !root.ctrl-held; clicked => { root.chosen(7); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-counter" => "Counter (N)"); icon: "M3 12 a9 9 0 1 0 18 0 a9 9 0 1 0 -18 0 z M10.5 9 l2 -1.2 V16"; active: root.tool == 8 && !root.ctrl-held; clicked => { root.chosen(8); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-stamp" => "Stamp (S)"); icon: "M8 12 V7 a4 4 0 0 1 8 0 v5 M5 12 h14 v4 H5 z M7 16 v4 h10 v-4"; active: root.tool == 9 && !root.ctrl-held; clicked => { root.chosen(9); } }
        // Stable layout from v1: tools not implemented yet stay in place, disabled.
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-image" => "Image (I)"); tip: self.label + " — " + @tr("common-in-development" => "Coming soon"); icon: "M5 5 h14 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 V7 a2 2 0 0 1 2 -2 z M7 10 a1.5 1.5 0 1 0 3 0 a1.5 1.5 0 1 0 -3 0 M4 17 l5 -5 4 4 3 -3 4 4"; enabled: false; }
        if root.with-crop: Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; x: 8px; width: parent.width - 16px; background: Theme.line; } }
        if root.with-crop: IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-crop" => "Crop (C)"); icon: "M6 2 v14 a2 2 0 0 0 2 2 h14 M2 6 h14 a2 2 0 0 1 2 2 v14"; active: root.tool == 10; clicked => { root.chosen(10); } }
}

export component AppWindow inherits Window {
    default-font-family: "Onest";
    title: @tr("app-name" => "Znimok");
    // Own title bar: Windows draws window buttons; macOS keeps the traffic lights (inset).
    in property <bool> custom-frame: false;
    in property <length> lights-inset: 0px;
    in property <bool> win-maximized: false;
    no-frame: root.custom-frame;
    callback window-drag();
    callback window-toggle();
    callback window-minimize();
    callback window-close();
    callback window-resize(int);
    in property <image> app-icon;
    icon: app-icon;
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 800px;
    min-height: 560px;
    background: Theme.app;
    default-font-size: 13px;

    // ---- state shared with Rust
    in-out property <int> page: 0; // 0 library, 1 editor
    in property <[CardData]> cards;
    in property <string> library-dir;
    in property <bool> capture-available: true;
    in property <string> capture-key: "Ctrl+Shift+4";
    in-out property <string> toast;

    in property <string> doc-name;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in-out property <bool> autosave: true;
    in property <int> save-state: 0; // 0 saved, 1 unsaved, 2 saving
    in-out property <int> tool: 1;
    in property <image> canvas;
    in property <string> image-size;
    in property <int> mark-count;
    in property <string> zoom-text: "100 %";
    in property <string> crop-text;
    in property <int> color-index: 0;
    in property <int> thick-index: 1;
    in property <bool> has-selection;
    in property <int> selection-count;
    // inspector (ZK-54)
    in-out property <int> insp-tab: 0;
    // macOS: shortcuts shown with ⌘ ⇧ ⌥, and the cursor image sized for points (winit maps an
    // image's pixels to points there).
    in property <bool> mac;
    // Canvas cursor from the app (ZK-47): 0 arrow of the Select tool, 1 crosshair, 2 I-beam,
    // 3 move, 4 nwse, 5 nesw, 6 ns, 7 ew, 8 grab, 9 grabbing.
    in property <int> canvas-cursor;
    in property <int> shadow-index;
    in property <int> glow-index;
    in property <string> geom-x2;
    in property <string> geom-y2;
    // Image tab (ZK-53): tone sliders as positions 0…1 plus their readings, crop panel, size.
    in-out property <float> tone-exposure: 0.5;
    in-out property <float> tone-gamma: 0.5;
    in-out property <float> tone-contrast: 0.5;
    in property <string> tone-exposure-text;
    in property <string> tone-gamma-text;
    in property <string> tone-contrast-text;
    in property <bool> tone-default: true;
    in property <bool> cropped;
    in property <bool> crop-lock;
    in-out property <string> crop-w;
    in-out property <string> crop-h;
    in property <string> crop-sizes;
    in property <string> crop-outside;
    in-out property <string> size-w;
    in-out property <string> size-h;
    in-out property <bool> size-keep: true;
    in-out property <bool> size-scale-text: false;
    // Kind whose properties are shown (-1 none): 0 rect, 1 ellipse, 2 line, 3 pen, 4 text,
    // 5 hide, 6 marker, 7 counter, 8 stamp, 9 image. For a selection or, without one, for the
    // current tool's defaults.
    in property <int> prop-kind: -1;
    in property <bool> prop-for-selection;
    in property <string> prop-title;
    in property <int> fill-index: -1;
    in property <int> dash-index;
    in property <int> corners-index;
    in property <int> head-start;
    in property <int> head-end: 1;
    in property <int> text-size-index: 1;
    // Point size of the text in screenshot pixels (editable; − / + step through the ladder).
    in-out property <string> text-size-px: "24";
    in property <bool> text-bold;
    in property <bool> text-italic;
    in-out property <float> alpha: 1.0;
    in-out property <string> geom-x;
    in-out property <string> geom-y;
    in-out property <string> geom-w;
    in-out property <string> geom-h;
    in property <[LayerRow]> layers;
    in property <string> info-size;
    in property <string> info-source;
    in property <string> info-taken;
    in property <string> info-path;
    in-out property <string> meta-title;
    in-out property <string> meta-description;
    in-out property <string> meta-author;
    in-out property <string> meta-rights;
    in-out property <string> meta-tags;
    // zoom slider position 0…1 (log scale 6 %…1600 %)
    in-out property <float> zoom-pos: 0.5;
    in property <string> hint;
    in-out property <string> hover-hint;

    // text editing overlay
    in-out property <bool> editing: false;
    in-out property <length> edit-x;
    in-out property <length> edit-y;
    in-out property <string> edit-text;

    // ---- over the screen (ZK-58): the window covers the frozen display, no bars and no
    // inspector; the frame (in window pixels) carries a floating rail and an action bar.
    in property <bool> over-screen;
    in property <length> ov-x;
    in property <length> ov-y;
    in property <length> ov-w;
    in property <length> ov-h;
    callback over-to-window();
    callback over-copy();
    callback over-close();
    out property <length> canvas-width: canvas-area.width;
    out property <length> canvas-height: canvas-area.height;

    // ---- callbacks
    callback new-shot();
    callback open-file();
    callback open-clipboard();
    callback open-card(string);
    callback search(string);
    callback back();
    callback undo();
    callback redo();
    callback copy();
    callback export();
    callback autosave-toggled(bool);
    callback tool-chosen(int);
    // kind (0 down, 1 move, 2 up), x, y, button (0 left, 1 right, 2 middle), shift, ctrl (⌘ on macOS)
    callback pointer(int, length, length, int, bool, bool);
    // Ctrl held on the canvas = the Select tool for the moment (owner, 28.09).
    in-out property <bool> ctrl-held;
    callback wheel(length, length, length, length, bool, bool, bool);
    callback key(string, bool, bool, bool);
    callback commit-text(string);
    callback cancel-text();
    // ZK-49: typing right on the canvas — the hidden input reports its caret and selection.
    callback text-edited(int, int);
    callback text-cursor(int, int);
    callback canvas-double(length, length);
    public function edit-select(anchor: int, focus: int) {
        edit.set-selection-offsets(anchor, focus);
    }
    in property <int> text-align;
    // Counters and stamps (ZK-51).
    in property <int> counter-shape;
    in property <int> digit-index: -1;
    in property <int> pin-rot;
    in-out property <string> counter-start;
    in property <string> counter-next;
    in property <int> stamp-id;
    callback set-counter-start(string);
    in-out property <string> text-box;
    callback set-text-box(string);
    callback arrange(int);
    callback align(int);
    callback distribute(int);
    callback group(bool);
    callback duplicate();
    callback zoom-fit();
    callback zoom-100();
    callback zoom-to(float);
    callback set-prop(string, int);
    callback set-alpha(float, bool);
    callback set-geom(string, string);
    callback set-text-size(string);
    callback layer-click(int, bool);
    callback layer-eye(int);
    // Group header row: click selects every member, the eye hides them all, the chevron folds.
    callback layer-group-click(int, bool);
    callback layer-group-eye(int);
    callback layer-collapse(int);
    // Dragging a row (ZK-54): row index, y in the list (px from its top), phase 0 move,
    // 1 drop, 2 cancel. The app answers with where it would land: `layer-drop-row` and
    // `layer-drop-mode` (0 line above the row, 1 onto the row = group, 2 line below it).
    callback layer-drag(int, length, int);
    in-out property <int> layer-drag-from: -1;
    in-out property <length> layer-drag-y;
    in property <int> layer-drop-row: -1;
    in property <int> layer-drop-mode;
    callback meta-edited(string, string);
    callback image-action(string);
    callback drag-out();
    // ZK-61: write title, description, author, rights, tags and date into exported files.
    in property <bool> export-meta: true;
    callback toggle-export-meta();
    // Library cards (ZK-55) and the message line's action ("Undo").
    callback save-as();
    callback card-trash(string);
    callback card-rename(string, string);
    callback card-reveal(string);
    in property <string> toast-action;
    callback toast-action-clicked();
    // Settings page (ZK-56): page 2 of the window.
    callback settings-open();
    callback setting(string, int);
    in-out property <int> settings-page: 0;
    in property <bool> pref-capture;
    in property <bool> pref-quick-library;
    in property <bool> pref-keep-tool;
    in property <bool> pref-autosave;
    in property <bool> pref-metadata;
    in property <bool> pref-updates;
    in property <int> pref-lang;
    in property <bool> pref-ret-size;
    in-out property <string> pref-ret-count;
    in-out property <string> pref-ret-mb;
    in property <string> pref-lib-dir;
    in property <string> pref-file;
    in property <string> pref-version;
    // Start at login (ZK-57 / ZK-77) and the first-run guide.
    in property <bool> pref-autostart;
    in property <bool> pref-autostart-ok: true;
    in property <string> pref-autostart-note;
    in property <bool> onb-screen-ok: true;
    in property <string> onb-keys;
    // One line for the guide: which combinations are taken, what works instead.
    in property <string> onb-keys-warn;
    // Hotkeys page (ZK-44): region, screen, clipboard, empty editor.
    in property <[string]> key-texts;
    in property <[string]> key-warns;
    in property <int> key-recording: -1;
    public function focus-settings() { set-keys.focus(); }
    callback set-tone(string, float, bool);
    callback compare(bool);
    callback set-crop-size(string, string);
    callback size-edited(string, string);

    public function focus-library() { lib-keys.focus(); }
    public function focus-canvas() { keys.focus(); }

    // ================================================================= library
    Rectangle {
        opacity: root.page == 0 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 160ms; easing: ease-in-out; }
        background: Theme.app;
        lib-keys := FocusScope {
            key-pressed(e) => {
                if (e.modifiers.control && (e.text == "v" || e.text == "V" || e.text == "м" || e.text == "М")) {
                    root.open-clipboard();
                    return accept;
                }
                if (e.modifiers.control && (e.text == "o" || e.text == "O" || e.text == "щ" || e.text == "Щ")) {
                    root.open-file();
                    return accept;
                }
                return reject;
            }
            VerticalLayout {
                Rectangle {
                    height: 52px;
                    background: Theme.panel;
                    DragArea { drag => { root.window-drag(); } toggle => { root.window-toggle(); } }
                    if root.custom-frame: WindowControls {
                        x: parent.width - self.width;
                        height: parent.height;
                        maximized: root.win-maximized;
                        minimize => { root.window-minimize(); }
                        toggle => { root.window-toggle(); }
                        close => { root.window-close(); }
                    }
                    HorizontalLayout {
                        padding-left: 16px + root.lights-inset;
                        padding-right: root.custom-frame ? 146px : 16px;
                        spacing: 12px;
                        Path {
                            y: (parent.height - self.height) / 2;
                            width: 24px; height: 24px;
                            viewbox-width: 24; viewbox-height: 24;
                            commands: "M3.5 13.5 h8 L3.5 21 h8";
                            stroke: #3D7BF5; stroke-width: 2.4px; fill: transparent;
                        }
                        Text { text: @tr("lib-title" => "Library"); color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        Rectangle {
                            width: 360px;
                            LineEdit {
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                placeholder-text: @tr("lib-search" => "Search by name, tag or text in the screenshot");
                                edited(t) => { root.search(t); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TextButton {
                            y: (parent.height - self.height) / 2;
                            text: @tr("lib-new-shot" => "New screenshot");
                            icon: "M12 5 v14 M5 12 h14";
                            primary: true;
                            enabled: root.capture-available;
                            clicked => { root.new-shot(); }
                        }
                        TextButton {
                            y: (parent.height - self.height) / 2;
                            text: @tr("open-file" => "File…");
                            icon: "M3 7 a2 2 0 0 1 2 -2 h4 l2 2 h8 a2 2 0 0 1 2 2 v9 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 z";
                            clicked => { root.open-file(); }
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: "M12 9 a3 3 0 1 0 0 6 a3 3 0 1 0 0 -6 z M19.4 15 a1.7 1.7 0 0 0 .3 1.8 l.1 .1 a2 2 0 1 1 -2.8 2.8 l-.1 -.1 a1.7 1.7 0 0 0 -1.8 -.3 a1.7 1.7 0 0 0 -1 1.5 V21 a2 2 0 1 1 -4 0 v-.1 a1.7 1.7 0 0 0 -1.1 -1.5 a1.7 1.7 0 0 0 -1.8 .3 l-.1 .1 a2 2 0 1 1 -2.8 -2.8 l.1 -.1 a1.7 1.7 0 0 0 .3 -1.8 a1.7 1.7 0 0 0 -1.5 -1 H3 a2 2 0 1 1 0 -4 h.1 a1.7 1.7 0 0 0 1.5 -1.1 a1.7 1.7 0 0 0 -.3 -1.8 l-.1 -.1 a2 2 0 1 1 2.8 -2.8 l.1 .1 a1.7 1.7 0 0 0 1.8 .3 H9 a1.7 1.7 0 0 0 1 -1.5 V3 a2 2 0 1 1 4 0 v.1 a1.7 1.7 0 0 0 1 1.5 a1.7 1.7 0 0 0 1.8 -.3 l.1 -.1 a2 2 0 1 1 2.8 2.8 l-.1 .1 a1.7 1.7 0 0 0 -.3 1.8 V9 a1.7 1.7 0 0 0 1.5 1 H21 a2 2 0 1 1 0 4 h-.1 a1.7 1.7 0 0 0 -1.5 1 z";
                            label: @tr("nav-settings" => "Settings");
                            clicked => { root.settings-open(); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                grid := Rectangle {
                    vertical-stretch: 1;
                    property <length> gap: 16px;
                    property <int> cols: max(1, floor((self.width - 32px + gap) / (240px + gap)));
                    property <length> cw: (self.width - 32px - (cols - 1) * gap) / cols;
                    property <length> ch: cw * 0.62 + 56px;
                    if root.cards.length == 0: VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text { text: @tr("lib-empty-title" => "Your screenshots will appear here"); color: Theme.text; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: @tr("lib-empty-body" => "Press {0} to capture a region, or use the button below.", root.capture-key); color: Theme.text2; horizontal-alignment: center; }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            TextButton {
                                text: @tr("lib-new-shot" => "New screenshot");
                                icon: "M12 5 v14 M5 12 h14";
                                primary: true;
                                enabled: root.capture-available;
                                clicked => { root.new-shot(); }
                            }
                            TextButton {
                                text: @tr("open-clipboard" => "From clipboard");
                                clicked => { root.open-clipboard(); }
                            }
                        }
                        Text { text: @tr("lib-empty-drop" => "Drop an image here to open it"); color: Theme.text3; horizontal-alignment: center; }
                        Text { text: root.library-dir; color: Theme.text3; font-size: 11px; horizontal-alignment: center; }
                    }
                    ScrollView {
                        visible: root.cards.length > 0;
                        content-height: (floor((root.cards.length + grid.cols - 1) / grid.cols)) * (grid.ch + grid.gap) + 32px;
                        for card[i] in root.cards: CardView {
                            x: 16px + mod(i, grid.cols) * (grid.cw + grid.gap);
                            y: 16px + floor(i / grid.cols) * (grid.ch + grid.gap);
                            width: grid.cw;
                            height: grid.ch;
                            data: card;
                            open => { root.open-card(card.path); }
                            rename(name) => { root.card-rename(card.path, name); }
                            trash => { root.card-trash(card.path); }
                            reveal => { root.card-reveal(card.path); }
                        }
                    }
                }
                Rectangle {
                    height: 30px;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text { text: root.toast != "" ? root.toast : root.library-dir; color: root.toast != "" ? Theme.accent-text : Theme.text3; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        if root.toast != "" && root.toast-action != "": VerticalLayout {
                            alignment: center;
                            SmallButton { text: root.toast-action; clicked => { root.toast-action-clicked(); } }
                        }
                    }
                }
            }
            init => { self.focus(); }
        }
    }

    // ============================================================ first run (ZK-57)
    // Once, before anything else: what Znimok needs from this system, each step one card.
    Rectangle {
        opacity: root.page == 3 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 200ms; easing: ease-in-out; }
        background: Theme.app;
        TouchArea { }
        // Title bar: drags the window like the other pages' bars.
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 52px;
            background: Theme.panel;
            DragArea { x: 0; y: 0; width: parent.width; height: parent.height; drag => { root.window-drag(); } toggle => { root.window-toggle(); } }
            HorizontalLayout {
                padding-left: 16px + root.lights-inset;
                spacing: 12px;
                alignment: start;
                Path {
                    y: (parent.height - self.height) / 2;
                    width: 24px; height: 24px;
                    viewbox-width: 24; viewbox-height: 24;
                    commands: "M3.5 13.5 h8 L3.5 21 h8";
                    stroke: #3D7BF5; stroke-width: 2.4px; fill: transparent;
                }
                Text { text: "Znimok"; color: Theme.text; font-family: "Unbounded"; font-size: 15px; font-weight: 600; vertical-alignment: center; }
            }
            if root.custom-frame: WindowControls {
                x: parent.width - self.width;
                y: 0;
                height: parent.height;
                maximized: root.win-maximized;
                minimize => { root.window-minimize(); }
                toggle => { root.window-toggle(); }
                close => { root.window-close(); }
            }
        }
        Rectangle { x: 0; y: 52px; width: parent.width; height: 1px; background: Theme.line; }
        VerticalLayout {
            x: (parent.width - self.width) / 2;
            y: 53px;
            width: min(parent.width - 48px, 620px);
            height: parent.height - 53px;
            alignment: center;
            spacing: 14px;
            Text { text: root.mac ? @tr("onb-title-mac" => "Three permissions — and Znimok is ready") : @tr("onb-title-win" => "Two steps — and Znimok is ready"); color: Theme.text; font-size: 22px; font-weight: 700; wrap: word-wrap; }
            Text { text: root.mac ? @tr("onb-intro-mac" => "macOS asks for permission for everything that sees the screen. Znimok works only on your Mac and sends nothing anywhere without your action.") : @tr("onb-intro-win" => "Znimok needs no administrator rights and sends nothing anywhere without your action. Check the hotkeys and choose where screenshots live."); color: Theme.text2; font-size: 13px; wrap: word-wrap; }
            // Screen recording (macOS only)
            if root.mac: Rectangle {
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: root.onb-screen-ok ? #34C48A55 : Theme.control-on;
                height: screen-lay.preferred-height;
                screen-lay := HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: @tr("onb-screen" => "Screen and system audio recording"); color: Theme.text; font-size: 14px; font-weight: 600; }
                        Text { text: root.onb-screen-ok ? @tr("onb-screen-granted" => "Granted. Needed for any capture.") : @tr("onb-screen-needed" => "Needed for any capture. macOS will ask you to restart Znimok."); color: root.onb-screen-ok ? Theme.ok : Theme.text3; font-size: 12px; wrap: word-wrap; }
                    }
                    if !root.onb-screen-ok: VerticalLayout {
                        alignment: center;
                        TextButton { text: @tr("onb-allow" => "Allow"); primary: true; clicked => { root.setting("onb-screen", 0); } }
                    }
                }
            }
            // Hotkeys
            Rectangle {
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.control-on;
                height: keys-lay.preferred-height;
                keys-lay := HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: @tr("onb-keys" => "Hotkeys"); color: Theme.text; font-size: 14px; font-weight: 600; }
                        Text { text: root.onb-keys; color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                        if root.onb-keys-warn != "": Text { text: root.onb-keys-warn; color: Theme.attention; font-size: 11px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton { text: @tr("onb-open-settings" => "Open settings"); clicked => { root.setting("onb-keys", 0); } }
                    }
                }
            }
            // Library folder
            Rectangle {
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.control-on;
                height: lib-lay.preferred-height;
                lib-lay := HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: @tr("onb-library" => "Library folder"); color: Theme.text; font-size: 14px; font-weight: 600; }
                        Text { text: @tr("onb-library-hint" => "All screenshots and videos live here as files. You can pick a folder on a cloud drive."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                        Text { text: root.pref-lib-dir; color: Theme.text2; font-size: 11px; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton { text: @tr("common-change-ellipsis" => "Change…"); clicked => { root.setting("lib-folder", 0); } }
                    }
                }
            }
            // Start at login
            if root.pref-autostart-ok: Rectangle {
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.control-on;
                height: auto-lay.preferred-height;
                auto-lay := VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    SwitchRow { text: @tr("look-autostart" => "Start at sign-in"); checked: root.pref-autostart; toggled => { root.setting("autostart", self.checked ? 1 : 0); } }
                    if root.pref-autostart-note != "": Text { text: root.pref-autostart-note; color: Theme.attention; font-size: 11px; wrap: word-wrap; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                onb-hide := CheckBox { text: @tr("onb-dont-show" => "Don't show next time"); checked: true; }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: @tr("onb-skip-all" => "Skip all"); clicked => { root.setting("onb-done", onb-hide.checked ? 1 : 0); } }
                TextButton { text: @tr("common-done" => "Done"); primary: true; clicked => { root.setting("onb-done", onb-hide.checked ? 1 : 0); } }
            }
        }
    }

    // ================================================================ settings (ZK-56)
    // Inside the main window (not a separate one, PLAN): pages on the left, the page on the
    // right; every change applies and saves at once. Esc or the back arrow returns.
    Rectangle {
        opacity: root.page == 2 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 160ms; easing: ease-in-out; }
        background: Theme.app;
        set-keys := FocusScope {
            enabled: root.page == 2;
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.setting("close", 0); return accept; }
                return reject;
            }
            VerticalLayout {
                Rectangle {
                    height: 52px;
                    background: Theme.panel;
                    DragArea { drag => { root.window-drag(); } toggle => { root.window-toggle(); } }
                    if root.custom-frame: WindowControls {
                        x: parent.width - self.width;
                        height: parent.height;
                        maximized: root.win-maximized;
                        minimize => { root.window-minimize(); }
                        toggle => { root.window-toggle(); }
                        close => { root.window-close(); }
                    }
                    HorizontalLayout {
                        padding-left: 12px + root.lights-inset;
                        padding-right: root.custom-frame ? 146px : 16px;
                        spacing: 8px;
                        IconButton { y: (parent.height - self.height) / 2; icon: "M15 5 l-7 7 7 7"; label: @tr("common-close" => "Close") + "  Esc"; clicked => { root.setting("close", 0); } }
                        Text { text: @tr("set-title" => "Settings"); color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: @tr("set-applied-now" => "Changes apply immediately"); color: Theme.text3; font-size: 12px; vertical-alignment: center; }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout {
                    vertical-stretch: 1;
                    // pages
                    Rectangle {
                        width: 232px;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 2px;
                            alignment: start;
                            for t[i] in [
                                @tr("set-page-shots" => "Screenshots"),
                                @tr("set-page-keys" => "Hotkeys"),
                                @tr("set-page-library" => "Library"),
                                @tr("set-page-sharing" => "Sharing"),
                                @tr("set-page-look" => "Appearance and language"),
                                @tr("set-page-privacy" => "Privacy"),
                                @tr("set-page-about" => "About Znimok"),
                                @tr("dev-page" => "For developers"),
                            ]: Rectangle {
                                height: 34px;
                                border-radius: 8px;
                                background: root.settings-page == i ? Theme.control-on : (nav-ta.has-hover ? Theme.elevated : transparent);
                                animate background { duration: 120ms; }
                                Text { x: 12px; text: t; color: root.settings-page == i ? Theme.text : Theme.text2; font-size: 13px; font-weight: root.settings-page == i ? 600 : 400; vertical-alignment: center; height: parent.height; }
                                nav-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.settings-page = i; } }
                            }
                        }
                    }
                    Rectangle { width: 1px; background: Theme.line; }
                    // the page
                    set-sv := ScrollView {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            x: 0;
                            // A readable column: never wider than 680 px, never wider than the view.
                            width: min(set-sv.visible-width - 12px, 680px);
                            padding: 28px;
                            spacing: 18px;
                            alignment: start;
                            // ---- Screenshots
                            if root.settings-page == 0: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("shots-intro" => "What happens when you release the mouse in the overlay. Each action sits on exactly one gesture."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                SwitchRow { text: @tr("shots-quick-library" => "Quick captures go to the library too"); checked: root.pref-quick-library; toggled => { root.setting("quick-library", self.checked ? 1 : 0); } }
                                SwitchRow { text: @tr("shots-tool-stays" => "The tool stays active after drawing"); checked: root.pref-keep-tool; toggled => { root.setting("keep-tool", self.checked ? 1 : 0); } }
                                SwitchRow { text: @tr("shots-autosave" => "Save automatically (also in the editor title bar)"); checked: root.pref-autosave; toggled => { root.setting("autosave", self.checked ? 1 : 0); } }
                            }
                            // ---- Hotkeys (choosing other combinations: ZK-44)
                            if root.settings-page == 1: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("keys-intro" => "They work in any program. Click a field and press a combination to change it. On a Mac the standard ⌘⇧3/4/5 belong to the system, so the defaults are different."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                SwitchRow { text: @tr("keys-enable" => "Capture with hotkeys"); checked: root.pref-capture; toggled => { root.setting("capture", self.checked ? 1 : 0); } }
                                Text { text: @tr("keys-enable-hint" => "Off — the combinations are free for other programs"); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                for label[i] in [
                                    @tr("keys-region" => "Region screenshot"),
                                    @tr("keys-screen" => "Whole-screen screenshot"),
                                    @tr("keys-clipboard" => "Clipboard image → editor"),
                                    @tr("keys-blank" => "Blank editor"),
                                ]: VerticalLayout {
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text { text: label; color: Theme.text2; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                        // Click, then press the combination (Esc — cancel, Backspace — none).
                                        Rectangle {
                                            width: 170px;
                                            height: 30px;
                                            border-radius: 7px;
                                            background: root.key-recording == i ? #3D7BF526 : (key-ta.has-hover ? Theme.control-on : Theme.elevated);
                                            border-width: root.key-recording == i ? 1.5px : 1px;
                                            border-color: root.key-recording == i ? Theme.accent : Theme.control-on;
                                            animate background, border-color { duration: 120ms; }
                                            Text {
                                                text: root.key-recording == i ? @tr("keys-press" => "press a combination…") : root.key-texts[i];
                                                font-family: root.key-recording == i ? "Onest" : "JetBrains Mono";
                                                color: root.key-recording == i ? Theme.accent-text : (root.pref-capture ? Theme.text : Theme.disabled);
                                                font-size: 12px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                width: parent.width;
                                                height: parent.height;
                                            }
                                            key-ta := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.setting("key-record", i); }
                                            }
                                        }
                                    }
                                    if root.key-warns[i] != "": Text { text: root.key-warns[i]; color: Theme.attention; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    TextButton { text: @tr("keys-defaults" => "Restore defaults"); clicked => { root.setting("keys-defaults", 0); } }
                                }
                            }
                            // ---- Library
                            if root.settings-page == 2: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("libset-intro" => "The folder is the source of truth. You can keep it on a cloud drive and Znimok will pick up changes."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                Text { text: @tr("libset-folder" => "Library folder"); color: Theme.text2; font-size: 12px; }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 7px;
                                    background: Theme.elevated;
                                    Text { x: 10px; width: parent.width - 20px; text: root.pref-lib-dir; color: Theme.text; font-size: 12px; vertical-alignment: center; height: parent.height; overflow: elide; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    TextButton { text: @tr("common-change-ellipsis" => "Change…"); clicked => { root.setting("lib-folder", 0); } }
                                    TextButton { text: @tr("libset-show-folder" => "Show folder"); clicked => { root.setting("show-folder", 0); } }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                Text { text: @tr("libset-keep-shots" => "Keep screenshots no more than"); color: Theme.text2; font-size: 12px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 200px;
                                        height: 30px;
                                        border-radius: 8px;
                                        background: Theme.elevated;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            SegOption { text: @tr("libset-by-count" => "count"); on: !root.pref-ret-size; clicked => { root.setting("ret-by", 0); } }
                                            SegOption { text: @tr("libset-by-size" => "size"); on: root.pref-ret-size; clicked => { root.setting("ret-by", 1); } }
                                        }
                                    }
                                    if !root.pref-ret-size: NumField { width: 110px; label: ""; value <=> root.pref-ret-count; committed(v) => { root.setting("ret-count", 0); } }
                                    if root.pref-ret-size: NumField { width: 110px; label: ""; value <=> root.pref-ret-mb; committed(v) => { root.setting("ret-mb", 0); } }
                                    Text { text: root.pref-ret-size ? "MB" : ""; color: Theme.text3; font-size: 12px; vertical-alignment: center; width: 24px; }
                                }
                                Text { text: @tr("libset-oldest-trash" => "The oldest go to the trash, not away for good"); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                            }
                            // ---- Sharing
                            if root.settings-page == 3: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("sharing-intro" => "What the main Copy button does and which format comes out."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                SwitchRow { text: @tr("sharing-metadata" => "Write metadata into files"); checked: root.pref-metadata; toggled => { root.setting("metadata", self.checked ? 1 : 0); } }
                                Text { text: @tr("export-metadata" => "Write metadata (title, description, author, date)"); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                            }
                            // ---- Look and language
                            if root.settings-page == 4: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("look-language" => "Language"); color: Theme.text2; font-size: 12px; }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 9px;
                                    background: Theme.elevated;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;
                                        SegOption { text: @tr("look-language-system" => "System"); on: root.pref-lang == 0; clicked => { root.setting("lang", 0); } }
                                        SegOption { text: "Українська"; on: root.pref-lang == 1; clicked => { root.setting("lang", 1); } }
                                        SegOption { text: "English"; on: root.pref-lang == 2; clicked => { root.setting("lang", 2); } }
                                    }
                                }
                                if root.pref-autostart-ok: SwitchRow { text: @tr("look-autostart" => "Start at sign-in"); checked: root.pref-autostart; toggled => { root.setting("autostart", self.checked ? 1 : 0); } }
                                if root.pref-autostart-note != "": Text { text: root.pref-autostart-note; color: Theme.attention; font-size: 11px; wrap: word-wrap; }
                                Text { text: @tr("look-theme" => "Theme"); color: Theme.text2; font-size: 12px; }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 9px;
                                    background: Theme.elevated;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;
                                        SegOption { text: @tr("look-theme-system" => "As in the system"); on: Theme.mode == 0; clicked => { root.setting("theme", 0); } }
                                        SegOption { text: @tr("look-theme-light" => "Light"); on: Theme.mode == 1; clicked => { root.setting("theme", 1); } }
                                        SegOption { text: @tr("look-theme-dark" => "Dark"); on: Theme.mode == 2; clicked => { root.setting("theme", 2); } }
                                    }
                                }
                            }
                            // ---- Privacy
                            if root.settings-page == 5: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("priv-intro" => "Znimok sends nothing anywhere without your action. Everything that touches the network and your data is here."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                SwitchRow { text: @tr("priv-updates" => "Check for updates daily"); checked: root.pref-updates; toggled => { root.setting("updates", self.checked ? 1 : 0); } }
                                Text { text: @tr("priv-updates-hint" => "GitHub Releases, version number only"); color: Theme.text3; font-size: 11px; }
                                for row in [
                                    { k: @tr("priv-telemetry" => "Telemetry and statistics"), v: @tr("priv-telemetry-none" => "none, and no switch either") },
                                    { k: @tr("priv-crash" => "Crash reports"), v: @tr("priv-crash-local" => "a local file; you send it yourself") },
                                    { k: @tr("priv-cloud" => "Cloud models (your own key)"), v: @tr("priv-cloud-off" => "off, no key") },
                                ]: HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: row.k; color: Theme.text2; font-size: 12px; horizontal-stretch: 1; }
                                    Text { text: row.v; color: Theme.text3; font-size: 12px; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: root.mac ? @tr("priv-mac-perms" => "macOS permissions") : @tr("onb-open-guide" => "First-run guide"); color: Theme.text2; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                    TextButton { text: @tr("priv-check" => "Check"); clicked => { root.setting("onb-open", 0); } }
                                }
                                Text { text: root.pref-file; color: Theme.text3; font-size: 10px; wrap: word-wrap; }
                            }
                            // ---- For developers (temporary, owner 29.09): reset and replay things
                            if root.settings-page == 7: VerticalLayout {
                                spacing: 12px;
                                Text { text: @tr("dev-intro" => "A temporary page for testing: reset state and show what normally appears only once."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                for a[i] in [
                                    { key: "dev-onboarding", label: @tr("dev-onboarding" => "Show the first-run guide again") },
                                    { key: "dev-pill", label: @tr("dev-pill" => "Show the card after a capture") },
                                    { key: "dev-crash", label: @tr("dev-crash" => "Show the crash-report question") },
                                    { key: "dev-open-settings", label: @tr("dev-open-settings" => "Open the settings folder") },
                                    { key: "dev-open-logs", label: @tr("dev-open-logs" => "Open the logs folder") },
                                    { key: "dev-empty-trash", label: @tr("dev-empty-trash" => "Empty the library trash") },
                                    { key: "dev-reset", label: @tr("dev-reset" => "Reset all settings") },
                                ]: HorizontalLayout {
                                    alignment: start;
                                    TextButton { text: a.label; clicked => { root.setting(a.key, 0); } }
                                }
                                Text { text: root.pref-file; color: Theme.text3; font-size: 10px; wrap: word-wrap; }
                            }
                            // ---- About
                            if root.settings-page == 6: VerticalLayout {
                                spacing: 14px;
                                Text { text: root.pref-version; color: Theme.text; font-size: 18px; font-weight: 700; }
                                Text { text: @tr("about-fonts" => "Fonts: Onest, JetBrains Mono, Unbounded — SIL Open Font License 1.1"); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                HorizontalLayout { alignment: start; AboutSlint { height: 160px; } }
                            }
                        }
                    }
                }
            }
        }
    }

    // ================================================================== editor
    Rectangle {
        opacity: root.page == 1 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 160ms; easing: ease-in-out; }
        background: Theme.app;
        VerticalLayout {
            // ---- top bar: every item 32 px high, centred on one line (no hand-placed y)
            Rectangle {
                height: root.over-screen ? 0px : 52px;
                visible: !root.over-screen;
                background: Theme.panel;
                DragArea { drag => { root.window-drag(); } toggle => { root.window-toggle(); } }
                if root.custom-frame: WindowControls {
                    x: parent.width - self.width;
                    height: parent.height;
                    maximized: root.win-maximized;
                    minimize => { root.window-minimize(); }
                    toggle => { root.window-toggle(); }
                    close => { root.window-close(); }
                }
                HorizontalLayout {
                    padding-left: 10px + root.lights-inset;
                    padding-right: root.custom-frame ? 150px : 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 6px;
                    BarButton {
                        icon: "M15 6 l-6 6 6 6";
                        text: @tr("nav-library" => "Library");
                        tip: @tr("nav-back-to-library" => "Back to library");
                        clicked => { root.back(); }
                    }
                    open-btn := BarButton {
                        text: @tr("common-open" => "Open");
                        chevron: true;
                        tip: @tr("open-file" => "File…") + " · " + @tr("open-clipboard" => "From clipboard");
                        clicked => { open-menu.show(); }
                        open-menu := PopupWindow {
                            x: 0;
                            y: parent.height + 4px;
                            width: 260px;
                            Rectangle {
                                background: Theme.elevated;
                                border-radius: 12px;
                                drop-shadow-blur: 24px;
                                drop-shadow-color: #00000080;
                                VerticalLayout {
                                    padding: 6px;
                                    MenuItemRow { text: @tr("open-file" => "File…"); shortcut: Keys.k("Ctrl+O", "⌘O"); clicked => { root.open-file(); } }
                                    MenuItemRow { text: @tr("open-clipboard" => "From clipboard"); shortcut: Keys.k("Ctrl+V", "⌘V"); clicked => { root.open-clipboard(); } }
                                    MenuItemRow { text: @tr("open-new-shot" => "New screenshot"); shortcut: root.capture-key; enabled: root.capture-available; clicked => { root.new-shot(); } }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        padding-left: 4px;
                        padding-right: 4px;
                        Rectangle { width: 1px; height: 20px; background: Theme.control-on; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 22px;
                            width: kind-text.preferred-width + 16px;
                            border-radius: 6px;
                            background: #3D7BF524;
                            kind-text := Text { text: @tr("doc-kind-screenshot" => "Screenshot"); color: Theme.accent-text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                    }
                    Text { text: root.doc-name; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; max-width: 360px; horizontal-stretch: 0; }
                    Rectangle { width: 6px; }
                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked <=> root.autosave;
                                toggled => { root.autosave-toggled(self.checked); }
                            }
                        }
                        Text { text: @tr("doc-autosave" => "Save automatically"); color: Theme.text2; font-size: 12px; vertical-alignment: center; wrap: no-wrap; }
                        Text {
                            text: root.save-state == 0 ? @tr("doc-state-saved" => "saved") : (root.save-state == 2 ? @tr("doc-state-saving" => "saving…") : @tr("doc-state-unsaved" => "unsaved"));
                            color: root.save-state == 1 ? Theme.attention : Theme.text3;
                            animate color { duration: 200ms; }
                            font-size: 12px;
                            vertical-alignment: center;
                            wrap: no-wrap;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 76px;
                        border-radius: 10px;
                        background: Theme.elevated;
                        HorizontalLayout {
                            padding: 2px;
                            spacing: 0px;
                            IconButton { width: 36px; height: 28px; label: @tr("doc-undo" => "Undo"); tip: self.label + "  " + Keys.k("Ctrl+Z", "⌘Z"); icon: "M9 14 L4 9 l5 -5 M4 9 h11 a5 5 0 0 1 0 10 h-3"; enabled: root.can-undo; clicked => { root.undo(); } }
                            IconButton { width: 36px; height: 28px; label: @tr("doc-redo" => "Redo"); tip: self.label + "  " + Keys.k("Ctrl+Shift+Z", "⇧⌘Z"); icon: "M15 14 l5 -5 -5 -5 M20 9 H9 a5 5 0 0 0 0 10 h3"; enabled: root.can-redo; clicked => { root.redo(); } }
                        }
                    }
                    IconButton { width: 36px; height: 28px; y: (parent.height - self.height) / 2; icon: "M12 9 a3 3 0 1 0 0 6 a3 3 0 1 0 0 -6 z M19.4 15 a1.7 1.7 0 0 0 .3 1.8 l.1 .1 a2 2 0 1 1 -2.8 2.8 l-.1 -.1 a1.7 1.7 0 0 0 -1.8 -.3 a1.7 1.7 0 0 0 -1 1.5 V21 a2 2 0 1 1 -4 0 v-.1 a1.7 1.7 0 0 0 -1.1 -1.5 a1.7 1.7 0 0 0 -1.8 .3 l-.1 .1 a2 2 0 1 1 -2.8 -2.8 l.1 -.1 a1.7 1.7 0 0 0 .3 -1.8 a1.7 1.7 0 0 0 -1.5 -1 H3 a2 2 0 1 1 0 -4 h.1 a1.7 1.7 0 0 0 1.5 -1.1 a1.7 1.7 0 0 0 -.3 -1.8 l-.1 -.1 a2 2 0 1 1 2.8 -2.8 l.1 .1 a1.7 1.7 0 0 0 1.8 .3 H9 a1.7 1.7 0 0 0 1 -1.5 V3 a2 2 0 1 1 4 0 v.1 a1.7 1.7 0 0 0 1 1.5 a1.7 1.7 0 0 0 1.8 -.3 l.1 -.1 a2 2 0 1 1 2.8 2.8 l-.1 .1 a1.7 1.7 0 0 0 -.3 1.8 V9 a1.7 1.7 0 0 0 1.5 1 H21 a2 2 0 1 1 0 4 h-.1 a1.7 1.7 0 0 0 -1.5 1 z"; label: @tr("nav-settings" => "Settings"); clicked => { root.settings-open(); } }
                    Rectangle { width: 4px; }
                    copy-box := Rectangle {
                        width: copy-row.preferred-width;
                        border-radius: 8px;
                        background: Theme.accent;
                        clip: true;
                        copy-row := HorizontalLayout {
                            Rectangle {
                                width: copy-inner.preferred-width;
                                background: copy-ta.has-hover ? #5189F7 : transparent;
                                animate background { duration: 120ms; }
                                copy-inner := HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 14px;
                                    spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon { width: 18px; height: 18px; tint: white; d: "M11 9 h7 a2 2 0 0 1 2 2 v7 a2 2 0 0 1 -2 2 h-7 a2 2 0 0 1 -2 -2 v-7 a2 2 0 0 1 2 -2 z M5 15 V5 a2 2 0 0 1 2 -2 h10"; }
                                    }
                                    Text { text: @tr("doc-copy" => "Copy"); color: white; font-size: 13px; font-weight: 600; vertical-alignment: center; wrap: no-wrap; }
                                }
                                // Click copies; pulling it a few pixels starts a drag of the picture as a
                                // PNG file into a messenger or a folder (ZK-64).
                                copy-ta := TipTouch {
                                    property <bool> dragged;
                                    tip: @tr("share-copy-image" => "Copy image") + "  " + Keys.k("Ctrl+C", "⌘C") + (Keys.last-share == 0 ? " / Enter" : "") + " · " + @tr("share-drag-tip" => "drag to a chat or a folder");
                                    mouse-cursor: self.dragged ? MouseCursor.grabbing : MouseCursor.pointer;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) { self.dragged = false; }
                                    }
                                    moved => {
                                        if (self.pressed && !self.dragged && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px)) {
                                            self.dragged = true;
                                            root.drag-out();
                                        }
                                    }
                                    clicked => {
                                        if (!self.dragged) { root.copy(); }
                                        self.dragged = false;
                                    }
                                }
                            }
                            Rectangle { width: 1px; background: #FFFFFF38; }
                            Rectangle {
                                width: 30px;
                                background: more-ta.has-hover ? #5189F7 : transparent;
                                animate background { duration: 120ms; }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout { alignment: center; Chevron { tint: white; } }
                                }
                                more-ta := TipTouch { tip: @tr("doc-other-ways" => "More options"); clicked => { more-menu.show(); } }
                            }
                        }
                        more-menu := PopupWindow {
                            x: parent.width - 260px;
                            y: parent.height + 4px;
                            width: 260px;
                            Rectangle {
                                background: Theme.elevated;
                                border-radius: 12px;
                                drop-shadow-blur: 24px;
                                drop-shadow-color: #00000080;
                                VerticalLayout {
                                    padding: 6px;
                                    MenuItemRow { text: @tr("share-copy-image" => "Copy image"); shortcut: Keys.k("Ctrl+C", "⌘C") + (Keys.last-share == 0 ? "  Enter" : ""); clicked => { root.copy(); } }
                                    MenuItemRow { text: @tr("share-export" => "Export file…"); shortcut: Keys.k("Ctrl+Shift+S", "⇧⌘S") + (Keys.last-share == 1 ? "  Enter" : ""); clicked => { root.export(); } }
                                    MenuItemRow { text: @tr("doc-save-as" => "Save as…"); clicked => { root.save-as(); } }
                                    MenuItemRow { text: @tr("share-system" => "Share…"); enabled: false; }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    MenuItemRow { text: @tr("export-metadata-menu" => "Write metadata"); shortcut: root.export-meta ? "✓" : ""; clicked => { root.toggle-export-meta(); } }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { height: root.over-screen ? 0px : 1px; background: Theme.line; }
            HorizontalLayout {
                vertical-stretch: 1;
                // ---- tool rail (tooltips to the right)
                Rectangle {
                    width: root.over-screen ? 0px : 56px;
                    visible: !root.over-screen;
                    background: Theme.panel;
                    ToolRail { tool: root.tool; ctrl-held: root.ctrl-held; chosen(i) => { root.tool-chosen(i); } }
                }
                Rectangle { width: root.over-screen ? 0px : 1px; background: Theme.line; }
                // ---- canvas
                canvas-area := Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.canvas;
                    clip: true;
                    Image {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        source: root.canvas;
                        image-fit: fill;
                        image-rendering: pixelated;
                    }
                    keys := FocusScope {
                        key-pressed(e) => {
                            if (e.text == Key.Control || e.text == Key.Meta) { root.ctrl-held = true; }
                            if (root.editing) { return reject; }
                            root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
                            return accept;
                        }
                        key-released(e) => {
                            if (e.text == Key.Control || e.text == Key.Meta) { root.ctrl-held = false; }
                            return accept;
                        }
                        changed has-focus => { if (!self.has-focus) { root.ctrl-held = false; } }
                        TouchArea {
                            // Ctrl (⌘) turns a drawing tool into Select at once, before the pointer moves.
                            property <int> c: root.ctrl-held && root.tool != 10 && (root.canvas-cursor == 1 || root.canvas-cursor == 2) ? 0 : root.canvas-cursor;
                            mouse-cursor: self.c == 0 ? (root.mac ? MouseCursor.custom(@image-url("cursors/select-mac.svg"), 2, 1) : MouseCursor.custom(@image-url("cursors/select.svg"), 4, 2))
                                : self.c == 1 ? MouseCursor.crosshair
                                : self.c == 2 ? MouseCursor.text
                                : self.c == 3 ? MouseCursor.move
                                : self.c == 4 ? MouseCursor.nwse-resize
                                : self.c == 5 ? MouseCursor.nesw-resize
                                : self.c == 6 ? MouseCursor.ns-resize
                                : self.c == 7 ? MouseCursor.ew-resize
                                : self.c == 8 ? MouseCursor.grab
                                : self.c == 9 ? MouseCursor.grabbing
                                : MouseCursor.default;
                            pointer-event(e) => {
                                if (!root.editing) { keys.focus(); }
                                if (e.kind == PointerEventKind.down) {
                                    root.pointer(0, self.mouse-x, self.mouse-y, e.button == PointerEventButton.left ? 0 : (e.button == PointerEventButton.right ? 1 : 2), e.modifiers.shift, e.modifiers.control);
                                } else if (e.kind == PointerEventKind.up) {
                                    root.pointer(2, self.mouse-x, self.mouse-y, e.button == PointerEventButton.left ? 0 : (e.button == PointerEventButton.right ? 1 : 2), e.modifiers.shift, e.modifiers.control);
                                } else if (e.kind == PointerEventKind.move) {
                                    root.pointer(1, self.mouse-x, self.mouse-y, 0, e.modifiers.shift, e.modifiers.control);
                                }
                            }
                            double-clicked => { root.canvas-double(self.mouse-x, self.mouse-y); }
                            scroll-event(e) => {
                                root.wheel(self.mouse-x, self.mouse-y, e.delta-x, e.delta-y, e.modifiers.control, e.modifiers.alt, e.modifiers.shift);
                                return accept;
                            }
                        }
                        init => { self.focus(); }
                    }
                    // The keys of the text being typed (ZK-49). Invisible: the canvas draws the text,
                    // the caret and the selection itself, at the real size and zoom. It sits where the
                    // text starts so an input method's window appears next to it.
                    edit := TextInput {
                        x: root.edit-x;
                        y: root.edit-y;
                        width: 2px;
                        height: 2px;
                        enabled: root.editing;
                        visible: root.editing;
                        single-line: false;
                        color: transparent;
                        selection-background-color: transparent;
                        selection-foreground-color: transparent;
                        text-cursor-width: 0px;
                        font-size: 12px;
                        text <=> root.edit-text;
                        edited => { root.text-edited(self.cursor-position-byte-offset, self.anchor-position-byte-offset); }
                        cursor-position-changed(pos) => { root.text-cursor(self.cursor-position-byte-offset, self.anchor-position-byte-offset); }
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                root.cancel-text();
                                return accept;
                            }
                            // Enter finishes, Shift+Enter starts a new line (as in LH).
                            if (e.text == Key.Return && !e.modifiers.shift) {
                                root.commit-text(self.text);
                                return accept;
                            }
                            return reject;
                        }
                        changed enabled => {
                            if (self.enabled) { self.focus(); }
                        }
                    }
                    // ---- over the screen (ZK-58): the rail at the left of the frame and the bar below
                    // it; where there is no room — on the other side, else inside the frame.
                    if root.over-screen: Rectangle {
                        property <length> lx: root.ov-x - self.width - 12px;
                        property <length> rx: root.ov-x + root.ov-w + 12px;
                        width: 56px;
                        height: ov-rail.preferred-height;
                        x: self.lx >= 8px ? self.lx : (self.rx + self.width <= parent.width - 8px ? self.rx : root.ov-x + 8px);
                        y: max(8px, min(root.ov-y, parent.height - self.height - 8px));
                        border-radius: 12px;
                        background: Theme.panel;
                        drop-shadow-blur: 18px;
                        drop-shadow-color: #00000080;
                        ov-rail := ToolRail {
                            tool: root.tool;
                            ctrl-held: root.ctrl-held;
                            with-crop: false;
                            chosen(i) => { root.tool-chosen(i); }
                        }
                    }
                    if root.over-screen: Rectangle {
                        property <length> below: root.ov-y + root.ov-h + 12px;
                        property <length> above: root.ov-y - self.height - 12px;
                        width: ov-bar.preferred-width;
                        height: 48px;
                        // From the frame's left edge: the rail stands left of the frame, so the bar
                        // under a narrow frame runs to the right instead of into the rail.
                        x: max(8px, min(root.ov-x, parent.width - self.width - 8px));
                        y: self.below + self.height <= parent.height - 8px ? self.below : (self.above >= 8px ? self.above : root.ov-y + root.ov-h - self.height - 8px);
                        border-radius: 12px;
                        background: Theme.panel;
                        drop-shadow-blur: 18px;
                        drop-shadow-color: #00000080;
                        ov-bar := HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            // what this is, and how the frame works
                            Rectangle {
                                width: chip-text.preferred-width + 20px;
                                border-radius: 8px;
                                background: Theme.elevated;
                                chip-text := Text { text: @tr("overlay-chip" => "Over the screen"); color: Theme.text2; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                                TipTouch {
                                    mouse-cursor: MouseCursor.default;
                                    tip-side: 2;
                                    tip: @tr("overlay-hint-frame" => "drag the frame corners — that is the crop") + " · " + Keys.k("Ctrl+S", "⌘S") + " " + @tr("overlay-hint-save" => "to library") + " · Esc " + @tr("overlay-hint-close" => "close");
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                ColourRow { width: 270px; selected: root.color-index; picked(i) => { root.set-prop("color", i); } }
                            }
                            IconButton { tip-side: 2; label: @tr("doc-undo" => "Undo"); tip: self.label + "  " + Keys.k("Ctrl+Z", "⌘Z"); icon: "M9 14 L4 9 l5 -5 M4 9 h11 a5 5 0 0 1 0 10 h-3"; enabled: root.can-undo; clicked => { root.undo(); } }
                            IconButton { tip-side: 2; label: @tr("doc-redo" => "Redo"); tip: self.label + "  " + Keys.k("Ctrl+Shift+Z", "⇧⌘Z"); icon: "M15 14 l5 -5 -5 -5 M20 9 H9 a5 5 0 0 0 0 10 h3"; enabled: root.can-redo; clicked => { root.redo(); } }
                            IconButton { tip-side: 2; label: @tr("overlay-open-window" => "Open in the editor window"); tip: @tr("overlay-open-window-tip" => "To the editor window — tone, size, library"); icon: "M4 6 a2 2 0 0 1 2 -2 h12 a2 2 0 0 1 2 2 v12 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 z M4 9 h16 M7 6.5 h.01 M9.5 6.5 h.01"; clicked => { root.over-to-window(); } }
                            TextButton { primary: true; icon: "M11 9 h7 a2 2 0 0 1 2 2 v7 a2 2 0 0 1 -2 2 h-7 a2 2 0 0 1 -2 -2 v-7 a2 2 0 0 1 2 -2 z M5 15 V5 a2 2 0 0 1 2 -2 h10"; text: @tr("doc-copy" => "Copy"); clicked => { root.over-copy(); } }
                            IconButton { tip-side: 2; label: @tr("common-close" => "Close"); tip: self.label + "  Esc"; icon: "M6 6 L18 18 M18 6 L6 18"; clicked => { root.over-close(); } }
                        }
                    }
                }
                Rectangle { width: root.over-screen ? 0px : 1px; background: Theme.line; }
                // ---- inspector (ZK-54): Object · Layers · Image · Meta
                Rectangle {
                    width: root.over-screen ? 0px : 284px;
                    visible: !root.over-screen;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;
                        // tabs
                        Rectangle {
                            height: 32px;
                            border-radius: 9px;
                            background: Theme.elevated;
                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;
                                SegOption { text: @tr("insp-tab-object" => "Object"); on: root.insp-tab == 0; clicked => { root.insp-tab = 0; } }
                                SegOption { text: @tr("insp-tab-layers" => "Layers"); on: root.insp-tab == 1; clicked => { root.insp-tab = 1; } }
                                SegOption { text: @tr("insp-tab-shot" => "Image"); on: root.insp-tab == 2; clicked => { root.insp-tab = 2; } }
                                SegOption { text: @tr("insp-tab-meta" => "Meta"); on: root.insp-tab == 3; clicked => { root.insp-tab = 3; } }
                            }
                        }
                        // ---- Object
                        if root.insp-tab == 0: InspScroll {
                            VerticalLayout {
                                spacing: 14px;
                                alignment: start;
                                // Title row: what is being edited, and how many.
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: root.prop-kind >= 0 ? root.prop-title : (root.mark-count == 0 ? @tr("insp-no-marks" => "No annotations yet. Pick a tool on the left and draw on the screenshot.") : @tr("insp-nothing-selected" => "Select an annotation to change it, or pick a tool on the left."));
                                        color: root.prop-kind >= 0 ? Theme.text : Theme.text3;
                                        font-size: root.prop-kind >= 0 ? 13px : 12px;
                                        font-weight: root.prop-kind >= 0 ? 600 : 400;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    if root.prop-for-selection && root.selection-count > 1: Text {
                                        text: @tr("arrange-selected" => "Selected: {0}", root.selection-count);
                                        color: Theme.text3;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                                // ---- Colours. Kinds with two colours show them as a pair with the swap
                                // button between (owner, 28.09): shapes Fill ⇅ Stroke — the stroke's
                                // thickness, style and corners follow it; text Letters ⇅ Outline.
                                if root.prop-kind >= 0 && root.prop-kind != 5 && root.prop-kind != 9: VerticalLayout {
                                    spacing: 8px;
                                    // first colour of a pair: fill (shapes) / letters (text)
                                    if root.prop-kind <= 1 || root.prop-kind == 4: VerticalLayout {
                                        spacing: 8px;
                                        Text { height: 22px; text: root.prop-kind == 4 ? @tr("ctx-text-colour" => "Text colour") : @tr("insp-fill" => "Fill"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; vertical-alignment: center; }
                                        if root.prop-kind <= 1: ColourRow {
                                            selected: root.fill-index;
                                            with-none: true;
                                            none-tip: @tr("ctx-fill-none" => "Fill colour: none");
                                            picked(i) => { root.set-prop("fill", i); }
                                        }
                                        if root.prop-kind == 4: ColourRow {
                                            selected: root.color-index;
                                            picked(i) => { root.set-prop("color", i); }
                                        }
                                    }
                                    // second colour: caption on the left, the swap button on the right —
                                    // between the two rows it swaps
                                    HorizontalLayout {
                                        height: 22px;
                                        Text { text: root.prop-kind == 4 ? @tr("ctx-text-outline" => "Outline colour") : @tr("insp-stroke" => "Stroke"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; vertical-alignment: center; horizontal-stretch: 1; }
                                        if root.prop-kind <= 1 || root.prop-kind == 4: IconButton {
                                            width: 22px;
                                            height: 22px;
                                            icon: "M7 4 L3 8 l4 4 M3 8 h13 a4 4 0 0 1 4 4 M17 20 l4 -4 -4 -4 M21 16 H8 a4 4 0 0 1 -4 -4";
                                            label: @tr("insp-swap-colours" => "Swap stroke and fill");
                                            enabled: root.fill-index >= 0 || root.color-index >= 0;
                                            clicked => { root.set-prop("swap", 0); }
                                        }
                                    }
                                    if root.prop-kind == 4: ColourRow {
                                        selected: root.fill-index;
                                        with-none: true;
                                        none-tip: @tr("ctx-fill-none" => "Fill colour: none");
                                        picked(i) => { root.set-prop("fill", i); }
                                    }
                                    if root.prop-kind != 4: ColourRow {
                                        selected: root.color-index;
                                        with-none: root.prop-kind <= 1;
                                        none-tip: @tr("insp-stroke-none" => "No outline");
                                        picked(i) => { root.set-prop(i < 0 ? "stroke-none" : "color", i); }
                                    }
                                    if root.prop-kind <= 3: PropRow {
                                        label: @tr("insp-thickness" => "Thickness");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            for t[i] in [1.5px, 3px, 5.5px]: SegOption { bar: t; on: root.thick-index == i; tip: i == 0 ? @tr("ctx-thin" => "Thin") : (i == 1 ? @tr("ctx-medium" => "Medium") : @tr("ctx-thick" => "Thick")); clicked => { root.set-prop("thick", i); } }
                                        }
                                    }
                                    if root.prop-kind <= 3: PropRow {
                                        label: @tr("ctx-line-style" => "Line style");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M3 12 h18"; on: root.dash-index == 0; tip: @tr("insp-line-solid" => "Solid"); clicked => { root.set-prop("dash", 0); } }
                                            SegOption { icon: "M3 12 h4 M10 12 h4 M17 12 h4"; on: root.dash-index == 1; tip: @tr("insp-line-dashed" => "Dashed"); clicked => { root.set-prop("dash", 1); } }
                                            SegOption { icon: "M3 12 h5 M11 12 h1.5 M15.5 12 h5.5"; on: root.dash-index == 2; tip: @tr("insp-line-dashdot" => "Dash-dot"); clicked => { root.set-prop("dash", 2); } }
                                        }
                                    }
                                    if root.prop-kind == 0: PropRow {
                                        label: @tr("insp-corners" => "Corners");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M5 19 V5 h14"; on: root.corners-index == 0; tip: @tr("insp-corners-sharp" => "Sharp"); clicked => { root.set-prop("corners", 0); } }
                                            SegOption { icon: "M5 19 V9 a4 4 0 0 1 4 -4 h10"; on: root.corners-index == 1; tip: @tr("insp-corners-soft" => "Soft"); clicked => { root.set-prop("corners", 1); } }
                                            SegOption { icon: "M5 19 V14 a9 9 0 0 1 9 -9 h5"; on: root.corners-index == 2; tip: @tr("insp-corners-round" => "Round"); clicked => { root.set-prop("corners", 2); } }
                                        }
                                    }
                                }
                                // ---- Arrowheads: a property of the line and of the pen trail
                                if root.prop-kind == 2 || root.prop-kind == 3: PropSection {
                                    title: @tr("insp-heads" => "Arrowheads");
                                    PropRow {
                                        label: @tr("insp-head-start" => "Start");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M4 12 h16"; on: root.head-start == 0; tip: @tr("common-none" => "None"); clicked => { root.set-prop("head-start", 0); } }
                                            SegOption { icon: "M20 12 H8 M4 12 l6 -4 v8 z"; on: root.head-start == 1; tip: @tr("insp-head-triangle" => "Triangle"); clicked => { root.set-prop("head-start", 1); } }
                                            SegOption { icon: "M20 12 H4 M10 6 l-6 6 6 6"; on: root.head-start == 2; tip: @tr("insp-head-chevron" => "Chevron"); clicked => { root.set-prop("head-start", 2); } }
                                            SegOption { icon: "M20 12 H9 M4 12 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0"; on: root.head-start == 3; tip: @tr("insp-head-dot" => "Dot"); clicked => { root.set-prop("head-start", 3); } }
                                        }
                                    }
                                    PropRow {
                                        label: @tr("insp-head-end" => "End");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M4 12 h16"; on: root.head-end == 0; tip: @tr("common-none" => "None"); clicked => { root.set-prop("head-end", 0); } }
                                            SegOption { icon: "M4 12 h12 M20 12 l-6 -4 v8 z"; on: root.head-end == 1; tip: @tr("insp-head-triangle" => "Triangle"); clicked => { root.set-prop("head-end", 1); } }
                                            SegOption { icon: "M4 12 h16 M14 6 l6 6 -6 6"; on: root.head-end == 2; tip: @tr("insp-head-chevron" => "Chevron"); clicked => { root.set-prop("head-end", 2); } }
                                            SegOption { icon: "M4 12 h11 M15 12 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0"; on: root.head-end == 3; tip: @tr("insp-head-dot" => "Dot"); clicked => { root.set-prop("head-end", 3); } }
                                        }
                                    }
                                }
                                // ---- Text
                                if root.prop-kind == 4: PropSection {
                                    title: @tr("tool-text-name" => "Text");
                                    PropRow {
                                        label: @tr("text-size" => "Size");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { width: 30px; horizontal-stretch: 0; icon: "M6 12 h12"; tip: @tr("text-size-down" => "Smaller type"); clicked => { root.set-prop("text-step", -1); } }
                                            Rectangle {
                                                width: 52px;
                                                height: 28px;
                                                border-radius: 7px;
                                                background: Theme.elevated;
                                                border-width: 1px;
                                                border-color: size-input.has-focus ? Theme.accent : Theme.control-on;
                                                animate border-color { duration: 120ms; }
                                                size-input := TextInput {
                                                    width: parent.width - 8px;
                                                    height: parent.height;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    color: Theme.text;
                                                    font-size: 12px;
                                                    input-type: number;
                                                    text <=> root.text-size-px;
                                                    accepted => { root.set-text-size(self.text); }
                                                    changed has-focus => { if (!self.has-focus) { root.set-text-size(self.text); } }
                                                }
                                            }
                                            SegOption { width: 30px; horizontal-stretch: 0; icon: "M6 12 h12 M12 6 v12"; tip: @tr("text-size-up" => "Larger type"); clicked => { root.set-prop("text-step", 1); } }
                                            Rectangle { horizontal-stretch: 1; }
                                            SegOption { width: 32px; horizontal-stretch: 0; icon: "M7 5 h6 a3.5 3.5 0 0 1 0 7 H7 z M7 12 h7 a3.5 3.5 0 0 1 0 7 H7 z"; on: root.text-bold; tip: @tr("ctx-bold" => "Bold"); clicked => { root.set-prop("bold", root.text-bold ? 0 : 1); } }
                                            SegOption { width: 32px; horizontal-stretch: 0; icon: "M10 5 h8 M6 19 h8 M14 5 l-4 14"; on: root.text-italic; tip: @tr("ctx-italic" => "Italic"); clicked => { root.set-prop("italic", root.text-italic ? 0 : 1); } }
                                        }
                                    }
                                    PropRow {
                                        label: @tr("text-block" => "Block");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M4 6 h16 M4 10 h10 M4 14 h16 M4 18 h8"; on: root.text-align == 0; tip: @tr("ctx-align-left" => "Align left"); clicked => { root.set-prop("align", 0); } }
                                            SegOption { icon: "M4 6 h16 M7 10 h10 M4 14 h16 M8 18 h8"; on: root.text-align == 1; tip: @tr("ctx-align-centre" => "Align centre"); clicked => { root.set-prop("align", 1); } }
                                            SegOption { icon: "M4 6 h16 M10 10 h10 M4 14 h16 M12 18 h8"; on: root.text-align == 2; tip: @tr("ctx-align-right" => "Align right"); clicked => { root.set-prop("align", 2); } }
                                        }
                                    }
                                    if root.prop-for-selection: PropRow {
                                        label: @tr("insp-width" => "Width");
                                        HorizontalLayout {
                                            spacing: 6px;
                                            NumField { label: ""; value <=> root.text-box; committed(v) => { root.set-text-box(v); } }
                                            SegOption { width: 64px; horizontal-stretch: 0; text: @tr("common-auto" => "Auto"); on: root.text-box == ""; tip: @tr("text-block-hint" => "Width 0 — no wrapping; the side handles change the width."); clicked => { root.set-prop("box-auto", 0); } }
                                        }
                                    }
                                }
                                // ---- Counter (ZK-51): shape, digit colour, numbering
                                if root.prop-kind == 7: PropSection {
                                    title: @tr("tool-counter-name" => "Counter");
                                    PropRow {
                                        label: @tr("counter-shape" => "Shape");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M3 12 a9 9 0 1 0 18 0 a9 9 0 1 0 -18 0 z"; on: root.counter-shape == 0; tip: @tr("counter-circle" => "Circle"); clicked => { root.set-prop("counter-shape", 0); } }
                                            SegOption { icon: "M6 4 h12 a2 2 0 0 1 2 2 v12 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 V6 a2 2 0 0 1 2 -2 z"; on: root.counter-shape == 1; tip: @tr("counter-square" => "Square"); clicked => { root.set-prop("counter-shape", 1); } }
                                            SegOption { icon: "M12 21 C7 15 5 12 5 9 a7 7 0 1 1 14 0 c0 3 -2 6 -7 12 z"; on: root.counter-shape == 2; tip: @tr("counter-pin" => "Pin"); clicked => { root.set-prop("counter-shape", 2); } }
                                        }
                                    }
                                    // A pin points where it matters: four directions.
                                    if root.counter-shape == 2 && root.prop-for-selection: PropRow {
                                        label: "";
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M12 5 v14 M6 13 l6 6 6 -6"; on: root.pin-rot == 0; clicked => { root.set-prop("pin-rot", 0); } }
                                            SegOption { icon: "M19 12 H5 M11 6 l-6 6 6 6"; on: root.pin-rot == 1; clicked => { root.set-prop("pin-rot", 1); } }
                                            SegOption { icon: "M12 19 V5 M6 11 l6 -6 6 6"; on: root.pin-rot == 2; clicked => { root.set-prop("pin-rot", 2); } }
                                            SegOption { icon: "M5 12 h14 M13 6 l6 6 -6 6"; on: root.pin-rot == 3; clicked => { root.set-prop("pin-rot", 3); } }
                                        }
                                    }
                                    Text { height: 22px; text: @tr("counter-digit-colour" => "Number"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; vertical-alignment: center; }
                                    ColourRow {
                                        selected: root.digit-index;
                                        with-none: true;
                                        none-tip: @tr("counter-digit-auto" => "Auto: black or white, whichever reads better");
                                        picked(i) => { root.set-prop("digit", i); }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: @tr("counter-start-from" => "Start numbering from…"); color: Theme.text3; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                        NumField { width: 90px; label: ""; value <=> root.counter-start; committed(v) => { root.set-counter-start(v); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        TextButton { text: @tr("counter-new-group" => "New numbering group"); clicked => { root.set-prop("counter-group-new", 0); } }
                                        if !root.prop-for-selection: Text { text: root.counter-next; color: Theme.text3; font-size: 11px; vertical-alignment: center; }
                                    }
                                }
                                // ---- Stamp (ZK-51): six drawn signs and emoji
                                if root.prop-kind == 8: PropSection {
                                    title: @tr("stamp-picker" => "Stamps and emoji");
                                    Text { height: 18px; text: @tr("stamp-stamps" => "Stamps"); color: Theme.text3; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    HorizontalLayout {
                                        spacing: 2px;
                                            SegOption { icon: "M5 12.5 l4.5 4.5 L19 7"; on: root.stamp-id == 0; tip: @tr("stamp-check" => "Check mark"); clicked => { root.set-prop("stamp", 0); } }
                                            SegOption { icon: "M6 6 l12 12 M18 6 L6 18"; on: root.stamp-id == 1; tip: @tr("stamp-cross" => "Cross"); clicked => { root.set-prop("stamp", 1); } }
                                            SegOption { icon: "M9 9 a3 3 0 1 1 4 2.8 c-.8 .4 -1 1 -1 2.2 M12 17.5 v.5"; on: root.stamp-id == 2; tip: @tr("stamp-question" => "Question"); clicked => { root.set-prop("stamp", 2); } }
                                            SegOption { icon: "M12 5 v9 M12 18 v.5"; on: root.stamp-id == 3; tip: @tr("stamp-exclamation" => "Exclamation"); clicked => { root.set-prop("stamp", 3); } }
                                            SegOption { icon: "M12 3.5 l2.6 5.3 5.9 .9 -4.2 4.1 1 5.8 -5.3 -2.8 -5.3 2.8 1 -5.8 -4.2 -4.1 5.9 -.9 z"; on: root.stamp-id == 4; tip: @tr("stamp-star" => "Star"); clicked => { root.set-prop("stamp", 4); } }
                                            SegOption { icon: "M12 4 L21 19 H3 z M12 10 v4 M12 16.5 v.5"; on: root.stamp-id == 5; tip: @tr("stamp-warning" => "Warning"); clicked => { root.set-prop("stamp", 5); } }
                                    }
                                    Text { height: 18px; text: @tr("stamp-emoji" => "Emoji"); color: Theme.text3; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    // 8 a row: the cell size fits the panel, whatever its width.
                                    Rectangle {
                                        height: 3 * (self.width / 8);
                                        for e[c] in ["😀", "👍", "🔥", "⭐", "❤️", "✅", "⚠️", "🚀", "😂", "😍", "🤔", "😎", "😭", "😡", "🙏", "👏", "👀", "💡", "🎉", "📌", "❌", "❓", "💬", "🐞"]: Rectangle {
                                            x: mod(c, 8) * (parent.width / 8);
                                            y: floor(c / 8) * (parent.width / 8);
                                            width: parent.width / 8 - 2px;
                                            height: parent.width / 8 - 2px;
                                            border-radius: 7px;
                                            background: root.stamp-id == 100 + c ? Theme.control-on : (em-ta.has-hover ? Theme.elevated : transparent);
                                            animate background { duration: 120ms; }
                                            Text { text: e; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                                            em-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.set-prop("stamp", 100 + c); } }
                                        }
                                    }
                                }
                                // ---- Effects (ZK-48): shadow and glow, off / light / strong
                                if root.prop-kind == 0 || root.prop-kind == 1 || root.prop-kind == 2 || root.prop-kind == 4 || root.prop-kind == 7 || root.prop-kind == 8 || root.prop-kind == 9: PropSection {
                                    title: @tr("insp-effects" => "Effects");
                                    PropRow {
                                        label: @tr("insp-effect-shadow" => "Shadow");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { text: @tr("common-off" => "Off"); on: root.shadow-index == 0; clicked => { root.set-prop("shadow", 0); } }
                                            SegOption { text: @tr("insp-effect-light" => "Light"); on: root.shadow-index == 1; clicked => { root.set-prop("shadow", 1); } }
                                            SegOption { text: @tr("insp-effect-strong" => "Strong"); on: root.shadow-index == 2; clicked => { root.set-prop("shadow", 2); } }
                                        }
                                    }
                                    PropRow {
                                        label: @tr("insp-effect-glow" => "Glow");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { text: @tr("common-off" => "Off"); on: root.glow-index == 0; clicked => { root.set-prop("glow", 0); } }
                                            SegOption { text: @tr("insp-effect-light" => "Light"); on: root.glow-index == 1; clicked => { root.set-prop("glow", 1); } }
                                            SegOption { text: @tr("insp-effect-strong" => "Strong"); on: root.glow-index == 2; clicked => { root.set-prop("glow", 2); } }
                                        }
                                    }
                                }
                                // ---- Opacity
                                if root.prop-kind >= 0 && root.prop-kind != 5: PropRow {
                                    label: @tr("insp-opacity" => "Opacity");
                                    HorizontalLayout {
                                        spacing: 8px;
                                        MiniSlider {
                                            value <=> root.alpha;
                                            tip: @tr("insp-opacity" => "Opacity");
                                            moved(v) => { root.set-alpha(v, false); }
                                            released => { root.set-alpha(root.alpha, true); }
                                        }
                                        Text { text: round(root.alpha * 100) + " %"; color: Theme.text2; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; width: 36px; }
                                    }
                                }
                                // ---- Position and size of one selected mark
                                if root.prop-for-selection && root.selection-count == 1 && root.prop-kind == 2: PropSection {
                                    title: @tr("insp-line-points" => "Line ends");
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-x1" => "X1"); value: root.geom-x; committed(v) => { root.set-geom("x1", v); } }
                                        NumField { label: @tr("insp-y1" => "Y1"); value: root.geom-y; committed(v) => { root.set-geom("y1", v); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-x2" => "X2"); value: root.geom-x2; committed(v) => { root.set-geom("x2", v); } }
                                        NumField { label: @tr("insp-y2" => "Y2"); value: root.geom-y2; committed(v) => { root.set-geom("y2", v); } }
                                    }
                                }
                                if root.prop-for-selection && root.selection-count == 1 && root.prop-kind != 2: PropSection {
                                    title: @tr("insp-position" => "Position and size");
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-x" => "X"); value: root.geom-x; committed(v) => { root.set-geom("x", v); } }
                                        NumField { label: @tr("insp-y" => "Y"); value: root.geom-y; committed(v) => { root.set-geom("y", v); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-w" => "W"); value: root.geom-w; committed(v) => { root.set-geom("w", v); } }
                                        NumField { label: @tr("insp-h" => "H"); value: root.geom-h; committed(v) => { root.set-geom("h", v); } }
                                    }
                                }
                                // ---- Arrange (ZK-52)
                                if root.selection-count >= 1: PropSection {
                                    title: @tr("arrange-title" => "Arrange");
                                    PropRow {
                                        label: @tr("arrange-order" => "Order");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M4 4 h16 M12 20 V8 M7 13 l5 -5 5 5"; tip: @tr("arrange-front" => "Bring to front") + "  " + Keys.k("Ctrl+Shift+]", "⇧⌘]"); clicked => { root.arrange(0); } }
                                            SegOption { icon: "M12 19 V5 M6 11 l6 -6 6 6"; tip: @tr("layers-up" => "Bring forward") + "  " + Keys.k("Ctrl+]", "⌘]"); clicked => { root.arrange(2); } }
                                            SegOption { icon: "M12 5 v14 M6 13 l6 6 6 -6"; tip: @tr("layers-down" => "Send backward") + "  " + Keys.k("Ctrl+[", "⌘["); clicked => { root.arrange(3); } }
                                            SegOption { icon: "M4 20 h16 M12 4 v12 M7 11 l5 5 5 -5"; tip: @tr("arrange-back" => "Send to back") + "  " + Keys.k("Ctrl+Shift+[", "⇧⌘["); clicked => { root.arrange(1); } }
                                            Rectangle { width: 6px; }
                                            SegOption { icon: "M9 9 h11 v11 H9 z M15 9 V4 H4 v11 h5"; tip: @tr("common-duplicate" => "Duplicate") + "  " + Keys.k("Ctrl+D", "⌘D"); clicked => { root.duplicate(); } }
                                        }
                                    }
                                    if root.selection-count >= 2: PropRow {
                                        label: @tr("arrange-align" => "Align");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M4 3 v18 M8 7 h9 v3 H8 z M8 14 h13 v3 H8 z"; tip: @tr("arrange-align-left" => "Align left edges"); clicked => { root.align(0); } }
                                            SegOption { icon: "M12 3 v18 M7 7 h10 v3 H7 z M5 14 h14 v3 H5 z"; tip: @tr("arrange-align-hcentre" => "Align vertical centres"); clicked => { root.align(1); } }
                                            SegOption { icon: "M20 3 v18 M7 7 h9 v3 H7 z M3 14 h13 v3 H3 z"; tip: @tr("arrange-align-right" => "Align right edges"); clicked => { root.align(2); } }
                                            SegOption { icon: "M3 4 h18 M7 8 v9 h3 V8 z M14 8 v13 h3 V8 z"; tip: @tr("arrange-align-top" => "Align top edges"); clicked => { root.align(3); } }
                                            SegOption { icon: "M3 12 h18 M7 7 v10 h3 V7 z M14 5 v14 h3 V5 z"; tip: @tr("arrange-align-vcentre" => "Align horizontal centres"); clicked => { root.align(4); } }
                                            SegOption { icon: "M3 20 h18 M7 7 v9 h3 V7 z M14 3 v13 h3 V3 z"; tip: @tr("arrange-align-bottom" => "Align bottom edges"); clicked => { root.align(5); } }
                                        }
                                    }
                                    if root.selection-count >= 2: PropRow {
                                        label: @tr("arrange-distribute" => "Spread");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M3 3 v18 M21 3 v18 M9 8 h6 v8 H9 z"; enabled: root.selection-count >= 3; tip: @tr("arrange-distribute-x" => "Even gaps across"); clicked => { root.distribute(0); } }
                                            SegOption { icon: "M3 3 h18 M3 21 h18 M8 9 h8 v6 H8 z"; enabled: root.selection-count >= 3; tip: @tr("arrange-distribute-y" => "Even gaps down"); clicked => { root.distribute(1); } }
                                            Rectangle { width: 6px; }
                                            SegOption { icon: "M4 4 h7 v7 H4 z M13 13 h7 v7 h-7 z M2 2 h20 v20 H2 z"; tip: @tr("arrange-group" => "Group") + "  " + Keys.k("Ctrl+G", "⌘G"); clicked => { root.group(true); } }
                                            SegOption { icon: "M4 4 h7 v7 H4 z M13 13 h7 v7 h-7 z"; tip: @tr("arrange-ungroup" => "Ungroup") + "  " + Keys.k("Ctrl+Shift+G", "⇧⌘G"); clicked => { root.group(false); } }
                                        }
                                    }
                                }
                            }
                        }
                        // ---- Layers: top of the list = front
                        if root.insp-tab == 1: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 6px;
                            if root.layers.length == 0: Text { text: @tr("layers-empty" => "No annotations yet — draw something on the canvas."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                            // The list, with the lifted copy of a dragged row floating above it.
                            Rectangle {
                                vertical-stretch: 1;
                                lsv := InspScroll {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: start;
                                        for l[i] in root.layers: Rectangle {
                                            height: 32px;
                                            border-radius: 7px;
                                            property <bool> lifted: root.layer-drag-from == i;
                                            property <bool> target: root.layer-drag-from >= 0 && root.layer-drop-row == i;
                                            background: self.target && root.layer-drop-mode == 1 ? #3D7BF540 : (l.selected ? #3D7BF533 : (row-ta.has-hover && root.layer-drag-from < 0 ? Theme.elevated : transparent));
                                            border-width: self.target && root.layer-drop-mode == 1 ? 1.5px : 0;
                                            border-color: Theme.accent;
                                            opacity: self.lifted ? 0.35 : 1;
                                            animate background, opacity { duration: 120ms; }
                                            row-ta := TouchArea {
                                                property <bool> dragging;
                                                mouse-cursor: root.layer-drag-from >= 0 ? MouseCursor.ns-resize : MouseCursor.pointer;
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                        self.dragging = false;
                                                        if (l.is-group) {
                                                            root.layer-group-click(l.id, e.modifiers.shift || e.modifiers.control);
                                                        } else {
                                                            root.layer-click(l.id, e.modifiers.shift || e.modifiers.control);
                                                        }
                                                    }
                                                    if (e.kind == PointerEventKind.up && self.dragging) {
                                                        self.dragging = false;
                                                        root.layer-drag(i, i * 34px + self.mouse-y, 1);
                                                        root.layer-drag-from = -1;
                                                    }
                                                    if (e.kind == PointerEventKind.cancel && self.dragging) {
                                                        self.dragging = false;
                                                        root.layer-drag(i, i * 34px + self.mouse-y, 2);
                                                        root.layer-drag-from = -1;
                                                    }
                                                }
                                                moved => {
                                                    if (self.pressed && !self.dragging && abs(self.mouse-y - self.pressed-y) > 4px) {
                                                        self.dragging = true;
                                                        root.layer-drag-from = i;
                                                    }
                                                    if (self.dragging) {
                                                        root.layer-drag-y = i * 34px + self.mouse-y;
                                                        root.layer-drag(i, root.layer-drag-y, 0);
                                                    }
                                                }
                                            }
                                            // Insertion line above / below the row.
                                            if self.target && root.layer-drop-mode != 1: Rectangle {
                                                x: 4px + l.depth * 18px;
                                                y: root.layer-drop-mode == 0 ? -2px : parent.height;
                                                width: parent.width - self.x - 4px;
                                                height: 2px;
                                                border-radius: 1px;
                                                background: Theme.accent;
                                            }
                                            // Group members hang from a thin guide.
                                            if l.depth > 0: Rectangle { x: 14px; y: -2px; width: 1px; height: parent.height + 4px; background: Theme.line; }
                                            HorizontalLayout {
                                                padding-left: 6px + l.depth * 18px;
                                                padding-right: 2px;
                                                spacing: 6px;
                                                if l.is-group: IconButton {
                                                    width: 20px;
                                                    height: 28px;
                                                    icon: l.collapsed ? "M9 6 l6 6 -6 6" : "M6 9 l6 6 6 -6";
                                                    label: l.collapsed ? @tr("layers-expand-group" => "Expand group") : @tr("layers-collapse-group" => "Collapse group");
                                                    clicked => { root.layer-collapse(l.id); }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Icon { width: 18px; height: 18px; d: KindIcons.paths[l.kind]; tint: l.hidden ? Theme.disabled : (l.is-group ? Theme.accent-text : Theme.text2); }
                                                }
                                                Text { text: l.name; color: l.hidden ? Theme.text3 : Theme.text; font-size: 12px; font-weight: l.is-group ? 600 : 400; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                                if l.is-group: Text { text: l.count; color: Theme.text3; font-size: 11px; vertical-alignment: center; }
                                                IconButton {
                                                    width: 28px;
                                                    height: 28px;
                                                    label: l.hidden ? @tr("layers-show" => "Show") : @tr("layers-hide" => "Hide");
                                                    icon: l.hidden ? "M3 3 l18 18 M10.6 10.6 a2 2 0 0 0 2.8 2.8 M9.9 5.1 A10 10 0 0 1 21 12 a17 17 0 0 1 -2.8 3.6 M6.6 6.6 A17 17 0 0 0 3 12 s3.5 6 9 6 a9 9 0 0 0 3.6 -0.7" : "M2 12 s3.5 -7 10 -7 10 7 10 7 -3.5 7 -10 7 -10 -7 -10 -7 z M9 12 a3 3 0 1 0 6 0 a3 3 0 1 0 -6 0";
                                                    clicked => {
                                                        if (l.is-group) { root.layer-group-eye(l.id); } else { root.layer-eye(l.id); }
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 30px;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                spacing: 6px;
                                                VerticalLayout { alignment: center; Icon { width: 18px; height: 18px; d: KindIcons.paths[9]; tint: Theme.text3; } }
                                                Text { text: @tr("layers-background" => "Screenshot (background) — always at the bottom"); color: Theme.text3; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                            }
                                        }
                                        if root.layers.length > 1: Text { text: @tr("layers-drag-hint" => "Drag a row to change the order; drop it onto another row to group them."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    }
                                }
                                // The row being dragged, lifted: follows the pointer with a shadow.
                                if root.layer-drag-from >= 0 && root.layer-drag-from < root.layers.length: ghost := Rectangle {
                                    property <LayerRow> r: root.layers[root.layer-drag-from];
                                    x: 4px;
                                    y: clamp(lsv.content-y + root.layer-drag-y - 16px, -8px, parent.height - 24px);
                                    width: parent.width - 20px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Theme.elevated;
                                    border-width: 1px;
                                    border-color: Theme.control-on;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-color: #00000090;
                                    // see-through a little: the target's highlight shows under it
                                    opacity: 0.9;
                                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                                    transform-scale: 1.03;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 6px;
                                        VerticalLayout { alignment: center; Icon { width: 18px; height: 18px; d: KindIcons.paths[ghost.r.kind]; tint: Theme.text; } }
                                        Text { text: ghost.r.name; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }
                        // ---- Image (ZK-53): crop, turns, tone, size — a recipe over the original.
                        if root.insp-tab == 2: InspScroll {
                            VerticalLayout {
                                spacing: 18px;
                                alignment: start;
                                // Crop: the panel while the Crop tool is on, a button otherwise.
                                if root.tool == 10: PropSection {
                                    title: @tr("crop-title" => "Crop");
                                    action-icon: "M4.5 12 a7.5 7.5 0 1 0 2.2 -5.3 M4.5 4 v4 h4";
                                    action-tip: @tr("status-crop-whole" => "Crop: whole screenshot");
                                    action => { root.image-action("crop-whole"); }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-w" => "W"); value <=> root.crop-w; committed(v) => { root.set-crop-size("w", v); } }
                                        NumField { label: @tr("insp-h" => "H"); value <=> root.crop-h; committed(v) => { root.set-crop-size("h", v); } }
                                        IconButton { width: 28px; height: 26px; icon: "M8 11 V8 a4 4 0 0 1 8 0 v3 M6 11 h12 v9 H6 z"; active: root.crop-lock; label: @tr("crop-lock-ratio" => "Lock proportions"); clicked => { root.image-action("crop-lock"); } }
                                    }
                                    Text { text: root.crop-sizes; color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                                    if root.crop-outside != "": Text { text: root.crop-outside; color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;
                                        TextButton { text: @tr("common-cancel" => "Cancel"); clicked => { root.image-action("crop-cancel"); } }
                                        TextButton { text: @tr("common-done" => "Done"); primary: true; clicked => { root.image-action("crop-done"); } }
                                    }
                                }
                                if root.tool != 10: PropSection {
                                    title: @tr("shot-crop" => "Crop");
                                    action-icon: root.cropped ? "M4.5 12 a7.5 7.5 0 1 0 2.2 -5.3 M4.5 4 v4 h4" : "";
                                    action-tip: @tr("status-crop-whole" => "Crop: whole screenshot");
                                    action => { root.image-action("crop-whole"); }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        TextButton { text: @tr("shot-crop-button" => "Crop (C)"); icon: "M6 2 v14 a2 2 0 0 0 2 2 h14 M2 6 h14 a2 2 0 0 1 2 2 v14"; clicked => { root.image-action("crop"); } }
                                        Text { text: root.crop-text; color: Theme.text3; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    }
                                }
                                PropSection {
                                    title: @tr("shot-rotate-mirror" => "Rotate and mirror");
                                    HorizontalLayout {
                                        spacing: 2px;
                                        SegOption { icon: "M4 4 v5 h5 M4.6 9 A8 8 0 1 1 5.5 16.5"; tip: @tr("shot-rotate-left" => "Rotate left"); clicked => { root.image-action("rotate-left"); } }
                                        SegOption { icon: "M20 4 v5 h-5 M19.4 9 A8 8 0 1 0 18.5 16.5"; tip: @tr("shot-rotate-right" => "Rotate right"); clicked => { root.image-action("rotate-right"); } }
                                        SegOption { icon: "M12 2 v20 M8.5 6 L2.5 18 h6 z M15.5 6 l6 12 h-6 z"; tip: @tr("shot-mirror-h" => "Mirror horizontally"); clicked => { root.image-action("mirror-h"); } }
                                        SegOption { icon: "M2 12 h20 M6 8.5 L18 2.5 v6 z M6 15.5 l12 6 v-6 z"; tip: @tr("shot-mirror-v" => "Mirror vertically"); clicked => { root.image-action("mirror-v"); } }
                                    }
                                }
                                PropSection {
                                    title: @tr("shot-tone" => "Tone");
                                    action-icon: "M4.5 12 a7.5 7.5 0 1 0 2.2 -5.3 M4.5 4 v4 h4";
                                    action-tip: @tr("shot-tone-reset-tip" => "Back to the tone as captured");
                                    action-enabled: !root.tone-default;
                                    action => { root.image-action("tone-reset"); }
                                    PropRow {
                                        label: @tr("shot-exposure" => "Exposure");
                                        MiniSlider { horizontal-stretch: 1; value <=> root.tone-exposure; tip: @tr("shot-exposure" => "Exposure"); moved(v) => { root.set-tone("exposure", v, false); } released => { root.set-tone("exposure", root.tone-exposure, true); } }
                                        Text { text: root.tone-exposure-text; color: Theme.text2; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; width: 56px; }
                                    }
                                    PropRow {
                                        label: @tr("shot-gamma" => "Gamma");
                                        MiniSlider { horizontal-stretch: 1; value <=> root.tone-gamma; tip: @tr("shot-gamma" => "Gamma"); moved(v) => { root.set-tone("gamma", v, false); } released => { root.set-tone("gamma", root.tone-gamma, true); } }
                                        Text { text: root.tone-gamma-text; color: Theme.text2; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; width: 56px; }
                                    }
                                    PropRow {
                                        label: @tr("shot-contrast" => "Contrast");
                                        MiniSlider { horizontal-stretch: 1; value <=> root.tone-contrast; tip: @tr("shot-contrast" => "Contrast"); moved(v) => { root.set-tone("contrast", v, false); } released => { root.set-tone("contrast", root.tone-contrast, true); } }
                                        Text { text: root.tone-contrast-text; color: Theme.text2; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; width: 56px; }
                                    }
                                    HoldButton { text: @tr("shot-compare" => "Compare"); tip: @tr("shot-compare-tip" => "Hold to see the original frame"); held(on) => { root.compare(on); } }
                                    Text { text: @tr("shot-tone-hint" => "A recipe over the original: the original stays untouched; Compare shows it while you hold."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                }
                                PropSection {
                                    title: @tr("size-image-title" => "Image size");
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-w" => "W"); value <=> root.size-w; committed(v) => { root.size-edited("w", v); } }
                                        NumField { label: @tr("insp-h" => "H"); value <=> root.size-h; committed(v) => { root.size-edited("h", v); } }
                                    }
                                    SwitchRow { text: @tr("size-keep-ratio" => "Keep proportions"); checked <=> root.size-keep; }
                                    SwitchRow { text: @tr("size-scale-text" => "Scale text with the image"); checked <=> root.size-scale-text; }
                                    Text { text: @tr("size-note-image" => "Line widths, counters and stamps keep their size; text scales only with the checkbox above."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        alignment: end;
                                        TextButton { text: @tr("size-apply" => "Resize"); clicked => { root.image-action("size-apply"); } }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: root.info-size; color: Theme.text; font-size: 14px; font-weight: 600; }
                                    Text { text: @tr("meta-source" => "Source"); color: Theme.text3; font-size: 11px; }
                                    Text { text: root.info-source; color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: @tr("meta-taken" => "Date taken"); color: Theme.text3; font-size: 11px; }
                                    Text { text: root.info-taken; color: Theme.text2; font-size: 12px; }
                                }
                                Text { text: root.info-path; color: Theme.text3; font-size: 10px; wrap: word-wrap; }
                            }
                        }
                        // ---- Meta
                        if root.insp-tab == 3: InspScroll {
                            VerticalLayout {
                                spacing: 10px;
                                alignment: start;
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: @tr("meta-title" => "Title"); color: Theme.text3; font-size: 11px; }
                                    LineEdit { text <=> root.meta-title; edited(t) => { root.meta-edited("title", t); } }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: @tr("meta-description" => "Description"); color: Theme.text3; font-size: 11px; }
                                    TextEdit { height: 80px; text <=> root.meta-description; wrap: word-wrap; edited(t) => { root.meta-edited("description", t); } }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: @tr("meta-tags" => "Tags"); color: Theme.text3; font-size: 11px; }
                                    LineEdit { text <=> root.meta-tags; placeholder-text: @tr("meta-add-tag" => "add…"); edited(t) => { root.meta-edited("tags", t); } }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: @tr("meta-author" => "Author"); color: Theme.text3; font-size: 11px; }
                                    LineEdit { text <=> root.meta-author; edited(t) => { root.meta-edited("author", t); } }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: @tr("meta-rights" => "Copyright"); color: Theme.text3; font-size: 11px; }
                                    LineEdit { text <=> root.meta-rights; edited(t) => { root.meta-edited("rights", t); } }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: @tr("meta-taken" => "Date taken"); color: Theme.text3; font-size: 11px; }
                                    Text { text: root.info-taken; color: Theme.text2; font-size: 12px; }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { height: root.over-screen ? 0px : 1px; background: Theme.line; }
            // ---- status bar: size · hint · crop · zoom (fit, slider, %, 100%)
            Rectangle {
                height: root.over-screen ? 0px : 30px;
                visible: !root.over-screen;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 12px;
                    Text { text: root.image-size; color: Theme.text3; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.toast != "" ? root.toast : root.hint; color: root.toast != "" ? Theme.accent-text : Theme.text2; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: root.crop-text; color: Theme.text3; font-size: 12px; vertical-alignment: center; }
                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;
                        SmallButton { icon: "M4 9 V4 h5 M15 4 h5 v5 M20 15 v5 h-5 M9 20 H4 v-5"; tip: @tr("status-fit" => "Fit to window") + "  " + Keys.k("Ctrl+0", "⌘0"); clicked => { root.zoom-fit(); } }
                        MiniSlider {
                            width: 120px;
                            value <=> root.zoom-pos;
                            tip: @tr("status-zoom" => "Zoom");
                            moved(v) => { root.zoom-to(v); }
                        }
                        Text { text: root.zoom-text; color: Theme.text; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; width: 44px; }
                        SmallButton { text: "100%"; tip: @tr("status-zoom-100" => "Zoom 100 %") + "  " + Keys.k("Ctrl+1", "⌘1"); clicked => { root.zoom-100(); } }
                    }
                }
            }
        }
    }

    // ---- resize edges of the frameless window (Windows)
    if root.custom-frame && !root.win-maximized && !root.over-screen: Rectangle {
        property <length> e: 5px;
        ResizeEdge { x: 0; y: 0; width: parent.width; height: parent.e; dir: 1; mouse-cursor: ns-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: parent.height - parent.e; width: parent.width; height: parent.e; dir: 4; mouse-cursor: ns-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: 0; width: parent.e; height: parent.height; dir: 7; mouse-cursor: ew-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: parent.width - parent.e; y: 0; width: parent.e; height: parent.height; dir: 0; mouse-cursor: ew-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: 0; width: 10px; height: 10px; dir: 3; mouse-cursor: nwse-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: parent.width - 10px; y: 0; width: 10px; height: 10px; dir: 2; mouse-cursor: nesw-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: parent.height - 10px; width: 10px; height: 10px; dir: 6; mouse-cursor: nesw-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px; dir: 5; mouse-cursor: nwse-resize; resize(d) => { root.window-resize(d); } }
    }

    // ---- in-window dialog (owner, 28.09): questions in the app's own look, not the system box.
    // A scrim swallows the clicks; the card springs in; Enter = the primary button, Esc = cancel.
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-body;
    in property <[string]> dialog-buttons;
    in property <int> dialog-primary: -1;
    in property <int> dialog-cancel: -1;
    callback dialog-answer(int);
    changed dialog-open => {
        if (root.dialog-open) {
            Tip.armed = false;
            dialog-keys.focus();
        }
    }
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000088;
        opacity: root.dialog-open ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 160ms; easing: ease-out; }
        TouchArea { }
        dialog-keys := FocusScope {
            enabled: root.dialog-open;
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.dialog-answer(root.dialog-cancel);
                } else if (e.text == Key.Return) {
                    root.dialog-answer(root.dialog-primary);
                }
                accept
            }
        }
        Rectangle {
            width: min(440px, root.width - 32px);
            height: dialog-lay.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 20px;
            border-radius: 14px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.control-on;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000A0;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: root.dialog-open ? 1.0 : 0.92;
            animate transform-scale { duration: 260ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.12); }
            TouchArea { }
            dialog-lay := VerticalLayout {
                padding: 22px;
                padding-bottom: 18px;
                spacing: 8px;
                Text { text: root.dialog-title; color: Theme.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
                if root.dialog-body != "": Text { text: root.dialog-body; color: Theme.text2; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout {
                    padding-top: 14px;
                    spacing: 8px;
                    alignment: end;
                    for b[i] in root.dialog-buttons: TextButton {
                        text: b;
                        primary: i == root.dialog-primary;
                        clicked => { root.dialog-answer(i); }
                    }
                }
            }
        }
    }

    // ---- tooltip bubble (drawn last: above everything but popups)
    property <bool> tip-show: false;
    property <int> tip-serial: Tip.serial;
    property <bool> tip-armed: Tip.armed;
    changed tip-serial => { root.tip-show = false; }
    changed tip-armed => { if (!root.tip-armed) { root.tip-show = false; } }
    Timer {
        interval: 550ms;
        running: root.tip-armed && !root.tip-show;
        triggered => { root.tip-show = true; }
    }
    Rectangle {
        opacity: root.tip-show ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 130ms; easing: ease-out; }
        width: tip-text.preferred-width + 18px;
        height: 26px;
        x: clamp(Tip.side == 1 ? Tip.ax + 8px : Tip.ax - self.width / 2, 4px, max(4px, root.width - self.width - 4px));
        y: clamp(Tip.side == 0 ? Tip.ay + 6px : (Tip.side == 2 ? Tip.ay - self.height - 6px : Tip.ay - self.height / 2), 4px, max(4px, root.height - self.height - 4px));
        border-radius: 7px;
        background: Theme.tip-bg;
        border-width: 1px;
        border-color: Theme.control-on;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000080;
        tip-text := Text { text: Tip.text; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
    }
}
