// Znimok — first working prototype of the application UI (ZK-46/47/59).
// Layout follows the design mock-up (Design artifact v17): library as the home screen; editor
// with a top bar (back, Open, title, autosave, undo/redo, Copy ▾), a tool rail, the canvas, an
// inspector and a status bar. Strings come from i18n/*.ftl through @tr (ZK-29).
// Not yet here: tabs, overlay editor, full inspector, settings (see the tickets of Phase 4).

import { AboutSlint, LineEdit, ListView, Palette as StdPalette, ScrollView, TextEdit } from "std-widgets.slint";
// Bundled faces (ZK-34, SIL OFL 1.1): Onest for the interface and the marks, JetBrains Mono for
// numbers and key combinations, Unbounded for the Znimok wordmark only.
import "../../znimok-render/fonts/Onest.ttf";
import "../../znimok-render/fonts/JetBrainsMono.ttf";
import "../../znimok-render/fonts/Unbounded.ttf";

// Light and dark (ZK-46): "as the system" by default, or chosen in the settings. The capture
// overlay is always dark (decision of 28.09: it sits over any screen), so it sets mode 2.
// Neutrals lean a little blue, like the accent; the light theme keeps text at ≥ 7:1 on panels.
export global Theme {
    // 0 as the system, 1 light, 2 dark.
    in-out property <int> mode: 0;
    // What the system uses now (from winit: at start and on every change).
    in-out property <bool> system-dark: true;
    out property <bool> dark: root.mode == 2 || (root.mode == 0 && root.system-dark);
    out property <color> canvas: root.dark ? #0B0D11 : #E3E6EB;
    out property <color> app: root.dark ? #0F1115 : #F4F5F7;
    out property <color> panel: root.dark ? #171A20 : #FFFFFF;
    out property <color> elevated: root.dark ? #1E2229 : #EEF0F3;
    out property <color> control-on: root.dark ? #2A2F38 : #DCE0E6;
    out property <color> line: root.dark ? #22262E : #E3E6EA;
    out property <color> text: root.dark ? #E8EAEE : #15181D;
    out property <color> text2: root.dark ? #A7ADB8 : #4A515C;
    out property <color> text3: root.dark ? #6F7682 : #7A818C;
    out property <color> accent: #3D7BF5;
    out property <color> accent-text: root.dark ? #8FB6FF : #2458C6;
    out property <color> attention: root.dark ? #FFD23F : #A36A00;
    out property <color> ok: root.dark ? #34C48A : #178A5B;
    out property <color> disabled: root.dark ? #4A505A : #B4B9C1;
    // A hovered control, a swatch's rim, the tooltip bubble.
    out property <color> hover: root.dark ? #FFFFFF0D : #0000000A;
    out property <color> swatch-rim: root.dark ? #FFFFFF22 : #00000029;
    out property <color> tip-bg: root.dark ? #0B0D11F2 : #FFFFFFF7;
}

export struct CardData {
    name: string,
    meta: string,
    thumb: image,
    path: string,
    // Picked with Shift / Ctrl (ZK-176).
    selected: bool,
    // Pinned (ZK-178); the keyboard's card (ZK-179).
    pinned: bool,
    current: bool,
    // Its place in the grid (ZK-177, from Rust): group titles up to its own, card rows above
    // its row, its column.
    hb: int,
    rb: int,
    col: int,
}

// The video timeline (ZK-181): a ruler label, a piece of the film strip (kind 0 cut out,
// 1 outside in/out, 2 the selected part, 3 the selected range), a sound track's row.
export struct TlTick { x: length, label: string }
export struct TlPiece { x: length, w: length, kind: int }
// A mark's bar on the marks track (ZK-94): its time in track pixels, lane, colour.
export struct TlMark { id: int, x: length, w: length, lane: int, colour: color, selected: bool }
export struct VidTrack { label: string, colour: color, muted: bool, volume: int }
// The DevTools log (ZK-191): a tick of the log lane (cls 0 network and the rest, 1 navigation,
// 2 dataLayer, 3 warning, 4 error), a filter chip, a row of the list, a phase of a request's timing.
export struct DevTick { x: length, cls: int }
export struct DevChip { label: string, count: int }
export struct DevRow { time: string, label: string, text: string, src: string, cls: int }
export struct DevTiming { label: string, a: float, w: float, ms: string }
// Sharing targets (ZK-101): a webhook on the integrations page, and the targets «Send to» offers.
export struct IntWebhook { id: string, enabled: bool, name: string, url: string, header: string, secret-set: bool, status: string, busy: bool }
export struct IntTarget { key: string, name: string }
export struct IntGoogleAccount { id: string, email: string, active: bool }

// A group title in the library grid (ZK-177): titles and card rows above it.
export struct LibHeader {
    title: string,
    hb: int,
    rb: int,
}

component Icon inherits Path {
    in property <string> d;
    in property <color> tint: Theme.text2;
    commands: d;
    stroke: tint;
    stroke-width: 1.75px;
    fill: transparent;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 20px;
    height: 20px;
}

// ---------------------------------------------------------------------------------------------
// Tooltips (owner, 28.09): any control with a `tip` shows it after a short hover, beside the
// control, fading in. One shared bubble drawn at the end of AppWindow.
export global Tip {
    in-out property <string> text;
    // Anchor in window coordinates and which side of it the bubble goes: 0 below, 1 right, 2 above.
    in-out property <length> ax;
    in-out property <length> ay;
    in-out property <int> side;
    in-out property <bool> armed;
    in-out property <int> serial;
}

// Shortcuts as each system writes them (ZK-60): "Ctrl+Shift+Z" on Windows, "⇧⌘Z" on macOS.
export global Keys {
    in property <bool> mac;
    // Last way the picture left the editor, repeated by Enter: 0 copy, 1 export.
    in property <int> last-share;
    public pure function k(win: string, mac: string) -> string {
        return self.mac ? mac : win;
    }
}

// A TouchArea that arms the shared tooltip while hovered.
component TipTouch inherits TouchArea {
    in property <string> tip;
    in property <int> tip-side: 0;
    // What can be clicked shows the pointing hand (owner, 29.09); users of TipTouch that are
    // not buttons (sliders, the drag handle of Copy) set their own.
    mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
    property <int> mine: -1;
    changed has-hover => {
        if (self.has-hover && root.tip != "") {
            Tip.text = root.tip;
            Tip.side = root.tip-side;
            Tip.ax = root.tip-side == 1 ? self.absolute-position.x + self.width : self.absolute-position.x + self.width / 2;
            Tip.ay = root.tip-side == 0 ? self.absolute-position.y + self.height : (root.tip-side == 2 ? self.absolute-position.y : self.absolute-position.y + self.height / 2);
            Tip.serial += 1;
            root.mine = Tip.serial;
            Tip.armed = true;
        } else if (!self.has-hover && Tip.serial == root.mine) {
            Tip.armed = false;
        }
    }
    changed pressed => {
        if (self.pressed) { Tip.armed = false; }
    }
}

// Small "open menu" chevron, drawn at its real size (not a scaled 24 px icon).
component Chevron inherits Path {
    in property <color> tint: Theme.text2;
    commands: "M1 1.5 L5 5.5 L9 1.5";
    viewbox-width: 10;
    viewbox-height: 7;
    width: 10px;
    height: 7px;
    stroke: tint;
    stroke-width: 1.6px;
    fill: transparent;
}

// Top-bar button: optional icon, text, optional chevron; 32 px high, content centred.
component BarButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> chevron;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked;
    height: 32px;
    width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: ta.has-hover && root.enabled ? Theme.elevated : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.95 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    accessible-role: button;
    accessible-label: root.text;
    row := HorizontalLayout {
        padding-left: root.icon != "" ? 6px : 10px;
        padding-right: root.chevron ? 8px : 10px;
        spacing: 6px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { d: root.icon; tint: root.enabled ? Theme.text2 : Theme.disabled; }
        }
        Text { text: root.text; color: root.enabled ? Theme.text2 : Theme.disabled; font-size: 13px; font-weight: 500; vertical-alignment: center; wrap: no-wrap; }
        if root.chevron: VerticalLayout {
            alignment: center;
            Chevron { }
        }
    }
    ta := TipTouch {
        tip: root.tip;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Small status-bar button: the same box for an icon ("Fit") and for text ("100%").
component SmallButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    height: 22px;
    width: root.icon != "" ? 28px : max(28px, label.preferred-width + 14px);
    horizontal-stretch: 0;
    border-radius: 6px;
    background: ta.has-hover && root.enabled ? Theme.control-on : Theme.elevated;
    animate background { duration: 120ms; easing: ease-out; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.92 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    if root.icon != "": Icon { width: 14px; height: 14px; d: root.icon; tint: Theme.text2; }
    label := Text {
        visible: root.icon == "";
        text: root.text;
        color: Theme.text2;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TipTouch {
        tip: root.tip;
        tip-side: 2;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One option of a segmented control (thickness, line style, corners, heads, tabs…).
component SegOption inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> on;
    in property <string> tip;
    in property <bool> enabled: true;
    // Line-thickness preview: a bar this thick instead of text or an icon.
    in property <length> bar: 0px;
    callback clicked;
    height: 28px;
    horizontal-stretch: 1;
    border-radius: 7px;
    background: root.on ? Theme.control-on : (ta.has-hover && root.enabled ? Theme.hover : Theme.elevated);
    animate background { duration: 140ms; easing: ease-out; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.94 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    if root.icon != "": Icon { width: 18px; height: 18px; d: root.icon; tint: root.on ? Theme.text : (root.enabled ? Theme.text2 : Theme.disabled); }
    if root.bar > 0: Rectangle {
        width: parent.width * 0.55;
        height: root.bar;
        border-radius: root.bar / 2;
        background: root.on ? Theme.text : Theme.text2;
    }
    if root.icon == "" && root.bar == 0: Text {
        text: root.text;
        color: root.on ? Theme.text : (root.enabled ? Theme.text2 : Theme.disabled);
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TipTouch {
        tip: root.tip;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Colour chip; `none` draws the "no colour" slash.
component Swatch inherits Rectangle {
    in property <color> c;
    in property <bool> on;
    in property <bool> none;
    in property <string> tip;
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: root.none ? Theme.elevated : root.c;
    border-width: root.on ? 2px : 1px;
    border-color: root.on ? Theme.text : Theme.swatch-rim;
    animate border-width { duration: 140ms; easing: ease-out; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.88 : (ta.has-hover ? 1.08 : 1.0);
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    if root.none: Path {
        commands: "M5 19 L19 5";
        viewbox-width: 24;
        viewbox-height: 24;
        width: parent.width;
        height: parent.height;
        stroke: #FF5A5F;
        stroke-width: 1.6px;
    }
    ta := TipTouch {
        tip: root.tip;
        clicked => { root.clicked(); }
    }
}

// Slider 0…1 with a knob that grows under the finger.
component MiniSlider inherits Rectangle {
    in-out property <float> value;
    in property <string> tip;
    callback moved(float);
    callback released();
    height: 22px;
    min-width: 60px;
    function set-from(x: length) {
        root.value = clamp(x / max(1px, root.width), 0, 1);
        root.moved(root.value);
    }
    Rectangle { x: 0; y: (parent.height - 4px) / 2; height: 4px; width: parent.width; border-radius: 2px; background: Theme.control-on; }
    Rectangle { x: 0; y: (parent.height - 4px) / 2; height: 4px; width: parent.width * root.value; border-radius: 2px; background: Theme.accent; }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: white;
        x: (parent.width - self.width) * root.value;
        y: (parent.height - self.height) / 2;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000080;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: ta.pressed ? 1.3 : (ta.has-hover ? 1.12 : 1.0);
        animate transform-scale { duration: 150ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    ta := TipTouch {
        tip: root.tip;
        tip-side: 2;
        // Only left and right: a two-way arrow (Windows draws "grab" as four arrows, owner 29.09).
        mouse-cursor: MouseCursor.ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.set-from(self.mouse-x); }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => {
            if (self.pressed) { root.set-from(self.mouse-x); }
        }
    }
}

// Numeric field with a label in front (X, Y, W, H).
component NumField inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;
    callback committed(string);
    spacing: 4px;
    Text { text: root.label; color: Theme.text3; font-size: 11px; vertical-alignment: center; width: 18px; }
    Rectangle {
        height: 26px;
        horizontal-stretch: 1;
        border-radius: 6px;
        background: Theme.elevated;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.control-on;
        animate border-color { duration: 120ms; }
        input := TextInput {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            vertical-alignment: center;
            color: Theme.text;
            font-size: 12px;
            input-type: number;
            font-family: "JetBrains Mono";
            text <=> root.value;
            accepted => { root.committed(self.text); }
            changed has-focus => { if (!self.has-focus) { root.committed(self.text); } }
        }
    }
}

// The colour picker (ZK-160) talks to the app through this: a colour for a control ("color",
// "fill", "outline", "digit"), a typed hex code, the eyedropper; the app keeps the recent colours.
export global ColourPick {
    in property <[color]> recent;
    callback pick(string, color);
    callback hex-entered(string, string);
    callback eyedrop(string);
    pure callback hex(color) -> string;
}

// Palette shared by the stroke and fill rows.
global Palette {
    out property <[color]> colors: [#FF5A5F, #FF8A3D, #FFD23F, #34C48A, #3D7BF5, #9B5CF5, #FFFFFF, #14161A];
    // The marker's inks (ZK-171, as Little Helpers): bright under multiply.
    out property <[color]> marker: [#FFFF00, #00FF00, #FF00FF, #00FFFF];
}

// A format card of the export sheet (ZK-187).
export struct ExportCard {
    title: string,
    sub: string,
    desc: string,
    estimate: string,
    enabled: bool,
}

export struct LayerRow {
    // Mark id, or the group id on a group's header row.
    id: int,
    name: string,
    kind: int,
    hidden: bool,
    selected: bool,
    // Group header (kind 10) and its members (depth 1) — ZK-54.
    is-group: bool,
    depth: int,
    collapsed: bool,
    count: int,
}

// Icons of the mark kinds (layers list), in the order of `prop-kind` / LayerRow.kind:
// rectangle, ellipse, line, pen, text, hide, marker, counter, stamp, image.
global KindIcons {
    out property <[string]> paths: [
        "M6 5 h12 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 V7 a2 2 0 0 1 2 -2 z",
        "M4 12 a8 6 0 1 0 16 0 a8 6 0 1 0 -16 0 z",
        "M4 20 L20 4 M11 4 h9 v9",
        "M15.5 4.5 a2.1 2.1 0 0 1 3 3 L8 18 l-4 1 1 -4 z M13.5 6.5 l3 3 M12 20 q2 -3 4 0 t4 0",
        "M5 6 h14 M12 6 v14",
        "M3 3 l18 18 M10.6 10.6 a2 2 0 0 0 2.8 2.8 M9.9 5.1 A10 10 0 0 1 21 12 a17 17 0 0 1 -2.8 3.6 M6.6 6.6 A17 17 0 0 0 3 12 s3.5 6 9 6 a9 9 0 0 0 3.6 -0.7",
        "M14 3.5 L20.5 10 L13 17.5 L6.5 11 Z M6.5 11 L4 16.5 L7.5 20 L13 17.5 M16.5 6 L10 12.5 M3 22.3 h9",
        "M3 12 a9 9 0 1 0 18 0 a9 9 0 1 0 -18 0 z M10.5 9 l2 -1.2 V16",
        "M8 12 V7 a4 4 0 0 1 8 0 v5 M5 12 h14 v4 H5 z M7 16 v4 h10 v-4",
        "M5 5 h14 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 V7 a2 2 0 0 1 2 -2 z M7 10 a1.5 1.5 0 1 0 3 0 a1.5 1.5 0 1 0 -3 0 M4 17 l5 -5 4 4 3 -3 4 4",
        // 10: a group (folder)
        "M3 7 a2 2 0 0 1 2 -2 h4 l2 2 h8 a2 2 0 0 1 2 2 v8 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 z",
    ];
}

// ---------------------------------------------------------------------------------------------
// Own title bar (owner, 28.09: "the header must be ours and follow the window's theme").
// Windows: no system frame; our bars carry minimise / maximise / close on the right, the empty
// part of a bar drags the window, a double click maximises, the edges resize it.
// macOS: the system traffic lights stay (native), over a transparent title bar; our bars leave
// room for them on the left.

// Empty part of a bar: drags the window, double click = maximise / restore.
component DragArea inherits TouchArea {
    callback drag();
    callback toggle();
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.drag(); }
    }
    double-clicked => { root.toggle(); }
}

component WindowButton inherits Rectangle {
    in property <string> icon;
    in property <bool> danger;
    in property <string> tip;
    callback clicked;
    width: 46px;
    background: ta.has-hover ? (root.danger ? #E81123 : Theme.elevated) : transparent;
    animate background { duration: 100ms; }
    Icon { width: 14px; height: 14px; d: root.icon; tint: ta.has-hover && root.danger ? white : Theme.text2; }
    ta := TipTouch { tip: root.tip; clicked => { root.clicked(); } }
}

component WindowControls inherits HorizontalLayout {
    in property <bool> maximized;
    width: 138px;
    spacing: 0px;
    callback minimize();
    callback toggle();
    callback close();
    WindowButton { icon: "M5 12 h14"; clicked => { root.minimize(); } }
    WindowButton {
        icon: root.maximized ? "M8 8 h11 v11 H8 z M5 16 V5 h11" : "M5.5 5.5 h13 v13 h-13 z";
        clicked => { root.toggle(); }
    }
    WindowButton { icon: "M6 6 l12 12 M18 6 l-12 12"; danger: true; clicked => { root.close(); } }
}

// Invisible resize edge of a frameless window (Windows).
component ResizeEdge inherits TouchArea {
    in property <int> dir;
    callback resize(int);
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.resize(root.dir); }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <string> label;
    // Tooltip text (defaults to the label) and side: 0 below, 1 right, 2 above.
    in property <string> tip: root.label;
    in property <int> tip-side: 0;
    callback clicked;
    callback hovered(bool);
    width: 36px;
    height: 32px;
    border-radius: 8px;
    background: active ? Theme.control-on : (ta.has-hover && enabled ? Theme.elevated : transparent);
    accessible-role: button;
    accessible-label: label;
    // Tactile press: a quick dip and back (iOS-like).
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.94 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    animate background { duration: 120ms; easing: ease-out; }

    Icon {
        d: icon;
        tint: !enabled ? Theme.disabled : (active ? Theme.text : Theme.text2);
    }
    ta := TipTouch {
        tip: root.tip;
        tip-side: root.tip-side;
        enabled: root.enabled;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    out property <bool> hover: ta.has-hover;
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: primary ? (enabled ? (ta.has-hover ? #5189F7 : Theme.accent) : Theme.control-on) : (ta.has-hover && enabled ? Theme.elevated : transparent);
    // Tactile press: a quick dip and back (iOS-like).
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.94 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    animate background { duration: 120ms; easing: ease-out; }

    border-width: primary ? 0 : 1px;
    border-color: Theme.control-on;
    accessible-role: button;
    accessible-label: text;
    lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            d: root.icon;
            tint: primary ? white : (enabled ? Theme.text : Theme.disabled);
        }
        Text {
            text: root.text;
            color: primary ? white : (enabled ? Theme.text : Theme.disabled);
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

component MenuItemRow inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    border-radius: 8px;
    background: ta.has-hover && enabled ? Theme.control-on : transparent;
    animate background { duration: 100ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        // A label longer than the menu ends with «…» instead of running past its edge.
        Text { text: root.text; color: enabled ? Theme.text : Theme.disabled; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; wrap: no-wrap; overflow: elide; min-width: 0px; }
        Text { text: root.shortcut; color: Theme.text3; font-size: 11px; vertical-alignment: center; wrap: no-wrap; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// A sound device to record from (ZK-189): the name of the chosen one, a menu of the others.
component DeviceRow inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> names;
    in property <int> current;
    callback picked(int);
    spacing: 10px;
    Text { text: root.label; color: Theme.text2; font-size: 12px; vertical-alignment: center; width: 120px; }
    pick := Rectangle {
        height: 30px;
        horizontal-stretch: 1;
        border-radius: 8px;
        background: pick-ta.has-hover ? Theme.hover : Theme.elevated;
        animate background { duration: 120ms; }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 8px;
            spacing: 6px;
            Text { text: root.names[root.current]; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Path { width: 10px; height: 6px; y: (parent.height - self.height) / 2; commands: "M0 0 L5 5 L10 0"; stroke: Theme.text2; stroke-width: 1.5px; fill: transparent; }
        }
        pick-ta := TouchArea { clicked => { menu.show(); } }
        menu := PopupWindow {
            x: 0;
            y: parent.height + 4px;
            width: pick.width;
            Rectangle {
                background: Theme.elevated;
                border-radius: 12px;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000080;
                VerticalLayout {
                    padding: 6px;
                    for n[i] in root.names: MenuItemRow { text: (i == root.current ? "✓  " : "     ") + n; clicked => { root.picked(i); } }
                }
            }
        }
    }
}

// Check box: a rounded square that fills with the accent and draws its tick (tactile press).
component CheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled;
    // The row is one target: box and caption (a TouchArea inside a layout would be a cell of its
    // own, zero wide — the first version never got the click).
    width: row.preferred-width;
    height: max(20px, row.preferred-height);
    row := HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: root.checked ? Theme.accent : transparent;
            border-width: root.checked ? 0 : 1.5px;
            border-color: Theme.text3;
            animate background { duration: 140ms; easing: ease-out; }
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: ta.pressed ? 0.88 : 1.0;
            animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            if root.checked: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M6 12.5 l4 4 L18 8";
                stroke: white;
                stroke-width: 2.4px;
                fill: transparent;
            }
        }
        Text { text: root.text; color: Theme.text2; font-size: 12px; vertical-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component Switch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled;
    width: 32px;
    height: 18px;
    border-radius: 9px;
    background: checked ? Theme.accent : Theme.control-on;
    accessible-role: switch;
    accessible-checked: checked;
    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: white;
        animate x { duration: 160ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// ---------------------------------------------------------------------------------------------
// Object panel building blocks: a section with a small caption (and an optional action on the
// right), a row with a 60 px label column, and a colour row with room for the colour picker.

// Scrolling column of the inspector. The content takes the viewport's width (minus a gutter
// for the vertical bar), never its own preferred width: no horizontal scrolling, text wraps,
// the bar never covers a control (owner, 29.09).
component InspScroll inherits ScrollView {
    in property <length> spacing: 14px;
    vertical-stretch: 1;
    // Never sideways (owner, 29.09): the viewport would otherwise take the content's minimum
    // width and show a horizontal bar even when everything fits the panel.
    content-width: self.visible-width;
    VerticalLayout {
        x: 0;
        width: max(120px, root.visible-width - 12px);
        spacing: root.spacing;
        alignment: start;
        @children
    }
}

component PropSection inherits VerticalLayout {
    in property <string> title;
    in property <string> action-icon;
    in property <string> action-tip;
    in property <bool> action-enabled: true;
    callback action();
    spacing: 8px;
    HorizontalLayout {
        height: 22px;
        Text { text: root.title; color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; vertical-alignment: center; horizontal-stretch: 1; }
        if root.action-icon != "": IconButton { width: 26px; height: 22px; icon: root.action-icon; label: root.action-tip; enabled: root.action-enabled; clicked => { root.action(); } }
    }
    @children
}

component PropRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text { text: root.label; color: Theme.text3; font-size: 11px; vertical-alignment: center; width: 60px; overflow: elide; }
    @children
}

// Palette chips plus, at the right, the chip that opens the colour picker (ZK-160): a
// saturation/brightness square, a hue strip, the hex code, the eyedropper and recent colours.
// A colour off the palette (`selected` -2) shows inside that chip.
component ColourRow inherits Rectangle {
    in property <int> selected: -1;
    in property <bool> with-none;
    in property <string> none-tip;
    // Which colour this row sets, for the picker, and the colour it has now.
    in property <string> key: "color";
    in property <color> current;
    // The chips offered: the common palette, or a tool's own (the marker's, ZK-171).
    in property <[color]> colors: Palette.colors;
    callback picked(int);
    // Ten columns in every row (none, eight colours, the picker at the right edge), so rows line
    // up under each other whether or not they offer "none" (owner, 29.09).
    property <length> cell: min(27px, self.width / 10);
    property <length> chip: min(22px, self.cell - 3px);
    // The picker's colour while it is open: hue 0–360, saturation and value 0–1.
    property <float> h;
    property <float> s;
    property <float> v;
    property <string> hex-text;
    property <color> picked-colour: Colors.hsv(self.h, self.s, self.v);
    function load() {
        if (root.selected == -1) {
            root.h = 0;
            root.s = 0;
            root.v = 1;
        } else {
            root.h = root.current.to-hsv().hue;
            root.s = root.current.to-hsv().saturation;
            root.v = root.current.to-hsv().value;
        }
        root.hex-text = ColourPick.hex(root.picked-colour);
    }
    function commit() {
        root.hex-text = ColourPick.hex(root.picked-colour);
        ColourPick.pick(root.key, root.picked-colour);
    }
    // A colour set from outside (the hex field, the eyedropper, undo) moves the picker there.
    changed current => {
        if (root.selected != -1 && root.current != root.picked-colour) {
            root.load();
        }
    }
    height: 24px;
    if root.with-none: Swatch { x: 0; y: (parent.height - self.height) / 2; width: root.chip; height: root.chip; none: true; on: root.selected == -1; tip: root.none-tip; clicked => { root.picked(-1); } }
    for c[i] in root.colors: Swatch { x: (i + 1) * root.cell; y: (parent.height - self.height) / 2; width: root.chip; height: root.chip; c: c; on: root.selected == i; clicked => { root.picked(i); } }
    pick-chip := Rectangle {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: root.chip;
        height: root.chip;
        border-radius: 7px;
        background: @linear-gradient(135deg, #FF5A5F 0%, #FFD23F 30%, #34C48A 55%, #3D7BF5 80%, #9B5CF5 100%);
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: pick-ta.pressed ? 0.88 : (pick-ta.has-hover ? 1.08 : 1.0);
        animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        // A colour of its own shows inside the rainbow ring; otherwise the pipette icon.
        Rectangle {
            x: root.selected == -2 ? 3px : 2px;
            y: self.x;
            width: parent.width - 2 * self.x;
            height: parent.height - 2 * self.y;
            border-radius: 5px;
            background: root.selected == -2 ? root.current : Theme.panel;
            border-width: root.selected == -2 ? 1px : 0px;
            border-color: Theme.panel;
        }
        if root.selected != -2: Icon { width: 12px; height: 12px; d: "M3 21 l6 -6 M15 3 l6 6 -9 9 -6 -6 z M13 5 l6 6"; tint: Theme.text2; }
        pick-ta := TipTouch {
            tip: @tr("colour-picker" => "Colour picker");
            clicked => {
                root.load();
                picker.show();
            }
        }
    }
    picker := PopupWindow {
        x: root.width - 236px;
        y: root.height + 6px;
        width: 236px;
        close-policy: close-on-click-outside;
        // Opens with a quick fade and grow from the chip's corner (owner: tactile motion).
        Rectangle {
            property <bool> shown;
            init => { self.shown = true; }
            opacity: self.shown ? 1 : 0;
            transform-scale: self.shown ? 1 : 0.94;
            transform-origin: { x: self.width - 12px, y: 0 };
            animate opacity { duration: 140ms; easing: ease-out; }
            animate transform-scale { duration: 180ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        Rectangle {
            background: Theme.panel;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.swatch-rim;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000060;
        }
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            // Saturation → right, brightness → up, in the hue below.
            sv := Rectangle {
                height: 132px;
                border-radius: 8px;
                clip: true;
                background: Colors.hsv(root.h, 1, 1);
                Rectangle { background: @linear-gradient(90deg, #FFFFFF 0%, #FFFFFF00 100%); }
                Rectangle { background: @linear-gradient(180deg, #00000000 0%, #000000 100%); }
                Rectangle {
                    x: root.s * parent.width - self.width / 2;
                    y: (1 - root.v) * parent.height - self.height / 2;
                    width: sv-ta.pressed ? 18px : 14px;
                    height: self.width;
                    animate width { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    border-radius: self.width / 2;
                    border-width: 2px;
                    border-color: #FFFFFF;
                    background: root.picked-colour;
                    drop-shadow-blur: 3px;
                    drop-shadow-color: #00000080;
                }
                sv-ta := TouchArea {
                    function at() {
                        root.s = clamp(self.mouse-x / self.width, 0, 1);
                        root.v = 1 - clamp(self.mouse-y / self.height, 0, 1);
                        root.hex-text = ColourPick.hex(root.picked-colour);
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) { self.at(); }
                        if (e.kind == PointerEventKind.up) { root.commit(); }
                    }
                    moved => { self.at(); }
                }
            }
            hue := Rectangle {
                height: 14px;
                border-radius: 7px;
                background: @linear-gradient(90deg, #FF0000 0%, #FFFF00 16.67%, #00FF00 33.33%, #00FFFF 50%, #0000FF 66.67%, #FF00FF 83.33%, #FF0000 100%);
                Rectangle {
                    x: root.h / 360 * (parent.width - self.width);
                    y: (parent.height - self.height) / 2;
                    width: hue-ta.pressed ? 18px : 16px;
                    height: self.width;
                    animate width { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    border-radius: self.width / 2;
                    border-width: 2px;
                    border-color: #FFFFFF;
                    background: Colors.hsv(root.h, 1, 1);
                    drop-shadow-blur: 3px;
                    drop-shadow-color: #00000080;
                }
                hue-ta := TouchArea {
                    function at() {
                        root.h = clamp(self.mouse-x / self.width, 0, 1) * 360;
                        if (root.s == 0 && root.v == 1) {
                            // From white a hue alone would change nothing: show it at full strength.
                            root.s = 1;
                        }
                        root.hex-text = ColourPick.hex(root.picked-colour);
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) { self.at(); }
                        if (e.kind == PointerEventKind.up) { root.commit(); }
                    }
                    moved => { self.at(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                height: 28px;
                Rectangle {
                    width: 28px;
                    border-radius: 7px;
                    background: root.picked-colour;
                    border-width: 1px;
                    border-color: Theme.swatch-rim;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: Theme.elevated;
                    border-width: 1px;
                    border-color: hex-input.has-focus ? Theme.accent : Theme.control-on;
                    animate border-color { duration: 120ms; }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 6px;
                        Text { text: @tr("colour-hex" => "HEX"); color: Theme.text3; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                        hex-input := TextInput {
                            vertical-alignment: center;
                            color: Theme.text;
                            font-size: 12px;
                            font-family: "JetBrains Mono";
                            single-line: true;
                            text <=> root.hex-text;
                            accepted => { ColourPick.hex-entered(root.key, self.text); }
                        }
                    }
                }
                IconButton {
                    width: 28px;
                    height: 28px;
                    icon: "M3 21 l6 -6 M15 3 l6 6 -9 9 -6 -6 z M13 5 l6 6";
                    label: @tr("colour-eyedropper" => "Eyedropper");
                    tip: @tr("colour-eyedropper-tip" => "Eyedropper: pick a colour from the screenshot or the screen");
                    clicked => {
                        picker.close();
                        ColourPick.eyedrop(root.key);
                    }
                }
            }
            if ColourPick.recent.length > 0: VerticalLayout {
                spacing: 6px;
                Text { text: @tr("colour-recent" => "Recent"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    for c in ColourPick.recent: Swatch {
                        width: 22px;
                        height: 22px;
                        c: c;
                        on: root.selected == -2 && root.current == c;
                        clicked => {
                            ColourPick.pick(root.key, c);
                            picker.close();
                        }
                    }
                }
            }
        }
        }
    }
}

// Button that acts while held ("Compare": the original tone while the finger is down).
component HoldButton inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    callback held(bool);
    height: 28px;
    border-radius: 7px;
    background: ta.pressed ? Theme.control-on : (ta.has-hover ? Theme.hover : Theme.elevated);
    animate background { duration: 120ms; easing: ease-out; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.96 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    Text {
        text: root.text;
        color: ta.pressed ? Theme.text : Theme.text2;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TipTouch {
        tip: root.tip;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.held(true); }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.held(false); }
        }
    }
}

// A switch with its caption on the left.
component SwitchRow inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    // Off: shown as it is, dimmed, and not switchable (the export sheet's «white» for JPEG).
    in property <bool> enabled: true;
    callback toggled;
    spacing: 8px;
    height: 24px;
    Text { text: root.text; color: root.enabled ? Theme.text2 : Theme.text3; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
    VerticalLayout {
        alignment: center;
        opacity: root.enabled ? 1 : 0.5;
        Switch { checked <=> root.checked; toggled => { root.toggled(); } }
        // Takes the clicks while off.
        if !root.enabled: TouchArea { }
    }
}

// A small round button over a library card (shows while the card is hovered).
component CardHover inherits Rectangle {
    out property <bool> hover: ta.has-hover;
    in property <string> icon;
    in property <string> tip;
    in property <bool> danger;
    // Shift was held on the click (the trash button: delete for good).
    out property <bool> with-shift;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: ta.has-hover ? (root.danger ? #FF5A5F : Theme.control-on) : #0B0D11CC;
    animate background { duration: 120ms; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.9 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    Icon { width: 16px; height: 16px; d: root.icon; tint: ta.has-hover ? #FFFFFF : #FFFFFFD0; }
    ta := TipTouch {
        tip: root.tip;
        pointer-event(e) => { root.with-shift = e.modifiers.shift; }
        clicked => { root.clicked(); }
    }
}

component CardView inherits Rectangle {
    in property <CardData> data;
    // A card of the library's trash (ZK-175): Restore and Destroy instead of Rename, Show and
    // Trash, and a click never opens it.
    in property <bool> in-trash;
    callback open;
    // ZK-176: 0 a plain click in the trash (just this card), 1 Ctrl / ⌘ (one more or one less),
    // 2 Shift (a range from the last clicked card).
    callback pick(int);
    callback rename(string);
    // true = Shift held: delete for good instead of the trash.
    callback trash(bool);
    callback reveal();
    callback restore();
    callback destroy();
    callback pin();
    // Rename was left (Enter or Esc): the grid takes the keys again.
    callback left-rename();
    // F2 on the keyboard's card (ZK-179): a new value starts the rename there.
    in property <int> rename-tick;
    changed rename-tick => {
        if (root.data.current && !root.in-trash) { root.renaming = true; }
    }
    property <bool> renaming;
    // ZK-174: the card stays under the pointer while the pointer is on one of its buttons
    // (the buttons take the hover from the card's own area, the card must not "jump").
    property <bool> hot: ta.has-hover || pb.hover || rb.hover || fb.hover || tb.hover || sb.hover || db.hover;
    border-radius: 12px;
    background: Theme.panel;
    border-width: root.data.selected ? 2.5px : (root.hot ? 1.5px : 0);
    border-color: Theme.accent;
    // Lifts a little under the pointer, dips when pressed.
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.98 : (root.hot ? 1.02 : 1.0);
    animate transform-scale { duration: 180ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    drop-shadow-blur: root.hot ? 18px : 0px;
    drop-shadow-color: #00000066;
    animate drop-shadow-blur { duration: 180ms; easing: ease-out; }
    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 64px;
        border-radius: 8px;
        background: Theme.canvas;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.data.thumb;
            image-fit: contain;
        }
    }
    if !root.renaming: Text {
        x: 12px;
        y: parent.height - 50px;
        width: parent.width - 24px;
        text: root.data.name;
        color: Theme.text;
        font-size: 13px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        x: 12px;
        y: parent.height - 28px;
        width: parent.width - 24px;
        text: root.data.meta;
        color: Theme.text3;
        font-size: 11px;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        // The modifiers of the press decide what the click does.
        property <int> mode;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                // Alt (⌥): open in a new window (ZK-192).
                self.mode = e.modifiers.shift ? 2 : (e.modifiers.control ? 1 : (e.modifiers.alt ? 3 : 0));
            }
        }
        clicked => {
            if (!root.renaming) {
                if (self.mode == 0 && !root.in-trash) { root.open(); } else if (self.mode == 3 && root.in-trash) { root.pick(0); } else { root.pick(self.mode); }
            }
        }
    }
    // The keyboard's card (ZK-179): a ring just outside.
    if root.data.current: Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: 15px;
        border-width: 2px;
        border-color: Theme.accent-text;
    }
    // Picked: a tick on the picture's corner; pinned: a pin next to it (ZK-178).
    if root.data.selected: Rectangle {
        x: 14px;
        y: 14px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: Theme.accent;
        Icon { width: 14px; height: 14px; d: "M5 12.5 l4.5 4.5 L19 7"; tint: #FFFFFF; }
    }
    if root.data.pinned: Rectangle {
        x: root.data.selected ? 42px : 14px;
        y: 14px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: #0B0D11CC;
        Icon { width: 14px; height: 14px; d: "M9 4 h6 l-1 6 3 3 v2 H7 v-2 l3 -3 z M12 15 v6"; tint: #FFD23F; }
    }
    // Inline rename: Enter keeps the name, Esc or leaving the field drops it.
    if root.renaming: Rectangle {
        x: 8px;
        y: parent.height - 54px;
        width: parent.width - 16px;
        height: 26px;
        border-radius: 6px;
        background: Theme.elevated;
        border-width: 1px;
        border-color: Theme.accent;
        name-input := TextInput {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            vertical-alignment: center;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            text: root.data.name;
            accepted => { root.renaming = false; root.rename(self.text); root.left-rename(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.renaming = false; root.left-rename(); return accept; }
                return reject;
            }
            changed has-focus => { if (!self.has-focus) { root.renaming = false; } }
            init => { self.focus(); self.select-all(); }
        }
    }
    // Actions on the picture's corner while the card is under the pointer.
    HorizontalLayout {
        x: parent.width - self.preferred-width - 14px;
        y: 14px;
        spacing: 6px;
        visible: !root.in-trash;
        opacity: root.hot ? 1 : 0;
        animate opacity { duration: 140ms; }
        pb := CardHover { icon: "M9 4 h6 l-1 6 3 3 v2 H7 v-2 l3 -3 z M12 15 v6"; tip: root.data.pinned ? @tr("lib-unpin" => "Unpin") : @tr("lib-pin" => "Pin — the library limit never removes it"); clicked => { root.pin(); } }
        rb := CardHover { icon: "M15.5 4.5 a2.1 2.1 0 0 1 3 3 L8 18 l-4 1 1 -4 z"; tip: @tr("common-rename" => "Rename"); clicked => { root.renaming = true; } }
        fb := CardHover { icon: "M3 7 a2 2 0 0 1 2 -2 h4 l2 2 h8 a2 2 0 0 1 2 2 v8 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 z"; tip: @tr("lib-show-in-folder" => "Show in folder"); clicked => { root.reveal(); } }
        tb := CardHover { icon: "M4 7 h16 M10 11 v6 M14 11 v6 M6 7 l1 12 a2 2 0 0 0 2 2 h6 a2 2 0 0 0 2 -2 l1 -12 M9 7 V4 h6 v3"; tip: @tr("lib-trash-long" => "Move to trash") + " · Shift — " + @tr("lib-delete-forever" => "delete for good"); danger: true; clicked => { root.trash(self.with-shift); } }
    }
    // In the trash: back to the library, or away for good (after one question).
    HorizontalLayout {
        x: parent.width - self.preferred-width - 14px;
        y: 14px;
        spacing: 6px;
        visible: root.in-trash;
        opacity: root.hot ? 1 : 0;
        animate opacity { duration: 140ms; }
        sb := CardHover { icon: "M4 12 a8 8 0 1 0 2.3 -5.6 M4 4 v4 h4"; tip: @tr("trash-restore" => "Restore"); clicked => { root.restore(); } }
        db := CardHover { icon: "M4 7 h16 M10 11 v6 M14 11 v6 M6 7 l1 12 a2 2 0 0 0 2 2 h6 a2 2 0 0 0 2 -2 l1 -12 M9 7 V4 h6 v3"; tip: @tr("trash-destroy" => "Destroy"); danger: true; clicked => { root.destroy(); } }
    }
}

component HintChip inherits HorizontalLayout {
    in property <string> key;
    in property <string> text;
    spacing: 6px;
    height: 20px;
    Rectangle {
        width: key-text.preferred-width + 12px;
        height: 20px;
        border-radius: 5px;
        background: #FFFFFF1F;
        key-text := Text { text: root.key; color: #E8EAEE; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
    }
    Text { text: root.text; color: #A7ADB8; font-size: 12px; vertical-alignment: center; }
}

// The capture overlay (ZK-39/40): the frozen screen, a dim veil, a selection frame
// (drag = region, click = window under the pointer, Space = whole screen), guides through the
// pointer across the whole screen (they are the cursor, as in Little Helpers), a magnifier drawn
// by Rust (nearest neighbour, pixel grid from ×8) and the hint strip, which jumps to the top
// when the pointer comes near it. Coordinates are logical pixels of this window.
// ---------------------------------------------------------------------------------------------
// The small card in the corner after a quick capture (ZK-41): the shot is already in the
// clipboard and the library. Its own window: it must not take the focus from what the user is
// doing (see the attributes hook in main.rs), so its buttons carry no shared tooltips — the
// second line of the card says what the button under the pointer does.

component PillButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    out property <bool> hover: ta.has-hover;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: ta.pressed ? Theme.control-on : (ta.has-hover ? Theme.elevated : transparent);
    animate background { duration: 120ms; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: ta.pressed ? 0.92 : 1.0;
    animate transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    accessible-role: button;
    accessible-label: root.label;
    Icon { width: 18px; height: 18px; d: root.icon; tint: ta.has-hover ? Theme.text : Theme.text2; }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component Pill inherits Window {
    // «Send to …» in one click (ZK-101): the default target or the first ready one; empty = none.
    in property <string> send-target;
    callback send();
    default-font-family: "Onest";
    // Matched by the window-attributes hook in main.rs: no activation, no taskbar button.
    title: "Znimok pill";
    no-frame: true;
    always-on-top: true;
    width: 380px;
    height: 96px;
    background: Theme.panel;
    in property <image> thumb;
    in property <string> heading;
    in property <string> sub;
    // Time left, 1 → 0 (the thin bar at the bottom).
    in property <float> progress: 1;
    in property <bool> shown;
    callback edit();
    callback dismiss();
    callback save-file();
    callback show-library();
    callback drag-out();
    callback hovered(bool);
    out property <bool> hover: bg.has-hover || th.has-hover || b-edit.hover || b-save.hover || b-lib.hover || b-close.hover;
    changed hover => { root.hovered(self.hover); }
    property <string> hint: b-save.hover ? @tr("pill-save-file" => "Save as file…") : (b-lib.hover ? @tr("pill-show-library" => "Show in library") : (th.has-hover ? @tr("share-drag-tip" => "drag to a chat or a folder") : ""));

    Rectangle {
        // Slides in from the side and settles with a little overshoot (owner: iOS-like motion).
        x: root.shown ? 0 : 28px;
        opacity: root.shown ? 1 : 0;
        animate x { duration: 340ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.15); }
        animate opacity { duration: 200ms; easing: ease-out; }
        width: root.width;
        height: root.height;
        border-width: 1px;
        border-color: Theme.control-on;
        background: Theme.panel;
        bg := TouchArea { }
        HorizontalLayout {
            padding: 10px;
            padding-right: 8px;
            spacing: 12px;
            // The picture: click edits, pulling it drags the file out.
            Rectangle {
                width: 104px;
                border-radius: 8px;
                background: Theme.canvas;
                clip: true;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale: th.pressed ? 0.96 : (th.has-hover ? 1.02 : 1.0);
                animate transform-scale { duration: 160ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                Image { width: parent.width; height: parent.height; source: root.thumb; image-fit: contain; }
                th := TouchArea {
                    property <bool> dragged;
                    mouse-cursor: self.dragged ? MouseCursor.grabbing : MouseCursor.pointer;
                    pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.dragged = false; } }
                    moved => {
                        if (self.pressed && !self.dragged && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px)) {
                            self.dragged = true;
                            root.drag-out();
                        }
                    }
                    clicked => {
                        if (!self.dragged) { root.edit(); }
                        self.dragged = false;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.heading; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                Text { text: root.hint != "" ? root.hint : root.sub; color: root.hint != "" ? Theme.accent-text : Theme.text2; font-size: 11px; overflow: elide; }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 4px;
                    alignment: start;
                    b-edit := TextButton { text: @tr("pill-edit" => "Edit"); primary: true; clicked => { root.edit(); } }
                    b-save := PillButton { icon: "M12 4 v11 M7 10 l5 5 5 -5 M5 19 h14"; label: @tr("pill-save-file" => "Save as file…"); clicked => { root.save-file(); } }
                    b-lib := PillButton { icon: "M4 4 h7 v7 H4 z M13 4 h7 v7 h-7 z M4 13 h7 v7 H4 z M13 13 h7 v7 h-7 z"; label: @tr("pill-show-library" => "Show in library"); clicked => { root.show-library(); } }
                    if root.send-target != "": PillButton { icon: "M4 12 L20 4 L14 20 L11 13 Z M11 13 L20 4"; label: @tr("share-send-to-one" => "Send to {0}", root.send-target); clicked => { root.send(); } }
                }
            }
            VerticalLayout {
                alignment: start;
                b-close := PillButton { width: 26px; height: 26px; icon: "M6 6 l12 12 M18 6 L6 18"; label: @tr("common-close" => "Close"); clicked => { root.dismiss(); } }
            }
        }
        // Time left: a thin accent line that runs out (pauses while the pointer is on the card).
        Rectangle {
            x: 0;
            y: parent.height - 2px;
            height: 2px;
            width: parent.width * root.progress;
            background: Theme.accent;
            opacity: 0.8;
        }
    }
}

// Countdown before a delayed capture (ZK-128, LH CAPS-85): a small square in the bottom-right
// corner of the display. It takes no focus and lets the mouse through (Rust sets that up), so
// a menu that closes on a hotkey can be opened while it counts; it is gone before the capture.
export struct AgentClient {
    name: string,
    scopes: string,
}

// Scrolling capture (ZK-141): the height so far and the two ways out; it sits outside the area.
export component ScrollPanel inherits Window {
    init => { Theme.mode = 2; }
    default-font-family: "Onest";
    // Matched by the window-attributes hook in main.rs: no activation, no taskbar button.
    title: "Znimok scroll";
    no-frame: true;
    always-on-top: true;
    width: 330px;
    height: 64px;
    background: #141418;
    in property <int> stitched: 0;
    in property <bool> manual;
    callback done();
    callback cancel();
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: @tr("scroll-progress" => "Scrolling… {0} px", root.stitched); color: white; font-size: 14px; font-weight: 600; }
            Text { text: root.manual ? @tr("scroll-manual" => "Scroll it yourself — Znimok keeps up") : @tr("scroll-auto" => "Esc — cancel"); color: #AAAAB2; font-size: 11px; }
        }
        VerticalLayout {
            alignment: center;
            TextButton { text: @tr("common-done" => "Done"); primary: true; clicked => { root.done(); } }
        }
        VerticalLayout {
            alignment: center;
            TextButton { text: @tr("common-cancel" => "Cancel"); clicked => { root.cancel(); } }
        }
    }
}

// While recording (ZK-91): a thin red edge around the recorded part (four of these, outside
// it, so they are never in the video; the mouse goes through) and the control bar next to it.
// Matched by the window-attributes hook in main.rs: no activation, no taskbar button.
export component RecEdge inherits Window {
    title: "Znimok rec";
    no-frame: true;
    always-on-top: true;
    background: #FF5A5F;
    in property <bool> paused;
    // Paused: the edge turns amber, as the bar's dot.
    Rectangle { background: root.paused ? #FFD23F : #FF5A5F; }
}

export component RecBar inherits Window {
    init => { Theme.mode = 2; }
    default-font-family: "Onest";
    title: "Znimok rec";
    no-frame: true;
    always-on-top: true;
    width: 272px;
    height: 52px;
    background: #141418;
    in property <string> time: "0:00";
    in property <bool> paused;
    callback pause();
    callback stop();
    HorizontalLayout {
        padding: 10px;
        padding-left: 14px;
        spacing: 10px;
        // A red dot that breathes while recording, amber while paused.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.paused ? #FFD23F : #FF5A5F;
                opacity: root.paused ? 1 : (mod(animation-tick() / 1ms, 1400) < 900 ? 1 : 0.35);
            }
        }
        Text { text: root.time; color: white; font-family: "JetBrains Mono"; font-size: 16px; font-weight: 600; vertical-alignment: center; min-width: 64px; }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            TextButton { text: root.paused ? @tr("rec-resume" => "Resume") : @tr("rec-pause" => "Pause"); clicked => { root.pause(); } }
        }
        VerticalLayout {
            alignment: center;
            TextButton { text: @tr("rec-stop" => "Stop"); primary: true; clicked => { root.stop(); } }
        }
    }
}

export component Countdown inherits Window {
    init => { Theme.mode = 2; }
    default-font-family: "Onest";
    // Matched by the window-attributes hook in main.rs: no activation, no taskbar button.
    title: "Znimok countdown";
    no-frame: true;
    always-on-top: true;
    width: 120px;
    height: 120px;
    // Opaque: the corners are rounded by the system (Windows 11) / left square.
    background: #141418;
    in property <int> left: 3;
    Rectangle {
        Text {
            y: 10px;
            height: 76px;
            width: parent.width;
            text: root.left;
            color: white;
            font-size: 64px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            // Each second arrives with a small "breath".
            animate font-size { duration: 160ms; easing: ease-out; }
        }
        Text {
            y: 84px;
            height: 22px;
            width: parent.width;
            text: @tr("capture-countdown-cancel" => "Esc — cancel");
            color: #AAAAB2;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component Overlay inherits Window {
    init => { Theme.mode = 2; }
    default-font-family: "Onest";
    no-frame: true;
    // Windows: top-most. macOS: Rust sets a window level above the menu bar instead (Slint's
    // top-most = NSFloatingWindowLevel 3, below the menu bar; it would also override ours).
    in property <bool> on-top: true;
    in property <bool> mac;
    always-on-top: root.on-top;
    background: black;
    title: "Znimok";

    in property <image> shot;
    // Selection, or the window under the pointer when nothing is dragged.
    in property <bool> has-sel;
    in-out property <length> sel-x;
    in-out property <length> sel-y;
    in-out property <length> sel-w;
    in-out property <length> sel-h;
    in property <string> sel-label;
    in property <bool> is-window;
    // What releasing does, by modifier (ZK-155): 0 editor, 1 over the screen, 2 clipboard.
    in property <int> act-plain: 0;
    in property <int> act-shift: 2;
    in property <int> act-alt: 1;
    // The hint strip at all (ZK-156).
    in property <bool> show-hints: true;
    // A recording's overlay (ZK-189): its own hint strip, with the sound choice.
    in property <bool> video;
    in property <string> sound-text;
    pure function act-text(a: int) -> string {
        return a == 1 ? @tr("capture-over-screen" => "over the screen") : (a == 2 ? @tr("capture-to-clipboard" => "to clipboard") : @tr("capture-to-editor" => "to editor"));
    }
    // Pointer (for the guides, the lens and the hint strip).
    in property <length> pointer-x: -100px;
    in property <length> pointer-y: -100px;
    in property <image> guide-h;
    in property <image> guide-v;
    // Magnifier (ZK-40): off until the wheel turns it on.
    in property <bool> lens-visible;
    in property <image> lens;
    in property <length> lens-size: 144px;
    in property <string> lens-coords;
    in property <string> lens-hex;
    in property <color> lens-color;

    callback pointer(int, length, length, bool, bool);
    callback key(string, bool, bool);
    callback wheel(length);
    // The lens or the hint strip hopped to the other side (ZK-214, felt on the mouse).
    callback haptic(string);

    // The frame glides from window to window while hovering (like the system screenshot tool);
    // while dragging a region it follows the pointer exactly.
    animate sel-x, sel-y, sel-w, sel-h { duration: root.is-window ? 140ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    in property <bool> lens-pulse;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.shot;
        image-fit: fill;
    }
    // Veil around the selection (the whole screen when nothing is selected).
    Rectangle { x: 0; y: 0; width: parent.width; height: root.has-sel ? root.sel-y : parent.height; background: #00000073; }
    if root.has-sel: Rectangle { x: 0; y: root.sel-y + root.sel-h; width: parent.width; height: max(0, parent.height - root.sel-y - root.sel-h); background: #00000073; }
    if root.has-sel: Rectangle { x: 0; y: root.sel-y; width: root.sel-x; height: root.sel-h; background: #00000073; }
    if root.has-sel: Rectangle { x: root.sel-x + root.sel-w; y: root.sel-y; width: max(0, parent.width - root.sel-x - root.sel-w); height: root.sel-h; background: #00000073; }
    if root.has-sel: Rectangle {
        x: root.sel-x - 1px;
        y: root.sel-y - 1px;
        width: root.sel-w + 2px;
        height: root.sel-h + 2px;
        border-width: root.is-window ? 2.5px : 1px;
        border-color: root.is-window ? #50A0FF : #FFFFFFEB;
        background: transparent;
    }
    // Guides through the pointer: where the frame's corner will land. Drawn by Rust pixel by
    // pixel in a colour that contrasts with what is under each pixel (black on light, white on
    // dark), one physical pixel thick.
    Image { x: 0; y: root.pointer-y; width: parent.width; height: 1phx; source: root.guide-h; image-fit: fill; image-rendering: pixelated; }
    Image { x: root.pointer-x; y: 0; width: 1phx; height: parent.height; source: root.guide-v; image-fit: fill; image-rendering: pixelated; }
    if root.has-sel && root.sel-label != "": Rectangle {
        x: min(max(4px, root.sel-x), parent.width - self.width - 4px);
        y: root.sel-y > 34px ? root.sel-y - 30px : min(root.sel-y + root.sel-h + 6px, parent.height - 30px);
        width: label.preferred-width + 16px;
        height: 24px;
        border-radius: 6px;
        background: #171A20E6;
        label := Text { text: root.sel-label; color: #E8EAEE; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
    }
    // Hint strip: bottom centre, or top centre when the pointer comes near the bottom.
    hint-strip := Rectangle {
        property <bool> up: root.pointer-y > parent.height - self.height - 28px - 80px;
        changed up => { if (root.show-hints) { root.haptic("hintsFlip"); } }
        visible: root.show-hints;
        x: (parent.width - self.width) / 2;
        y: self.up ? 28px : parent.height - self.height - 28px;
        // Moves out of the pointer's way with a small overshoot — a physical "hop".
        animate y { duration: 320ms; easing: ease-out-back; }
        width: hints.preferred-width + 32px;
        height: 40px;
        border-radius: 12px;
        background: #171A20F0;
        hints := HorizontalLayout {
            x: 14px;
            y: (parent.height - 20px) / 2;
            width: self.preferred-width;
            height: 20px;
            spacing: 18px;
            if !root.video: HintChip { key: @tr("capture-release" => "release"); text: root.act-text(root.act-plain); }
            if !root.video: HintChip { key: "Shift"; text: root.act-text(root.act-shift); }
            if !root.video: HintChip { key: root.mac ? "⌥" : "Alt"; text: root.act-text(root.act-alt); }
            if root.video: HintChip { key: @tr("capture-release" => "release"); text: @tr("capture-record" => "record"); }
            HintChip { key: "Space"; text: @tr("capture-whole-screen" => "whole screen"); }
            HintChip { key: @tr("capture-click" => "click"); text: @tr("capture-window" => "window"); }
            if root.video: HintChip { key: "A"; text: root.sound-text; }
            if !root.video: HintChip { key: @tr("capture-wheel" => "wheel"); text: @tr("capture-magnifier" => "magnifier"); }
            if !root.video: HintChip { key: @tr("capture-double" => "double click"); text: @tr("capture-delayed" => "after 3 s"); }
            if !root.video: HintChip { key: "Q"; text: @tr("capture-qr" => "QR code"); }
            if !root.video: HintChip { key: "S"; text: @tr("capture-scroll" => "with scrolling"); }
            HintChip { key: "Esc"; text: @tr("capture-cancel" => "cancel"); }
        }
    }
    // Magnifier: above-right of the pointer (like Little Helpers), flipping at the edges.
    Rectangle {
        opacity: root.lens-visible ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 140ms; easing: ease-in-out; }
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: root.lens-pulse ? 1.07 : 1.0;
        animate transform-scale { duration: 160ms; easing: ease-in-out; }
        property <length> info-h: 44px;
        property <length> gap: 24px;
        // Which side of the pointer: flips near the edges. Only the offset is animated, so the
        // lens still follows the pointer exactly and glides over when it changes sides.
        property <bool> left: root.pointer-x + self.gap + root.lens-size > parent.width;
        property <bool> below: root.pointer-y - 44px - root.lens-size - self.info-h < 0;
        changed left => { if (root.lens-visible) { root.haptic("lensFlip"); } }
        changed below => { if (root.lens-visible) { root.haptic("lensFlip"); } }
        property <length> off-x: self.left ? -self.gap - root.lens-size : self.gap;
        property <length> off-y: self.below ? self.gap : -44px - root.lens-size - self.info-h;
        animate off-x, off-y { duration: 240ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        x: max(0, root.pointer-x + self.off-x);
        y: min(max(0, root.pointer-y + self.off-y), parent.height - root.lens-size - self.info-h);
        width: root.lens-size;
        height: root.lens-size + self.info-h;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000099;
        background: #141418E1;
        Image {
            x: 0;
            y: 0;
            width: root.lens-size;
            height: root.lens-size;
            source: root.lens;
            image-fit: fill;
            image-rendering: pixelated;
        }
        Text {
            x: 6px;
            y: root.lens-size + 2px;
            height: 20px;
            text: root.lens-coords;
            color: #EBEBF0;
            font-size: 11px;
            vertical-alignment: center;
        }
        Rectangle {
            x: 6px;
            y: root.lens-size + 24px;
            width: 14px;
            height: 14px;
            background: root.lens-color;
            border-width: 1px;
            border-color: #FFFFFFC8;
        }
        Text {
            x: 26px;
            y: root.lens-size + 22px;
            height: 18px;
            text: root.lens-hex;
            color: #EBEBF0;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    fs := FocusScope {
        key-pressed(e) => {
            root.key(e.text, e.modifiers.shift, e.modifiers.alt);
            return accept;
        }
        TouchArea {
            // The guides are the cursor.
            mouse-cursor: none;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.pointer(e.button == PointerEventButton.left ? 0 : 3, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.alt);
                } else if (e.kind == PointerEventKind.up) {
                    root.pointer(e.button == PointerEventButton.left ? 2 : 4, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.alt);
                } else if (e.kind == PointerEventKind.move) {
                    root.pointer(1, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.alt);
                }
            }
            scroll-event(e) => {
                root.wheel(e.delta-y);
                return accept;
            }
        }
    }
    public function grab-focus() { fs.focus(); }
}

// Tray icon (Windows) / menu bar item (macOS): the app keeps running there after the window
// closes, so the hotkey works and "Quit" is always one click away (ZK-45 in full later).
export component AppTray inherits SystemTrayIcon {
    in property <image> tray-icon;
    in property <string> capture-key;
    in property <bool> capture-available: true;
    in property <bool> mac: false;
    icon: tray-icon;
    tooltip: root.recording ? @tr("tray-tooltip-recording" => "Znimok — recording {0}", root.rec-time) : (root.paused ? @tr("tray-tooltip-paused-keys" => "Znimok — hotkeys paused") : @tr("tray-tooltip" => "Znimok"));
    // ZK-180/91: recording, its time, and the hotkey that starts / stops it.
    in property <bool> recording;
    in property <string> rec-time;
    in property <string> record-key;
    callback record();

    callback shot();
    callback read-codes();
    callback read-text();
    callback open-window();
    callback quit();
    // ZK-44: all global hotkeys released until resumed.
    in property <bool> paused;
    callback toggle-pause();

    clicked => { root.open-window(); }

    Menu {
        MenuItem {
            title: @tr("tray-screen" => "Screenshot") + "    " + root.capture-key;
            enabled: root.capture-available;
            activated => { root.shot(); }
        }
        MenuItem {
            title: (root.recording ? @tr("tray-stop-record" => "Stop recording") + "  " + root.rec-time : @tr("tray-record" => "Record video")) + "    " + root.record-key;
            enabled: root.capture-available;
            activated => { root.record(); }
        }
        MenuItem {
            title: @tr("tray-read-codes" => "Read a QR code from the screen");
            enabled: root.capture-available;
            activated => { root.read-codes(); }
        }
        MenuItem {
            title: @tr("tray-read-text" => "Copy text from the screen");
            enabled: root.capture-available;
            activated => { root.read-text(); }
        }
        MenuItem {
            title: @tr("tray-open" => "Open Znimok");
            activated => { root.open-window(); }
        }
        MenuItem {
            title: root.paused ? @tr("tray-resume-keys" => "Resume hotkeys") : @tr("tray-pause-keys" => "Pause hotkeys");
            activated => { root.toggle-pause(); }
        }
        MenuSeparator { }
        MenuItem {
            title: root.mac ? @tr("tray-quit-mac" => "Quit Znimok") : @tr("tray-quit" => "Quit");
            activated => { root.quit(); }
        }
    }
}

// The tool rail: docked at the left of the editor, or floating by the frame over the screen
// (ZK-58, without Crop there: the frame itself is the crop).
component ToolRail inherits VerticalLayout {
    in property <int> tool;
    in property <bool> ctrl-held;
    in property <bool> with-crop: true;
    // Image (ZK-163): a file dialog, so not over the screen (it would open under the frame).
    in property <bool> with-image: true;
    callback chosen(int);
    callback insert-image();
    padding: 8px;
    spacing: 4px;
    alignment: start;
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-select" => "Select (V)"); icon: "M5 3 l14 8 -6 2 -3 6 -5 -16 z"; active: root.tool == 0 || root.ctrl-held; clicked => { root.chosen(0); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-rect" => "Rectangle (R)"); icon: "M6 5 h12 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 V7 a2 2 0 0 1 2 -2 z"; active: root.tool == 1 && !root.ctrl-held; clicked => { root.chosen(1); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-ellipse" => "Ellipse (E)"); icon: "M4 12 a8 6 0 1 0 16 0 a8 6 0 1 0 -16 0 z"; active: root.tool == 2 && !root.ctrl-held; clicked => { root.chosen(2); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-line" => "Line (L)"); icon: "M4 20 L20 4 M11 4 h9 v9"; active: root.tool == 3 && !root.ctrl-held; clicked => { root.chosen(3); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-pen" => "Pen (P)"); icon: "M15.5 4.5 a2.1 2.1 0 0 1 3 3 L8 18 l-4 1 1 -4 z M13.5 6.5 l3 3 M12 20 q2 -3 4 0 t4 0"; active: root.tool == 4 && !root.ctrl-held; clicked => { root.chosen(4); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-text" => "Text (T)"); icon: "M5 6 h14 M12 6 v14"; active: root.tool == 5 && !root.ctrl-held; clicked => { root.chosen(5); } }
        Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; x: 8px; width: parent.width - 16px; background: Theme.line; } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-hide" => "Hide (B)"); icon: "M3 3 l18 18 M10.6 10.6 a2 2 0 0 0 2.8 2.8 M9.9 5.1 A10 10 0 0 1 21 12 a17 17 0 0 1 -2.8 3.6 M6.6 6.6 A17 17 0 0 0 3 12 s3.5 6 9 6 a9 9 0 0 0 3.6 -0.7"; active: root.tool == 6 && !root.ctrl-held; clicked => { root.chosen(6); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-highlighter" => "Highlighter (H)"); icon: "M14 3.5 L20.5 10 L13 17.5 L6.5 11 Z M6.5 11 L4 16.5 L7.5 20 L13 17.5 M16.5 6 L10 12.5 M3 22.3 h9"; active: root.tool == 7 && !root.ctrl-held; clicked => { root.chosen(7); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-counter" => "Counter (N)"); icon: "M3 12 a9 9 0 1 0 18 0 a9 9 0 1 0 -18 0 z M10.5 9 l2 -1.2 V16"; active: root.tool == 8 && !root.ctrl-held; clicked => { root.chosen(8); } }
        IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-stamp" => "Stamp (S)"); icon: "M8 12 V7 a4 4 0 0 1 8 0 v5 M5 12 h14 v4 H5 z M7 16 v4 h10 v-4"; active: root.tool == 9 && !root.ctrl-held; clicked => { root.chosen(9); } }
        // Not a tool that stays on: it asks for a picture and puts it in as a mark (ZK-163).
        if root.with-image: IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-image" => "Image (I)"); tip: self.label + " — " + @tr("tool-image-tip" => "Put a picture from a file on the screenshot (Ctrl+V pastes one from the clipboard)"); icon: "M5 5 h14 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 V7 a2 2 0 0 1 2 -2 z M7 10 a1.5 1.5 0 1 0 3 0 a1.5 1.5 0 1 0 -3 0 M4 17 l5 -5 4 4 3 -3 4 4"; clicked => { root.insert-image(); } }
        if root.with-crop: Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; x: 8px; width: parent.width - 16px; background: Theme.line; } }
        if root.with-crop: IconButton { width: 40px; height: 36px; tip-side: 1; label: @tr("tool-crop" => "Crop (C)"); icon: "M6 2 v14 a2 2 0 0 0 2 2 h14 M2 6 h14 a2 2 0 0 1 2 2 v14"; active: root.tool == 10; clicked => { root.chosen(10); } }
}

export component AppWindow inherits Window {
    default-font-family: "Onest";
    // An editor window carries its document's name (ZK-107); the library window the app's.
    in property <string> window-title: @tr("app-name" => "Znimok");
    title: root.window-title;
    // Own title bar: Windows draws window buttons; macOS keeps the traffic lights (inset).
    in property <bool> custom-frame: false;
    in property <length> lights-inset: 0px;
    in property <bool> win-maximized: false;
    no-frame: root.custom-frame;
    callback window-drag();
    callback window-toggle();
    callback window-minimize();
    callback window-close();
    callback window-resize(int);
    in property <image> app-icon;
    icon: app-icon;
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 800px;
    min-height: 560px;
    background: Theme.app;
    default-font-size: 13px;

    // ---- state shared with Rust
    in-out property <int> page: 0; // 0 library, 1 editor
    in property <[CardData]> cards;
    // The library page shows the trash (ZK-175); documents in it; cards picked (ZK-176).
    in property <bool> trash-view;
    in property <int> trash-count;
    in property <int> picked-count;
    // The picked cards are all pinned (the bar offers Unpin then, ZK-178).
    in property <bool> picked-pinned;
    // The grid's groups (ZK-177): titles, and the totals of titles and card rows.
    in property <[LibHeader]> lib-headers;
    in property <int> lib-hb;
    in property <int> lib-rb;
    // F2 on the keyboard's card (ZK-179).
    in-out property <int> lib-rename-tick;
    in property <string> library-dir;
    in property <bool> capture-available: true;
    in property <string> capture-key: "Ctrl+Shift+4";
    in-out property <string> toast;

    in property <string> doc-name;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in-out property <bool> autosave: true;
    in property <int> save-state: 0; // 0 saved, 1 unsaved, 2 saving
    in-out property <int> tool: 1;
    in property <image> canvas;
    // ZK-92: the video's frame, shown under the canvas straight from the GPU (the canvas is
    // see-through over the picture then); the whole picture at vid-x/y/w/h, clipped to the frame.
    in property <image> vid-image;
    in property <bool> vid-live;
    in property <length> vid-x;
    in property <length> vid-y;
    in property <length> vid-w;
    in property <length> vid-h;
    in property <length> vid-clip-x;
    in property <length> vid-clip-y;
    in property <length> vid-clip-w;
    in property <length> vid-clip-h;
    in property <bool> vid-smooth: true;
    in property <bool> vid-backward;
    // The film strip's thumbnails, composed by Rust at the timeline's zoom.
    in property <image> tl-strip;
    in property <string> image-size;
    in property <int> mark-count;
    in property <string> zoom-text: "100 %";
    in property <string> crop-text;
    in property <int> color-index: 0;
    in property <int> marker-size: 1;
    // The colours shown by the colour rows; an index of -2 means "off the palette" (ZK-160).
    in property <color> color-rgb;
    in property <color> fill-rgb;
    in property <color> digit-rgb;
    in property <int> thick-index: 1;
    in property <bool> has-selection;
    in property <int> selection-count;
    // inspector (ZK-54)
    in-out property <int> insp-tab: 0;
    // The «Відео» mode (ZK-181): the transport, the timeline and the «Відео» tab.
    in property <bool> vid-mode;
    in property <bool> vid-playing;
    in property <bool> vid-can-play: true;
    in property <string> vid-time: "0:00.00";
    in property <string> vid-total: "0:00.00";
    // The recording's full length while it is trimmed (shown struck out), else empty.
    in property <string> vid-total-full;
    in property <string> vid-frame-label;
    in property <string> vid-speed: "1×";
    in property <bool> vid-loop;
    in property <bool> vid-muted;
    in property <bool> vid-edited;
    in property <string> vid-trim-in;
    in property <string> vid-trim-out;
    in property <string> vid-trim-cut;
    in property <string> vid-trim-left;
    in property <string> vid-note;
    in property <[VidTrack]> vid-tracks;
    // The sound lane's waveforms, one per track (ZK-189).
    in property <[image]> tl-waves;
    // 0 no sound, 1 system, 2 microphone, 3 both — and which tracks the recording has.
    in property <int> vid-sound-mode;
    in property <bool> vid-has-system;
    in property <bool> vid-has-mic;
    // The timeline has the keys (the last press was on it).
    in property <bool> tl-focus;
    in property <[TlTick]> tl-ticks;
    in property <[TlPiece]> tl-pieces;
    in property <[TlMark]> tl-marks;
    in property <length> tl-in;
    in property <length> tl-out;
    in property <length> tl-playhead;
    in property <bool> tl-has-range;
    // The DevTools log (ZK-191): whether the recording has one, the panel open, the lane's
    // ticks, chips and rows; the row at the playhead and the selected one; the details pane.
    in property <bool> devp-has;
    in property <bool> devp-open;
    in property <bool> devp-follow;
    in property <[DevTick]> devp-ticks;
    in property <[DevChip]> devp-chips;
    in property <int> devp-chip;
    in-out property <string> devp-query;
    in property <[DevRow]> devp-rows;
    in property <int> devp-current: -1;
    in property <int> devp-selected: -1;
    in property <bool> devp-detail-open;
    in property <string> devp-detail-title;
    in property <bool> devp-tabbed;
    in property <[bool]> devp-has-tab;
    in property <int> devp-tab;
    in property <string> devp-detail;
    in property <[DevTiming]> devp-timing;
    in property <bool> devp-can-save;
    callback devp-action(string, int);
    callback devp-search(string);
    // macOS: shortcuts shown with ⌘ ⇧ ⌥, and the cursor image sized for points (winit maps an
    // image's pixels to points there).
    in property <bool> mac;
    // Canvas cursor from the app (ZK-47): 0 arrow of the Select tool, 1 crosshair, 2 I-beam,
    // 3 move, 4 nwse, 5 nesw, 6 ns, 7 ew, 8 grab, 9 grabbing.
    in property <int> canvas-cursor;
    in property <int> shadow-index;
    in property <int> glow-index;
    in property <string> geom-x2;
    in property <string> geom-y2;
    // Image tab (ZK-53): tone sliders as positions 0…1 plus their readings, crop panel, size.
    in-out property <float> tone-exposure: 0.5;
    in-out property <float> tone-gamma: 0.5;
    in-out property <float> tone-contrast: 0.5;
    in property <string> tone-exposure-text;
    in property <string> tone-gamma-text;
    in property <string> tone-contrast-text;
    in property <bool> tone-default: true;
    in property <bool> cropped;
    in property <bool> crop-lock;
    // ZK-188: the crop's proportions preset: 0 free, 1 16:9, 2 4:3, 3 1:1, 4 9:16, 5 its own.
    in property <int> crop-aspect;
    // The «Відео» tab (ZK-188): the part kept, the speed, the size on export.
    in property <float> vid-kept-frac: 1;
    in property <int> vid-speed-i: 1;
    in property <string> vid-out-w;
    in property <string> vid-out-h;
    in property <bool> vid-out-lock: true;
    in property <int> vid-out-preset;
    in-out property <string> crop-w;
    in-out property <string> crop-h;
    in property <string> crop-sizes;
    in property <string> crop-outside;
    in-out property <string> size-w;
    in-out property <string> size-h;
    in-out property <bool> size-keep: true;
    in-out property <bool> size-scale-text: false;
    // Kind whose properties are shown (-1 none): 0 rect, 1 ellipse, 2 line, 3 pen, 4 text,
    // 5 hide, 6 marker, 7 counter, 8 stamp, 9 image. For a selection or, without one, for the
    // current tool's defaults.
    in property <int> prop-kind: -1;
    in property <bool> prop-for-selection;
    in property <string> prop-title;
    in property <int> fill-index: -1;
    in property <int> dash-index;
    in property <int> corners-index;
    in property <int> head-start;
    in property <int> head-end: 1;
    in property <int> text-size-index: 1;
    // Point size of the text in screenshot pixels (editable; − / + step through the ladder).
    in-out property <string> text-size-px: "24";
    in property <bool> text-bold;
    in property <bool> text-italic;
    in-out property <float> alpha: 1.0;
    in-out property <string> geom-x;
    in-out property <string> geom-y;
    in-out property <string> geom-w;
    in-out property <string> geom-h;
    // The angle of the selected mark and whether its kind turns (ZK-164).
    in-out property <string> geom-rot;
    in property <bool> prop-can-turn;
    // Text on the picture (ZK-184): the panel, a reading running, the text (editable), a status.
    in property <bool> text-open;
    in property <bool> text-busy;
    in-out property <string> text-result;
    in property <string> text-status;
    callback text-start();
    callback text-close();
    callback text-copy-all();
    // The angle beside the pointer while turning (ZK-164); empty = hidden.
    in property <string> rot-hint;
    in property <float> rot-hint-x;
    in property <float> rot-hint-y;
    in property <[LayerRow]> layers;
    in property <string> info-size;
    in property <string> info-source;
    in property <string> info-taken;
    in property <string> info-path;
    in-out property <string> meta-title;
    in-out property <string> meta-description;
    in-out property <string> meta-author;
    in-out property <string> meta-rights;
    in-out property <string> meta-tags;
    // zoom slider position 0…1 (log scale 6 %…1600 %)
    in-out property <float> zoom-pos: 0.5;
    in property <string> hint;
    in-out property <string> hover-hint;

    // text editing overlay
    in-out property <bool> editing: false;
    in-out property <length> edit-x;
    in-out property <length> edit-y;
    in-out property <string> edit-text;

    // ---- over the screen (ZK-58): the window covers the frozen display, no bars and no
    // inspector; the frame (in window pixels) carries a floating rail and an action bar.
    in property <bool> over-screen;
    in property <length> ov-x;
    in property <length> ov-y;
    in property <length> ov-w;
    in property <length> ov-h;
    // The properties bar over the screen stands under the frame (no room above it), ZK-172.
    out property <bool> ov-bar-down: ov-panel.down;
    callback over-to-window();
    // ZK-119: QR codes and barcodes on the picture.
    callback read-codes();
    callback over-copy();
    callback over-close();
    out property <length> canvas-width: canvas-area.width;
    out property <length> canvas-height: canvas-area.height;

    // ---- callbacks
    callback new-shot();
    callback open-file();
    callback open-clipboard();
    callback open-card(string);
    callback search(string);
    callback back();
    callback undo();
    callback redo();
    callback copy();
    // True for a second after a successful copy: the Copy button shows a tick (LH behaviour, ZK-126).
    in-out property <bool> copied;
    callback export();
    callback autosave-toggled(bool);
    callback tool-chosen(int);
    // The Image button (ZK-163): pick a picture file, it becomes a mark.
    callback insert-image();
    // kind (0 down, 1 move, 2 up), x, y, button (0 left, 1 right, 2 middle), shift, ctrl (⌘ on macOS)
    callback pointer(int, length, length, int, bool, bool);
    // Ctrl held on the canvas = the Select tool for the moment (owner, 28.09).
    in-out property <bool> ctrl-held;
    callback wheel(length, length, length, length, bool, bool, bool);
    callback key(string, bool, bool, bool);
    callback commit-text(string);
    callback cancel-text();
    // ZK-49: typing right on the canvas — the hidden input reports its caret and selection.
    callback text-edited(int, int);
    callback text-cursor(int, int);
    callback canvas-double(length, length);
    public function edit-select(anchor: int, focus: int) {
        edit.set-selection-offsets(anchor, focus);
    }
    in property <int> text-align;
    // Counters and stamps (ZK-51).
    in property <int> counter-shape;
    in property <int> digit-index: -1;
    // Size step of the counter (S M L XL; -1 = none of them), ZK-166.
    in property <int> counter-size;
    in property <int> stamp-size: 1;
    in-out property <string> counter-start;
    in property <string> counter-next;
    in property <int> stamp-id;
    callback set-counter-start(string);
    in-out property <string> text-box;
    callback set-text-box(string);
    callback arrange(int);
    callback align(int);
    callback distribute(int);
    callback group(bool);
    callback duplicate();
    callback zoom-fit();
    callback zoom-100();
    callback zoom-to(float);
    callback set-prop(string, int);
    callback set-alpha(float, bool);
    callback set-geom(string, string);
    callback set-text-size(string);
    callback layer-click(int, bool);
    callback layer-eye(int);
    // Group header row: click selects every member, the eye hides them all, the chevron folds.
    callback layer-group-click(int, bool);
    callback layer-group-eye(int);
    callback layer-collapse(int);
    // Dragging a row (ZK-54): row index, y in the list (px from its top), phase 0 move,
    // 1 drop, 2 cancel. The app answers with where it would land: `layer-drop-row` and
    // `layer-drop-mode` (0 line above the row, 1 onto the row = group, 2 line below it).
    callback layer-drag(int, length, int);
    in-out property <int> layer-drag-from: -1;
    in-out property <length> layer-drag-y;
    in property <int> layer-drop-row: -1;
    in property <int> layer-drop-mode;
    callback meta-edited(string, string);
    callback image-action(string);
    callback drag-out();
    // ZK-61: write title, description, author, rights, tags and date into exported files.
    in property <bool> export-meta: true;
    callback toggle-export-meta();
    // Library cards (ZK-55) and the message line's action ("Undo").
    callback save-as();
    callback card-trash(string, bool);
    callback card-rename(string, string);
    callback card-reveal(string);
    // ZK-176: a card clicked with Ctrl / ⌘ (1) or Shift (2), or plainly in the trash (0).
    callback card-click(string, int);
    // ZK-175/176: view-library, view-trash, pick-all, pick-none, picked-trash, picked-restore,
    // picked-destroy, trash-empty; restore / destroy with the card's path.
    callback lib-action(string, string);
    // ZK-177: the grid's columns (the places are computed in Rust); ZK-179: a key in the grid.
    callback lib-layout(int);
    // ZK-181: play/pause/back/fwd/home/end/loop/mute/speed/fit/zoom-in/zoom-out; the timeline's
    // actions (cut, keep, split, in, out, restore <frame>, reset, deselect, frame-shot, sound
    // <mode>, track-mute/unmute <i>); the pointer over the tracks (0 down, 1 move, 2 up), the
    // wheel (x, delta, Ctrl) and the track area's width.
    callback vid-transport(string);
    callback vid-action(string, int);
    // ZK-190: the video's share menu (copy-mp4, copy-gif, copy-frame, export, library, frame-shot).
    callback vid-share(string);
    // ZK-188: W or H of the size on export typed in.
    callback vid-out-edited(string, string);
    callback tl-pointer(int, length, length, bool);
    in property <int> tl-hot;
    in property <int> tl-hot-mark: -1;
    in property <int> tl-hot-grip;
    callback tl-wheel(length, float, bool);
    callback tl-layout(length);
    callback lib-key(string, bool);
    // The keyboard's card came into view: title rows and card rows above it.
    public function lib-scroll-to(hb: int, rb: int) {
        grid.scroll-to(hb, rb);
    }
    in property <string> toast-action;
    callback toast-action-clicked();
    // Settings page (ZK-56): page 2 of the window.
    callback settings-open();
    callback setting(string, int);
    in-out property <int> settings-page: 0;
    in property <bool> pref-capture;
    in property <bool> pref-quick-library;
    // ZK-155: the action of each gesture (0 editor, 1 over the screen, 2 clipboard); ZK-156.
    in property <int> pref-gesture-plain: 0;
    in property <int> pref-gesture-shift: 2;
    in property <int> pref-gesture-alt: 1;
    in property <bool> pref-show-hints: true;
    // The «For developers» page is revealed for this build (ZK-140).
    in property <bool> pref-dev-page;
    in property <bool> pref-keep-tool;
    in property <bool> pref-autosave;
    in property <bool> pref-metadata;
    in property <bool> pref-updates;
    // Agents page (ZK-132).
    in property <bool> pref-mcp;
    in property <[AgentClient]> agent-clients;
    in property <[string]> agent-log;
    in property <string> agent-model;
    // Updates page.
    in property <string> upd-version;
    in property <string> upd-last;
    in property <string> upd-status;
    in property <bool> upd-busy;
    in property <bool> upd-can-install;
    in property <bool> upd-can-open;
    // macOS (ZK-143): download / unpacking progress 0…1, hidden below 0.
    in property <float> upd-progress: -1;
    in property <int> pref-lang;
    in property <bool> pref-ret-size;
    in-out property <string> pref-ret-count;
    in-out property <string> pref-trash-days;
    // ZK-186: the search by text on the screenshots, and how far the reading is.
    in property <bool> pref-lib-search-text;
    in property <string> lib-text-status;
    // Recording (ZK-180): 30 / 60; quality 0–2; a clicked window followed; sound 0–3 (ZK-189).
    in property <int> pref-rec-fps: 30;
    in property <int> pref-rec-quality: 1;
    in property <bool> pref-rec-follow: true;
    in property <bool> pref-rec-open-editor: true;
    in property <int> pref-rec-sound;
    // Devices of the sound choice (ZK-189): the default first, then the active ones.
    in property <[string]> rec-sys-devices: ["—"];
    in property <int> rec-sys-device;
    in property <[string]> rec-mic-devices: ["—"];
    in property <int> rec-mic-device;
    in property <bool> pref-rec-cursor: true;
    // ZK-97: the browser's log, the extension may start, how many browsers are connected.
    in property <bool> pref-rec-devlog: true;
    in property <bool> pref-rec-ext-control: true;
    // ZK-98: hiding in a report — 0 ask, 1 always, 2 never — and the keys.
    in property <int> pref-rec-hide;
    in property <string> pref-rec-hide-keys;
    // ZK-245: the report's signature
    in property <string> pref-rec-sign-name;
    in property <string> pref-rec-sign-contact;
    in property <string> pref-rec-sign-rights;
    callback setting-text(string, string);
    // ZK-101: Extensions and integrations. `int-action(what, target)`: check, find-chat,
    // add-webhook, remove-webhook, default, store, plugin.
    callback int-action(string, string);
    in property <bool> int-chrome-on;
    in property <bool> int-logi-on;
    in property <bool> int-tg-enabled;
    in property <bool> int-tg-token-set;
    in property <string> int-tg-chat;
    in property <string> int-tg-chat-title;
    in property <string> int-tg-status;
    in property <bool> int-tg-busy;
    in property <bool> int-jira-enabled;
    in property <string> int-jira-site;
    in property <string> int-jira-email;
    in property <bool> int-jira-token-set;
    in property <string> int-jira-project;
    in property <string> int-jira-issue;
    in property <string> int-jira-type;
    in property <string> int-jira-status;
    in property <bool> int-jira-busy;
    in property <bool> int-google-available;
    in property <bool> int-google-enabled;
    in property <bool> int-google-link;
    in property <[IntGoogleAccount]> int-google-accounts;
    in property <string> int-google-status;
    in property <bool> int-google-busy;
    in property <bool> int-slack-enabled;
    in property <bool> int-slack-token-set;
    in property <string> int-slack-channel;
    in property <string> int-slack-status;
    in property <bool> int-slack-busy;
    in property <bool> int-rm-enabled;
    in property <string> int-rm-url;
    in property <bool> int-rm-key-set;
    in property <string> int-rm-project;
    in property <string> int-rm-issue;
    in property <string> int-rm-status;
    in property <bool> int-rm-busy;
    in property <[IntWebhook]> int-webhooks;
    in property <[IntTarget]> int-targets;
    in property <string> int-default;
    in property <string> rec-browsers;
    in property <bool> rec-browsers-on;
    in-out property <string> pref-ret-mb;
    // The videos' own size limit, MB (ZK-100).
    in-out property <string> pref-video-mb;
    // What the library shows (ZK-100): 0 all, 1 screenshots, 2 videos.
    in property <int> lib-kind;
    in property <string> pref-lib-dir;
    // The words before the date in new names (ZK-221).
    in property <string> pref-shot-prefix;
    in property <string> pref-video-prefix;
    in property <string> pref-file;
    in property <string> pref-version;
    // The commit and the platform on the About page (ZK-198).
    in property <string> pref-build;
    // Start at login (ZK-57 / ZK-77) and the first-run guide.
    in property <bool> pref-autostart;
    in property <bool> pref-autostart-ok: true;
    in property <string> pref-autostart-note;
    in property <bool> onb-screen-ok: true;
    in property <string> onb-keys;
    // One line for the guide: which combinations are taken, what works instead.
    in property <string> onb-keys-warn;
    // Hotkeys page (ZK-44): region, screen, clipboard, empty editor.
    in property <[string]> key-texts;
    in property <[string]> key-warns;
    in property <int> key-recording: -1;
    public function focus-settings() { set-keys.focus(); }
    callback set-tone(string, float, bool);
    callback compare(bool);
    callback set-crop-size(string, string);
    callback size-edited(string, string);

    public function focus-library() { lib-keys.focus(); }
    public function focus-canvas() { keys.focus(); }

    // ================================================================= library
    Rectangle {
        opacity: root.page == 0 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 160ms; easing: ease-in-out; }
        background: Theme.app;
        lib-keys := FocusScope {
            key-pressed(e) => {
                if (e.modifiers.control && (e.text == "v" || e.text == "V" || e.text == "м" || e.text == "М")) {
                    root.open-clipboard();
                    return accept;
                }
                if (e.modifiers.control && (e.text == "o" || e.text == "O" || e.text == "щ" || e.text == "Щ")) {
                    root.open-file();
                    return accept;
                }
                // ZK-176: all the cards shown, none, the picked ones away.
                if (e.modifiers.control && (e.text == "a" || e.text == "A" || e.text == "ф" || e.text == "Ф")) {
                    root.lib-action("pick-all", "");
                    return accept;
                }
                if (e.text == Key.Escape && root.picked-count > 0) {
                    root.lib-action("pick-none", "");
                    return accept;
                }
                if (e.text == Key.Delete || e.text == Key.Backspace) {
                    root.lib-key("delete", false);
                    return accept;
                }
                // ZK-179: moving through the grid (Shift: the pick grows), Enter, Space, F2.
                if (e.text == Key.LeftArrow) { root.lib-key("left", e.modifiers.shift); return accept; }
                if (e.text == Key.RightArrow) { root.lib-key("right", e.modifiers.shift); return accept; }
                if (e.text == Key.UpArrow) { root.lib-key("up", e.modifiers.shift); return accept; }
                if (e.text == Key.DownArrow) { root.lib-key("down", e.modifiers.shift); return accept; }
                if (e.text == Key.Home) { root.lib-key("home", e.modifiers.shift); return accept; }
                if (e.text == Key.End) { root.lib-key("end", e.modifiers.shift); return accept; }
                if (e.text == Key.Return) { root.lib-key("enter", false); return accept; }
                if (e.text == " ") { root.lib-key("space", false); return accept; }
                if (e.text == Key.F2) { root.lib-key("f2", false); return accept; }
                return reject;
            }
            VerticalLayout {
                Rectangle {
                    height: 52px;
                    background: Theme.panel;
                    DragArea { drag => { root.window-drag(); } toggle => { root.window-toggle(); } }
                    if root.custom-frame: WindowControls {
                        x: parent.width - self.width;
                        height: parent.height;
                        maximized: root.win-maximized;
                        minimize => { root.window-minimize(); }
                        toggle => { root.window-toggle(); }
                        close => { root.window-close(); }
                    }
                    HorizontalLayout {
                        padding-left: 16px + root.lights-inset;
                        padding-right: root.custom-frame ? 146px : 16px;
                        spacing: 12px;
                        // The app icon, as in the editor's header.
                        Image {
                            y: (parent.height - self.height) / 2;
                            width: 26px; height: 26px;
                            source: @image-url("../icons/app-64.png");
                        }
                        // The library or its trash (ZK-175).
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 230px;
                            height: 32px;
                            border-radius: 9px;
                            background: Theme.elevated;
                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;
                                SegOption { text: @tr("lib-title" => "Library"); on: !root.trash-view; clicked => { root.lib-action("view-library", ""); } }
                                SegOption { text: root.trash-count > 0 ? @tr("lib-trash-tab" => "Trash") + " · " + root.trash-count : @tr("lib-trash-tab" => "Trash"); on: root.trash-view; clicked => { root.lib-action("view-trash", ""); } }
                            }
                        }
                        // All / screenshots / videos (ZK-100).
                        if !root.trash-view: Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 250px;
                            height: 32px;
                            border-radius: 9px;
                            background: Theme.elevated;
                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;
                                SegOption { text: @tr("lib-kind-all" => "All"); on: root.lib-kind == 0; clicked => { root.lib-action("kind-all", ""); } }
                                SegOption { text: @tr("lib-kind-shots" => "Shots"); on: root.lib-kind == 1; clicked => { root.lib-action("kind-shots", ""); } }
                                SegOption { text: @tr("lib-kind-videos" => "Videos"); on: root.lib-kind == 2; clicked => { root.lib-action("kind-videos", ""); } }
                            }
                        }
                        Rectangle {
                            width: 300px;
                            LineEdit {
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                placeholder-text: @tr("lib-search" => "Search by name, tag or text in the screenshot");
                                edited(t) => { root.search(t); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.trash-view: TextButton {
                            y: (parent.height - self.height) / 2;
                            text: @tr("trash-destroy-all" => "Destroy all");
                            icon: "M4 7 h16 M10 11 v6 M14 11 v6 M6 7 l1 12 a2 2 0 0 0 2 2 h6 a2 2 0 0 0 2 -2 l1 -12 M9 7 V4 h6 v3";
                            enabled: root.cards.length > 0;
                            clicked => { root.lib-action("trash-empty", ""); }
                        }
                        if !root.trash-view: TextButton {
                            y: (parent.height - self.height) / 2;
                            text: @tr("lib-new-shot" => "New screenshot");
                            icon: "M12 5 v14 M5 12 h14";
                            primary: true;
                            enabled: root.capture-available;
                            clicked => { root.new-shot(); }
                        }
                        if !root.trash-view: TextButton {
                            y: (parent.height - self.height) / 2;
                            text: @tr("open-file" => "File…");
                            icon: "M3 7 a2 2 0 0 1 2 -2 h4 l2 2 h8 a2 2 0 0 1 2 2 v9 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 z";
                            clicked => { root.open-file(); }
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: "M12 9 a3 3 0 1 0 0 6 a3 3 0 1 0 0 -6 z M19.4 15 a1.7 1.7 0 0 0 .3 1.8 l.1 .1 a2 2 0 1 1 -2.8 2.8 l-.1 -.1 a1.7 1.7 0 0 0 -1.8 -.3 a1.7 1.7 0 0 0 -1 1.5 V21 a2 2 0 1 1 -4 0 v-.1 a1.7 1.7 0 0 0 -1.1 -1.5 a1.7 1.7 0 0 0 -1.8 .3 l-.1 .1 a2 2 0 1 1 -2.8 -2.8 l.1 -.1 a1.7 1.7 0 0 0 .3 -1.8 a1.7 1.7 0 0 0 -1.5 -1 H3 a2 2 0 1 1 0 -4 h.1 a1.7 1.7 0 0 0 1.5 -1.1 a1.7 1.7 0 0 0 -.3 -1.8 l-.1 -.1 a2 2 0 1 1 2.8 -2.8 l.1 .1 a1.7 1.7 0 0 0 1.8 .3 H9 a1.7 1.7 0 0 0 1 -1.5 V3 a2 2 0 1 1 4 0 v.1 a1.7 1.7 0 0 0 1 1.5 a1.7 1.7 0 0 0 1.8 -.3 l.1 -.1 a2 2 0 1 1 2.8 2.8 l-.1 .1 a1.7 1.7 0 0 0 -.3 1.8 V9 a1.7 1.7 0 0 0 1.5 1 H21 a2 2 0 1 1 0 4 h-.1 a1.7 1.7 0 0 0 -1.5 1 z";
                            label: @tr("nav-settings" => "Settings");
                            clicked => { root.settings-open(); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                grid := Rectangle {
                    vertical-stretch: 1;
                    property <length> gap: 16px;
                    property <int> cols: max(1, floor((self.width - 32px + gap) / (240px + gap)));
                    property <length> cw: (self.width - 32px - (cols - 1) * gap) / cols;
                    property <length> ch: cw * 0.62 + 56px;
                    // A group title's height (ZK-177).
                    property <length> hh: 40px;
                    changed cols => { root.lib-layout(self.cols); }
                    init => { root.lib-layout(self.cols); }
                    function row-y(hb: int, rb: int) -> length {
                        16px + hb * self.hh + rb * (self.ch + self.gap)
                    }
                    public function scroll-to(hb: int, rb: int) {
                        // The card's top and bottom in the content; the view moves as little
                        // as it can to show it whole.
                        lib-sv.content-y = min(0px, max(-(self.row-y(hb, rb) - 8px), min(lib-sv.content-y, -(self.row-y(hb, rb) + self.ch + 8px - lib-sv.visible-height))));
                    }
                    if root.cards.length == 0 && root.trash-view: VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text { text: @tr("trash-empty-title" => "The trash is empty"); color: Theme.text; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: @tr("trash-empty-body" => "Deleted documents stay here for {0} days, then go for good. The term is in Settings → Library.", root.pref-trash-days); color: Theme.text2; horizontal-alignment: center; wrap: word-wrap; }
                    }
                    if root.cards.length == 0 && !root.trash-view: VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text { text: @tr("lib-empty-title" => "Your screenshots will appear here"); color: Theme.text; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: @tr("lib-empty-body" => "Press {0} to capture a region, or use the button below.", root.capture-key); color: Theme.text2; horizontal-alignment: center; }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            TextButton {
                                text: @tr("lib-new-shot" => "New screenshot");
                                icon: "M12 5 v14 M5 12 h14";
                                primary: true;
                                enabled: root.capture-available;
                                clicked => { root.new-shot(); }
                            }
                            TextButton {
                                text: @tr("open-clipboard" => "From clipboard");
                                clicked => { root.open-clipboard(); }
                            }
                        }
                        Text { text: @tr("lib-empty-drop" => "Drop an image here to open it"); color: Theme.text3; horizontal-alignment: center; }
                        Text { text: root.library-dir; color: Theme.text3; font-size: 11px; horizontal-alignment: center; }
                    }
                    lib-sv := ScrollView {
                        visible: root.cards.length > 0;
                        content-height: grid.row-y(root.lib-hb, root.lib-rb) + 16px;
                        // Group titles (ZK-177).
                        for h in root.lib-headers: Text {
                            x: 18px;
                            y: grid.row-y(h.hb, h.rb) + 8px;
                            width: grid.width - 36px;
                            height: grid.hh - 8px;
                            text: h.title;
                            color: Theme.text2;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        for card[i] in root.cards: CardView {
                            x: 16px + card.col * (grid.cw + grid.gap);
                            y: grid.row-y(card.hb, card.rb);
                            width: grid.cw;
                            height: grid.ch;
                            data: card;
                            in-trash: root.trash-view;
                            rename-tick: root.lib-rename-tick;
                            pin => { root.lib-action("pin", card.path); }
                            left-rename => { lib-keys.focus(); }
                            open => { root.open-card(card.path); }
                            pick(m) => { root.card-click(card.path, m); }
                            rename(name) => { root.card-rename(card.path, name); }
                            trash(forever) => { root.card-trash(card.path, forever); }
                            reveal => { root.card-reveal(card.path); }
                            restore => { root.lib-action("restore", card.path); }
                            destroy => { root.lib-action("destroy", card.path); }
                        }
                    }
                    // Cards picked (ZK-176): how many, and what to do with them.
                    if root.picked-count > 0: Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 16px;
                        width: pick-bar.preferred-width;
                        height: 48px;
                        border-radius: 12px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.line;
                        drop-shadow-blur: 18px;
                        drop-shadow-color: #00000060;
                        pick-bar := HorizontalLayout {
                            padding: 8px;
                            padding-left: 16px;
                            spacing: 8px;
                            Text { text: @tr("lib-picked" => "Selected: {0}", root.picked-count); color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                            if !root.trash-view: TextButton { text: root.picked-pinned ? @tr("lib-unpin" => "Unpin") : @tr("lib-pin-short" => "Pin"); clicked => { root.lib-action("picked-pin", ""); } }
                            if !root.trash-view: TextButton { text: @tr("lib-trash-long" => "Move to trash"); clicked => { root.lib-action("picked-trash", ""); } }
                            if root.trash-view: TextButton { text: @tr("trash-restore" => "Restore"); clicked => { root.lib-action("picked-restore", ""); } }
                            if root.trash-view: TextButton { text: @tr("trash-destroy" => "Destroy"); clicked => { root.lib-action("picked-destroy", ""); } }
                            IconButton { icon: "M6 6 L18 18 M18 6 L6 18"; label: @tr("lib-pick-none" => "Clear selection"); tip: self.label + "  Esc"; clicked => { root.lib-action("pick-none", ""); } }
                        }
                    }
                }
                Rectangle {
                    height: 30px;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text { text: root.toast != "" ? root.toast : root.library-dir; color: root.toast != "" ? Theme.accent-text : Theme.text3; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        if root.toast != "" && root.toast-action != "": VerticalLayout {
                            alignment: center;
                            SmallButton { text: root.toast-action; clicked => { root.toast-action-clicked(); } }
                        }
                    }
                }
            }
            init => { self.focus(); }
        }
    }

    // ============================================================ first run (ZK-57)
    // Once, before anything else: what Znimok needs from this system, each step one card.
    Rectangle {
        opacity: root.page == 3 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 200ms; easing: ease-in-out; }
        background: Theme.app;
        TouchArea { }
        // Title bar: drags the window like the other pages' bars.
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 52px;
            background: Theme.panel;
            DragArea { x: 0; y: 0; width: parent.width; height: parent.height; drag => { root.window-drag(); } toggle => { root.window-toggle(); } }
            HorizontalLayout {
                padding-left: 16px + root.lights-inset;
                spacing: 12px;
                alignment: start;
                // The app icon (the designer's PNG, 29.09).
                Image {
                    y: (parent.height - self.height) / 2;
                    width: 26px; height: 26px;
                    source: @image-url("../icons/app-64.png");
                }
                Text { text: "Znimok"; color: Theme.text; font-family: "Unbounded"; font-size: 15px; font-weight: 600; vertical-alignment: center; }
            }
            if root.custom-frame: WindowControls {
                x: parent.width - self.width;
                y: 0;
                height: parent.height;
                maximized: root.win-maximized;
                minimize => { root.window-minimize(); }
                toggle => { root.window-toggle(); }
                close => { root.window-close(); }
            }
        }
        Rectangle { x: 0; y: 52px; width: parent.width; height: 1px; background: Theme.line; }
        VerticalLayout {
            x: (parent.width - self.width) / 2;
            y: 53px;
            width: min(parent.width - 48px, 620px);
            height: parent.height - 53px;
            alignment: center;
            spacing: 14px;
            Text { text: root.mac ? @tr("onb-title-mac" => "Three permissions — and Znimok is ready") : @tr("onb-title-win" => "Two steps — and Znimok is ready"); color: Theme.text; font-size: 22px; font-weight: 700; wrap: word-wrap; }
            Text { text: root.mac ? @tr("onb-intro-mac" => "macOS asks for permission for everything that sees the screen. Znimok works only on your Mac and sends nothing anywhere without your action.") : @tr("onb-intro-win" => "Znimok needs no administrator rights and sends nothing anywhere without your action. Check the hotkeys and choose where screenshots live."); color: Theme.text2; font-size: 13px; wrap: word-wrap; }
            // Screen recording (macOS only)
            if root.mac: Rectangle {
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: root.onb-screen-ok ? #34C48A55 : Theme.control-on;
                height: screen-lay.preferred-height;
                screen-lay := HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: @tr("onb-screen" => "Screen and system audio recording"); color: Theme.text; font-size: 14px; font-weight: 600; }
                        Text { text: root.onb-screen-ok ? @tr("onb-screen-granted" => "Granted. Needed for any capture.") : @tr("onb-screen-needed" => "Needed for any capture. macOS will ask you to restart Znimok."); color: root.onb-screen-ok ? Theme.ok : Theme.text3; font-size: 12px; wrap: word-wrap; }
                    }
                    if !root.onb-screen-ok: VerticalLayout {
                        alignment: center;
                        TextButton { text: @tr("onb-allow" => "Allow"); primary: true; clicked => { root.setting("onb-screen", 0); } }
                    }
                }
            }
            // Hotkeys
            Rectangle {
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.control-on;
                height: keys-lay.preferred-height;
                keys-lay := HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: @tr("onb-keys" => "Hotkeys"); color: Theme.text; font-size: 14px; font-weight: 600; }
                        Text { text: root.onb-keys; color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                        if root.onb-keys-warn != "": Text { text: root.onb-keys-warn; color: Theme.attention; font-size: 11px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton { text: @tr("onb-open-settings" => "Open settings"); clicked => { root.setting("onb-keys", 0); } }
                    }
                }
            }
            // Library folder
            Rectangle {
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.control-on;
                height: lib-lay.preferred-height;
                lib-lay := HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: @tr("onb-library" => "Library folder"); color: Theme.text; font-size: 14px; font-weight: 600; }
                        Text { text: @tr("onb-library-hint" => "All screenshots and videos live here as files. You can pick a folder on a cloud drive."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                        Text { text: root.pref-lib-dir; color: Theme.text2; font-size: 11px; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton { text: @tr("common-change-ellipsis" => "Change…"); clicked => { root.setting("lib-folder", 0); } }
                    }
                }
            }
            // Start at login
            if root.pref-autostart-ok: Rectangle {
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.control-on;
                height: auto-lay.preferred-height;
                auto-lay := VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    SwitchRow { text: @tr("look-autostart" => "Start at sign-in"); checked: root.pref-autostart; toggled => { root.setting("autostart", self.checked ? 1 : 0); } }
                    if root.pref-autostart-note != "": Text { text: root.pref-autostart-note; color: Theme.attention; font-size: 11px; wrap: word-wrap; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                onb-hide := CheckBox { text: @tr("onb-dont-show" => "Don't show next time"); checked: true; }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: @tr("onb-skip-all" => "Skip all"); clicked => { root.setting("onb-done", onb-hide.checked ? 1 : 0); } }
                TextButton { text: @tr("common-done" => "Done"); primary: true; clicked => { root.setting("onb-done", onb-hide.checked ? 1 : 0); } }
            }
        }
    }

    // ================================================================ settings (ZK-56)
    // Inside the main window (not a separate one, PLAN): pages on the left, the page on the
    // right; every change applies and saves at once. Esc or the back arrow returns.
    Rectangle {
        opacity: root.page == 2 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 160ms; easing: ease-in-out; }
        background: Theme.app;
        set-keys := FocusScope {
            enabled: root.page == 2;
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.setting("close", 0); return accept; }
                return reject;
            }
            VerticalLayout {
                Rectangle {
                    height: 52px;
                    background: Theme.panel;
                    DragArea { drag => { root.window-drag(); } toggle => { root.window-toggle(); } }
                    if root.custom-frame: WindowControls {
                        x: parent.width - self.width;
                        height: parent.height;
                        maximized: root.win-maximized;
                        minimize => { root.window-minimize(); }
                        toggle => { root.window-toggle(); }
                        close => { root.window-close(); }
                    }
                    HorizontalLayout {
                        padding-left: 12px + root.lights-inset;
                        padding-right: root.custom-frame ? 146px : 16px;
                        spacing: 8px;
                        IconButton { y: (parent.height - self.height) / 2; icon: "M15 5 l-7 7 7 7"; label: @tr("common-close" => "Close") + "  Esc"; clicked => { root.setting("close", 0); } }
                        Text { text: @tr("set-title" => "Settings"); color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        // Ten clicks here show or hide «For developers» (ZK-140). Nothing about it
                        // looks clickable, and it takes the clicks so a double one does not
                        // maximize the window as the title bar would.
                        Rectangle {
                            width: applied-text.preferred-width;
                            applied-text := Text { text: @tr("set-applied-now" => "Changes apply immediately"); color: Theme.text3; font-size: 12px; vertical-alignment: center; height: parent.height; }
                            TouchArea {
                                property <int> clicks;
                                mouse-cursor: default;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        self.clicks += 1;
                                        if (self.clicks >= 10) {
                                            self.clicks = 0;
                                            root.setting("dev-toggle", 0);
                                        }
                                    }
                                }
                                double-clicked => { }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout {
                    vertical-stretch: 1;
                    // pages
                    Rectangle {
                        width: 232px;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 2px;
                            alignment: start;
                            // Page numbers stay as they were (the code and the self-test use them); the
                            // list shows them in the design's order. -1 = not yet (stable layout).
                            for t in [
                                { p: 0, t: @tr("set-page-shots" => "Screenshots") },
                                { p: 10, t: @tr("set-page-recording" => "Recording") },
                                { p: 1, t: @tr("set-page-keys" => "Hotkeys") },
                                { p: 2, t: @tr("set-page-library" => "Library") },
                                { p: 3, t: @tr("set-page-sharing" => "Sharing") },
                                { p: 11, t: @tr("set-page-integrations" => "Extensions and integrations") },
                                { p: 8, t: @tr("set-page-agents" => "Agents and models") },
                                { p: 4, t: @tr("set-page-look" => "Appearance and language") },
                                { p: 5, t: @tr("set-page-privacy" => "Privacy") },
                                { p: 9, t: @tr("set-page-updates" => "Updates") },
                                { p: 6, t: @tr("set-page-about" => "About Znimok") },
                                { p: 7, t: @tr("dev-page" => "For developers") },
                            ]: Rectangle {
                                // «For developers» only when revealed (ZK-140).
                                visible: t.p != 7 || root.pref-dev-page;
                                height: self.visible ? 34px : 0px;
                                border-radius: 8px;
                                background: t.p >= 0 && root.settings-page == t.p ? Theme.control-on : (nav-ta.has-hover && t.p >= 0 ? Theme.elevated : transparent);
                                animate background { duration: 120ms; }
                                Text { x: 12px; text: t.t; color: t.p < 0 ? Theme.disabled : (root.settings-page == t.p ? Theme.text : Theme.text2); font-size: 13px; font-weight: root.settings-page == t.p ? 600 : 400; vertical-alignment: center; height: parent.height; }
                                nav-ta := TipTouch {
                                    enabled: t.p >= 0;
                                    tip: t.p < 0 ? @tr("common-in-development" => "Coming soon") : "";
                                    tip-side: 1;
                                    clicked => { root.settings-page = t.p; }
                                }
                            }
                        }
                    }
                    Rectangle { width: 1px; background: Theme.line; }
                    // the page
                    set-sv := ScrollView {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            x: 0;
                            // A readable column: never wider than 680 px, never wider than the view.
                            width: min(set-sv.visible-width - 12px, 680px);
                            padding: 28px;
                            spacing: 18px;
                            alignment: start;
                            // ---- Screenshots
                            if root.settings-page == 0: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("shots-intro" => "What happens when you release the mouse in the overlay. Each action sits on exactly one gesture."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                // ZK-155: a gesture per row; choosing an action another gesture has swaps the two.
                                Text { text: @tr("shots-gestures" => "What a capture does on release"); color: Theme.text; font-size: 13px; font-weight: 600; }
                                for row in [
                                    { key: "gesture-plain", label: @tr("shots-gesture-plain" => "Release"), act: root.pref-gesture-plain },
                                    { key: "gesture-shift", label: @tr("shots-gesture-shift" => "Shift + release"), act: root.pref-gesture-shift },
                                    { key: "gesture-alt", label: root.mac ? @tr("shots-gesture-option" => "⌥ + release") : @tr("shots-gesture-alt" => "Alt + release"), act: root.pref-gesture-alt },
                                ]: HorizontalLayout {
                                    spacing: 10px;
                                    Text { width: 130px; text: row.label; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                                    SegOption { text: @tr("shots-seg-editor" => "Editor"); on: row.act == 0; clicked => { root.setting(row.key, 0); } }
                                    SegOption { text: @tr("shots-seg-over" => "Over the screen"); on: row.act == 1; clicked => { root.setting(row.key, 1); } }
                                    SegOption { text: @tr("shots-seg-clipboard" => "Clipboard"); on: row.act == 2; clicked => { root.setting(row.key, 2); } }
                                }
                                SwitchRow { text: @tr("shots-show-hints" => "Show the hint strip while capturing"); checked: root.pref-show-hints; toggled => { root.setting("show-hints", self.checked ? 1 : 0); } }
                                SwitchRow { text: @tr("shots-quick-library" => "Quick captures go to the library too"); checked: root.pref-quick-library; toggled => { root.setting("quick-library", self.checked ? 1 : 0); } }
                                SwitchRow { text: @tr("shots-tool-stays" => "The tool stays active after drawing"); checked: root.pref-keep-tool; toggled => { root.setting("keep-tool", self.checked ? 1 : 0); } }
                                SwitchRow { text: @tr("shots-autosave" => "Save automatically (also in the editor title bar)"); checked: root.pref-autosave; toggled => { root.setting("autosave", self.checked ? 1 : 0); } }
                            }
                            // ---- Hotkeys (choosing other combinations: ZK-44)
                            if root.settings-page == 1: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("keys-intro" => "They work in any program. Click a field and press a combination to change it. On a Mac the standard ⌘⇧3/4/5 belong to the system, so the defaults are different."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                SwitchRow { text: @tr("keys-enable" => "Capture with hotkeys"); checked: root.pref-capture; toggled => { root.setting("capture", self.checked ? 1 : 0); } }
                                Text { text: @tr("keys-enable-hint" => "Off — the combinations are free for other programs"); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                for label[i] in [
                                    @tr("keys-region" => "Region screenshot"),
                                    @tr("keys-screen" => "Whole-screen screenshot"),
                                    @tr("keys-clipboard" => "Clipboard image → editor"),
                                    @tr("keys-blank" => "Blank editor"),
                                    @tr("keys-read-codes" => "Read QR codes on the screen"),
                                    @tr("keys-read-text" => "Copy text from the screen"),
                                    @tr("keys-video" => "Start / stop video recording"),
                                ]: VerticalLayout {
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text { text: label; color: Theme.text2; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                        // Click, then press the combination (Esc — cancel, Backspace — none).
                                        Rectangle {
                                            width: 170px;
                                            height: 30px;
                                            border-radius: 7px;
                                            background: root.key-recording == i ? #3D7BF526 : (key-ta.has-hover ? Theme.control-on : Theme.elevated);
                                            border-width: root.key-recording == i ? 1.5px : 1px;
                                            border-color: root.key-recording == i ? Theme.accent : Theme.control-on;
                                            animate background, border-color { duration: 120ms; }
                                            Text {
                                                text: root.key-recording == i ? @tr("keys-press" => "press a combination…") : root.key-texts[i];
                                                font-family: root.key-recording == i ? "Onest" : "JetBrains Mono";
                                                color: root.key-recording == i ? Theme.accent-text : (root.pref-capture ? Theme.text : Theme.disabled);
                                                font-size: 12px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                width: parent.width;
                                                height: parent.height;
                                            }
                                            key-ta := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.setting("key-record", i); }
                                            }
                                        }
                                    }
                                    if root.key-warns[i] != "": Text { text: root.key-warns[i]; color: Theme.attention; font-size: 11px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    TextButton { text: @tr("keys-defaults" => "Restore defaults"); clicked => { root.setting("keys-defaults", 0); } }
                                }
                            }
                            // ---- Library
                            if root.settings-page == 2: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("libset-intro" => "The folder is the source of truth. You can keep it on a cloud drive and Znimok will pick up changes."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                Text { text: @tr("libset-folder" => "Library folder"); color: Theme.text2; font-size: 12px; }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 7px;
                                    background: Theme.elevated;
                                    Text { x: 10px; width: parent.width - 20px; text: root.pref-lib-dir; color: Theme.text; font-size: 12px; vertical-alignment: center; height: parent.height; overflow: elide; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    TextButton { text: @tr("common-change-ellipsis" => "Change…"); clicked => { root.setting("lib-folder", 0); } }
                                    TextButton { text: @tr("libset-show-folder" => "Show folder"); clicked => { root.setting("show-folder", 0); } }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                // ZK-221: the person's own words before the date in new names.
                                Text { text: @tr("libset-names" => "Names of new documents"); color: Theme.text2; font-size: 12px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: @tr("libset-shot-prefix" => "Screenshots"); color: Theme.text3; font-size: 11px; }
                                        LineEdit { text: root.pref-shot-prefix; placeholder-text: @tr("doc-kind-screenshot" => "Screenshot"); edited(t) => { root.setting-text("shot-prefix", t); } }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: @tr("libset-video-prefix" => "Recordings"); color: Theme.text3; font-size: 11px; }
                                        LineEdit { text: root.pref-video-prefix; placeholder-text: @tr("libset-video-word" => "Recording"); edited(t) => { root.setting-text("video-prefix", t); } }
                                    }
                                }
                                Text { text: @tr("libset-names-hint" => "The word before the date and the time, as in «Screenshot 2026-10-02 12.00.00». Empty: the usual word."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                Rectangle { height: 1px; background: Theme.line; }
                                Text { text: @tr("libset-keep-shots" => "Keep screenshots no more than"); color: Theme.text2; font-size: 12px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 200px;
                                        height: 30px;
                                        border-radius: 8px;
                                        background: Theme.elevated;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            SegOption { text: @tr("libset-by-count" => "count"); on: !root.pref-ret-size; clicked => { root.setting("ret-by", 0); } }
                                            SegOption { text: @tr("libset-by-size" => "size"); on: root.pref-ret-size; clicked => { root.setting("ret-by", 1); } }
                                        }
                                    }
                                    if !root.pref-ret-size: NumField { width: 110px; label: ""; value <=> root.pref-ret-count; committed(v) => { root.setting("ret-count", 0); } }
                                    if root.pref-ret-size: NumField { width: 110px; label: ""; value <=> root.pref-ret-mb; committed(v) => { root.setting("ret-mb", 0); } }
                                    Text { text: root.pref-ret-size ? "MB" : ""; color: Theme.text3; font-size: 12px; vertical-alignment: center; width: 24px; }
                                }
                                // ZK-100: videos have a size limit of their own.
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: @tr("libset-keep-videos" => "Videos — no more than"); color: Theme.text2; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                    NumField { width: 110px; label: ""; value <=> root.pref-video-mb; committed(v) => { root.setting("ret-video-mb", 0); } }
                                    Text { text: "MB"; color: Theme.text3; font-size: 12px; vertical-alignment: center; width: 24px; }
                                }
                                Text { text: @tr("libset-oldest-trash" => "The oldest go to the trash, not away for good"); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                Rectangle { height: 1px; background: Theme.line; }
                                // ZK-175: how long the trash keeps what was deleted.
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: @tr("libset-trash-days" => "Keep deleted documents in the trash, days"); color: Theme.text2; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                    NumField { width: 110px; label: ""; value <=> root.pref-trash-days; committed(v) => { root.setting("trash-days", 0); } }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                // ZK-186: the text on the screenshots in the search
                                SwitchRow { text: @tr("libset-search-text" => "Search the text on screenshots too"); checked: root.pref-lib-search-text; toggled => { root.setting("lib-search-text", self.checked ? 1 : 0); } }
                                Text { text: @tr("libset-search-text-hint" => "Znimok reads the text on your screenshots on this computer, slowly in the background, and keeps it only in the library's local index — not in the files and nowhere online. Turned off, what was read is forgotten."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                if root.pref-lib-search-text && root.lib-text-status != "": Text { text: root.lib-text-status; color: Theme.text2; font-size: 11px; wrap: word-wrap; }
                            }
                            // ---- Sharing
                            if root.settings-page == 3: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("sharing-intro" => "What the main Copy button does and which format comes out."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                SwitchRow { text: @tr("sharing-metadata" => "Write metadata into files"); checked: root.pref-metadata; toggled => { root.setting("metadata", self.checked ? 1 : 0); } }
                                Text { text: @tr("export-metadata" => "Write metadata (title, description, author, date)"); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                            }
                            // ---- Extensions and integrations (ZK-101)
                            if root.settings-page == 11: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("int-intro" => "Znimok in the browser and on Logitech devices, and where «Send to» delivers a screenshot, a recording or a report. Tokens and keys stay in the system's secret store."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                // Extensions
                                Text { text: @tr("int-extensions" => "Extensions"); color: Theme.text; font-size: 14px; font-weight: 700; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: @tr("int-chrome" => "Chrome and Edge extension"); color: Theme.text2; font-size: 12px; }
                                        Text { text: root.int-chrome-on ? @tr("int-connected" => "Connected") : @tr("int-chrome-off" => "The browser's DevTools log in recordings, and «Record this window»"); color: root.int-chrome-on ? Theme.accent : Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    }
                                    TextButton { text: @tr("int-chrome-store" => "Chrome Web Store"); clicked => { root.int-action("store", "chrome"); } }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: @tr("int-logi" => "Logi Options+ plugin"); color: Theme.text2; font-size: 12px; }
                                        Text { text: root.int-logi-on ? @tr("int-connected" => "Connected") : @tr("int-logi-off" => "Znimok on the MX Creative Console and the Actions Ring, haptics on the MX Master 4"); color: root.int-logi-on ? Theme.accent : Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    }
                                    TextButton { text: @tr("int-logi-page" => "The plugin"); clicked => { root.int-action("store", "logi"); } }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                // Where to send
                                Text { text: @tr("int-targets" => "Send to"); color: Theme.text; font-size: 14px; font-weight: 700; }
                                Text { text: @tr("int-targets-hint" => "Switched on and filled in, a target appears in «Send to» on the card after a shot and in the export sheets. If it cannot be reached, Znimok tries again later."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                if root.int-targets.length > 0: VerticalLayout {
                                    spacing: 6px;
                                    Text { text: @tr("int-default" => "In one click"); color: Theme.text2; font-size: 12px; }
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 4px;
                                        SegOption { text: @tr("int-default-ask" => "Ask"); on: root.int-default == ""; clicked => { root.int-action("default", ""); } }
                                        for t in root.int-targets: SegOption { text: t.name; on: root.int-default == t.key; clicked => { root.int-action("default", t.key); } }
                                    }
                                }
                                // Google Drive (ZK-259/260): only in a build with the OAuth client
                                if root.int-google-available: Rectangle { height: 1px; background: Theme.line; }
                                if root.int-google-available: SwitchRow { text: "Google Drive"; checked: root.int-google-enabled; toggled => { root.setting("int-google-enabled", self.checked ? 1 : 0); } }
                                if root.int-google-available && root.int-google-enabled: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: @tr("int-google-how" => "Sign in with your Google account in the browser. Znimok gets access only to the files it creates in your Drive (the «Znimok» folder) and to your e-mail address — nothing else in your Drive or mail."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    for a in root.int-google-accounts: HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: a.email; color: a.active ? Theme.text : Theme.text2; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                        if a.active: Text { text: @tr("int-google-active" => "Sends here"); color: Theme.accent; font-size: 11px; vertical-alignment: center; }
                                        if !a.active: TextButton { text: @tr("int-google-use" => "Use"); clicked => { root.int-action("google-use", a.id); } }
                                        TextButton { text: @tr("int-google-sign-out" => "Sign out"); clicked => { root.int-action("google-sign-out", a.id); } }
                                    }
                                    if root.int-google-accounts.length > 0: SwitchRow { text: @tr("int-google-link" => "Anyone with the link can view"); checked: root.int-google-link; toggled => { root.setting("int-google-link", self.checked ? 1 : 0); } }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text { text: root.int-google-status; color: Theme.text2; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                        TextButton { text: root.int-google-accounts.length == 0 ? @tr("int-google-sign-in" => "Sign in with Google") : @tr("int-google-add" => "Add an account"); enabled: !root.int-google-busy; clicked => { root.int-action("google-sign-in", ""); } }
                                        if root.int-google-accounts.length > 0: TextButton { text: @tr("int-check" => "Check"); enabled: !root.int-google-busy; clicked => { root.int-action("check", "google"); } }
                                    }
                                }
                                // Telegram
                                Rectangle { height: 1px; background: Theme.line; }
                                SwitchRow { text: "Telegram"; checked: root.int-tg-enabled; toggled => { root.setting("int-tg-enabled", self.checked ? 1 : 0); } }
                                if root.int-tg-enabled: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: @tr("int-tg-how" => "Make a bot with @BotFather, paste its token here, write anything to the bot, then «Find the chat»."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    LineEdit { input-type: password; placeholder-text: root.int-tg-token-set ? @tr("int-secret-saved" => "Saved — type a new one to replace it") : @tr("int-tg-token" => "Bot token"); edited(t) => { root.setting-text("int-tg-token", t); } }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit { horizontal-stretch: 1; text: root.int-tg-chat; placeholder-text: @tr("int-tg-chat" => "Chat ID or @channel"); edited(t) => { root.setting-text("int-tg-chat", t); } }
                                        TextButton { text: @tr("int-tg-find" => "Find the chat"); enabled: !root.int-tg-busy; clicked => { root.int-action("find-chat", "telegram"); } }
                                    }
                                    if root.int-tg-chat-title != "": Text { text: root.int-tg-chat-title; color: Theme.text2; font-size: 11px; }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text { text: root.int-tg-status; color: Theme.text2; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                        TextButton { text: @tr("int-check" => "Check"); enabled: !root.int-tg-busy; clicked => { root.int-action("check", "telegram"); } }
                                    }
                                }
                                // Jira
                                Rectangle { height: 1px; background: Theme.line; }
                                SwitchRow { text: "Jira"; checked: root.int-jira-enabled; toggled => { root.setting("int-jira-enabled", self.checked ? 1 : 0); } }
                                if root.int-jira-enabled: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: @tr("int-jira-how" => "Jira Cloud: your site, your e-mail and an API token (id.atlassian.com → Security → API tokens). Without an issue, each sending makes a new one in the project."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    LineEdit { text: root.int-jira-site; placeholder-text: @tr("int-jira-site" => "Site: your-team.atlassian.net"); edited(t) => { root.setting-text("int-jira-site", t); } }
                                    LineEdit { text: root.int-jira-email; placeholder-text: @tr("int-jira-email" => "E-mail"); edited(t) => { root.setting-text("int-jira-email", t); } }
                                    LineEdit { input-type: password; placeholder-text: root.int-jira-token-set ? @tr("int-secret-saved" => "Saved — type a new one to replace it") : @tr("int-jira-token" => "API token"); edited(t) => { root.setting-text("int-jira-token", t); } }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit { horizontal-stretch: 1; text: root.int-jira-project; placeholder-text: @tr("int-jira-project" => "Project key"); edited(t) => { root.setting-text("int-jira-project", t); } }
                                        LineEdit { horizontal-stretch: 1; text: root.int-jira-issue; placeholder-text: @tr("int-jira-issue" => "Issue (optional)"); edited(t) => { root.setting-text("int-jira-issue", t); } }
                                        LineEdit { horizontal-stretch: 1; text: root.int-jira-type; placeholder-text: @tr("int-jira-type" => "Type of a new issue"); edited(t) => { root.setting-text("int-jira-type", t); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text { text: root.int-jira-status; color: Theme.text2; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                        TextButton { text: @tr("int-check" => "Check"); enabled: !root.int-jira-busy; clicked => { root.int-action("check", "jira"); } }
                                    }
                                }
                                // Slack
                                Rectangle { height: 1px; background: Theme.line; }
                                SwitchRow { text: "Slack"; checked: root.int-slack-enabled; toggled => { root.setting("int-slack-enabled", self.checked ? 1 : 0); } }
                                if root.int-slack-enabled: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: @tr("int-slack-how" => "A Slack app with the files:write and chat:write scopes, installed to the workspace and added to the channel: its bot token (xoxb-…) and the channel's ID (the channel's details, at the bottom)."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    LineEdit { input-type: password; placeholder-text: root.int-slack-token-set ? @tr("int-secret-saved" => "Saved — type a new one to replace it") : @tr("int-slack-token" => "Bot token (xoxb-…)"); edited(t) => { root.setting-text("int-slack-token", t); } }
                                    LineEdit { text: root.int-slack-channel; placeholder-text: @tr("int-slack-channel" => "Channel ID (C0…)"); edited(t) => { root.setting-text("int-slack-channel", t); } }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text { text: root.int-slack-status; color: Theme.text2; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                        TextButton { text: @tr("int-check" => "Check"); enabled: !root.int-slack-busy; clicked => { root.int-action("check", "slack"); } }
                                    }
                                }
                                // Redmine
                                Rectangle { height: 1px; background: Theme.line; }
                                SwitchRow { text: "Redmine"; checked: root.int-rm-enabled; toggled => { root.setting("int-rm-enabled", self.checked ? 1 : 0); } }
                                if root.int-rm-enabled: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: @tr("int-rm-how" => "The REST API switched on in Redmine's administration, and your API key (My account → API access key). Without an issue, each sending makes a new one in the project."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    LineEdit { text: root.int-rm-url; placeholder-text: @tr("int-rm-url" => "Address: https://redmine.example.com"); edited(t) => { root.setting-text("int-rm-url", t); } }
                                    LineEdit { input-type: password; placeholder-text: root.int-rm-key-set ? @tr("int-secret-saved" => "Saved — type a new one to replace it") : @tr("int-rm-key" => "API key"); edited(t) => { root.setting-text("int-rm-key", t); } }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit { horizontal-stretch: 1; text: root.int-rm-project; placeholder-text: @tr("int-rm-project" => "Project identifier"); edited(t) => { root.setting-text("int-rm-project", t); } }
                                        LineEdit { horizontal-stretch: 1; text: root.int-rm-issue; placeholder-text: @tr("int-rm-issue" => "Issue number (optional)"); edited(t) => { root.setting-text("int-rm-issue", t); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text { text: root.int-rm-status; color: Theme.text2; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                        TextButton { text: @tr("int-check" => "Check"); enabled: !root.int-rm-busy; clicked => { root.int-action("check", "redmine"); } }
                                    }
                                }
                                // Webhooks
                                Rectangle { height: 1px; background: Theme.line; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: @tr("int-webhooks" => "Webhooks"); color: Theme.text2; font-size: 12px; }
                                        Text { text: @tr("int-webhooks-how" => "For n8n, Zapier, Make or a server of your own: a POST with two parts, meta (JSON) and file; a header you set, e.g. Authorization, goes with it."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    }
                                    TextButton { text: @tr("int-webhook-add" => "Add a webhook"); clicked => { root.int-action("add-webhook", ""); } }
                                }
                                for w in root.int-webhooks: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SwitchRow { horizontal-stretch: 1; text: w.name != "" ? w.name : @tr("int-webhook" => "Webhook"); checked: w.enabled; toggled => { root.setting-text("int-wh-enabled:" + w.id, self.checked ? "1" : "0"); } }
                                        TextButton { text: @tr("int-webhook-remove" => "Remove"); clicked => { root.int-action("remove-webhook", w.id); } }
                                    }
                                    LineEdit { text: w.name; placeholder-text: @tr("int-webhook-name" => "Name in the menu"); edited(t) => { root.setting-text("int-wh-name:" + w.id, t); } }
                                    LineEdit { text: w.url; placeholder-text: "https://…"; edited(t) => { root.setting-text("int-wh-url:" + w.id, t); } }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit { horizontal-stretch: 1; text: w.header; placeholder-text: @tr("int-webhook-header" => "Header, e.g. Authorization"); edited(t) => { root.setting-text("int-wh-header:" + w.id, t); } }
                                        LineEdit { horizontal-stretch: 2; input-type: password; placeholder-text: w.secret-set ? @tr("int-secret-saved" => "Saved — type a new one to replace it") : @tr("int-webhook-value" => "Its value, e.g. Bearer …"); edited(t) => { root.setting-text("int-wh-value:" + w.id, t); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text { text: w.status; color: Theme.text2; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                        TextButton { text: @tr("int-check" => "Check"); enabled: !w.busy; clicked => { root.int-action("check", "webhook:" + w.id); } }
                                    }
                                }
                            }
                            // ---- Look and language
                            if root.settings-page == 4: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("look-language" => "Language"); color: Theme.text2; font-size: 12px; }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 9px;
                                    background: Theme.elevated;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;
                                        SegOption { text: @tr("look-language-system" => "System"); on: root.pref-lang == 0; clicked => { root.setting("lang", 0); } }
                                        SegOption { text: "Українська"; on: root.pref-lang == 1; clicked => { root.setting("lang", 1); } }
                                        SegOption { text: "English"; on: root.pref-lang == 2; clicked => { root.setting("lang", 2); } }
                                    }
                                }
                                if root.pref-autostart-ok: SwitchRow { text: @tr("look-autostart" => "Start at sign-in"); checked: root.pref-autostart; toggled => { root.setting("autostart", self.checked ? 1 : 0); } }
                                if root.pref-autostart-note != "": Text { text: root.pref-autostart-note; color: Theme.attention; font-size: 11px; wrap: word-wrap; }
                                Text { text: @tr("look-theme" => "Theme"); color: Theme.text2; font-size: 12px; }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 9px;
                                    background: Theme.elevated;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;
                                        SegOption { text: @tr("look-theme-system" => "As in the system"); on: Theme.mode == 0; clicked => { root.setting("theme", 0); } }
                                        SegOption { text: @tr("look-theme-light" => "Light"); on: Theme.mode == 1; clicked => { root.setting("theme", 1); } }
                                        SegOption { text: @tr("look-theme-dark" => "Dark"); on: Theme.mode == 2; clicked => { root.setting("theme", 2); } }
                                    }
                                }
                            }
                            // ---- Privacy
                            if root.settings-page == 5: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("priv-intro" => "Znimok sends nothing anywhere without your action. Everything that touches the network and your data is here."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                SwitchRow { text: @tr("priv-updates" => "Check for updates daily"); checked: root.pref-updates; toggled => { root.setting("updates", self.checked ? 1 : 0); } }
                                Text { text: @tr("priv-updates-hint" => "GitHub Releases, version number only"); color: Theme.text3; font-size: 11px; }
                                for row in [
                                    { k: @tr("priv-telemetry" => "Telemetry and statistics"), v: @tr("priv-telemetry-none" => "none, and no switch either") },
                                    { k: @tr("priv-crash" => "Crash reports"), v: @tr("priv-crash-local" => "a local file; you send it yourself") },
                                    { k: @tr("priv-cloud" => "Cloud models (your own key)"), v: @tr("priv-cloud-off" => "off, no key") },
                                ]: HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: row.k; color: Theme.text2; font-size: 12px; horizontal-stretch: 1; }
                                    Text { text: row.v; color: Theme.text3; font-size: 12px; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: root.mac ? @tr("priv-mac-perms" => "macOS permissions") : @tr("onb-open-guide" => "First-run guide"); color: Theme.text2; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                    TextButton { text: @tr("priv-check" => "Check"); clicked => { root.setting("onb-open", 0); } }
                                }
                                Text { text: root.pref-file; color: Theme.text3; font-size: 10px; wrap: word-wrap; }
                            }
                            // ---- Agents and models (ZK-132)
                            if root.settings-page == 8: VerticalLayout {
                                spacing: 14px;
                                SwitchRow { text: @tr("agents-access" => "Access for agents on this computer (MCP)"); checked: root.pref-mcp; toggled => { root.setting("mcp", self.checked ? 1 : 0); } }
                                Text { text: @tr("agents-connect-hint" => "Claude Code: claude mcp add znimok -- znimok mcp. Claude Desktop: open the .mcpb file from the release."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                Text { text: @tr("agents-clients" => "Connected clients"); color: Theme.text2; font-size: 12px; font-weight: 600; }
                                Text { text: @tr("agents-clients-hint" => "Each agent gets its own key and its own permissions. Access is off until you turn it on."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                if root.agent-clients.length == 0: Text { text: @tr("agents-empty-title" => "No agent has connected yet"); color: Theme.text3; font-size: 12px; }
                                for c in root.agent-clients: HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: c.name; color: Theme.text; font-size: 12px; font-weight: 600; }
                                    Text { text: c.scopes; color: Theme.text3; font-size: 12px; horizontal-stretch: 1; wrap: word-wrap; }
                                }
                                if root.agent-clients.length > 0: HorizontalLayout {
                                    alignment: start;
                                    TextButton { text: @tr("agents-revoke-all" => "Revoke all permissions"); clicked => { root.setting("agents-revoke", 0); } }
                                }
                                Text { text: @tr("agents-models" => "Models for Znimok features"); color: Theme.text2; font-size: 12px; font-weight: 600; }
                                Text { text: @tr("agents-models-hint" => "On the device first. The cloud — only with your key and only for the features you allowed."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                for row in [
                                    { k: @tr("agents-ocr" => "Recognising text in screenshots"), v: @tr("agents-on-device" => "On device") },
                                    { k: @tr("agents-redact" => "Finding secrets and faces to mask"), v: @tr("agents-on-device" => "On device") },
                                    { k: @tr("agents-assistant" => "Natural-language assistant") + " · " + root.agent-model, v: @tr("agents-cloud-off" => "off, no key") },
                                ]: HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: row.k; color: Theme.text2; font-size: 12px; horizontal-stretch: 1; wrap: word-wrap; }
                                    Text { text: row.v; color: Theme.text3; font-size: 12px; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: @tr("agents-log" => "Action log"); color: Theme.text2; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                                    TextButton { text: @tr("agents-log-show" => "Show file"); clicked => { root.setting("agents-log", 0); } }
                                }
                                if root.agent-log.length == 0: Text { text: @tr("agents-log-empty" => "Nothing yet"); color: Theme.text3; font-size: 12px; }
                                for line in root.agent-log: Text { text: line; color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                            }
                            // ---- Updates (ZK-132; the updater itself is ZK-122)
                            // ---- Recording (ZK-180)
                            if root.settings-page == 10: VerticalLayout {
                                spacing: 14px;
                                Text { text: @tr("rec-intro" => "Quality and sources. Sound is off by default: you turn it on deliberately."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                Text { text: @tr("rec-how" => "The recording hotkey or «Record video» in the tray opens the same overlay as for screenshots: drag — a region, click — a window, Space — the whole screen. The same key or «Stop» ends it; the video goes to the library."); color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                                Text { text: @tr("rec-fps" => "Frames per second"); color: Theme.text2; font-size: 12px; }
                                Rectangle {
                                    height: 32px;
                                    width: 200px;
                                    border-radius: 9px;
                                    background: Theme.elevated;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;
                                        SegOption { text: "30"; on: root.pref-rec-fps == 30; clicked => { root.setting("rec-fps", 30); } }
                                        SegOption { text: "60"; on: root.pref-rec-fps == 60; clicked => { root.setting("rec-fps", 60); } }
                                    }
                                }
                                Text { text: @tr("rec-quality" => "Quality"); color: Theme.text2; font-size: 12px; }
                                Rectangle {
                                    height: 32px;
                                    width: 320px;
                                    border-radius: 9px;
                                    background: Theme.elevated;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;
                                        SegOption { text: @tr("rec-quality-low" => "Lower"); on: root.pref-rec-quality == 0; clicked => { root.setting("rec-quality", 0); } }
                                        SegOption { text: @tr("rec-quality-normal" => "Normal"); on: root.pref-rec-quality == 1; clicked => { root.setting("rec-quality", 1); } }
                                        SegOption { text: @tr("rec-quality-high" => "High"); on: root.pref-rec-quality == 2; clicked => { root.setting("rec-quality", 2); } }
                                    }
                                }
                                Text { text: @tr("rec-window-click" => "Click on a window"); color: Theme.text2; font-size: 12px; }
                                Rectangle {
                                    height: 32px;
                                    width: 320px;
                                    border-radius: 9px;
                                    background: Theme.elevated;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;
                                        SegOption { text: @tr("rec-follow" => "follow it"); on: root.pref-rec-follow; clicked => { root.setting("rec-follow", 1); } }
                                        SegOption { text: @tr("rec-as-region" => "as a region"); on: !root.pref-rec-follow; clicked => { root.setting("rec-follow", 0); } }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                // ZK-189: the sound's choice; the capture comes with ZK-89.
                                Text { text: @tr("vid-sound" => "Sound"); color: Theme.text2; font-size: 12px; }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 9px;
                                    background: Theme.elevated;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;
                                        SegOption { text: @tr("vid-no-sound" => "No sound"); on: root.pref-rec-sound == 0; clicked => { root.setting("rec-sound", 0); } }
                                        SegOption { text: @tr("rec-system-audio" => "System sound"); on: root.pref-rec-sound == 1; clicked => { root.setting("rec-sound", 1); } }
                                        SegOption { text: @tr("rec-microphone" => "Microphone"); on: root.pref-rec-sound == 2; clicked => { root.setting("rec-sound", 2); } }
                                        SegOption { text: @tr("vid-sound-both" => "Both"); on: root.pref-rec-sound == 3; clicked => { root.setting("rec-sound", 3); } }
                                    }
                                }
                                if root.pref-rec-sound == 1 || root.pref-rec-sound == 3: DeviceRow { label: @tr("rec-system-audio" => "System sound"); names: root.rec-sys-devices; current: root.rec-sys-device; picked(i) => { root.setting("rec-sys-device", i); } }
                                if root.pref-rec-sound == 2 || root.pref-rec-sound == 3: DeviceRow { label: @tr("rec-microphone" => "Microphone"); names: root.rec-mic-devices; current: root.rec-mic-device; picked(i) => { root.setting("rec-mic-device", i); } }
                                Text { text: @tr("rec-sound-tracks" => "Each source is a track of its own: in the editor it can be muted or made quieter. The system sound is what this computer plays; the microphone needs Windows' permission (Privacy → Microphone)."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                SwitchRow { text: @tr("rec-cursor-clicks" => "Cursor and click highlight"); checked: root.pref-rec-cursor; toggled => { root.setting("rec-cursor", self.checked ? 1 : 0); } }
                                SwitchRow { text: @tr("rec-open-editor" => "Open the editor when a recording ends"); checked: root.pref-rec-open-editor; toggled => { root.setting("rec-open-editor", self.checked ? 1 : 0); } }
                                Text { text: @tr("rec-cursor-hint" => "The pointer is drawn into the video, a click is a spreading ring and a held button a steady one; clicks on the recording bar are not recorded. The clicks are also kept as a log in the document."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                // ZK-97: the browser's DevTools log of a recording.
                                Rectangle { height: 1px; background: Theme.line; }
                                Text { text: @tr("rec-browser" => "Browser"); color: Theme.text2; font-size: 12px; }
                                SwitchRow { text: @tr("rec-devlog" => "Write the browser's DevTools log with a recording"); checked: root.pref-rec-devlog; toggled => { root.setting("rec-devlog", self.checked ? 1 : 0); } }
                                SwitchRow { text: @tr("rec-ext-control" => "Let the extension start a recording of its window"); checked: root.pref-rec-ext-control; toggled => { root.setting("rec-ext-control", self.checked ? 1 : 0); } }
                                Text { text: root.rec-browsers; color: root.rec-browsers-on ? Theme.text2 : Theme.attention; font-size: 12px; wrap: word-wrap; }
                                // ZK-98: what a developer report hides
                                Text { text: @tr("rec-hide-title" => "Hide sensitive values in a report"); color: Theme.text2; font-size: 12px; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    SegOption { text: @tr("rec-hide-ask" => "Ask"); on: root.pref-rec-hide == 0; clicked => { root.setting("rec-hide", 0); } }
                                    SegOption { text: @tr("rec-hide-always" => "Always"); on: root.pref-rec-hide == 1; clicked => { root.setting("rec-hide", 1); } }
                                    SegOption { text: @tr("rec-hide-never" => "Never"); on: root.pref-rec-hide == 2; clicked => { root.setting("rec-hide", 2); } }
                                }
                                Text { text: @tr("rec-hide-keys" => "Keys to hide"); color: Theme.text3; font-size: 11px; }
                                LineEdit {
                                    text: root.pref-rec-hide-keys;
                                    edited(t) => { root.setting-text("rec-hide-keys", t); }
                                }
                                Text { text: @tr("rec-hide-hint" => "Comma-separated: headers, JSON keys, form fields and dataLayer keys whose values become •••. Secrets such as tokens, e-mails and card numbers are found by their look as well. The log stays whole in your files."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                // ZK-245: who signs a report
                                Text { text: @tr("rec-sign-title" => "Report signature"); color: Theme.text2; font-size: 12px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { text: root.pref-rec-sign-name; placeholder-text: @tr("rec-sign-name" => "Your name"); edited(t) => { root.setting-text("rec-sign-name", t); } }
                                    LineEdit { text: root.pref-rec-sign-contact; placeholder-text: @tr("rec-sign-contact" => "E-mail or another contact"); edited(t) => { root.setting-text("rec-sign-contact", t); } }
                                }
                                LineEdit { text: root.pref-rec-sign-rights; placeholder-text: @tr("rec-sign-rights" => "Rights notice, e.g. © 2026 Company. Confidential."); edited(t) => { root.setting-text("rec-sign-rights", t); } }
                                Text { text: @tr("rec-sign-hint" => "A report page says who recorded it at the top and whose its content is at the bottom. Leave the fields empty for an unsigned report."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                Text { text: @tr("rec-devlog-hint" => "The Znimok extension for Chrome and Edge writes the page's console, errors, network (headers, request and response bodies) and navigations in sync with the video — everything the DevTools panels show, for debugging; sensitive parts can be hidden on export. Install it from the Chrome Web Store (the button below)."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                HorizontalLayout { alignment: start; TextButton { text: @tr("rec-devlog-store" => "Chrome Web Store"); clicked => { root.setting("open-store", 0); } } }
                            }
                            if root.settings-page == 9: VerticalLayout {
                                spacing: 14px;
                                Text { text: root.upd-version; color: Theme.text; font-size: 13px; font-weight: 600; }
                                SwitchRow { text: @tr("priv-updates" => "Check for updates daily"); checked: root.pref-updates; toggled => { root.setting("updates", self.checked ? 1 : 0); } }
                                Text { text: @tr("upd-channel-hint" => "Releases on GitHub, signed; the installer checks the signature before installing."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: root.upd-last; color: Theme.text2; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                    TextButton { text: @tr("upd-check-now" => "Check now"); enabled: !root.upd-busy; clicked => { root.setting("upd-check", 0); } }
                                }
                                if root.upd-status != "": Text { text: root.upd-status; color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                                if root.upd-progress >= 0: Rectangle {
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.control-on;
                                    Rectangle { x: 0; width: parent.width * min(1, root.upd-progress); height: parent.height; border-radius: 3px; background: Theme.accent; animate width { duration: 150ms; } }
                                }
                                if root.upd-can-install || root.upd-can-open: HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    if root.upd-can-install: TextButton { primary: true; text: @tr("update-now" => "Update now"); enabled: !root.upd-busy; clicked => { root.setting("upd-install", 0); } }
                                    if root.upd-can-open: TextButton { text: @tr("upd-release-page" => "Release page"); clicked => { root.setting("upd-page", 0); } }
                                }
                            }
                            // ---- For developers (temporary, owner 29.09): reset and replay things
                            if root.settings-page == 7 && root.pref-dev-page: VerticalLayout {
                                spacing: 12px;
                                Text { text: @tr("dev-intro" => "A temporary page for testing: reset state and show what normally appears only once."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                                for a[i] in [
                                    { key: "dev-onboarding", label: @tr("dev-onboarding" => "Show the first-run guide again") },
                                    { key: "dev-pill", label: @tr("dev-pill" => "Show the card after a capture") },
                                    { key: "dev-crash", label: @tr("dev-crash" => "Show the crash-report question") },
                                    { key: "dev-open-settings", label: @tr("dev-open-settings" => "Open the settings folder") },
                                    { key: "dev-open-logs", label: @tr("dev-open-logs" => "Open the logs folder") },
                                    { key: "dev-empty-trash", label: @tr("dev-empty-trash" => "Empty the library trash") },
                                    { key: "dev-reset", label: @tr("dev-reset" => "Reset all settings") },
                                ]: HorizontalLayout {
                                    alignment: start;
                                    TextButton { text: a.label; clicked => { root.setting(a.key, 0); } }
                                }
                                Text { text: root.pref-file; color: Theme.text3; font-size: 10px; wrap: word-wrap; }
                            }
                            // ---- About (ZK-198): what Znimok is, its version and build, the author, links,
                            // the fonts' and Slint's licences.
                            if root.settings-page == 6: VerticalLayout {
                                spacing: 18px;
                                // AboutSlint colours its captions by Slint's palette, which follows the
                                // system; our theme may be chosen otherwise.
                                init => { StdPalette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 18px;
                                    Image { width: 80px; height: 80px; source: @image-url("../icons/app-256.png"); }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text { text: "Znimok"; color: Theme.text; font-family: "Unbounded"; font-size: 24px; font-weight: 600; }
                                        Text { text: @tr("about-tagline" => "Screenshots and screen video with annotations"); color: Theme.text2; font-size: 13px; wrap: word-wrap; }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Text { text: root.pref-version; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                            Text { text: root.pref-build; color: Theme.text3; font-family: "JetBrains Mono"; font-size: 11px; vertical-alignment: center; }
                                            TextButton { text: @tr("about-copy-version" => "Copy"); clicked => { root.setting("about-copy", 0); } }
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                VerticalLayout {
                                    spacing: 8px;
                                    Text { text: @tr("about-description" => "Znimok captures the screen — a region, a window, the whole screen or a long scrolling page — and records video. Arrows, text, counters, blur and the other marks stay editable after saving, text on a picture can be copied as text, and every capture goes into a local library."); color: Theme.text; font-size: 13px; wrap: word-wrap; }
                                    Text { text: @tr("about-local" => "Everything stays on your computer: no account, no telemetry, no ads. Nothing leaves it without your action; the only request the program makes by itself is the update check, and it can be turned off."); color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    TextButton { text: @tr("about-site" => "Website"); clicked => { root.setting("about-link", 0); } }
                                    TextButton { text: "GitHub"; clicked => { root.setting("about-link", 1); } }
                                    TextButton { text: @tr("about-privacy" => "Privacy"); clicked => { root.setting("about-link", 2); } }
                                    TextButton { text: @tr("about-licence" => "Licence"); clicked => { root.setting("about-link", 3); } }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: @tr("about-copyright" => "© 2026 Vadym Slyva (Plum). All rights reserved."); color: Theme.text; font-size: 12px; font-weight: 600; wrap: word-wrap; }
                                    Text { text: @tr("about-licence-note" => "The source code is published so that anyone can check what the program does; that is not permission to reuse it. The terms are under «Licence»."); color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                                    Text { text: @tr("about-fonts" => "Fonts: Onest, JetBrains Mono, Unbounded — SIL Open Font License 1.1"); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                }
                                HorizontalLayout { alignment: start; AboutSlint { height: 140px; } }
                            }
                        }
                    }
                }
            }
        }
    }

    // ================================================================== editor
    Rectangle {
        opacity: root.page == 1 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 160ms; easing: ease-in-out; }
        background: Theme.app;
        VerticalLayout {
            // ---- top bar: every item 32 px high, centred on one line (no hand-placed y)
            Rectangle {
                height: root.over-screen ? 0px : 52px;
                visible: !root.over-screen;
                background: Theme.panel;
                DragArea { drag => { root.window-drag(); } toggle => { root.window-toggle(); } }
                if root.custom-frame: WindowControls {
                    x: parent.width - self.width;
                    height: parent.height;
                    maximized: root.win-maximized;
                    minimize => { root.window-minimize(); }
                    toggle => { root.window-toggle(); }
                    close => { root.window-close(); }
                }
                HorizontalLayout {
                    padding-left: 10px + root.lights-inset;
                    padding-right: root.custom-frame ? 150px : 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 6px;
                    BarButton {
                        icon: "M15 6 l-6 6 6 6";
                        text: @tr("nav-library" => "Library");
                        tip: @tr("nav-back-to-library" => "Back to library");
                        clicked => { root.back(); }
                    }
                    open-btn := BarButton {
                        text: @tr("common-open" => "Open");
                        chevron: true;
                        tip: @tr("open-file" => "File…") + " · " + @tr("open-clipboard" => "From clipboard");
                        clicked => { open-menu.show(); }
                        open-menu := PopupWindow {
                            x: 0;
                            y: parent.height + 4px;
                            width: 260px;
                            Rectangle {
                                background: Theme.elevated;
                                border-radius: 12px;
                                drop-shadow-blur: 24px;
                                drop-shadow-color: #00000080;
                                VerticalLayout {
                                    padding: 6px;
                                    MenuItemRow { text: @tr("open-file" => "File…"); shortcut: Keys.k("Ctrl+O", "⌘O"); clicked => { root.open-file(); } }
                                    MenuItemRow { text: @tr("open-clipboard" => "From clipboard"); shortcut: Keys.k("Ctrl+V", "⌘V"); clicked => { root.open-clipboard(); } }
                                    MenuItemRow { text: @tr("open-new-shot" => "New screenshot"); shortcut: root.capture-key; enabled: root.capture-available; clicked => { root.new-shot(); } }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        padding-left: 4px;
                        padding-right: 4px;
                        Rectangle { width: 1px; height: 20px; background: Theme.control-on; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 22px;
                            width: kind-text.preferred-width + 16px;
                            border-radius: 6px;
                            background: #3D7BF524;
                            kind-text := Text { text: root.vid-mode ? @tr("doc-kind-video" => "Video") : @tr("doc-kind-screenshot" => "Screenshot"); color: Theme.accent-text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                    }
                    Text { text: root.doc-name; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; max-width: 360px; horizontal-stretch: 0; }
                    Rectangle { width: 6px; }
                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked <=> root.autosave;
                                toggled => { root.autosave-toggled(self.checked); }
                            }
                        }
                        Text { text: @tr("doc-autosave" => "Save automatically"); color: Theme.text2; font-size: 12px; vertical-alignment: center; wrap: no-wrap; }
                        Text {
                            text: root.save-state == 0 ? @tr("doc-state-saved" => "saved") : (root.save-state == 2 ? @tr("doc-state-saving" => "saving…") : @tr("doc-state-unsaved" => "unsaved"));
                            color: root.save-state == 1 ? Theme.attention : Theme.text3;
                            animate color { duration: 200ms; }
                            font-size: 12px;
                            vertical-alignment: center;
                            wrap: no-wrap;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 76px;
                        border-radius: 10px;
                        background: Theme.elevated;
                        HorizontalLayout {
                            padding: 2px;
                            spacing: 0px;
                            IconButton { width: 36px; height: 28px; label: @tr("doc-undo" => "Undo"); tip: self.label + "  " + Keys.k("Ctrl+Z", "⌘Z"); icon: "M9 14 L4 9 l5 -5 M4 9 h11 a5 5 0 0 1 0 10 h-3"; enabled: root.can-undo; clicked => { root.undo(); } }
                            IconButton { width: 36px; height: 28px; label: @tr("doc-redo" => "Redo"); tip: self.label + "  " + Keys.k("Ctrl+Shift+Z", "⇧⌘Z"); icon: "M15 14 l5 -5 -5 -5 M20 9 H9 a5 5 0 0 0 0 10 h3"; enabled: root.can-redo; clicked => { root.redo(); } }
                        }
                    }
                    IconButton { width: 36px; height: 28px; y: (parent.height - self.height) / 2; icon: "M12 9 a3 3 0 1 0 0 6 a3 3 0 1 0 0 -6 z M19.4 15 a1.7 1.7 0 0 0 .3 1.8 l.1 .1 a2 2 0 1 1 -2.8 2.8 l-.1 -.1 a1.7 1.7 0 0 0 -1.8 -.3 a1.7 1.7 0 0 0 -1 1.5 V21 a2 2 0 1 1 -4 0 v-.1 a1.7 1.7 0 0 0 -1.1 -1.5 a1.7 1.7 0 0 0 -1.8 .3 l-.1 .1 a2 2 0 1 1 -2.8 -2.8 l.1 -.1 a1.7 1.7 0 0 0 .3 -1.8 a1.7 1.7 0 0 0 -1.5 -1 H3 a2 2 0 1 1 0 -4 h.1 a1.7 1.7 0 0 0 1.5 -1.1 a1.7 1.7 0 0 0 -.3 -1.8 l-.1 -.1 a2 2 0 1 1 2.8 -2.8 l.1 .1 a1.7 1.7 0 0 0 1.8 .3 H9 a1.7 1.7 0 0 0 1 -1.5 V3 a2 2 0 1 1 4 0 v.1 a1.7 1.7 0 0 0 1 1.5 a1.7 1.7 0 0 0 1.8 -.3 l.1 -.1 a2 2 0 1 1 2.8 2.8 l-.1 .1 a1.7 1.7 0 0 0 -.3 1.8 V9 a1.7 1.7 0 0 0 1.5 1 H21 a2 2 0 1 1 0 4 h-.1 a1.7 1.7 0 0 0 -1.5 1 z"; label: @tr("nav-settings" => "Settings"); clicked => { root.settings-open(); } }
                    Rectangle { width: 4px; }
                    copy-box := Rectangle {
                        width: copy-row.preferred-width;
                        border-radius: 8px;
                        background: Theme.accent;
                        clip: true;
                        copy-row := HorizontalLayout {
                            Rectangle {
                                width: copy-inner.preferred-width;
                                background: copy-ta.has-hover ? #5189F7 : transparent;
                                animate background { duration: 120ms; }
                                copy-inner := HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 14px;
                                    spacing: 6px;
                                    opacity: root.copied ? 0 : 1;
                                    animate opacity { duration: 160ms; easing: ease-out; }
                                    VerticalLayout {
                                        alignment: center;
                                        Icon { width: 18px; height: 18px; tint: white; d: "M11 9 h7 a2 2 0 0 1 2 2 v7 a2 2 0 0 1 -2 2 h-7 a2 2 0 0 1 -2 -2 v-7 a2 2 0 0 1 2 -2 z M5 15 V5 a2 2 0 0 1 2 -2 h10"; }
                                    }
                                    Text { text: root.vid-mode ? @tr("vid-copy-mp4" => "Copy MP4") : @tr("doc-copy" => "Copy"); color: white; font-size: 13px; font-weight: 600; vertical-alignment: center; wrap: no-wrap; }
                                }
                                // After a copy the title gives way to a tick for a second; the button keeps its width.
                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 20px;
                                    height: 20px;
                                    tint: white;
                                    stroke-width: 2.25px;
                                    d: "M5 12.5 L10 17.5 L19.5 7";
                                    opacity: root.copied ? 1 : 0;
                                    animate opacity { duration: 160ms; easing: ease-out; }
                                }
                                Timer {
                                    interval: 1s;
                                    running: root.copied;
                                    triggered => { root.copied = false; }
                                }
                                // Click copies; pulling it a few pixels starts a drag of the picture as a
                                // PNG file into a messenger or a folder (ZK-64).
                                copy-ta := TipTouch {
                                    property <bool> dragged;
                                    tip: @tr("share-copy-image" => "Copy image") + "  " + Keys.k("Ctrl+C", "⌘C") + (Keys.last-share == 0 ? " / Enter" : "") + " · " + @tr("share-drag-tip" => "drag to a chat or a folder");
                                    mouse-cursor: self.dragged ? MouseCursor.grabbing : MouseCursor.pointer;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) { self.dragged = false; }
                                    }
                                    moved => {
                                        if (self.pressed && !self.dragged && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px)) {
                                            self.dragged = true;
                                            root.drag-out();
                                        }
                                    }
                                    clicked => {
                                        if (!self.dragged) { root.copy(); }
                                        self.dragged = false;
                                    }
                                }
                            }
                            Rectangle { width: 1px; background: #FFFFFF38; }
                            Rectangle {
                                width: 30px;
                                background: more-ta.has-hover ? #5189F7 : transparent;
                                animate background { duration: 120ms; }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout { alignment: center; Chevron { tint: white; } }
                                }
                                more-ta := TipTouch { tip: @tr("doc-other-ways" => "More options"); clicked => { more-menu.show(); } }
                            }
                        }
                        more-menu := PopupWindow {
                            x: parent.width - 260px;
                            y: parent.height + 4px;
                            width: 260px;
                            Rectangle {
                                background: Theme.elevated;
                                border-radius: 12px;
                                drop-shadow-blur: 24px;
                                drop-shadow-color: #00000080;
                                VerticalLayout {
                                    padding: 6px;
                                    // A video (ZK-190): the MP4, a GIF, the frame, the sheet, the library.
                                    if root.vid-mode: MenuItemRow { text: @tr("vid-copy-mp4" => "Copy MP4"); shortcut: Keys.k("Ctrl+C", "⌘C"); clicked => { root.vid-share("copy-mp4"); } }
                                    if root.vid-mode: MenuItemRow { text: @tr("vid-copy-gif" => "Copy GIF"); clicked => { root.vid-share("copy-gif"); } }
                                    if root.vid-mode: MenuItemRow { text: @tr("vid-copy-frame" => "Copy frame"); shortcut: Keys.k("Ctrl+Shift+C", "⇧⌘C"); clicked => { root.vid-share("copy-frame"); } }
                                    if root.vid-mode: MenuItemRow { text: @tr("share-export" => "Export file…"); shortcut: Keys.k("Ctrl+E", "⌘E"); clicked => { root.vid-share("export"); } }
                                    if root.vid-mode: MenuItemRow { text: @tr("vid-save-library" => "Save to the library"); clicked => { root.vid-share("library"); } }
                                    if root.vid-mode: MenuItemRow { text: @tr("vid-frame-as-shot" => "Frame as screenshot"); shortcut: Keys.k("Ctrl+Shift+N", "⇧⌘N"); clicked => { root.vid-share("frame-shot"); } }
                                    if !root.vid-mode: MenuItemRow { text: @tr("share-copy-image" => "Copy image"); shortcut: Keys.k("Ctrl+C", "⌘C") + (Keys.last-share == 0 ? "  Enter" : ""); clicked => { root.copy(); } }
                                    if !root.vid-mode: MenuItemRow { text: @tr("share-export" => "Export file…"); shortcut: Keys.k("Ctrl+Shift+S", "⇧⌘S") + (Keys.last-share == 1 ? "  Enter" : ""); clicked => { root.export(); } }
                                    MenuItemRow { text: @tr("doc-save-as" => "Save as…"); clicked => { root.save-as(); } }
                                    if !root.vid-mode: MenuItemRow { text: @tr("share-system" => "Share…"); enabled: false; }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    MenuItemRow { text: @tr("export-metadata-menu" => "Write metadata"); shortcut: root.export-meta ? "✓" : ""; clicked => { root.toggle-export-meta(); } }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { height: root.over-screen ? 0px : 1px; background: Theme.line; }
            HorizontalLayout {
                vertical-stretch: 1;
                // ---- tool rail (tooltips to the right)
                Rectangle {
                    width: root.over-screen ? 0px : 56px;
                    visible: !root.over-screen;
                    background: Theme.panel;
                    ToolRail { tool: root.tool; ctrl-held: root.ctrl-held; chosen(i) => { root.tool-chosen(i); } insert-image => { root.insert-image(); } }
                }
                Rectangle { width: root.over-screen ? 0px : 1px; background: Theme.line; }
                // ---- canvas, and under it the video's transport and timeline (ZK-181)
                VerticalLayout {
                horizontal-stretch: 1;
                // The bars must not widen the column past what the window gives it.
                min-width: 0px;
                canvas-area := Rectangle {
                    vertical-stretch: 1;
                    background: Theme.canvas;
                    clip: true;
                    if root.vid-live && root.vid-mode: Rectangle {
                        x: root.vid-clip-x;
                        y: root.vid-clip-y;
                        width: max(0px, root.vid-clip-w);
                        height: max(0px, root.vid-clip-h);
                        clip: true;
                        Image {
                            x: root.vid-x - root.vid-clip-x;
                            y: root.vid-y - root.vid-clip-y;
                            width: root.vid-w;
                            height: root.vid-h;
                            source: root.vid-image;
                            image-fit: fill;
                            image-rendering: root.vid-smooth ? smooth : pixelated;
                        }
                    }
                    Image {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        source: root.canvas;
                        image-fit: fill;
                        image-rendering: pixelated;
                    }
                    keys := FocusScope {
                        key-pressed(e) => {
                            if (e.text == Key.Control || e.text == Key.Meta) { root.ctrl-held = true; }
                            if (root.editing) { return reject; }
                            root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
                            return accept;
                        }
                        key-released(e) => {
                            if (e.text == Key.Control || e.text == Key.Meta) { root.ctrl-held = false; }
                            return accept;
                        }
                        changed has-focus => { if (!self.has-focus) { root.ctrl-held = false; } }
                        TouchArea {
                            // Ctrl (⌘) turns a drawing tool into Select at once, before the pointer moves.
                            property <int> c: root.ctrl-held && root.tool != 10 && (root.canvas-cursor == 1 || root.canvas-cursor == 2) ? 0 : root.canvas-cursor;
                            mouse-cursor: self.c == 0 ? (root.mac ? MouseCursor.custom(@image-url("cursors/select-mac.svg"), 2, 1) : MouseCursor.custom(@image-url("cursors/select.svg"), 4, 2))
                                : self.c == 1 ? MouseCursor.crosshair
                                : self.c == 2 ? MouseCursor.text
                                : self.c == 3 ? MouseCursor.move
                                : self.c == 4 ? MouseCursor.nwse-resize
                                : self.c == 5 ? MouseCursor.nesw-resize
                                : self.c == 6 ? MouseCursor.ns-resize
                                : self.c == 7 ? MouseCursor.ew-resize
                                : self.c == 8 ? MouseCursor.grab
                                : self.c == 9 ? MouseCursor.grabbing
                                : self.c == 10 ? MouseCursor.custom(@image-url("cursors/rotate.svg"), 12, 12)
                                : MouseCursor.default;
                            pointer-event(e) => {
                                if (!root.editing) { keys.focus(); }
                                if (e.kind == PointerEventKind.down) {
                                    root.pointer(0, self.mouse-x, self.mouse-y, e.button == PointerEventButton.left ? 0 : (e.button == PointerEventButton.right ? 1 : 2), e.modifiers.shift, e.modifiers.control);
                                } else if (e.kind == PointerEventKind.up) {
                                    root.pointer(2, self.mouse-x, self.mouse-y, e.button == PointerEventButton.left ? 0 : (e.button == PointerEventButton.right ? 1 : 2), e.modifiers.shift, e.modifiers.control);
                                } else if (e.kind == PointerEventKind.move) {
                                    root.pointer(1, self.mouse-x, self.mouse-y, 0, e.modifiers.shift, e.modifiers.control);
                                }
                            }
                            double-clicked => { root.canvas-double(self.mouse-x, self.mouse-y); }
                            scroll-event(e) => {
                                root.wheel(self.mouse-x, self.mouse-y, e.delta-x, e.delta-y, e.modifiers.control, e.modifiers.alt, e.modifiers.shift);
                                return accept;
                            }
                        }
                        init => { self.focus(); }
                    }
                    // The keys of the text being typed (ZK-49). Invisible: the canvas draws the text,
                    // the caret and the selection itself, at the real size and zoom. It sits where the
                    // text starts so an input method's window appears next to it.
                    edit := TextInput {
                        x: root.edit-x;
                        y: root.edit-y;
                        width: 2px;
                        height: 2px;
                        enabled: root.editing;
                        visible: root.editing;
                        single-line: false;
                        color: transparent;
                        selection-background-color: transparent;
                        selection-foreground-color: transparent;
                        text-cursor-width: 0px;
                        font-size: 12px;
                        text <=> root.edit-text;
                        edited => { root.text-edited(self.cursor-position-byte-offset, self.anchor-position-byte-offset); }
                        cursor-position-changed(pos) => { root.text-cursor(self.cursor-position-byte-offset, self.anchor-position-byte-offset); }
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                root.cancel-text();
                                return accept;
                            }
                            // Enter finishes, Shift+Enter starts a new line (as in LH).
                            if (e.text == Key.Return && !e.modifiers.shift) {
                                root.commit-text(self.text);
                                return accept;
                            }
                            return reject;
                        }
                        changed enabled => {
                            if (self.enabled) { self.focus(); }
                        }
                    }
                    // The text found on the picture (ZK-184): what was read, editable, and how to
                    // read only a part. Opens with a quick fade and slide (owner: tactile motion).
                    if root.text-open: Rectangle {
                        property <bool> shown;
                        init => { self.shown = true; }
                        opacity: self.shown ? 1 : 0;
                        animate opacity { duration: 150ms; easing: ease-out; }
                        width: min(360px, parent.width - 32px);
                        height: min(440px, parent.height - 32px);
                        x: parent.width - self.width - 16px + (self.shown ? 0px : 12px);
                        animate x { duration: 180ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                        y: 16px;
                        border-radius: 12px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.swatch-rim;
                        drop-shadow-blur: 18px;
                        drop-shadow-offset-y: 6px;
                        drop-shadow-color: #00000060;
                        // The panel keeps its clicks to itself: the canvas under it reads frames.
                        TouchArea { }
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                height: 24px;
                                Text { text: @tr("text-title" => "Text on the screenshot"); color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                IconButton { width: 24px; height: 24px; icon: "M6 6 l12 12 M18 6 l-12 12"; label: @tr("common-close" => "Close") + "  Esc"; clicked => { root.text-close(); } }
                            }
                            Text { text: root.text-status; color: root.text-busy ? Theme.accent : Theme.text3; font-size: 12px; wrap: word-wrap; }
                            TextEdit {
                                vertical-stretch: 1;
                                text <=> root.text-result;
                                wrap: word-wrap;
                                font-size: 13px;
                            }
                            Text { text: @tr("text-hint" => "Drag a frame over the picture to read only that part; click a line to copy it."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                            HorizontalLayout {
                                alignment: end;
                                TextButton { primary: true; enabled: root.text-result != ""; text: @tr("text-copy-all" => "Copy all"); clicked => { root.text-copy-all(); } }
                            }
                        }
                    }
                    // The angle beside the pointer while a mark turns (ZK-164).
                    if root.rot-hint != "": Rectangle {
                        x: min(root.rot-hint-x * 1px + 18px, parent.width - self.width - 4px);
                        y: max(4px, root.rot-hint-y * 1px - self.height - 10px);
                        width: rot-text.preferred-width + 14px;
                        height: 22px;
                        border-radius: 6px;
                        background: Theme.tip-bg;
                        border-width: 1px;
                        border-color: Theme.control-on;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000070;
                        rot-text := Text { text: root.rot-hint; color: Theme.text; font-size: 12px; font-family: "JetBrains Mono"; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    // ---- over the screen (ZK-58): the rail at the left of the frame and the bar below
                    // it; where there is no room — on the other side, else inside the frame.
                    // ZK-157: a panel the frame comes close to slides over to the other side. The
                    // side is a state with hysteresis (it comes back only with room to spare, so it
                    // never jitters at the edge); only the switch between the two places animates —
                    // while the frame is dragged the panels follow it directly.
                    if root.over-screen: Rectangle {
                        property <length> lx: root.ov-x - self.width - 12px;
                        property <length> rx: root.ov-x + root.ov-w + 12px;
                        property <bool> right: false;
                        property <float> t: self.right ? 1 : 0;
                        // While the editor opens the frame arrives in steps: the panels take their
                        // place at once then, and glide only for the person's own changes.
                        property <bool> settled: false;
                        animate t { duration: self.settled ? 280ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                        Timer { interval: 300ms; running: !parent.settled; triggered => { parent.settled = true; } }
                        changed lx => {
                            if (self.lx < 8px) { self.right = true; } else if (self.lx >= 48px) { self.right = false; }
                        }
                        width: 56px;
                        height: ov-rail.preferred-height;
                        x: max(8px, min(self.lx + (self.rx - self.lx) * self.t, parent.width - self.width - 8px));
                        y: max(8px, min(root.ov-y, parent.height - self.height - 8px));
                        border-radius: 12px;
                        background: Theme.panel;
                        drop-shadow-blur: 18px;
                        drop-shadow-color: #00000080;
                        ov-rail := ToolRail {
                            tool: root.tool;
                            ctrl-held: root.ctrl-held;
                            with-crop: false;
                            with-image: false;
                            chosen(i) => { root.tool-chosen(i); }
                        }
                    }
                    // ZK-172 (owner, 30.09): the properties bar stands above the frame; under it only
                    // when there is no room above (hysteresis as the rail's), inside the frame at its
                    // bottom when there is room on neither side.
                    ov-panel := Rectangle {
                        visible: root.over-screen;
                        property <length> below: root.ov-y + root.ov-h + 12px;
                        property <length> above: root.ov-y - self.height - 12px;
                        property <bool> down: false;
                        property <float> t: self.down ? 1 : 0;
                        property <bool> settled: false;
                        // Tooltips open away from the frame.
                        property <int> tips: self.down ? 0 : 2;
                        animate t { duration: self.settled ? 280ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                        Timer { interval: 300ms; running: root.over-screen && !parent.settled; triggered => { parent.settled = true; } }
                        init => { self.down = self.above < 8px; }
                        changed above => {
                            if (self.above < 8px) { self.down = true; } else if (self.above >= 48px) { self.down = false; }
                        }
                        width: root.over-screen ? ov-bar.preferred-width : 0px;
                        height: root.over-screen ? 48px : 0px;
                        // From the frame's left edge: the rail stands left of the frame, so the bar
                        // over a narrow frame runs to the right instead of into the rail.
                        x: max(8px, min(root.ov-x, parent.width - self.width - 8px));
                        // Room below the frame, else inside it at its bottom.
                        property <length> bottom: self.below + self.height + 8px <= parent.height ? self.below : root.ov-y + root.ov-h - self.height - 8px;
                        y: max(8px, min(self.above + (self.bottom - self.above) * self.t, parent.height - self.height - 8px));
                        border-radius: 12px;
                        background: Theme.panel;
                        drop-shadow-blur: 18px;
                        drop-shadow-color: #00000080;
                        ov-bar := HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            // what this is, and how the frame works
                            Rectangle {
                                width: chip-text.preferred-width + 20px;
                                border-radius: 8px;
                                background: Theme.elevated;
                                chip-text := Text { text: @tr("overlay-chip" => "Over the screen"); color: Theme.text2; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                                TipTouch {
                                    mouse-cursor: MouseCursor.default;
                                    tip-side: ov-panel.tips;
                                    tip: @tr("overlay-hint-frame" => "drag the frame corners — that is the crop") + " · " + Keys.k("Ctrl+S", "⌘S") + " " + @tr("overlay-hint-save" => "to library") + " · Esc " + @tr("overlay-hint-close" => "close");
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                ColourRow { width: 270px; colors: root.prop-kind == 6 ? Palette.marker : Palette.colors; selected: root.color-index; key: "color"; current: root.color-rgb; picked(i) => { root.set-prop("color", i); } }
                            }
                            IconButton { tip-side: ov-panel.tips; label: @tr("doc-undo" => "Undo"); tip: self.label + "  " + Keys.k("Ctrl+Z", "⌘Z"); icon: "M9 14 L4 9 l5 -5 M4 9 h11 a5 5 0 0 1 0 10 h-3"; enabled: root.can-undo; clicked => { root.undo(); } }
                            IconButton { tip-side: ov-panel.tips; label: @tr("doc-redo" => "Redo"); tip: self.label + "  " + Keys.k("Ctrl+Shift+Z", "⇧⌘Z"); icon: "M15 14 l5 -5 -5 -5 M20 9 H9 a5 5 0 0 0 0 10 h3"; enabled: root.can-redo; clicked => { root.redo(); } }
                            IconButton { tip-side: ov-panel.tips; label: @tr("overlay-open-window" => "Open in the editor window"); tip: @tr("overlay-open-window-tip" => "To the editor window — tone, size, library"); icon: "M4 6 a2 2 0 0 1 2 -2 h12 a2 2 0 0 1 2 2 v12 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 z M4 9 h16 M7 6.5 h.01 M9.5 6.5 h.01"; clicked => { root.over-to-window(); } }
                            TextButton { primary: true; icon: "M11 9 h7 a2 2 0 0 1 2 2 v7 a2 2 0 0 1 -2 2 h-7 a2 2 0 0 1 -2 -2 v-7 a2 2 0 0 1 2 -2 z M5 15 V5 a2 2 0 0 1 2 -2 h10"; text: @tr("doc-copy" => "Copy"); clicked => { root.over-copy(); } }
                            IconButton { tip-side: ov-panel.tips; label: @tr("common-close" => "Close"); tip: self.label + "  Esc"; icon: "M6 6 L18 18 M18 6 L6 18"; clicked => { root.over-close(); } }
                        }
                    }
                }
                // ---- transport (ZK-181)
                if root.vid-mode && !root.over-screen: Rectangle {
                    height: 44px;
                    min-width: 0px;
                    clip: true;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 4px;
                        alignment: start;
                        IconButton { y: 6px; icon: "M6 5 v14 M18 5 l-9 7 9 7 z"; label: @tr("vid-to-start" => "To start"); tip: self.label + "  Home"; clicked => { root.vid-transport("home"); } }
                        IconButton { y: 6px; icon: "M15 6 l-6 6 6 6"; label: @tr("vid-frame-back" => "Frame back"); tip: self.label + "  ←"; clicked => { root.vid-transport("back"); } }
                        // ZK-92: backwards (J), as the key frames allow — decoded ahead into a cache.
                        IconButton { y: 6px; icon: "M17 5 l-11 7 11 7 z"; label: root.vid-playing && root.vid-backward ? @tr("vid-pause" => "Pause") : @tr("vid-play-back" => "Play backwards"); tip: self.label + "  J"; clicked => { root.vid-transport("reverse"); } }
                        Rectangle {
                            y: 6px;
                            width: 40px;
                            height: 32px;
                            border-radius: 8px;
                            background: root.vid-can-play ? Theme.accent : Theme.control-on;
                            Icon { d: root.vid-playing ? "M8 5 v14 M16 5 v14" : "M7 4 l13 8 -13 8 z"; tint: #FFFFFF; }
                            TipTouch { tip: (root.vid-playing ? @tr("vid-pause" => "Pause") : @tr("vid-play" => "Play")) + "  Space"; enabled: root.vid-can-play; clicked => { root.vid-transport("play"); } }
                        }
                        IconButton { y: 6px; icon: "M9 6 l6 6 -6 6"; label: @tr("vid-frame-forward" => "Frame forward"); tip: self.label + "  →"; clicked => { root.vid-transport("fwd"); } }
                        IconButton { y: 6px; icon: "M18 5 v14 M6 5 l9 7 -9 7 z"; label: @tr("vid-to-end" => "To end"); tip: self.label + "  End"; clicked => { root.vid-transport("end"); } }
                        Rectangle { width: 6px; }
                        Text { text: root.vid-time; color: Theme.text; font-family: "JetBrains Mono"; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                        Text { text: " / " + root.vid-total; color: Theme.text3; font-family: "JetBrains Mono"; font-size: 13px; vertical-alignment: center; }
                        if root.vid-total-full != "": Rectangle {
                            width: full-text.preferred-width;
                            full-text := Text { text: root.vid-total-full; color: Theme.text3; font-family: "JetBrains Mono"; font-size: 11px; vertical-alignment: center; height: parent.height; }
                            Rectangle { y: parent.height / 2; height: 1px; width: parent.width; background: Theme.text3; }
                        }
                        Rectangle { width: 8px; }
                        Text { text: root.vid-frame-label; color: Theme.text2; font-family: "JetBrains Mono"; font-size: 12px; vertical-alignment: center; }
                        Rectangle { width: 1px; height: 22px; y: 11px; background: Theme.line; }
                        SmallButton { y: 8px; text: root.vid-speed; clicked => { root.vid-transport("speed"); } }
                        if root.devp-has: IconButton { y: 6px; icon: "M12 3 l9 16 H3 z M12 10 v4 M12 17 h.01"; label: @tr("devp-next-error" => "To the next error"); tip: self.label; clicked => { root.devp-action("next-error", 0); } }
                        IconButton { y: 6px; active: root.vid-loop; icon: "M17 4 l3 3 -3 3 M20 7 H8 a4 4 0 0 0 -4 4 v1 M7 20 l-3 -3 3 -3 M4 17 h12 a4 4 0 0 0 4 -4 v-1"; label: @tr("vid-loop" => "Loop"); tip: self.label + "  " + Keys.k("Ctrl+L", "⌘L"); clicked => { root.vid-transport("loop"); } }
                        IconButton { y: 6px; active: root.vid-muted; icon: root.vid-muted ? "M4 10 v4 h4 l5 4 V6 L8 10 z M17 9 l4 6 M21 9 l-4 6" : "M4 10 v4 h4 l5 4 V6 L8 10 z M16 9 a4 4 0 0 1 0 6 M18.5 6.5 a8 8 0 0 1 0 11"; label: @tr("vid-sound" => "Sound"); tip: self.label + "  M"; clicked => { root.vid-transport("mute"); } }
                        Rectangle { horizontal-stretch: 1; }
                        // The timeline's own actions, next to what they act on.
                        SmallButton { y: 8px; text: @tr("vid-in-here" => "Start here"); tip: "I"; clicked => { root.vid-action("in", 0); } }
                        SmallButton { y: 8px; text: @tr("vid-out-here" => "End here"); tip: "O"; clicked => { root.vid-action("out", 0); } }
                        SmallButton { y: 8px; text: @tr("vid-split-here" => "Split here"); tip: "S"; clicked => { root.vid-action("split", 0); } }
                        Rectangle { width: 1px; height: 22px; y: 11px; background: Theme.line; }
                        TextButton { y: 6px; text: @tr("vid-frame-as-shot" => "Frame as screenshot"); icon: "M4 6 a2 2 0 0 1 2 -2 h12 a2 2 0 0 1 2 2 v12 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 z M14 4 v6 h6"; clicked => { root.vid-action("frame-shot", 0); } }
                        Rectangle { width: 1px; height: 22px; y: 11px; background: Theme.line; }
                        IconButton { y: 6px; icon: "M6 12 h12"; label: @tr("vid-zoom-out" => "Timeline: zoom out"); clicked => { root.vid-transport("zoom-out"); } }
                        IconButton { y: 6px; icon: "M6 12 h12 M12 6 v12"; label: @tr("vid-zoom-in" => "Timeline: zoom in"); clicked => { root.vid-transport("zoom-in"); } }
                        SmallButton { y: 8px; text: @tr("vid-fit" => "Fit"); clicked => { root.vid-transport("fit"); } }
                    }
                }
                if root.vid-mode && !root.over-screen: Rectangle { height: 1px; background: Theme.line; }
                // ---- timeline (ZK-181): lane labels, then the tracks Rust lays out in pixels
                if root.vid-mode && !root.over-screen: Rectangle {
                    height: root.devp-has ? 196px : 160px;
                    min-width: 0px;
                    clip: true;
                    background: Theme.panel;
                    HorizontalLayout {
                        Rectangle {
                            width: 64px;
                            VerticalLayout {
                                Rectangle { height: 22px; }
                                Text { height: 56px; text: @tr("vid-lane-video" => "video"); color: Theme.text3; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                Text { height: 26px; text: @tr("vid-lane-sound" => "sound"); color: Theme.text3; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                Text { height: 52px; text: @tr("vid-lane-marks" => "marks"); color: Theme.text3; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                // The log lane (ZK-191): only when the recording has one; its chevron opens the
                                // panel under the timeline.
                                if root.devp-has: Rectangle {
                                    height: 40px;
                                    background: lane-touch.has-hover ? Theme.hover : transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        Text { text: @tr("vid-lane-log" => "log"); color: root.devp-open ? Theme.text : Theme.text3; font-size: 11px; font-weight: 600; horizontal-alignment: center; }
                                        HorizontalLayout {
                                            alignment: center;
                                            Chevron { tint: root.devp-open ? Theme.text : Theme.text3; transform-rotation: root.devp-open ? 180deg : 0deg; animate transform-rotation { duration: 200ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); } }
                                        }
                                    }
                                    lane-touch := TipTouch { tip: root.devp-open ? @tr("devp-hide" => "Hide the log") : @tr("devp-show" => "Show the log"); clicked => { root.devp-action("toggle", 0); } }
                                }
                            }
                        }
                        Rectangle { width: 1px; background: Theme.line; }
                        tracks := Rectangle {
                            horizontal-stretch: 1;
                            clip: true;
                            changed width => { root.tl-layout(self.width - 16px); }
                            init => { root.tl-layout(self.width - 16px); }
                            // A thin ring while the timeline has the keys.
                            Rectangle { border-width: root.tl-focus ? 1px : 0; border-color: Theme.accent; }
                            // ruler
                            Rectangle { y: 0; height: 22px; background: Theme.canvas; }
                            Rectangle { y: 22px; height: 1px; background: Theme.line; }
                            for t in root.tl-ticks: Text { x: 8px + t.x + 3px; y: 4px; text: t.label; color: Theme.text3; font-family: "JetBrains Mono"; font-size: 10px; }
                            for t in root.tl-ticks: Rectangle { x: 8px + t.x; y: 16px; width: 1px; height: 6px; background: Theme.text3; }
                            // the film strip: thumbnails from the key frames (ZK-92)
                            Rectangle {
                                x: 8px;
                                y: 26px;
                                width: parent.width - 16px;
                                height: 52px;
                                border-radius: 4px;
                                background: Theme.control-on;
                                clip: true;
                                Image { width: parent.width; height: parent.height; source: root.tl-strip; image-fit: fill; }
                            }
                            for p in root.tl-pieces: Rectangle {
                                x: 8px + p.x;
                                y: p.kind == 3 ? 24px : 26px;
                                width: max(2px, p.w);
                                height: p.kind == 3 ? 56px : 52px;
                                border-radius: 4px;
                                background: p.kind == 0 ? #FF5A5F33 : (p.kind == 1 ? #0F1115CC : (p.kind == 2 ? #FF5A5F55 : #3D7BF533));
                                border-width: p.kind >= 2 ? 2px : 0;
                                border-color: p.kind == 3 ? Theme.accent : #FF5A5F;
                                if p.kind == 0: HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        SmallButton { text: @tr("vid-restore" => "Restore"); clicked => { root.vid-action("restore", (p.x / 1px)); } }
                                    }
                                }
                            }
                            // trim handles: lit and a touch wider under the pointer (ZK-219)
                            Rectangle { property <bool> hot: root.tl-hot == 1; x: 8px + root.tl-in - self.width; y: 26px; width: self.hot ? 13px : 10px; height: 52px; border-top-left-radius: 4px; border-bottom-left-radius: 4px; background: self.hot ? Theme.accent : Theme.text; animate width { duration: 160ms; easing: ease-out-back; } animate background { duration: 140ms; easing: ease-out; } Rectangle { width: 2px; height: 16px; border-radius: 1px; background: Theme.canvas; } }
                            Rectangle { property <bool> hot: root.tl-hot == 2; x: 8px + root.tl-out; y: 26px; width: self.hot ? 13px : 10px; height: 52px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; background: self.hot ? Theme.accent : Theme.text; animate width { duration: 160ms; easing: ease-out-back; } animate background { duration: 140ms; easing: ease-out; } Rectangle { width: 2px; height: 16px; border-radius: 1px; background: Theme.canvas; } }
                            // the actions over a selected range
                            if root.tl-has-range: Rectangle {
                                x: 8px;
                                y: 82px;
                                height: 26px;
                                width: range-bar.preferred-width;
                                border-radius: 8px;
                                background: Theme.elevated;
                                range-bar := HorizontalLayout {
                                    padding: 2px;
                                    spacing: 4px;
                                    SmallButton { text: @tr("vid-cut" => "Cut") + "  Del"; clicked => { root.vid-action("cut", 0); } }
                                    SmallButton { text: @tr("vid-keep-only" => "Keep only this") + "  ⇧Del"; clicked => { root.vid-action("keep", 0); } }
                                    SmallButton { text: "Esc"; clicked => { root.vid-action("deselect", 0); } }
                                }
                            }
                            // sound (ZK-189): a waveform per track in the lane between the strip and the
                            // marks; a line until its picture is there
                            for t[i] in root.vid-tracks: Rectangle {
                                x: 8px;
                                y: 80px + i * (22px / max(1, root.vid-tracks.length));
                                width: parent.width - 16px;
                                height: 22px / max(1, root.vid-tracks.length);
                                if i < root.tl-waves.length: Image { width: parent.width; height: parent.height; source: root.tl-waves[i]; image-fit: fill; }
                                if i >= root.tl-waves.length: Rectangle { y: (parent.height - 2px) / 2; height: 2px; background: t.muted ? Theme.line : t.colour; }
                            }
                            // marks lanes (ZK-94): a bar per mark, dragged by its body or its ends
                            Rectangle { y: 104px; height: 1px; background: Theme.line; }
                            Rectangle { y: 156px; height: 1px; background: Theme.line; }
                            for m in root.tl-marks: Rectangle {
                                property <bool> hot: root.tl-hot-mark == m.id;
                                property <bool> lit: m.selected || self.hot;
                                x: 8px + m.x;
                                y: 106px + m.lane * 12px - (self.hot ? 1px : 0px);
                                width: m.w;
                                height: self.hot ? 12px : 10px;
                                border-radius: 3px;
                                background: m.colour.with-alpha(self.lit ? 0.95 : 0.7);
                                border-width: m.selected ? 1.5px : (self.hot ? 1px : 0);
                                border-color: Theme.text;
                                animate y, height { duration: 160ms; easing: ease-out-back; }
                                animate background { duration: 140ms; easing: ease-out; }
                                if self.lit && m.w > 18px: Rectangle { x: 1px; width: 3px; height: 6px; border-radius: 1px; background: root.tl-hot-grip == 1 && parent.hot ? Theme.accent : Theme.canvas; }
                                if self.lit && m.w > 18px: Rectangle { x: parent.width - 4px; width: 3px; height: 6px; border-radius: 1px; background: root.tl-hot-grip == 2 && parent.hot ? Theme.accent : Theme.canvas; }
                            }
                            // the log lane (ZK-191): a tick per event; an error also runs a faint line across
                            // the whole timeline
                            for t in root.devp-ticks: Rectangle {
                                visible: t.cls != 5;
                                x: 8px + t.x;
                                y: t.cls == 4 ? 22px : 162px;
                                width: t.cls == 4 ? 1px : 2px;
                                height: t.cls == 4 ? parent.height - 22px : 28px;
                                background: t.cls == 4 ? #FF5A5F40 : (t.cls == 3 ? #F5A524 : (t.cls == 2 ? #A970FF : (t.cls == 1 ? Theme.accent : Theme.text3)));
                            }
                            // the clicks of the recording (ZK-229): a dot each at the lane's foot
                            for t in root.devp-ticks: Rectangle {
                                visible: t.cls == 5;
                                x: 8px + t.x - 3px;
                                y: 182px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.text;
                                border-width: 1px;
                                border-color: Theme.panel;
                            }
                            for t in root.devp-ticks: Rectangle {
                                visible: t.cls == 4;
                                x: 8px + t.x - 0.5px;
                                y: 162px;
                                width: 2px;
                                height: 28px;
                                background: #FF5A5F;
                            }
                            // playhead
                            Rectangle { x: 8px + root.tl-playhead; y: 0; width: 1px; height: parent.height; background: Theme.text; }
                            Rectangle { x: 8px + root.tl-playhead - 6px; y: 0; width: 13px; height: 8px; background: Theme.text; border-radius: 2px; }
                            TouchArea {
                                x: 0;
                                width: parent.width;
                                mouse-cursor: (root.tl-hot != 0 || root.tl-hot-grip != 0) ? MouseCursor.ew-resize : (root.tl-hot-mark >= 0 ? MouseCursor.grab : MouseCursor.default);
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) { root.tl-pointer(0, self.mouse-x - 8px, self.mouse-y, e.modifiers.shift); }
                                    if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.tl-pointer(2, self.mouse-x - 8px, self.mouse-y, e.modifiers.shift); }
                                    if (e.kind == PointerEventKind.move && !self.pressed) { root.tl-pointer(3, self.mouse-x - 8px, self.mouse-y, false); }
                                }
                                changed has-hover => { if (!self.has-hover && !self.pressed) { root.tl-pointer(4, 0, 0, false); } }
                                moved => { if (self.pressed) { root.tl-pointer(1, self.mouse-x - 8px, self.mouse-y, false); } }
                                scroll-event(e) => {
                                    root.tl-wheel(self.mouse-x - 8px, e.delta-y / 1px, e.modifiers.control);
                                    return accept;
                                }
                            }
                        }
                    }
                }
                // ---- the DevTools log under the timeline (ZK-191): search, chips, the list; a row's
                // details beside it (a request in tabs as in DevTools)
                if root.vid-mode && !root.over-screen && root.devp-has && root.devp-open: Rectangle { height: 1px; background: Theme.line; }
                if root.vid-mode && !root.over-screen && root.devp-has && root.devp-open: Rectangle {
                    height: 240px;
                    min-width: 0px;
                    clip: true;
                    background: Theme.panel;
                    // The row at the playhead stays in sight while the video plays.
                    property <int> cur: root.devp-current;
                    changed cur => {
                        if (root.devp-follow && self.cur >= 0) {
                            log-list.content-y = min(0px, max(log-list.visible-height - root.devp-rows.length * 22px, log-list.visible-height / 2 - self.cur * 22px));
                        }
                    }
                    HorizontalLayout {
                        Rectangle {
                          min-width: 0px;
                          horizontal-stretch: 1;
                          clip: true;
                          VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            HorizontalLayout {
                                height: 28px;
                                spacing: 6px;
                                Rectangle {
                                    width: 160px;
                                    LineEdit {
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        text <=> root.devp-query;
                                        placeholder-text: @tr("devp-search" => "Search the log");
                                        edited(t) => { root.devp-search(t); }
                                    }
                                }
                                // The chips scroll sideways when the column is too narrow for them all.
                                Flickable {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    content-height: self.height;
                                    content-width: chips-row.preferred-width;
                                    chips-row := HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                for c[i] in root.devp-chips: Rectangle {
                                    y: 3px;
                                    height: 22px;
                                    width: devchip-text.preferred-width + 18px;
                                    border-radius: 11px;
                                    background: root.devp-chip == i ? Theme.control-on : (devchip-touch.has-hover ? Theme.hover : Theme.elevated);
                                    animate background { duration: 120ms; easing: ease-out; }
                                    devchip-text := Text {
                                        text: c.label + "  " + c.count;
                                        color: root.devp-chip == i ? Theme.text : (c.count > 0 ? Theme.text2 : Theme.disabled);
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    devchip-touch := TouchArea { clicked => { root.devp-action("chip", i); } }
                                }
                                    }
                                }
                                SmallButton { y: 3px; icon: "M6 9 l6 6 6 -6"; tip: @tr("devp-hide" => "Hide the log"); clicked => { root.devp-action("toggle", 0); } }
                            }
                            if root.devp-rows.length == 0: Text {
                                vertical-stretch: 1;
                                text: @tr("devp-empty" => "Nothing matches.");
                                color: Theme.text3;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            log-list := ListView {
                                vertical-stretch: 1;
                                visible: root.devp-rows.length > 0;
                                for r[i] in root.devp-rows: Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: i == root.devp-selected ? Theme.control-on : (i == root.devp-current ? Theme.accent.with-alpha(0.14) : (row-touch.has-hover ? Theme.hover : transparent));
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 8px;
                                        Text { width: 64px; text: r.time; color: Theme.text3; font-family: "JetBrains Mono"; font-size: 11px; vertical-alignment: center; }
                                        Text { width: 64px; text: r.label; color: r.cls == 4 ? #FF5A5F : (r.cls == 3 ? #F5A524 : (r.cls == 2 ? #A970FF : (r.cls == 1 ? Theme.accent : Theme.text2))); font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                        Text { horizontal-stretch: 1; min-width: 0px; text: r.text; color: r.cls == 4 ? #FF5A5F : Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                        Text { width: 130px; text: r.src; color: Theme.text3; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                    }
                                    row-touch := TouchArea { clicked => { root.devp-action("row", i); } }
                                }
                            }
                          }
                        }
                        if root.devp-detail-open: Rectangle { width: 1px; background: Theme.line; }
                        if root.devp-detail-open: VerticalLayout {
                            min-width: 0px;
                            horizontal-stretch: 1;
                            padding: 8px;
                            spacing: 6px;
                            HorizontalLayout {
                                height: 24px;
                                spacing: 6px;
                                Text { horizontal-stretch: 1; min-width: 0px; text: root.devp-detail-title; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                if root.devp-can-save: SmallButton { y: 1px; text: @tr("devp-save" => "Save as…"); clicked => { root.devp-action("save", 0); } }
                                SmallButton { y: 1px; icon: "M6 6 L18 18 M18 6 L6 18"; tip: @tr("common-close" => "Close"); clicked => { root.devp-action("close", 0); } }
                            }
                            if root.devp-tabbed: Rectangle {
                                height: 28px;
                                border-radius: 8px;
                                background: Theme.elevated;
                                HorizontalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    SegOption { text: @tr("devp-tab-headers" => "Headers"); on: root.devp-tab == 0; clicked => { root.devp-action("tab", 0); } }
                                    SegOption { text: @tr("devp-tab-payload" => "Payload"); enabled: root.devp-has-tab.length > 1 && root.devp-has-tab[1]; on: root.devp-tab == 1; clicked => { root.devp-action("tab", 1); } }
                                    SegOption { text: @tr("devp-tab-preview" => "Preview"); enabled: root.devp-has-tab.length > 2 && root.devp-has-tab[2]; on: root.devp-tab == 2; clicked => { root.devp-action("tab", 2); } }
                                    SegOption { text: @tr("devp-tab-response" => "Response"); enabled: root.devp-has-tab.length > 3 && root.devp-has-tab[3]; on: root.devp-tab == 3; clicked => { root.devp-action("tab", 3); } }
                                    SegOption { text: @tr("devp-tab-timing" => "Timing"); enabled: root.devp-has-tab.length > 4 && root.devp-has-tab[4]; on: root.devp-tab == 4; clicked => { root.devp-action("tab", 4); } }
                                }
                            }
                            if !root.devp-tabbed || root.devp-tab != 4: TextEdit {
                                vertical-stretch: 1;
                                read-only: true;
                                wrap: word-wrap;
                                font-size: 11px;
                                text: root.devp-detail;
                            }
                            if root.devp-tabbed && root.devp-tab == 4: VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 4px;
                                alignment: start;
                                for t in root.devp-timing: HorizontalLayout {
                                    height: 18px;
                                    spacing: 8px;
                                    Text { width: 120px; text: t.label; color: Theme.text2; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        Rectangle { x: parent.width * t.a; y: 5px; width: max(2px, parent.width * t.w); height: 8px; border-radius: 2px; background: Theme.accent; }
                                    }
                                    Text { width: 72px; text: t.ms; color: Theme.text3; font-family: "JetBrains Mono"; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
                }
                Rectangle { width: root.over-screen ? 0px : 1px; background: Theme.line; }
                // ---- inspector (ZK-54): Object · Layers · Image · Meta
                Rectangle {
                    width: root.over-screen ? 0px : 284px;
                    visible: !root.over-screen;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;
                        // tabs
                        Rectangle {
                            height: 32px;
                            border-radius: 9px;
                            background: Theme.elevated;
                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;
                                SegOption { text: @tr("insp-tab-object" => "Object"); on: root.insp-tab == 0; clicked => { root.insp-tab = 0; } }
                                SegOption { text: @tr("insp-tab-layers" => "Layers"); on: root.insp-tab == 1; clicked => { root.insp-tab = 1; } }
                                SegOption { text: root.vid-mode ? @tr("insp-tab-video" => "Video") : @tr("insp-tab-shot" => "Image"); on: root.insp-tab == 2; clicked => { root.insp-tab = 2; } }
                                SegOption { text: @tr("insp-tab-meta" => "Meta"); on: root.insp-tab == 3; clicked => { root.insp-tab = 3; } }
                            }
                        }
                        // ---- Object
                        if root.insp-tab == 0: InspScroll {
                            VerticalLayout {
                                spacing: 14px;
                                alignment: start;
                                // Title row: what is being edited, and how many.
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: root.prop-kind >= 0 ? root.prop-title : (root.mark-count == 0 ? @tr("insp-no-marks" => "No annotations yet. Pick a tool on the left and draw on the screenshot.") : @tr("insp-nothing-selected" => "Select an annotation to change it, or pick a tool on the left."));
                                        color: root.prop-kind >= 0 ? Theme.text : Theme.text3;
                                        font-size: root.prop-kind >= 0 ? 13px : 12px;
                                        font-weight: root.prop-kind >= 0 ? 600 : 400;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    if root.prop-for-selection && root.selection-count > 1: Text {
                                        text: @tr("arrange-selected" => "Selected: {0}", root.selection-count);
                                        color: Theme.text3;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                                // ---- Colours. Kinds with two colours show them as a pair with the swap
                                // button between (owner, 28.09): shapes Fill ⇅ Stroke — the stroke's
                                // thickness, style and corners follow it; text Letters ⇅ Outline.
                                if root.prop-kind >= 0 && root.prop-kind != 5 && root.prop-kind != 9: VerticalLayout {
                                    spacing: 8px;
                                    // first colour of a pair: fill (shapes) / letters (text)
                                    if root.prop-kind <= 1 || root.prop-kind == 4: VerticalLayout {
                                        spacing: 8px;
                                        Text { height: 22px; text: root.prop-kind == 4 ? @tr("ctx-text-colour" => "Text colour") : @tr("insp-fill" => "Fill"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; vertical-alignment: center; }
                                        if root.prop-kind <= 1: ColourRow {
                                            selected: root.fill-index;
                                            key: "fill";
                                            current: root.fill-rgb;
                                            with-none: true;
                                            none-tip: @tr("ctx-fill-none" => "Fill colour: none");
                                            picked(i) => { root.set-prop("fill", i); }
                                        }
                                        if root.prop-kind == 4: ColourRow {
                                            selected: root.color-index;
                                            key: "color";
                                            current: root.color-rgb;
                                            picked(i) => { root.set-prop("color", i); }
                                        }
                                    }
                                    // second colour: caption on the left, the swap button on the right —
                                    // between the two rows it swaps
                                    HorizontalLayout {
                                        height: 22px;
                                        Text { text: root.prop-kind == 4 ? @tr("ctx-text-outline" => "Outline colour") : (root.prop-kind >= 6 && root.prop-kind <= 8 ? @tr("counter-colour" => "Colour") : @tr("insp-stroke" => "Stroke")); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; vertical-alignment: center; horizontal-stretch: 1; }
                                        if root.prop-kind <= 1 || root.prop-kind == 4: IconButton {
                                            width: 22px;
                                            height: 22px;
                                            icon: "M7 4 L3 8 l4 4 M3 8 h13 a4 4 0 0 1 4 4 M17 20 l4 -4 -4 -4 M21 16 H8 a4 4 0 0 1 -4 -4";
                                            label: @tr("insp-swap-colours" => "Swap stroke and fill");
                                            enabled: root.fill-index >= 0 || root.color-index >= 0;
                                            clicked => { root.set-prop("swap", 0); }
                                        }
                                    }
                                    if root.prop-kind == 4: ColourRow {
                                        selected: root.fill-index;
                                        key: "outline";
                                        current: root.fill-rgb;
                                        with-none: true;
                                        none-tip: @tr("ctx-outline-none" => "No outline");
                                        picked(i) => { root.set-prop("outline", i); }
                                    }
                                    if root.prop-kind != 4: ColourRow {
                                        colors: root.prop-kind == 6 ? Palette.marker : Palette.colors;
                                        selected: root.color-index;
                                        key: "color";
                                        current: root.color-rgb;
                                        with-none: root.prop-kind <= 1;
                                        none-tip: @tr("insp-stroke-none" => "No outline");
                                        picked(i) => { root.set-prop(i < 0 ? "stroke-none" : "color", i); }
                                    }
                                    // A counter: its number's colour under its own, the swap between (ZK-166).
                                    if root.prop-kind == 7: HorizontalLayout {
                                        height: 22px;
                                        Text { text: @tr("counter-digit-colour" => "Number"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; vertical-alignment: center; horizontal-stretch: 1; }
                                        IconButton {
                                            width: 22px;
                                            height: 22px;
                                            icon: "M7 4 L3 8 l4 4 M3 8 h13 a4 4 0 0 1 4 4 M17 20 l4 -4 -4 -4 M21 16 H8 a4 4 0 0 1 -4 -4";
                                            label: @tr("counter-swap" => "Swap the colour and the number");
                                            clicked => { root.set-prop("swap-digit", 0); }
                                        }
                                    }
                                    if root.prop-kind == 7: ColourRow {
                                        selected: root.digit-index;
                                        key: "digit";
                                        current: root.digit-rgb;
                                        with-none: true;
                                        none-tip: @tr("counter-digit-auto" => "Auto: black or white, whichever reads better");
                                        picked(i) => { root.set-prop("digit", i); }
                                    }
                                    // The marker: four fixed thicknesses, nothing typed (ZK-171).
                                    if root.prop-kind == 6: PropRow {
                                        label: @tr("insp-thickness" => "Thickness");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            for t[i] in [3px, 5px, 7.5px, 10.5px]: SegOption { bar: t; on: root.marker-size == i; tip: i == 0 ? @tr("ctx-thin" => "Thin") : (i == 1 ? @tr("ctx-medium" => "Medium") : (i == 2 ? @tr("ctx-thick" => "Thick") : @tr("marker-extra-thick" => "Extra thick"))); clicked => { root.set-prop("marker-size", i); } }
                                        }
                                    }
                                    if root.prop-kind <= 3: PropRow {
                                        label: @tr("insp-thickness" => "Thickness");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            for t[i] in [1.5px, 3px, 5.5px]: SegOption { bar: t; on: root.thick-index == i; tip: i == 0 ? @tr("ctx-thin" => "Thin") : (i == 1 ? @tr("ctx-medium" => "Medium") : @tr("ctx-thick" => "Thick")); clicked => { root.set-prop("thick", i); } }
                                        }
                                    }
                                    if root.prop-kind <= 3: PropRow {
                                        label: @tr("ctx-line-style" => "Line style");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M3 12 h18"; on: root.dash-index == 0; tip: @tr("insp-line-solid" => "Solid"); clicked => { root.set-prop("dash", 0); } }
                                            SegOption { icon: "M3 12 h4 M10 12 h4 M17 12 h4"; on: root.dash-index == 1; tip: @tr("insp-line-dashed" => "Dashed"); clicked => { root.set-prop("dash", 1); } }
                                            SegOption { icon: "M3 12 h5 M11 12 h1.5 M15.5 12 h5.5"; on: root.dash-index == 2; tip: @tr("insp-line-dashdot" => "Dash-dot"); clicked => { root.set-prop("dash", 2); } }
                                        }
                                    }
                                    if root.prop-kind == 0: PropRow {
                                        label: @tr("insp-corners" => "Corners");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M5 19 V5 h14"; on: root.corners-index == 0; tip: @tr("insp-corners-sharp" => "Sharp"); clicked => { root.set-prop("corners", 0); } }
                                            SegOption { icon: "M5 19 V9 a4 4 0 0 1 4 -4 h10"; on: root.corners-index == 1; tip: @tr("insp-corners-soft" => "Soft"); clicked => { root.set-prop("corners", 1); } }
                                            SegOption { icon: "M5 19 V14 a9 9 0 0 1 9 -9 h5"; on: root.corners-index == 2; tip: @tr("insp-corners-round" => "Round"); clicked => { root.set-prop("corners", 2); } }
                                        }
                                    }
                                }
                                // ---- Arrowheads: a property of the line and of the pen trail
                                if root.prop-kind == 2 || root.prop-kind == 3: PropSection {
                                    title: @tr("insp-heads" => "Arrowheads");
                                    PropRow {
                                        label: @tr("insp-head-start" => "Start");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M4 12 h16"; on: root.head-start == 0; tip: @tr("common-none" => "None"); clicked => { root.set-prop("head-start", 0); } }
                                            SegOption { icon: "M20 12 H8 M4 12 l6 -4 v8 z"; on: root.head-start == 1; tip: @tr("insp-head-triangle" => "Triangle"); clicked => { root.set-prop("head-start", 1); } }
                                            SegOption { icon: "M20 12 H4 M10 6 l-6 6 6 6"; on: root.head-start == 2; tip: @tr("insp-head-chevron" => "Chevron"); clicked => { root.set-prop("head-start", 2); } }
                                            SegOption { icon: "M20 12 H9 M4 12 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0"; on: root.head-start == 3; tip: @tr("insp-head-dot" => "Dot"); clicked => { root.set-prop("head-start", 3); } }
                                        }
                                    }
                                    PropRow {
                                        label: @tr("insp-head-end" => "End");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M4 12 h16"; on: root.head-end == 0; tip: @tr("common-none" => "None"); clicked => { root.set-prop("head-end", 0); } }
                                            SegOption { icon: "M4 12 h12 M20 12 l-6 -4 v8 z"; on: root.head-end == 1; tip: @tr("insp-head-triangle" => "Triangle"); clicked => { root.set-prop("head-end", 1); } }
                                            SegOption { icon: "M4 12 h16 M14 6 l6 6 -6 6"; on: root.head-end == 2; tip: @tr("insp-head-chevron" => "Chevron"); clicked => { root.set-prop("head-end", 2); } }
                                            SegOption { icon: "M4 12 h11 M15 12 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0"; on: root.head-end == 3; tip: @tr("insp-head-dot" => "Dot"); clicked => { root.set-prop("head-end", 3); } }
                                        }
                                    }
                                }
                                // ---- Text
                                if root.prop-kind == 4: PropSection {
                                    title: @tr("tool-text-name" => "Text");
                                    PropRow {
                                        label: @tr("text-size" => "Size");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { width: 30px; horizontal-stretch: 0; icon: "M6 12 h12"; tip: @tr("text-size-down" => "Smaller type"); clicked => { root.set-prop("text-step", -1); } }
                                            Rectangle {
                                                width: 52px;
                                                height: 28px;
                                                border-radius: 7px;
                                                background: Theme.elevated;
                                                border-width: 1px;
                                                border-color: size-input.has-focus ? Theme.accent : Theme.control-on;
                                                animate border-color { duration: 120ms; }
                                                size-input := TextInput {
                                                    width: parent.width - 8px;
                                                    height: parent.height;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    color: Theme.text;
                                                    font-size: 12px;
                                                    input-type: number;
                                                    text <=> root.text-size-px;
                                                    accepted => { root.set-text-size(self.text); }
                                                    changed has-focus => { if (!self.has-focus) { root.set-text-size(self.text); } }
                                                }
                                            }
                                            SegOption { width: 30px; horizontal-stretch: 0; icon: "M6 12 h12 M12 6 v12"; tip: @tr("text-size-up" => "Larger type"); clicked => { root.set-prop("text-step", 1); } }
                                            Rectangle { horizontal-stretch: 1; }
                                            SegOption { width: 32px; horizontal-stretch: 0; icon: "M7 5 h6 a3.5 3.5 0 0 1 0 7 H7 z M7 12 h7 a3.5 3.5 0 0 1 0 7 H7 z"; on: root.text-bold; tip: @tr("ctx-bold" => "Bold"); clicked => { root.set-prop("bold", root.text-bold ? 0 : 1); } }
                                            SegOption { width: 32px; horizontal-stretch: 0; icon: "M10 5 h8 M6 19 h8 M14 5 l-4 14"; on: root.text-italic; tip: @tr("ctx-italic" => "Italic"); clicked => { root.set-prop("italic", root.text-italic ? 0 : 1); } }
                                        }
                                    }
                                    PropRow {
                                        label: @tr("text-block" => "Block");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M4 6 h16 M4 10 h10 M4 14 h16 M4 18 h8"; on: root.text-align == 0; tip: @tr("ctx-align-left" => "Align left"); clicked => { root.set-prop("align", 0); } }
                                            SegOption { icon: "M4 6 h16 M7 10 h10 M4 14 h16 M8 18 h8"; on: root.text-align == 1; tip: @tr("ctx-align-centre" => "Align centre"); clicked => { root.set-prop("align", 1); } }
                                            SegOption { icon: "M4 6 h16 M10 10 h10 M4 14 h16 M12 18 h8"; on: root.text-align == 2; tip: @tr("ctx-align-right" => "Align right"); clicked => { root.set-prop("align", 2); } }
                                        }
                                    }
                                    if root.prop-for-selection: PropRow {
                                        label: @tr("insp-width" => "Width");
                                        HorizontalLayout {
                                            spacing: 6px;
                                            NumField { label: ""; value <=> root.text-box; committed(v) => { root.set-text-box(v); } }
                                            SegOption { width: 64px; horizontal-stretch: 0; text: @tr("common-auto" => "Auto"); on: root.text-box == ""; tip: @tr("text-block-hint" => "Width 0 — no wrapping; the side handles change the width."); clicked => { root.set-prop("box-auto", 0); } }
                                        }
                                    }
                                }
                                // ---- Counter (ZK-51): shape, digit colour, numbering
                                if root.prop-kind == 7: PropSection {
                                    title: @tr("tool-counter-name" => "Counter");
                                    PropRow {
                                        label: @tr("counter-shape" => "Shape");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M3 12 a9 9 0 1 0 18 0 a9 9 0 1 0 -18 0 z"; on: root.counter-shape == 0; tip: @tr("counter-circle" => "Circle"); clicked => { root.set-prop("counter-shape", 0); } }
                                            SegOption { icon: "M6 4 h12 a2 2 0 0 1 2 2 v12 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 V6 a2 2 0 0 1 2 -2 z"; on: root.counter-shape == 1; tip: @tr("counter-square" => "Square"); clicked => { root.set-prop("counter-shape", 1); } }
                                            SegOption { icon: "M12 21 C7 15 5 12 5 9 a7 7 0 1 1 14 0 c0 3 -2 6 -7 12 z"; on: root.counter-shape == 2; tip: @tr("counter-pin" => "Pin"); clicked => { root.set-prop("counter-shape", 2); } }
                                        }
                                    }
                                    // Fixed sizes; a pin turns by the rotation handle, any way (ZK-166).
                                    PropRow {
                                        label: @tr("counter-size" => "Size");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            for t[i] in ["S", "M", "L", "XL"]: SegOption { text: t; on: root.counter-size == i; clicked => { root.set-prop("counter-size", i); } }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: @tr("counter-start-from" => "Start numbering from…"); color: Theme.text3; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                        NumField { width: 90px; label: ""; value <=> root.counter-start; committed(v) => { root.set-counter-start(v); } }
                                    }
                                    // The whole numbering group at once (ZK-169).
                                    if root.prop-for-selection: VerticalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        TextButton { text: @tr("counter-edit-group-short" => "Edit the whole group"); clicked => { root.set-prop("counter-edit-group", 0); } }
                                        TextButton { text: @tr("counter-delete-group" => "Delete group"); clicked => { root.set-prop("counter-delete-group", 0); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        TextButton { text: @tr("counter-new-group" => "New numbering group"); clicked => { root.set-prop("counter-group-new", 0); } }
                                        if !root.prop-for-selection: Text { text: root.counter-next; color: Theme.text3; font-size: 11px; vertical-alignment: center; }
                                    }
                                }
                                // ---- Stamp (ZK-51): six drawn signs and emoji
                                if root.prop-kind == 8: PropSection {
                                    title: @tr("stamp-picker" => "Stamps and emoji");
                                    // Fixed sizes, no W / H fields (ZK-173).
                                    PropRow {
                                        label: @tr("counter-size" => "Size");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            for t[i] in ["S", "M", "L", "XL"]: SegOption { text: t; on: root.stamp-size == i; clicked => { root.set-prop("stamp-size", i); } }
                                        }
                                    }
                                    Text { height: 18px; text: @tr("stamp-stamps" => "Stamps"); color: Theme.text3; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    HorizontalLayout {
                                        spacing: 2px;
                                            SegOption { icon: "M5 12.5 l4.5 4.5 L19 7"; on: root.stamp-id == 0; tip: @tr("stamp-check" => "Check mark"); clicked => { root.set-prop("stamp", 0); } }
                                            SegOption { icon: "M6 6 l12 12 M18 6 L6 18"; on: root.stamp-id == 1; tip: @tr("stamp-cross" => "Cross"); clicked => { root.set-prop("stamp", 1); } }
                                            SegOption { icon: "M9 9 a3 3 0 1 1 4 2.8 c-.8 .4 -1 1 -1 2.2 M12 17.5 v.5"; on: root.stamp-id == 2; tip: @tr("stamp-question" => "Question"); clicked => { root.set-prop("stamp", 2); } }
                                            SegOption { icon: "M12 5 v9 M12 18 v.5"; on: root.stamp-id == 3; tip: @tr("stamp-exclamation" => "Exclamation"); clicked => { root.set-prop("stamp", 3); } }
                                            SegOption { icon: "M12 3.5 l2.6 5.3 5.9 .9 -4.2 4.1 1 5.8 -5.3 -2.8 -5.3 2.8 1 -5.8 -4.2 -4.1 5.9 -.9 z"; on: root.stamp-id == 4; tip: @tr("stamp-star" => "Star"); clicked => { root.set-prop("stamp", 4); } }
                                            SegOption { icon: "M12 4 L21 19 H3 z M12 10 v4 M12 16.5 v.5"; on: root.stamp-id == 5; tip: @tr("stamp-warning" => "Warning"); clicked => { root.set-prop("stamp", 5); } }
                                    }
                                    Text { height: 18px; text: @tr("stamp-emoji" => "Emoji"); color: Theme.text3; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    // 8 a row: the cell size fits the panel, whatever its width.
                                    Rectangle {
                                        height: 3 * (self.width / 8);
                                        for e[c] in ["😀", "👍", "🔥", "⭐", "❤️", "✅", "⚠️", "🚀", "😂", "😍", "🤔", "😎", "😭", "😡", "🙏", "👏", "👀", "💡", "🎉", "📌", "❌", "❓", "💬", "🐞"]: Rectangle {
                                            x: mod(c, 8) * (parent.width / 8);
                                            y: floor(c / 8) * (parent.width / 8);
                                            width: parent.width / 8 - 2px;
                                            height: parent.width / 8 - 2px;
                                            border-radius: 7px;
                                            background: root.stamp-id == 100 + c ? Theme.control-on : (em-ta.has-hover ? Theme.elevated : transparent);
                                            animate background { duration: 120ms; }
                                            Text { text: e; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                                            em-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.set-prop("stamp", 100 + c); } }
                                        }
                                    }
                                }
                                // ---- Effects (ZK-48): shadow and glow, off / light / strong
                                if root.prop-kind == 0 || root.prop-kind == 1 || root.prop-kind == 2 || root.prop-kind == 4 || root.prop-kind == 7 || root.prop-kind == 8 || root.prop-kind == 9: PropSection {
                                    title: @tr("insp-effects" => "Effects");
                                    PropRow {
                                        label: @tr("insp-effect-shadow" => "Shadow");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { text: @tr("common-off" => "Off"); on: root.shadow-index == 0; clicked => { root.set-prop("shadow", 0); } }
                                            SegOption { text: @tr("insp-effect-light" => "Light"); on: root.shadow-index == 1; clicked => { root.set-prop("shadow", 1); } }
                                            SegOption { text: @tr("insp-effect-strong" => "Strong"); on: root.shadow-index == 2; clicked => { root.set-prop("shadow", 2); } }
                                        }
                                    }
                                    PropRow {
                                        label: @tr("insp-effect-glow" => "Glow");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { text: @tr("common-off" => "Off"); on: root.glow-index == 0; clicked => { root.set-prop("glow", 0); } }
                                            SegOption { text: @tr("insp-effect-light" => "Light"); on: root.glow-index == 1; clicked => { root.set-prop("glow", 1); } }
                                            SegOption { text: @tr("insp-effect-strong" => "Strong"); on: root.glow-index == 2; clicked => { root.set-prop("glow", 2); } }
                                        }
                                    }
                                }
                                // ---- Opacity
                                if root.prop-kind >= 0 && root.prop-kind != 5: PropRow {
                                    label: @tr("insp-opacity" => "Opacity");
                                    HorizontalLayout {
                                        spacing: 8px;
                                        MiniSlider {
                                            value <=> root.alpha;
                                            tip: @tr("insp-opacity" => "Opacity");
                                            moved(v) => { root.set-alpha(v, false); }
                                            released => { root.set-alpha(root.alpha, true); }
                                        }
                                        Text { text: round(root.alpha * 100) + " %"; color: Theme.text2; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; width: 36px; }
                                    }
                                }
                                // ---- Position and size of one selected mark
                                if root.prop-for-selection && root.selection-count == 1 && root.prop-kind == 2: PropSection {
                                    title: @tr("insp-line-points" => "Line ends");
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-x1" => "X1"); value: root.geom-x; committed(v) => { root.set-geom("x1", v); } }
                                        NumField { label: @tr("insp-y1" => "Y1"); value: root.geom-y; committed(v) => { root.set-geom("y1", v); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-x2" => "X2"); value: root.geom-x2; committed(v) => { root.set-geom("x2", v); } }
                                        NumField { label: @tr("insp-y2" => "Y2"); value: root.geom-y2; committed(v) => { root.set-geom("y2", v); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: "∠"; value: root.geom-rot; committed(v) => { root.set-geom("rot", v); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                                if root.prop-for-selection && root.selection-count == 1 && root.prop-kind != 2: pos-sec := PropSection {
                                    // W / H in pixels only for boxes whose size is free (owner 30.09, ZK-173):
                                    // rectangle, ellipse, hide, image. The rest have fixed sizes or their own.
                                    property <bool> sized: root.prop-kind == 0 || root.prop-kind == 1 || root.prop-kind == 5 || root.prop-kind == 9;
                                    title: self.sized ? @tr("insp-position" => "Position and size") : @tr("insp-place" => "Position");
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-x" => "X"); value: root.geom-x; committed(v) => { root.set-geom("x", v); } }
                                        NumField { label: @tr("insp-y" => "Y"); value: root.geom-y; committed(v) => { root.set-geom("y", v); } }
                                    }
                                    if pos-sec.sized: HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-w" => "W"); value: root.geom-w; committed(v) => { root.set-geom("w", v); } }
                                        NumField { label: @tr("insp-h" => "H"); value: root.geom-h; committed(v) => { root.set-geom("h", v); } }
                                    }
                                    if root.prop-can-turn: HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: "∠"; value: root.geom-rot; committed(v) => { root.set-geom("rot", v); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                                // ---- Arrange (ZK-52)
                                if root.selection-count >= 1: PropSection {
                                    title: @tr("arrange-title" => "Arrange");
                                    PropRow {
                                        label: @tr("arrange-order" => "Order");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M4 4 h16 M12 20 V8 M7 13 l5 -5 5 5"; tip: @tr("arrange-front" => "Bring to front") + "  " + Keys.k("Ctrl+Shift+]", "⇧⌘]"); clicked => { root.arrange(0); } }
                                            SegOption { icon: "M12 19 V5 M6 11 l6 -6 6 6"; tip: @tr("layers-up" => "Bring forward") + "  " + Keys.k("Ctrl+]", "⌘]"); clicked => { root.arrange(2); } }
                                            SegOption { icon: "M12 5 v14 M6 13 l6 6 6 -6"; tip: @tr("layers-down" => "Send backward") + "  " + Keys.k("Ctrl+[", "⌘["); clicked => { root.arrange(3); } }
                                            SegOption { icon: "M4 20 h16 M12 4 v12 M7 11 l5 5 5 -5"; tip: @tr("arrange-back" => "Send to back") + "  " + Keys.k("Ctrl+Shift+[", "⇧⌘["); clicked => { root.arrange(1); } }
                                            Rectangle { width: 6px; }
                                            SegOption { icon: "M9 9 h11 v11 H9 z M15 9 V4 H4 v11 h5"; tip: @tr("common-duplicate" => "Duplicate") + "  " + Keys.k("Ctrl+D", "⌘D"); clicked => { root.duplicate(); } }
                                        }
                                    }
                                    if root.selection-count >= 2: PropRow {
                                        label: @tr("arrange-align" => "Align");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M4 3 v18 M8 7 h9 v3 H8 z M8 14 h13 v3 H8 z"; tip: @tr("arrange-align-left" => "Align left edges"); clicked => { root.align(0); } }
                                            SegOption { icon: "M12 3 v18 M7 7 h10 v3 H7 z M5 14 h14 v3 H5 z"; tip: @tr("arrange-align-hcentre" => "Align vertical centres"); clicked => { root.align(1); } }
                                            SegOption { icon: "M20 3 v18 M7 7 h9 v3 H7 z M3 14 h13 v3 H3 z"; tip: @tr("arrange-align-right" => "Align right edges"); clicked => { root.align(2); } }
                                            SegOption { icon: "M3 4 h18 M7 8 v9 h3 V8 z M14 8 v13 h3 V8 z"; tip: @tr("arrange-align-top" => "Align top edges"); clicked => { root.align(3); } }
                                            SegOption { icon: "M3 12 h18 M7 7 v10 h3 V7 z M14 5 v14 h3 V5 z"; tip: @tr("arrange-align-vcentre" => "Align horizontal centres"); clicked => { root.align(4); } }
                                            SegOption { icon: "M3 20 h18 M7 7 v9 h3 V7 z M14 3 v13 h3 V3 z"; tip: @tr("arrange-align-bottom" => "Align bottom edges"); clicked => { root.align(5); } }
                                        }
                                    }
                                    if root.selection-count >= 2: PropRow {
                                        label: @tr("arrange-distribute" => "Spread");
                                        HorizontalLayout {
                                            spacing: 2px;
                                            SegOption { icon: "M3 3 v18 M21 3 v18 M9 8 h6 v8 H9 z"; enabled: root.selection-count >= 3; tip: @tr("arrange-distribute-x" => "Even gaps across"); clicked => { root.distribute(0); } }
                                            SegOption { icon: "M3 3 h18 M3 21 h18 M8 9 h8 v6 H8 z"; enabled: root.selection-count >= 3; tip: @tr("arrange-distribute-y" => "Even gaps down"); clicked => { root.distribute(1); } }
                                            Rectangle { width: 6px; }
                                            SegOption { icon: "M4 4 h7 v7 H4 z M13 13 h7 v7 h-7 z M2 2 h20 v20 H2 z"; tip: @tr("arrange-group" => "Group") + "  " + Keys.k("Ctrl+G", "⌘G"); clicked => { root.group(true); } }
                                            SegOption { icon: "M4 4 h7 v7 H4 z M13 13 h7 v7 h-7 z"; tip: @tr("arrange-ungroup" => "Ungroup") + "  " + Keys.k("Ctrl+Shift+G", "⇧⌘G"); clicked => { root.group(false); } }
                                        }
                                    }
                                }
                            }
                        }
                        // ---- Layers: top of the list = front
                        if root.insp-tab == 1: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 6px;
                            if root.layers.length == 0: Text { text: @tr("layers-empty" => "No annotations yet — draw something on the canvas."); color: Theme.text3; font-size: 12px; wrap: word-wrap; }
                            // The list, with the lifted copy of a dragged row floating above it.
                            Rectangle {
                                vertical-stretch: 1;
                                lsv := InspScroll {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: start;
                                        for l[i] in root.layers: Rectangle {
                                            height: 32px;
                                            border-radius: 7px;
                                            property <bool> lifted: root.layer-drag-from == i;
                                            property <bool> target: root.layer-drag-from >= 0 && root.layer-drop-row == i;
                                            background: self.target && root.layer-drop-mode == 1 ? #3D7BF540 : (l.selected ? #3D7BF533 : (row-ta.has-hover && root.layer-drag-from < 0 ? Theme.elevated : transparent));
                                            border-width: self.target && root.layer-drop-mode == 1 ? 1.5px : 0;
                                            border-color: Theme.accent;
                                            opacity: self.lifted ? 0.35 : 1;
                                            animate background, opacity { duration: 120ms; }
                                            row-ta := TouchArea {
                                                property <bool> dragging;
                                                mouse-cursor: root.layer-drag-from >= 0 ? MouseCursor.ns-resize : MouseCursor.pointer;
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                        self.dragging = false;
                                                        if (l.is-group) {
                                                            root.layer-group-click(l.id, e.modifiers.shift || e.modifiers.control);
                                                        } else {
                                                            root.layer-click(l.id, e.modifiers.shift || e.modifiers.control);
                                                        }
                                                    }
                                                    if (e.kind == PointerEventKind.up && self.dragging) {
                                                        self.dragging = false;
                                                        root.layer-drag(i, i * 34px + self.mouse-y, 1);
                                                        root.layer-drag-from = -1;
                                                    }
                                                    if (e.kind == PointerEventKind.cancel && self.dragging) {
                                                        self.dragging = false;
                                                        root.layer-drag(i, i * 34px + self.mouse-y, 2);
                                                        root.layer-drag-from = -1;
                                                    }
                                                }
                                                moved => {
                                                    if (self.pressed && !self.dragging && abs(self.mouse-y - self.pressed-y) > 4px) {
                                                        self.dragging = true;
                                                        root.layer-drag-from = i;
                                                    }
                                                    if (self.dragging) {
                                                        root.layer-drag-y = i * 34px + self.mouse-y;
                                                        root.layer-drag(i, root.layer-drag-y, 0);
                                                    }
                                                }
                                            }
                                            // Insertion line above / below the row.
                                            if self.target && root.layer-drop-mode != 1: Rectangle {
                                                x: 4px + l.depth * 18px;
                                                y: root.layer-drop-mode == 0 ? -2px : parent.height;
                                                width: parent.width - self.x - 4px;
                                                height: 2px;
                                                border-radius: 1px;
                                                background: Theme.accent;
                                            }
                                            // Group members hang from a thin guide.
                                            if l.depth > 0: Rectangle { x: 14px; y: -2px; width: 1px; height: parent.height + 4px; background: Theme.line; }
                                            HorizontalLayout {
                                                padding-left: 6px + l.depth * 18px;
                                                padding-right: 2px;
                                                spacing: 6px;
                                                if l.is-group: IconButton {
                                                    width: 20px;
                                                    height: 28px;
                                                    icon: l.collapsed ? "M9 6 l6 6 -6 6" : "M6 9 l6 6 6 -6";
                                                    label: l.collapsed ? @tr("layers-expand-group" => "Expand group") : @tr("layers-collapse-group" => "Collapse group");
                                                    clicked => { root.layer-collapse(l.id); }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Icon { width: 18px; height: 18px; d: KindIcons.paths[l.kind]; tint: l.hidden ? Theme.disabled : (l.is-group ? Theme.accent-text : Theme.text2); }
                                                }
                                                Text { text: l.name; color: l.hidden ? Theme.text3 : Theme.text; font-size: 12px; font-weight: l.is-group ? 600 : 400; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                                if l.is-group: Text { text: l.count; color: Theme.text3; font-size: 11px; vertical-alignment: center; }
                                                IconButton {
                                                    width: 28px;
                                                    height: 28px;
                                                    label: l.hidden ? @tr("layers-show" => "Show") : @tr("layers-hide" => "Hide");
                                                    icon: l.hidden ? "M3 3 l18 18 M10.6 10.6 a2 2 0 0 0 2.8 2.8 M9.9 5.1 A10 10 0 0 1 21 12 a17 17 0 0 1 -2.8 3.6 M6.6 6.6 A17 17 0 0 0 3 12 s3.5 6 9 6 a9 9 0 0 0 3.6 -0.7" : "M2 12 s3.5 -7 10 -7 10 7 10 7 -3.5 7 -10 7 -10 -7 -10 -7 z M9 12 a3 3 0 1 0 6 0 a3 3 0 1 0 -6 0";
                                                    clicked => {
                                                        if (l.is-group) { root.layer-group-eye(l.id); } else { root.layer-eye(l.id); }
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 30px;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                spacing: 6px;
                                                VerticalLayout { alignment: center; Icon { width: 18px; height: 18px; d: KindIcons.paths[9]; tint: Theme.text3; } }
                                                Text { text: @tr("layers-background" => "Screenshot (background) — always at the bottom"); color: Theme.text3; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                            }
                                        }
                                        if root.layers.length > 1: Text { text: @tr("layers-drag-hint" => "Drag a row to change the order; drop it onto another row to group them."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    }
                                }
                                // The row being dragged, lifted: follows the pointer with a shadow.
                                if root.layer-drag-from >= 0 && root.layer-drag-from < root.layers.length: ghost := Rectangle {
                                    property <LayerRow> r: root.layers[root.layer-drag-from];
                                    x: 4px;
                                    y: clamp(lsv.content-y + root.layer-drag-y - 16px, -8px, parent.height - 24px);
                                    width: parent.width - 20px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Theme.elevated;
                                    border-width: 1px;
                                    border-color: Theme.control-on;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-color: #00000090;
                                    // see-through a little: the target's highlight shows under it
                                    opacity: 0.9;
                                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                                    transform-scale: 1.03;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 6px;
                                        VerticalLayout { alignment: center; Icon { width: 18px; height: 18px; d: KindIcons.paths[ghost.r.kind]; tint: Theme.text; } }
                                        Text { text: ghost.r.name; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }
                        // ---- Image (ZK-53): crop, turns, tone, size — a recipe over the original.
                        if root.insp-tab == 2: InspScroll {
                            VerticalLayout {
                                spacing: 18px;
                                alignment: start;
                                // ZK-119: QR codes and barcodes; ZK-184: the text — both on the device.
                                VerticalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    HorizontalLayout {
                                        alignment: start;
                                        TextButton {
                                            icon: "M4 4 h6 v6 H4 z M14 4 h6 v6 h-6 z M4 14 h6 v6 H4 z M14 14 h2 v2 h-2 z M18 18 h2 v2 h-2 z M14 18 h2 M18 14 h2";
                                            text: @tr("img-read-codes" => "Read QR codes and barcodes");
                                            clicked => { root.read-codes(); }
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        TextButton {
                                            icon: "M4 7 V5 h16 v2 M12 5 v14 M9 19 h6 M3 3 h3 M3 3 v3 M21 3 h-3 M21 3 v3 M3 21 h3 M3 21 v-3 M21 21 h-3 M21 21 v-3";
                                            text: @tr("img-read-text" => "Text from the screenshot") + " (X)";
                                            clicked => { root.text-start(); }
                                        }
                                    }
                                }
                                // ---- video (ZK-181/188/189): what is left after the trimming, and the sound
                                if root.vid-mode: PropSection {
                                    title: @tr("vid-trim" => "Trim");
                                    HorizontalLayout { Text { text: @tr("vid-from" => "From"); color: Theme.text2; font-size: 12px; horizontal-stretch: 1; } Text { text: root.vid-trim-in; color: Theme.text; font-family: "JetBrains Mono"; font-size: 12px; } }
                                    HorizontalLayout { Text { text: @tr("vid-to" => "To"); color: Theme.text2; font-size: 12px; horizontal-stretch: 1; } Text { text: root.vid-trim-out; color: Theme.text; font-family: "JetBrains Mono"; font-size: 12px; } }
                                    HorizontalLayout { Text { text: @tr("vid-cut" => "Cut"); color: Theme.text2; font-size: 12px; horizontal-stretch: 1; } Text { text: root.vid-trim-cut; color: Theme.text; font-family: "JetBrains Mono"; font-size: 12px; } }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.control-on;
                                        Rectangle { x: 0; width: parent.width * root.vid-kept-frac; border-radius: 3px; background: Theme.accent; }
                                    }
                                    HorizontalLayout { Text { text: @tr("vid-left" => "Left"); color: Theme.text; font-size: 12px; font-weight: 600; horizontal-stretch: 1; } Text { text: root.vid-trim-left; color: Theme.text; font-family: "JetBrains Mono"; font-size: 12px; font-weight: 600; } }
                                    Text { text: @tr("vid-trim-note" => "The recording is never changed: what is cut can come back, and the file is rewritten only on export."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    Text { text: @tr("vid-tl-hint" => "Drag on the strip to pick a piece · Del cuts it · Shift+Del keeps only it · S splits"); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    if root.vid-edited: HorizontalLayout { alignment: start; TextButton { text: @tr("vid-reset-trim" => "Reset trimming"); clicked => { root.vid-action("reset", 0); } } }
                                    if root.vid-note != "": Text { text: root.vid-note; color: Theme.attention; font-size: 11px; wrap: word-wrap; }
                                }
                                if root.vid-mode: PropSection {
                                    title: @tr("vid-sound" => "Sound");
                                    HorizontalLayout {
                                        spacing: 2px;
                                        SegOption { text: @tr("vid-no-sound" => "No sound"); on: root.vid-sound-mode == 0; clicked => { root.vid-action("sound", 0); } }
                                        SegOption { text: @tr("vid-track-system" => "System"); enabled: root.vid-has-system; on: root.vid-sound-mode == 1; clicked => { root.vid-action("sound", 1); } }
                                        SegOption { text: @tr("vid-track-mic" => "Microphone"); enabled: root.vid-has-mic; on: root.vid-sound-mode == 2; clicked => { root.vid-action("sound", 2); } }
                                        SegOption { text: @tr("vid-sound-both" => "Both"); enabled: root.vid-has-system && root.vid-has-mic; on: root.vid-sound-mode == 3; clicked => { root.vid-action("sound", 3); } }
                                    }
                                    for t[i] in root.vid-tracks: HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle { y: 6px; width: 8px; height: 8px; border-radius: 2px; background: t.colour; }
                                        Text { text: t.label; color: t.muted ? Theme.text3 : Theme.text; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                                        Text { text: t.volume + " %"; color: Theme.text3; font-family: "JetBrains Mono"; font-size: 11px; vertical-alignment: center; }
                                        SmallButton { text: t.muted ? @tr("vid-track-on" => "Turn on") : @tr("vid-track-off" => "Turn off"); clicked => { root.vid-action(t.muted ? "track-unmute" : "track-mute", i); } }
                                    }
                                    Text { text: @tr("vid-tracks-note" => "Tracks are separate; export mixes them into one."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                }
                                if root.vid-mode: PropSection {
                                    title: @tr("vid-speed-title" => "Speed");
                                    HorizontalLayout {
                                        spacing: 2px;
                                        SegOption { text: "0.5×"; on: root.vid-speed-i == 0; clicked => { root.vid-action("speed-set", 0); } }
                                        SegOption { text: "1×"; on: root.vid-speed-i == 1; clicked => { root.vid-action("speed-set", 1); } }
                                        SegOption { text: "1.5×"; on: root.vid-speed-i == 2; clicked => { root.vid-action("speed-set", 2); } }
                                        SegOption { text: "2×"; on: root.vid-speed-i == 3; clicked => { root.vid-action("speed-set", 3); } }
                                    }
                                    Text { text: @tr("vid-speed-note" => "Playback in the editor only; the export keeps the real speed."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                }
                                // Crop: the panel while the Crop tool is on, a button otherwise.
                                if root.tool == 10: PropSection {
                                    title: @tr("crop-title" => "Crop");
                                    action-icon: "M4.5 12 a7.5 7.5 0 1 0 2.2 -5.3 M4.5 4 v4 h4";
                                    action-tip: @tr("status-crop-whole" => "Crop: whole screenshot");
                                    action => { root.image-action("crop-whole"); }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-w" => "W"); value <=> root.crop-w; committed(v) => { root.set-crop-size("w", v); } }
                                        NumField { label: @tr("insp-h" => "H"); value <=> root.crop-h; committed(v) => { root.set-crop-size("h", v); } }
                                        IconButton { width: 28px; height: 26px; icon: "M8 11 V8 a4 4 0 0 1 8 0 v3 M6 11 h12 v9 H6 z"; active: root.crop-lock; label: @tr("crop-lock-ratio" => "Lock proportions"); clicked => { root.image-action("crop-lock"); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 2px;
                                        SegOption { text: @tr("crop-aspect-free" => "Free"); on: root.crop-aspect == 0 || root.crop-aspect == 5; clicked => { root.image-action("crop-aspect-0"); } }
                                        SegOption { text: "16:9"; on: root.crop-aspect == 1; clicked => { root.image-action("crop-aspect-1"); } }
                                        SegOption { text: "4:3"; on: root.crop-aspect == 2; clicked => { root.image-action("crop-aspect-2"); } }
                                        SegOption { text: "1:1"; on: root.crop-aspect == 3; clicked => { root.image-action("crop-aspect-3"); } }
                                        SegOption { text: "9:16"; on: root.crop-aspect == 4; clicked => { root.image-action("crop-aspect-4"); } }
                                    }
                                    Text { text: root.crop-sizes; color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                                    if root.crop-outside != "": Text { text: root.crop-outside; color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;
                                        TextButton { text: @tr("common-cancel" => "Cancel"); clicked => { root.image-action("crop-cancel"); } }
                                        TextButton { text: @tr("common-done" => "Done"); primary: true; clicked => { root.image-action("crop-done"); } }
                                    }
                                }
                                if root.tool != 10: PropSection {
                                    title: @tr("shot-crop" => "Crop");
                                    action-icon: root.cropped ? "M4.5 12 a7.5 7.5 0 1 0 2.2 -5.3 M4.5 4 v4 h4" : "";
                                    action-tip: @tr("status-crop-whole" => "Crop: whole screenshot");
                                    action => { root.image-action("crop-whole"); }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        TextButton { text: @tr("shot-crop-button" => "Crop (C)"); icon: "M6 2 v14 a2 2 0 0 0 2 2 h14 M2 6 h14 a2 2 0 0 1 2 2 v14"; clicked => { root.image-action("crop"); } }
                                        Text { text: root.crop-text; color: Theme.text3; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    }
                                }
                                if !root.vid-mode: PropSection {
                                    title: @tr("shot-rotate-mirror" => "Rotate and mirror");
                                    HorizontalLayout {
                                        spacing: 2px;
                                        SegOption { icon: "M4 4 v5 h5 M4.6 9 A8 8 0 1 1 5.5 16.5"; tip: @tr("shot-rotate-left" => "Rotate left"); clicked => { root.image-action("rotate-left"); } }
                                        SegOption { icon: "M20 4 v5 h-5 M19.4 9 A8 8 0 1 0 18.5 16.5"; tip: @tr("shot-rotate-right" => "Rotate right"); clicked => { root.image-action("rotate-right"); } }
                                        SegOption { icon: "M12 2 v20 M8.5 6 L2.5 18 h6 z M15.5 6 l6 12 h-6 z"; tip: @tr("shot-mirror-h" => "Mirror horizontally"); clicked => { root.image-action("mirror-h"); } }
                                        SegOption { icon: "M2 12 h20 M6 8.5 L18 2.5 v6 z M6 15.5 l12 6 v-6 z"; tip: @tr("shot-mirror-v" => "Mirror vertically"); clicked => { root.image-action("mirror-v"); } }
                                    }
                                }
                                PropSection {
                                    title: @tr("shot-tone" => "Tone");
                                    action-icon: "M4.5 12 a7.5 7.5 0 1 0 2.2 -5.3 M4.5 4 v4 h4";
                                    action-tip: @tr("shot-tone-reset-tip" => "Back to the tone as captured");
                                    action-enabled: !root.tone-default;
                                    action => { root.image-action("tone-reset"); }
                                    PropRow {
                                        label: @tr("shot-exposure" => "Exposure");
                                        MiniSlider { horizontal-stretch: 1; value <=> root.tone-exposure; tip: @tr("shot-exposure" => "Exposure"); moved(v) => { root.set-tone("exposure", v, false); } released => { root.set-tone("exposure", root.tone-exposure, true); } }
                                        Text { text: root.tone-exposure-text; color: Theme.text2; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; width: 56px; }
                                    }
                                    PropRow {
                                        label: @tr("shot-gamma" => "Gamma");
                                        MiniSlider { horizontal-stretch: 1; value <=> root.tone-gamma; tip: @tr("shot-gamma" => "Gamma"); moved(v) => { root.set-tone("gamma", v, false); } released => { root.set-tone("gamma", root.tone-gamma, true); } }
                                        Text { text: root.tone-gamma-text; color: Theme.text2; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; width: 56px; }
                                    }
                                    PropRow {
                                        label: @tr("shot-contrast" => "Contrast");
                                        MiniSlider { horizontal-stretch: 1; value <=> root.tone-contrast; tip: @tr("shot-contrast" => "Contrast"); moved(v) => { root.set-tone("contrast", v, false); } released => { root.set-tone("contrast", root.tone-contrast, true); } }
                                        Text { text: root.tone-contrast-text; color: Theme.text2; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; width: 56px; }
                                    }
                                    HoldButton { text: @tr("shot-compare" => "Compare"); tip: @tr("shot-compare-tip" => "Hold to see the original frame"); held(on) => { root.compare(on); } }
                                    Text { text: @tr("shot-tone-hint" => "A recipe over the original: the original stays untouched; Compare shows it while you hold."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                }
                                if root.vid-mode: PropSection {
                                    title: @tr("vid-out-title" => "Size on export");
                                    HorizontalLayout {
                                        spacing: 2px;
                                        SegOption { text: "100 %"; on: root.vid-out-preset == 0; clicked => { root.vid-action("out-preset", 0); } }
                                        SegOption { text: "1280"; on: root.vid-out-preset == 1; clicked => { root.vid-action("out-preset", 1); } }
                                        SegOption { text: "1920"; on: root.vid-out-preset == 2; clicked => { root.vid-action("out-preset", 2); } }
                                        SegOption { text: "50 %"; on: root.vid-out-preset == 3; clicked => { root.vid-action("out-preset", 3); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-w" => "W"); value: root.vid-out-w; committed(v) => { root.vid-out-edited("w", v); } }
                                        NumField { label: @tr("insp-h" => "H"); value: root.vid-out-h; committed(v) => { root.vid-out-edited("h", v); } }
                                        IconButton { width: 28px; height: 26px; icon: "M8 11 V8 a4 4 0 0 1 8 0 v3 M6 11 h12 v9 H6 z"; active: root.vid-out-lock; label: @tr("crop-lock-ratio" => "Lock proportions"); clicked => { root.vid-action("out-lock", 0); } }
                                    }
                                    Text { text: @tr("vid-out-note" => "The frame is scaled on export; the recording stays as it is. Sides are even (the encoder needs it)."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                }
                                if !root.vid-mode: PropSection {
                                    title: @tr("size-image-title" => "Image size");
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumField { label: @tr("insp-w" => "W"); value <=> root.size-w; committed(v) => { root.size-edited("w", v); } }
                                        NumField { label: @tr("insp-h" => "H"); value <=> root.size-h; committed(v) => { root.size-edited("h", v); } }
                                    }
                                    SwitchRow { text: @tr("size-keep-ratio" => "Keep proportions"); checked <=> root.size-keep; }
                                    SwitchRow { text: @tr("size-scale-text" => "Scale text with the image"); checked <=> root.size-scale-text; }
                                    Text { text: @tr("size-note-image" => "Line widths, counters and stamps keep their size; text scales only with the checkbox above."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        alignment: end;
                                        TextButton { text: @tr("size-apply" => "Resize"); clicked => { root.image-action("size-apply"); } }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: root.info-size; color: Theme.text; font-size: 14px; font-weight: 600; }
                                    Text { text: @tr("meta-source" => "Source"); color: Theme.text3; font-size: 11px; }
                                    Text { text: root.info-source; color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: @tr("meta-taken" => "Date taken"); color: Theme.text3; font-size: 11px; }
                                    Text { text: root.info-taken; color: Theme.text2; font-size: 12px; }
                                }
                                Text { text: root.info-path; color: Theme.text3; font-size: 10px; wrap: word-wrap; }
                            }
                        }
                        // ---- Meta
                        if root.insp-tab == 3: InspScroll {
                            VerticalLayout {
                                spacing: 10px;
                                alignment: start;
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: @tr("meta-title" => "Title"); color: Theme.text3; font-size: 11px; }
                                    LineEdit { text <=> root.meta-title; edited(t) => { root.meta-edited("title", t); } }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: @tr("meta-description" => "Description"); color: Theme.text3; font-size: 11px; }
                                    TextEdit { height: 80px; text <=> root.meta-description; wrap: word-wrap; edited(t) => { root.meta-edited("description", t); } }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: @tr("meta-tags" => "Tags"); color: Theme.text3; font-size: 11px; }
                                    LineEdit { text <=> root.meta-tags; placeholder-text: @tr("meta-add-tag" => "add…"); edited(t) => { root.meta-edited("tags", t); } }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: @tr("meta-author" => "Author"); color: Theme.text3; font-size: 11px; }
                                    LineEdit { text <=> root.meta-author; edited(t) => { root.meta-edited("author", t); } }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: @tr("meta-rights" => "Copyright"); color: Theme.text3; font-size: 11px; }
                                    LineEdit { text <=> root.meta-rights; edited(t) => { root.meta-edited("rights", t); } }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: @tr("meta-taken" => "Date taken"); color: Theme.text3; font-size: 11px; }
                                    Text { text: root.info-taken; color: Theme.text2; font-size: 12px; }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { height: root.over-screen ? 0px : 1px; background: Theme.line; }
            // ---- status bar: size · hint · crop · zoom (fit, slider, %, 100%)
            Rectangle {
                height: root.over-screen ? 0px : 30px;
                visible: !root.over-screen;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 12px;
                    Text { text: root.image-size; color: Theme.text3; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.toast != "" ? root.toast : root.hint; color: root.toast != "" ? Theme.accent-text : Theme.text2; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: root.crop-text; color: Theme.text3; font-size: 12px; vertical-alignment: center; }
                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;
                        SmallButton { icon: "M4 9 V4 h5 M15 4 h5 v5 M20 15 v5 h-5 M9 20 H4 v-5"; tip: @tr("status-fit" => "Fit to window") + "  " + Keys.k("Ctrl+0", "⌘0"); clicked => { root.zoom-fit(); } }
                        MiniSlider {
                            width: 120px;
                            value <=> root.zoom-pos;
                            tip: @tr("status-zoom" => "Zoom");
                            moved(v) => { root.zoom-to(v); }
                        }
                        Text { text: root.zoom-text; color: Theme.text; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; width: 44px; }
                        SmallButton { text: "100%"; tip: @tr("status-zoom-100" => "Zoom 100 %") + "  " + Keys.k("Ctrl+1", "⌘1"); clicked => { root.zoom-100(); } }
                    }
                }
            }
        }
    }

    // ---- resize edges of the frameless window (Windows)
    if root.custom-frame && !root.win-maximized && !root.over-screen: Rectangle {
        property <length> e: 5px;
        ResizeEdge { x: 0; y: 0; width: parent.width; height: parent.e; dir: 1; mouse-cursor: ns-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: parent.height - parent.e; width: parent.width; height: parent.e; dir: 4; mouse-cursor: ns-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: 0; width: parent.e; height: parent.height; dir: 7; mouse-cursor: ew-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: parent.width - parent.e; y: 0; width: parent.e; height: parent.height; dir: 0; mouse-cursor: ew-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: 0; width: 10px; height: 10px; dir: 3; mouse-cursor: nwse-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: parent.width - 10px; y: 0; width: 10px; height: 10px; dir: 2; mouse-cursor: nesw-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: parent.height - 10px; width: 10px; height: 10px; dir: 6; mouse-cursor: nesw-resize; resize(d) => { root.window-resize(d); } }
        ResizeEdge { x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px; dir: 5; mouse-cursor: nwse-resize; resize(d) => { root.window-resize(d); } }
    }

    // ---- the export sheet (ZK-187): formats as cards with a size estimate on the left, the
    // chosen format's settings on the right, where it goes, and the two buttons. Built so the
    // video formats (MP4 / GIF / HTML) fit the same frame later.
    in property <bool> exp-open;
    in property <[ExportCard]> exp-cards;
    in property <int> exp-format;
    in property <int> exp-quality: 90;
    // WebP without loss (ZK-197).
    in property <bool> exp-lossless;
    in property <int> exp-scale: 1;
    in-out property <string> exp-width;
    in property <bool> exp-metadata;
    in property <bool> exp-white;
    in property <bool> exp-white-forced;
    in property <bool> exp-remember: true;
    in property <int> exp-to: 1;
    in-out property <string> exp-name;
    in property <string> exp-subtitle;
    in property <string> exp-estimate;
    in property <string> exp-go;
    in property <image> exp-preview;
    callback exp-set(string, int);
    callback exp-width-set(string);
    callback exp-go-clicked();
    callback exp-close();
    // ZK-190: the sheet shows a video's formats; the GIF's width / rate (indices), dithering,
    // the size limit (index), a warning, whether the library is a place, the progress (−1 idle).
    in property <bool> exp-video;
    in property <int> vexp-width: 1;
    in property <int> vexp-fps: 1;
    in property <bool> vexp-dither: true;
    in property <int> vexp-limit;
    in property <string> vexp-limit-text;
    in property <bool> vexp-over;
    in property <bool> vexp-library-ok: true;
    in property <float> vexp-progress: -1;
    // The report (ZK-98): one page or a .zreport; hiding — the sheet's switch (Settings: 0 ask,
    // 1 always, 2 never) and what it would hide; over 100 MB as a page.
    in property <bool> vexp-zreport;
    // ZK-245: the page's language (0 Ukrainian, 1 English) and the signature
    in property <int> vexp-lang;
    in property <bool> vexp-has-sign;
    in property <bool> vexp-sign: true;
    in property <bool> vexp-has-log;
    in property <int> vexp-hide-mode;
    in property <bool> vexp-hide: true;
    in property <string> vexp-hide-text;
    in property <bool> vexp-report-big;
    changed exp-open => {
        if (root.exp-open) {
            Tip.armed = false;
            exp-keys.focus();
        }
    }
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000088;
        opacity: root.exp-open ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 160ms; easing: ease-out; }
        TouchArea { clicked => { root.exp-close(); } }
        exp-keys := FocusScope {
            enabled: root.exp-open;
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.exp-close();
                } else if (e.text == Key.Return) {
                    root.exp-go-clicked();
                }
                accept
            }
        }
        Rectangle {
            // Whole physical pixels (ZK-201): a sheet at a fractional position is drawn through
            // a layer (clip with rounded corners) that the GPU then resamples — soft text.
            width: round(min(840px, root.width - 32px) / 1phx) * 1phx;
            height: round(min(exp-lay.preferred-height, root.height - 32px) / 1phx) * 1phx;
            x: round((parent.width - self.width) / 2 / 1phx) * 1phx;
            y: round(((parent.height - self.height) / 2 - 12px) / 1phx) * 1phx;
            border-radius: 16px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.control-on;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #000000A0;
            clip: true;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: root.exp-open ? 1.0 : 0.94;
            animate transform-scale { duration: 260ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.12); }
            TouchArea { }
            exp-lay := VerticalLayout {
                padding: 22px;
                padding-top: 18px;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 12px;
                    height: 28px;
                    Text { text: root.exp-video ? @tr("vexp-title" => "Export video") : @tr("export-title" => "Export file"); color: Theme.text; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                    Text { text: root.exp-subtitle; color: Theme.text3; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton { width: 32px; height: 28px; icon: "M6 6 L18 18 M18 6 L6 18"; label: @tr("common-close" => "Close") + "  Esc"; clicked => { root.exp-close(); } }
                }
                HorizontalLayout {
                    spacing: 20px;
                    // formats
                    VerticalLayout {
                        width: 320px;
                        spacing: 8px;
                        alignment: start;
                        for c[i] in root.exp-cards: Rectangle {
                            height: card-lay.preferred-height;
                            border-radius: 12px;
                            background: root.exp-format == i ? Theme.accent.transparentize(0.86) : (card-ta.has-hover ? Theme.hover : Theme.elevated);
                            border-width: 1.5px;
                            border-color: root.exp-format == i ? Theme.accent : transparent;
                            animate background, border-color { duration: 140ms; }
                            opacity: c.enabled ? 1 : 0.55;
                            card-lay := VerticalLayout {
                                padding: 14px;
                                padding-left: 16px;
                                spacing: 5px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: c.title; color: Theme.text; font-size: 14px; font-weight: 700; }
                                    Text { text: c.sub; color: Theme.text3; font-size: 13px; horizontal-stretch: 1; }
                                }
                                Text { text: c.desc; color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                                Text { text: c.estimate; color: Theme.accent; font-size: 11px; font-family: "JetBrains Mono"; }
                            }
                            card-ta := TipTouch {
                                enabled: c.enabled;
                                clicked => { root.exp-set("format", i); }
                            }
                        }
                        Rectangle { height: 4px; }
                        // the preview, as it will look
                        Rectangle {
                            height: 140px;
                            border-radius: 10px;
                            background: Theme.elevated;
                            clip: true;
                            Image { source: root.exp-preview; width: parent.width - 16px; height: parent.height - 16px; image-fit: contain; }
                        }
                    }
                    // the chosen format's settings
                    Rectangle { width: 1px; background: Theme.line; }
                    // ---- the video's formats (ZK-190)
                    if root.exp-video: VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;
                        alignment: start;
                        if root.exp-format == 1: VerticalLayout {
                            spacing: 8px;
                            Text { text: @tr("vexp-width" => "Width"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; }
                            HorizontalLayout {
                                spacing: 4px;
                                for w[i] in ["480", "640", "800", "1280"]: SegOption { text: w; on: root.vexp-width == i; clicked => { root.exp-set("vwidth", i); } }
                            }
                            Text { text: @tr("vexp-fps" => "Frames/s"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; }
                            HorizontalLayout {
                                spacing: 4px;
                                for f[i] in ["5", "10", "15", "20"]: SegOption { text: f; on: root.vexp-fps == i; clicked => { root.exp-set("vfps", i); } }
                            }
                            SwitchRow { text: @tr("vexp-dither" => "Dithering"); checked: root.vexp-dither; toggled => { root.exp-set("vdither", self.checked ? 1 : 0); } }
                            HorizontalLayout {
                                Text { text: @tr("vexp-limit" => "Not more than"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; horizontal-stretch: 1; }
                                Text { text: root.vexp-limit-text; color: Theme.text; font-size: 12px; font-family: "JetBrains Mono"; }
                            }
                            MiniSlider {
                                height: 20px;
                                value: root.vexp-limit / 6;
                                moved(v) => { root.exp-set("vlimit", round(v * 6)); }
                            }
                            Text { text: @tr("vexp-limit-note" => "Over the limit, Znimok lowers the frame rate, then the width, and says what it changed."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                            if root.vexp-over: Text { text: @tr("vexp-gif-warning" => "GIFs over 25 MB load poorly in chats. MP4 or WebP suits such clips better."); color: Theme.attention; font-size: 11px; wrap: word-wrap; }
                        }
                        if root.exp-format == 0: Text { text: @tr("vexp-mp4-note" => "H.264 with the hardware encoder; the sound tracks that are on are mixed into one; what is cut is left out with short fades at the joints."); color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                        if root.exp-format == 2 && root.vexp-has-log: Text { text: @tr("vexp-html-log-note" => "The page carries the browser's DevTools log beside the video, as the report does; sensitive values are hidden as set below."); color: Theme.text2; font-size: 11px; wrap: word-wrap; }
                        if root.exp-format == 2 && root.vexp-has-log && root.vexp-hide-mode == 0: SwitchRow { text: @tr("vexp-hide" => "Hide sensitive values"); checked: root.vexp-hide; toggled => { root.exp-set("rhide", self.checked ? 1 : 0); } }
                        if root.exp-format == 2 && !root.vexp-has-log: Text { text: @tr("vexp-html-note" => "The video and its marks in one file: the marks stay a layer over the video, shown in their time; a hide and a marker go into the video itself."); color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                        if root.exp-format == 3: Text { text: @tr("vexp-frame-note" => "The frame on the canvas, full size, with the marks shown on it — a new screenshot in a window of its own."); color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                        // ZK-98: the developer report
                        if root.exp-format == 4: VerticalLayout {
                            spacing: 8px;
                            Text { text: @tr("vexp-report-note" => "One page up to 100 MB opens in any browser; a .zreport keeps the video beside the page and the log and dataLayer as JSON, and opens in Znimok as a recording."); color: Theme.text2; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 4px;
                                SegOption { text: @tr("vexp-report-html" => "One page (HTML)"); on: !root.vexp-zreport; clicked => { root.exp-set("rzip", 0); } }
                                SegOption { text: @tr("vexp-report-zip" => "Archive (.zreport)"); on: root.vexp-zreport; clicked => { root.exp-set("rzip", 1); } }
                            }
                            if root.vexp-report-big: Text { text: @tr("vexp-report-big" => "Over 100 MB as one page — choose the .zreport."); color: Theme.attention; font-size: 11px; wrap: word-wrap; }
                            if !root.vexp-has-log: Text { text: @tr("vexp-no-log" => "This recording has no browser log: the report has the video and its marks."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                            if root.vexp-has-log && root.vexp-hide-mode == 0: SwitchRow { text: @tr("vexp-hide" => "Hide sensitive values"); checked: root.vexp-hide; toggled => { root.exp-set("rhide", self.checked ? 1 : 0); } }
                            if root.vexp-has-log && root.vexp-hide-mode == 1: Text { text: @tr("vexp-hide-always" => "Sensitive values are always hidden (Settings → Recording)."); color: Theme.text2; font-size: 11px; wrap: word-wrap; }
                            if root.vexp-has-log && root.vexp-hide-mode == 2: Text { text: @tr("vexp-hide-never" => "Sensitive values are not hidden (Settings → Recording)."); color: Theme.attention; font-size: 11px; wrap: word-wrap; }
                            if root.vexp-has-log && root.vexp-hide-mode != 2 && (root.vexp-hide-mode == 1 || root.vexp-hide): Text { text: root.vexp-hide-text; color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                        }
                        // ZK-245: a page with the log has a language of its own and may be signed
                        if root.exp-format == 4 || (root.exp-format == 2 && root.vexp-has-log): VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 4px;
                                Text { text: @tr("vexp-lang" => "Page language"); color: Theme.text2; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                SegOption { text: "Українська"; on: root.vexp-lang == 0; clicked => { root.exp-set("rlang", 0); } }
                                SegOption { text: "English"; on: root.vexp-lang == 1; clicked => { root.exp-set("rlang", 1); } }
                            }
                            if root.vexp-has-sign: SwitchRow { text: @tr("vexp-sign" => "Sign: who recorded it, the rights notice"); checked: root.vexp-sign; toggled => { root.exp-set("rsign", self.checked ? 1 : 0); } }
                            if !root.vexp-has-sign: Text { text: @tr("vexp-sign-none" => "Your name and a rights notice can be added in Settings → Recording."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                        }
                        if root.exp-format <= 2 || root.exp-format == 4: Rectangle {
                            border-radius: 10px;
                            background: Theme.elevated;
                            height: vest-lay.preferred-height;
                            vest-lay := HorizontalLayout {
                                padding: 12px;
                                Text { text: @tr("export-size" => "Size"); color: Theme.text2; font-size: 12px; horizontal-stretch: 1; }
                                Text { text: root.exp-estimate; color: Theme.accent; font-size: 12px; font-family: "JetBrains Mono"; }
                            }
                        }
                        if root.exp-format <= 2 || root.exp-format == 4: Text { text: @tr("export-name" => "Name"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; }
                        if root.exp-format <= 2 || root.exp-format == 4: Rectangle {
                            height: 30px;
                            border-radius: 7px;
                            background: Theme.elevated;
                            border-width: 1px;
                            border-color: vname-in.has-focus ? Theme.accent : Theme.control-on;
                            vname-in := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                vertical-alignment: center;
                                color: Theme.text;
                                font-size: 13px;
                                single-line: true;
                                text <=> root.exp-name;
                                accessible-label: @tr("export-name-a11y" => "File name");
                            }
                        }
                        if root.exp-format <= 2 || root.exp-format == 4: Text { text: @tr("export-where" => "Where"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; }
                        if root.exp-format <= 2 || root.exp-format == 4: HorizontalLayout {
                            spacing: 4px;
                            SegOption { text: @tr("export-to-clipboard" => "To clipboard"); on: root.exp-to == 0; clicked => { root.exp-set("to", 0); } }
                            SegOption { text: @tr("export-to-file" => "File…"); on: root.exp-to == 1; clicked => { root.exp-set("to", 1); } }
                            SegOption { text: @tr("export-to-library" => "To the library"); enabled: root.vexp-library-ok; on: root.exp-to == 2; clicked => { root.exp-set("to", 2); } }
                        }
                        if (root.exp-format <= 2 || root.exp-format == 4) && root.exp-to == 0: Text { text: @tr("vexp-clipboard-note" => "The clipboard gets the file: paste it into a chat or a folder."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                        if root.int-targets.length > 0 && (root.exp-format <= 2 || root.exp-format == 4): VerticalLayout {
                            spacing: 6px;
                            Text { text: @tr("share-send-to" => "Send to"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 4px;
                                for t in root.int-targets: SegOption { text: t.name; on: false; clicked => { root.int-action("send", t.key); } }
                            }
                        }
                        if root.vexp-progress >= 0: VerticalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.control-on;
                                Rectangle { x: 0; width: parent.width * root.vexp-progress; border-radius: 3px; background: Theme.accent; animate width { duration: 120ms; } }
                            }
                            Text { text: @tr("vexp-working" => "Exporting… {0} %", round(root.vexp-progress * 100)); color: Theme.text2; font-size: 12px; }
                        }
                        HorizontalLayout {
                            padding-top: 6px;
                            spacing: 8px;
                            alignment: end;
                            TextButton { text: @tr("common-cancel" => "Cancel"); clicked => { root.exp-close(); } }
                            TextButton { primary: true; enabled: root.vexp-progress < 0; text: root.exp-go; clicked => { root.exp-go-clicked(); } }
                        }
                    }
                    if !root.exp-video: VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;
                        alignment: start;
                        // WebP (ZK-197): lossless, or a quality like JPEG's.
                        if root.exp-format == 2: SwitchRow { text: @tr("export-lossless" => "Lossless"); checked: root.exp-lossless; toggled => { root.exp-set("lossless", self.checked ? 1 : 0); } }
                        if root.exp-format == 1 || (root.exp-format == 2 && !root.exp-lossless): VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                Text { text: @tr("export-quality" => "Quality"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; horizontal-stretch: 1; }
                                Text { text: root.exp-quality; color: Theme.text; font-size: 12px; font-family: "JetBrains Mono"; }
                            }
                            MiniSlider {
                                height: 20px;
                                value: (root.exp-quality - 1) / 99;
                                moved(v) => { root.exp-set("quality", round(1 + v * 99)); }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                for q in [60, 75, 85, 92]: SegOption { text: q; on: root.exp-quality == q; clicked => { root.exp-set("quality", q); } }
                            }
                        }
                        Text { text: @tr("export-scale" => "Scale"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; }
                        HorizontalLayout {
                            spacing: 4px;
                            SegOption { text: "50 %"; on: root.exp-scale == 0; clicked => { root.exp-set("scale", 0); } }
                            SegOption { text: "100 %"; on: root.exp-scale == 1; clicked => { root.exp-set("scale", 1); } }
                            SegOption { text: "200 %"; on: root.exp-scale == 2; clicked => { root.exp-set("scale", 2); } }
                            NumField { width: 110px; label: "px"; value <=> root.exp-width; committed(v) => { root.exp-width-set(v); } }
                        }
                        Rectangle {
                            border-radius: 10px;
                            background: Theme.elevated;
                            height: est-lay.preferred-height;
                            est-lay := HorizontalLayout {
                                padding: 12px;
                                Text { text: @tr("export-size" => "Size"); color: Theme.text2; font-size: 12px; horizontal-stretch: 1; }
                                Text { text: root.exp-estimate; color: Theme.accent; font-size: 12px; font-family: "JetBrains Mono"; }
                            }
                        }
                        SwitchRow { text: @tr("export-metadata" => "Write metadata (title, description, author, date)"); checked: root.exp-metadata; toggled => { root.exp-set("metadata", self.checked ? 1 : 0); } }
                        SwitchRow { enabled: !root.exp-white-forced; text: @tr("export-white-bg" => "Transparent background → white"); checked: root.exp-white; toggled => { root.exp-set("white", self.checked ? 1 : 0); } }
                        SwitchRow { text: @tr("export-remember" => "Remember these settings"); checked: root.exp-remember; toggled => { root.exp-set("remember", self.checked ? 1 : 0); } }
                        Text { text: @tr("export-name" => "Name"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; }
                        Rectangle {
                            height: 30px;
                            border-radius: 7px;
                            background: Theme.elevated;
                            border-width: 1px;
                            border-color: name-in.has-focus ? Theme.accent : Theme.control-on;
                            name-in := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                vertical-alignment: center;
                                color: Theme.text;
                                font-size: 13px;
                                single-line: true;
                                text <=> root.exp-name;
                                accessible-label: @tr("export-name-a11y" => "File name");
                            }
                        }
                        Text { text: @tr("export-where" => "Where"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; }
                        HorizontalLayout {
                            spacing: 4px;
                            SegOption { text: @tr("export-to-clipboard" => "To clipboard"); on: root.exp-to == 0; clicked => { root.exp-set("to", 0); } }
                            SegOption { text: @tr("export-to-file" => "File…"); on: root.exp-to == 1; clicked => { root.exp-set("to", 1); } }
                            SegOption { text: @tr("export-to-library" => "To the library"); on: root.exp-to == 2; clicked => { root.exp-set("to", 2); } }
                        }
                        if root.exp-to == 0: Text { text: @tr("export-clipboard-note" => "The clipboard takes the picture itself; the format and quality are for files."); color: Theme.text3; font-size: 11px; wrap: word-wrap; }
                        if root.int-targets.length > 0: VerticalLayout {
                            spacing: 6px;
                            Text { text: @tr("share-send-to" => "Send to"); color: Theme.text3; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 4px;
                                for t in root.int-targets: SegOption { text: t.name; on: false; clicked => { root.int-action("send", t.key); } }
                            }
                        }
                        HorizontalLayout {
                            padding-top: 6px;
                            spacing: 8px;
                            alignment: end;
                            TextButton { text: @tr("common-cancel" => "Cancel"); clicked => { root.exp-close(); } }
                            TextButton { primary: true; text: root.exp-go; clicked => { root.exp-go-clicked(); } }
                        }
                    }
                }
            }
        }
    }

    // ---- in-window dialog (owner, 28.09): questions in the app's own look, not the system box.
    // A scrim swallows the clicks; the card springs in; Enter = the primary button, Esc = cancel.
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-body;
    in property <[string]> dialog-buttons;
    in property <int> dialog-primary: -1;
    in property <int> dialog-cancel: -1;
    callback dialog-answer(int);
    changed dialog-open => {
        if (root.dialog-open) {
            Tip.armed = false;
            dialog-keys.focus();
        }
    }
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000088;
        opacity: root.dialog-open ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 160ms; easing: ease-out; }
        TouchArea { }
        dialog-keys := FocusScope {
            enabled: root.dialog-open;
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.dialog-answer(root.dialog-cancel);
                } else if (e.text == Key.Return) {
                    root.dialog-answer(root.dialog-primary);
                }
                accept
            }
        }
        Rectangle {
            // Whole physical pixels, as the export sheet (ZK-201).
            width: round(min(440px, root.width - 32px) / 1phx) * 1phx;
            height: round(dialog-lay.preferred-height / 1phx) * 1phx;
            x: round((parent.width - self.width) / 2 / 1phx) * 1phx;
            y: round(((parent.height - self.height) / 2 - 20px) / 1phx) * 1phx;
            border-radius: 14px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.control-on;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000A0;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: root.dialog-open ? 1.0 : 0.92;
            animate transform-scale { duration: 260ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.12); }
            TouchArea { }
            dialog-lay := VerticalLayout {
                padding: 22px;
                padding-bottom: 18px;
                spacing: 8px;
                Text { text: root.dialog-title; color: Theme.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
                if root.dialog-body != "": Text { text: root.dialog-body; color: Theme.text2; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout {
                    padding-top: 14px;
                    spacing: 8px;
                    alignment: end;
                    for b[i] in root.dialog-buttons: TextButton {
                        text: b;
                        primary: i == root.dialog-primary;
                        clicked => { root.dialog-answer(i); }
                    }
                }
            }
        }
    }

    // ---- tooltip bubble (drawn last: above everything but popups)
    property <bool> tip-show: false;
    property <int> tip-serial: Tip.serial;
    property <bool> tip-armed: Tip.armed;
    changed tip-serial => { root.tip-show = false; }
    changed tip-armed => { if (!root.tip-armed) { root.tip-show = false; } }
    Timer {
        interval: 550ms;
        running: root.tip-armed && !root.tip-show;
        triggered => { root.tip-show = true; }
    }
    Rectangle {
        opacity: root.tip-show ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 130ms; easing: ease-out; }
        width: tip-text.preferred-width + 18px;
        height: 26px;
        x: clamp(Tip.side == 1 ? Tip.ax + 8px : Tip.ax - self.width / 2, 4px, max(4px, root.width - self.width - 4px));
        y: clamp(Tip.side == 0 ? Tip.ay + 6px : (Tip.side == 2 ? Tip.ay - self.height - 6px : Tip.ay - self.height / 2), 4px, max(4px, root.height - self.height - 4px));
        border-radius: 7px;
        background: Theme.tip-bg;
        border-width: 1px;
        border-color: Theme.control-on;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000080;
        tip-text := Text { text: Tip.text; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
    }
}
