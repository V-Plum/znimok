<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Znimok.app under the hardened runtime (ZK-299). Screen capture needs no entitlement (TCC asks
     by NSScreenCaptureUsageDescription); the microphone in a recording does. Nothing else is
     relaxed: no JIT, no unsigned memory, library validation on (Sparkle.framework is re-signed
     with the same team). -->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
